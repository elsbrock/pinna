+/* Linux 5.8 replaced mgmt_frame_register with one call carrying the full set
+ * of registered subtypes; the driver filters only probe requests and action
+ * frames. */
+void mtk_p2p_cfg80211_update_mgmt_frame_registrations(struct wiphy *wiphy, struct wireless_dev *wdev,
+						      struct mgmt_frame_regs *upd)
+{
+	if (upd == NULL)
+		return;
+	mtk_p2p_cfg80211_mgmt_frame_register(wiphy, wdev, MAC_FRAME_PROBE_REQ,
+					     !!(upd->interface_stypes & BIT(IEEE80211_STYPE_PROBE_REQ >> 4)));
+	mtk_p2p_cfg80211_mgmt_frame_register(wiphy, wdev, MAC_FRAME_ACTION,
+					     !!(upd->interface_stypes & BIT(IEEE80211_STYPE_ACTION >> 4)));
+}
