+config MTK_MT8163_WIFI_AP
+	bool "MT8163 Wi-Fi access point (vendor Wi-Fi Direct)"
+	depends on MTK_MT8163_CONSYS
+	default n
+	help
+	  Build the vendor driver's Wi-Fi Direct part, which provides the
+	  access point interface: writing "A" to /dev/wmtWifi registers ap0,
+	  which hostapd drives over nl80211. It also enables Wi-Fi Display,
+	  which the vendor code requires with Wi-Fi Direct, as the stock
+	  build did. Without it the driver is station only.
+
