From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Simon Elsbrock <simon@iodev.org>
Date: Thu, 26 Nov 2026 16:20:00 +0100
Subject: [PATCH] ASoC: tlv320adcx140, mt8519: run the Echo Dot (5th gen)'s ADC
 as clock provider

The Echo Dot (5th gen)'s TLV320ADC5140 is the clock provider on eTDM1
(the device tree's etdm1-in-master-clock = 0): it makes BCLK and FSYNC
from the MCLK the AFE sends to its GPIO1. Amazon's ADC5140 driver sets
that up; mainline's tlv320adcx140 only sets the provider bit. With the
rate (48 kHz), BCLK ratio (256) and MCLK frequency at their reset
values and GPIO1 not an MCLK input, the microphones' capture on a
C2N6L4 ran but read nothing but zeros on all six channels (2026-11-26,
arecord on hw:0,9).

- tlv320adcx140: set_sysclk selects MCLK's frequency (MST_CFG0), and as
  clock provider hw_params programs the FSYNC rate and the BCLK cycles
  per frame (MST_CFG1), as Amazon's driver does.
- The device tree makes the ADC's GPIO1 the MCLK input
  (ti,gpio-config = <10 2>, the 0xa2 Amazon's driver writes).
- The machine driver flipped the BCLK polarity for the TI ADC, because
  Amazon's driver took it literally. Mainline's driver already inverts
  BCLK for the DSP formats, so the flip set the opposite edge from the
  one Amazon's driver set: the TI ADC now gets the link's polarity.

---
--- a/sound/soc/codecs/tlv320adcx140.c
+++ b/sound/soc/codecs/tlv320adcx140.c
@@ -33,6 +33,8 @@
 
 	unsigned int dai_fmt;
 	unsigned int slot_width;
+	/* The ADC drives BCLK and FSYNC (SND_SOC_DAIFMT_CBP_CFP). */
+	bool clock_provider;
 };
 
 static const char * const gpo_config_names[] = {
@@ -719,6 +721,41 @@
 			   ADCX140_PWR_CTRL_MSK, pwr_ctrl);
 }
 
+/* MST_CFG0: MCLK's frequency in bits 2:0, with FS_MODE (bit 3) at 0 for
+ * the 48 kHz family. MST_CFG1: FSYNC rate in bits 7:4, BCLK cycles per
+ * FSYNC in bits 3:0. */
+#define ADCX140_MCLK_FREQ_SEL_MSK	GENMASK(2, 0)
+#define ADCX140_FS_RATE_SHIFT		4
+
+static int adcx140_set_master_rate(struct snd_soc_component *component,
+				   struct snd_pcm_hw_params *params)
+{
+	static const unsigned int rates[] = {
+		8000, 16000, 24000, 32000, 48000, 96000, 192000, 384000, 768000,
+	};
+	static const unsigned int ratios[] = {
+		16, 24, 32, 48, 64, 96, 128, 192, 256, 384, 512, 1024, 2048,
+	};
+	unsigned int rate = params_rate(params);
+	unsigned int bclks = params_channels(params) *
+			     params_physical_width(params);
+	int fs, ratio;
+
+	for (fs = 0; fs < ARRAY_SIZE(rates) && rates[fs] != rate; fs++)
+		;
+	for (ratio = 0; ratio < ARRAY_SIZE(ratios) && ratios[ratio] != bclks; ratio++)
+		;
+	if (fs == ARRAY_SIZE(rates) || ratio == ARRAY_SIZE(ratios)) {
+		dev_err(component->dev,
+			"No clock provider setting for %u Hz with %u BCLKs a frame\n",
+			params_rate(params), bclks);
+		return -EINVAL;
+	}
+
+	return snd_soc_component_write(component, ADCX140_MST_CFG1,
+				       fs << ADCX140_FS_RATE_SHIFT | ratio);
+}
+
 static int adcx140_hw_params(struct snd_pcm_substream *substream,
 			     struct snd_pcm_hw_params *params,
 			     struct snd_soc_dai *dai)
@@ -726,6 +763,7 @@
 	struct snd_soc_component *component = dai->component;
 	struct adcx140_priv *adcx140 = snd_soc_component_get_drvdata(component);
 	u8 data = 0;
+	int ret;
 
 	switch (params_physical_width(params)) {
 	case 16:
@@ -751,6 +789,21 @@
 	snd_soc_component_update_bits(component, ADCX140_ASI_CFG0,
 			    ADCX140_WORD_LEN_MSK, data);
 
+	/*
+	 * As clock provider the ADC makes FSYNC and BCLK from MCLK, and the
+	 * rate and the BCLK-to-FSYNC ratio it makes them with are registers
+	 * of their own: left at their defaults (48 kHz, 256) it sends the
+	 * Echo Dot (5th gen)'s AFE no frame it can read. Amazon's ADC5140
+	 * driver programs them the same way.
+	 */
+	if (adcx140->clock_provider) {
+		ret = adcx140_set_master_rate(component, params);
+		if (ret) {
+			adcx140_pwr_ctrl(adcx140, true);
+			return ret;
+		}
+	}
+
 	adcx140_pwr_ctrl(adcx140, true);
 
 	return 0;
@@ -818,6 +871,7 @@
 		iface_reg1 |= ADCX140_BCLKINV_BIT;
 
 	adcx140->dai_fmt = fmt & SND_SOC_DAIFMT_FORMAT_MASK;
+	adcx140->clock_provider = iface_reg2 & ADCX140_BCLK_FSYNC_MASTER;
 
 	adcx140_pwr_ctrl(adcx140, false);
 
@@ -870,9 +924,36 @@
 	return 0;
 }
 
+/*
+ * MCLK's frequency, for the ADC as clock provider: MST_CFG0's MCLK_FREQ_SEL.
+ * The pin it arrives on is a GPIO's function (ti,gpio-config).
+ */
+static int adcx140_set_dai_sysclk(struct snd_soc_dai *dai, int clk_id,
+				  unsigned int freq, int dir)
+{
+	static const unsigned int mclks[] = {
+		12000000, 12288000, 13000000, 16000000,
+		19200000, 19680000, 24000000, 24576000,
+	};
+	int sel;
+
+	for (sel = 0; sel < ARRAY_SIZE(mclks) && mclks[sel] != freq; sel++)
+		;
+	if (sel == ARRAY_SIZE(mclks)) {
+		dev_err(dai->dev, "Unsupported MCLK %u Hz\n", freq);
+		return -EINVAL;
+	}
+
+	int ret = snd_soc_component_update_bits(dai->component, ADCX140_MST_CFG0,
+						ADCX140_MCLK_FREQ_SEL_MSK, sel);
+
+	return ret < 0 ? ret : 0;
+}
+
 static const struct snd_soc_dai_ops adcx140_dai_ops = {
 	.hw_params	= adcx140_hw_params,
 	.set_fmt	= adcx140_set_dai_fmt,
+	.set_sysclk	= adcx140_set_dai_sysclk,
 	.set_tdm_slot	= adcx140_set_dai_tdm_slot,
 };
 
--- a/arch/arm/boot/dts/mediatek/cannoli-cheesecake.dtsi
+++ b/arch/arm/boot/dts/mediatek/cannoli-cheesecake.dtsi
@@ -926,6 +926,13 @@
 		compatible = "ti,tlv320adc5140";
 		reg = <0x4c>;
 		reset-adc-regulator-supply = <&reset_adc>;
+		/*
+		 * GPIO1 is the MCLK input (function 10, drive 2): the ADC is
+		 * the clock provider on eTDM1 and makes BCLK and FSYNC from
+		 * the MCLK the AFE sends it. Amazon's ADC5140 driver writes the
+		 * same 0xa2 to GPIO_CFG0.
+		 */
+		ti,gpio-config = <10 2>;
 		adc-num = <0>;
 		disable-suspend;
 		status = "disabled";
--- a/sound/soc/mediatek/mt8519/mendocino.c
+++ b/sound/soc/mediatek/mt8519/mendocino.c
@@ -865,23 +865,6 @@
 /*   TLV320_PLL_ADC_FS_CLKIN_PLL_BCLK = 3 */
 /*    TLV320_ADC_FS_CLKIN_BCLK = 4 */
 
-static bool mt8519_mendocino_is_ti_adc(struct snd_soc_dai *codec_dai)
-{
-	if (!codec_dai)
-		return false;
-
-	if (codec_dai->name && (strstr(codec_dai->name, "tlv320adc5140") ||
-				strstr(codec_dai->name, "tlv320adc5120")))
-		return true;
-
-	return codec_dai->component && codec_dai->component->dev &&
-		codec_dai->component->dev->of_node &&
-		(of_device_is_compatible(codec_dai->component->dev->of_node,
-					 "ti,tlv320adc5140") ||
-		 of_device_is_compatible(codec_dai->component->dev->of_node,
-					 "ti,tlv320adc5120"));
-}
-
 static int mt8519_mendocino_hw_params(struct snd_pcm_substream *substream,
 				struct snd_pcm_hw_params *params)
 {
@@ -977,22 +960,15 @@
 			* params_channels(params) * params_rate(params)
 			, params_rate(params));
 
-		/* Inverse the BCLK bit for TI ADC5140 to match MTK and AKM. */
-		if (mt8519_mendocino_is_ti_adc(snd_soc_rtd_to_codec(rtd, 0))) {
-			switch (rtd->dai_link->dai_fmt & SND_SOC_DAIFMT_INV_MASK) {
-			case SND_SOC_DAIFMT_NB_NF:
-				fmt = rtd->dai_link->dai_fmt | SND_SOC_DAIFMT_IB_NF;
-				break;
-			case SND_SOC_DAIFMT_IB_NF:
-				fmt = rtd->dai_link->dai_fmt & SND_SOC_DAIFMT_INV_RESET;
-				break;
-			default:
-				pr_err("%s invalid dai fmt\n", __func__);
-				return -EINVAL;
-			}
-		} else {
-			fmt = rtd->dai_link->dai_fmt;
-		}
+		/*
+		 * Amazon's ADC5140 driver took the BCLK polarity literally, so
+		 * this driver flipped it for the TI ADC to match MTK and AKM.
+		 * Mainline's tlv320adcx140 already inverts BCLK for the DSP
+		 * formats, which is that same flip: the link's polarity is
+		 * what it needs, and flipped again the ADC sampled on the
+		 * other edge from the one Amazon's driver set.
+		 */
+		fmt = rtd->dai_link->dai_fmt;
 
 		snd_soc_dai_set_fmt(codec_dai, fmt);
 
