From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Simon Elsbrock <simon@iodev.org>
Date: Sat, 21 Nov 2026 17:27:10 +0100
Subject: [PATCH] thermal: mediatek: add the MT8519 SoC temperature sensor,
 ported to 6.12

MediaTek's on-die SoC thermal sensor from Amazon's 5.4 release (binds the DT's
mediatek,mt8519-thermal). Three changes for 6.12: the thermal-of API (get_temp
takes a thermal_zone_device and reads thermal_zone_device_priv; register with
devm_thermal_of_zone_register; void remove); read the thermal calibration from
the efuse through nvmem (define NVMEM_USE) instead of the removed
get_devinfo_with_index() devinfo API; and drop the mt8173-thermal match so it
does not overlap the MT8163 auxadc thermal already in the tree. Off in every
current variant.
---
 drivers/thermal/mediatek/Kconfig    |    7 +
 drivers/thermal/mediatek/Makefile   |    1 +
 drivers/thermal/mediatek/soc_temp.c | 1170 +++++++++++++++++++++++++++
 drivers/thermal/mediatek/soc_temp.h |  244 ++++++
 4 files changed, 1422 insertions(+)
 create mode 100644 drivers/thermal/mediatek/soc_temp.c
 create mode 100644 drivers/thermal/mediatek/soc_temp.h

diff --git a/drivers/thermal/mediatek/Kconfig b/drivers/thermal/mediatek/Kconfig
index d82c86d9b..4a47d9953 100644
--- a/drivers/thermal/mediatek/Kconfig
+++ b/drivers/thermal/mediatek/Kconfig
@@ -35,3 +35,10 @@ config MTK_LVTS_THERMAL_DEBUGFS
          Enable this option to debug the internals of the device driver.
 
 endif
+
+config MTK_SOC_TEMP
+	tristate "MediaTek MT8519 SoC temperature sensor"
+	depends on (ARCH_MEDIATEK || COMPILE_TEST) && THERMAL_OF
+	help
+	  On-die temperature sensor on the MediaTek MT8519 (Echo Dot 5th gen),
+	  calibrated from the efuse via nvmem.
diff --git a/drivers/thermal/mediatek/Makefile b/drivers/thermal/mediatek/Makefile
index 1c6daa1e6..877772e9f 100644
--- a/drivers/thermal/mediatek/Makefile
+++ b/drivers/thermal/mediatek/Makefile
@@ -1,2 +1,3 @@
 obj-$(CONFIG_MTK_SOC_THERMAL)	+= auxadc_thermal.o
 obj-$(CONFIG_MTK_LVTS_THERMAL)	+= lvts_thermal.o
+obj-$(CONFIG_MTK_SOC_TEMP) += soc_temp.o
diff --git a/drivers/thermal/mediatek/soc_temp.c b/drivers/thermal/mediatek/soc_temp.c
new file mode 100644
index 000000000..789edbd3b
--- /dev/null
+++ b/drivers/thermal/mediatek/soc_temp.c
@@ -0,0 +1,1170 @@
