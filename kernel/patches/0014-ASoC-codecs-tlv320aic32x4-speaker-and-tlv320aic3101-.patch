+#define AIC31XX_CODEC_CLKIN_SHIFT			0
+#define AIC31XX_CODEC_CLKIN_MCLK			0x0
+#define AIC31XX_CODEC_CLKIN_BCLK			0x1
+#define AIC31XX_CODEC_CLKIN_PLL				0x3
