+static void tlv320aic3101_sw_reset(struct snd_soc_component *component)
+{
+	int i;
+
+	/* # Software Reset */
+	for (i = 0; i < NUM_ADC3101; i++)
+		snd_soc_component_write(component, ADC_RESET(i), 0x1);
+
+	mdelay(20);
+}
