+static int aic32x4_playback_fail_closed(struct snd_soc_component *component,
+						int original_error)
+{
+	int ret;
+
+	/* Keep the codec DAC muted on any error.  MFP2 is already asserted by
+	 * the caller before entering this cleanup path. */
