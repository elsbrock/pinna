+/*
+* aic31xx_dai_set_pll
+*
+* This function is invoked as part of the PLL call-back
+* handler from the ALSA layer.
+*/
+static int aic31xx_dai_set_pll(struct snd_soc_dai *dai,
+		int pll_id, int source, unsigned int freq_in,
+		unsigned int freq_out)
+{
+	struct snd_soc_component *component = dai->component;
+	struct aic31xx_priv *aic31xx = snd_soc_component_get_drvdata(component);
+	const struct adc31xx_rate_divs *divs;
+	size_t divs_len;
+	u8 clk_mux, pll_enab = 0;
+	int i;
+
+	switch (source) {
+	case AIC3101_PLL_ADC_FS_CLKIN_PLL_MCLK:
+		clk_mux = (AIC31XX_PLL_CLKIN_MCLK << AIC31XX_PLL_CLKIN_SHIFT) |
+			   (AIC31XX_CODEC_CLKIN_PLL << AIC31XX_CODEC_CLKIN_SHIFT);
+		divs = aic31xx_divs_pll;
+		divs_len = ARRAY_SIZE(aic31xx_divs_pll);
+		pll_enab = ADC_PLL_POWER_UP;
+		break;
+	case AIC3101_PLL_ADC_FS_CLKIN_PLL_BCLK:
+		clk_mux = (AIC31XX_PLL_CLKIN_BCLK << AIC31XX_PLL_CLKIN_SHIFT) |
+			   (AIC31XX_CODEC_CLKIN_PLL << AIC31XX_CODEC_CLKIN_SHIFT);
+		divs = aic31xx_divs_pll;
+		divs_len = ARRAY_SIZE(aic31xx_divs_pll);
+		pll_enab = ADC_PLL_POWER_UP;
+		break;
+	case AIC3101_PLL_ADC_FS_CLKIN_MCLK:
+		clk_mux = (AIC31XX_PLL_CLKIN_MCLK << AIC31XX_PLL_CLKIN_SHIFT) |
+			   (AIC31XX_CODEC_CLKIN_MCLK << AIC31XX_CODEC_CLKIN_SHIFT);
+		divs = aic31xx_divs_pll;
+		divs_len = ARRAY_SIZE(aic31xx_divs_pll);
+		break;
+	case AIC3101_PLL_ADC_FS_CLKIN_BCLK:
+		clk_mux = (AIC31XX_PLL_CLKIN_BCLK << AIC31XX_PLL_CLKIN_SHIFT) |
+			   (AIC31XX_CODEC_CLKIN_BCLK << AIC31XX_CODEC_CLKIN_SHIFT);
+		divs = aic31xx_divs_bclk;
+		divs_len = ARRAY_SIZE(aic31xx_divs_bclk);
+		break;
+	default:
+		dev_err(component->dev, "source %d not supported\n", source);
+		return -EINVAL;
+	}
+
+	dev_dbg(component->dev, "In aic31xx: dai_set_pll mux=0x%x out=%d in=%d\n", clk_mux, freq_in, freq_out);
+
+	for (i = 0; i < divs_len; i++) {
+		if ((divs[i].rate == freq_out)
+			&& (divs[i].mclk == freq_in)) {
+				break;
+		}
+	}
+
+	if (i == divs_len) {
+		dev_err(component->dev, "sampling rate not supported\n");
+		return -EINVAL;
+	}
+
+	aic31xx->freq_in = freq_in;
+	aic31xx->freq_out = freq_out;
+	divs = &divs[i];
+
+	/* Backup gains and mode settings before reset */
+	tlv320aic3101_save_settings(component);
+
+	/* Reset ADCs */
+	tlv320aic3101_sw_reset(component);
+
+	/*turn off pll and m/n dividers on adc3101*/
+	for (i = 0; i < NUM_ADC3101; i++) {
+		snd_soc_component_write(component, ADC_PLL_PROG_PR(i), 0x00);
+		snd_soc_component_write(component, ADC_ADC_NADC(i), 0x00);
+		snd_soc_component_write(component, ADC_ADC_MADC(i), 0x00);
+		snd_soc_component_write(component, ADC_BCLK_N_DIV(i), 0X00);
+	}
+
+	snd_soc_component_write(component, ADC_CLKGEN_MUX(0), clk_mux);
+
+	snd_soc_component_write(component, ADC_ADC_AOSR(0), divs->aosr & 0xff);
+
+	snd_soc_component_write(component, ADC_PLL_PROG_PR(0),
+		pll_enab | (divs->pll_p & 0x7) << ADC_PLLP_SHIFT | divs->pll_r);
+	snd_soc_component_write(component, ADC_PLL_PROG_J(0), divs->pll_j & ADC_PLLJ_MASK);
+	snd_soc_component_write(component, ADC_PLL_PROG_D_MSB(0),
+		(divs->pll_d >> 8) & ADC_PLLD_MSB_MASK);
+	snd_soc_component_write(component, ADC_PLL_PROG_D_LSB(0),
+		divs->pll_d & ADC_PLLD_LSB_MASK);
+
+	/* NADC divider value. Do not turn on */
+	snd_soc_component_write(component, ADC_ADC_NADC(0), (divs->nadc & ADC_NADC_MASK));
+
+	/* MADC divider value */
+	snd_soc_component_write(component, ADC_ADC_MADC(0),
+			0x80 | (divs->madc & ADC_NADC_MASK));
+
+	mdelay(15);
+
+	if (pll_id == AIC3101_PLL_BCLK) {
+		/* Add BDIV
+		 * Only the first ADC could be master, so only set the bdiv_n for the first ADC.
+		 */
+		snd_soc_component_write(component, ADC_BCLK_N_DIV(0), divs->bdiv_n);
+	} else if (pll_id == AIC3101_PLL_CLKOUT) {
+		/* Add M_Val */
+	}
+
+	/* Program DSP */
+	aic31xx_apply_tuning(component);
+
+	dev_info(component->dev, "%s: DAI ID %d PLL_ID %d InFreq %d OutFreq %d\n",
+		__func__, dai->id, pll_id, freq_in, freq_out);
+	return 0;
+}
