+typedef union reg {
+	struct adc31xx_reg {
+		u8 reserved;
+		u8 device;
+		u8 page;
+		u8 offset;
+	} adc31xx_register;
+	unsigned int adc31xx_register_int;
+} adc31xx_reg_union;
+*/
