+/*
+ *----------------------------------------------------------------------------
+ * Function : adc31xx_change_page
+ * Purpose  : This function is to switch between page 0 and page 1.
+ *
+ *----------------------------------------------------------------------------
+ */
+static int adc31xx_change_page(unsigned int device, struct snd_soc_component *component,
+			       u8 new_page)
+{
+	struct aic31xx_priv *adc31xx = snd_soc_component_get_drvdata(component);
+
+	u8 data[2];
+
+	data[0] = 0x0;
+	data[1] = new_page;
+
+	if (i2c_master_send(adc31xx->adc_control_data[device], data, 2) != 2) {
+		dev_err(component->dev, "adc31xx_change_page %d: I2C Wrte Error\n",
+			device);
+		return -1;
+	}
+	adc31xx->adc_page_no[device] = new_page;
+	return 0;
+}
+
+/*
+ *----------------------------------------------------------------------------
+ * Function : aic31xx_write_reg_cache
+ * Purpose  : This function is to write aic31xx register cache
+ *----------------------------------------------------------------------------
+ */
+static inline void aic31xx_write_reg_cache(struct snd_soc_component *component, u8 device,
+					   u8 page, u16 reg, u8 value)
+{
+	struct aic31xx_priv *aic31xx =
+		snd_soc_component_get_drvdata(component);
+	u8 *cache = aic31xx->reg_cache;
+	int offset;
+
+	offset = device * ADC3101_CACHEREGNUM;
+
+	if (page == 1)
+		offset += 128;
+
+	if (offset + reg >= AIC31XX_CACHEREGNUM)
+		return;
+
+	dev_dbg(component->dev, "(%d) wrote %#x to %#x (%d) cache offset %d\n",
+		device, value, reg, reg, offset);
+
+	cache[offset + reg] = value;
+}
+
+/*
+ *----------------------------------------------------------------------------
+ * Function : aic31xx_read_reg_cache
+ * Purpose  : This function is to read the register cache
+ *
+ *----------------------------------------------------------------------------
+ */
+static unsigned int aic31xx_read_reg_cache(struct snd_soc_component *component,
+					   unsigned int reg)
+{
+	struct aic31xx_priv *aic31xx =
+		snd_soc_component_get_drvdata(component);
+	u8 *cache = aic31xx->reg_cache;
+	u16 device, page, reg_no;
+	int offset;
+
+	page = (reg & 0x3f800) >> 11;
+	device = (reg & 0x700) >> 8;
+	reg_no = reg & 0x7f;
+
+	if (page > 1) {
+		dev_warn(component->dev, "unable to read register: page:%u, reg:%u\n",
+			 page, reg_no);
+		return -EINVAL;
+	}
+
+	offset = device * ADC3101_CACHEREGNUM;
+
+	if (page == 1)
+		offset += 128;
+
+	if (offset + reg_no >= AIC31XX_CACHEREGNUM) {
+		dev_warn(component->dev, "unable to read register: page:%u, reg:%u\n",
+			 page, reg_no);
+		return -EINVAL;
+	}
+
+	dev_dbg(component->dev, "(%d) read %#x from %#x (%d) cache offset %d\n",
+		device, cache[offset + reg_no], reg_no, reg_no, offset);
+
+	return cache[offset + reg_no];
+}
+
+/*
+ *----------------------------------------------------------------------------
+ * Function : aic31xx_write
+ * Purpose  : This function is to write to the aic31xx register space.
+ *----------------------------------------------------------------------------
+ */
+static int aic31xx_write(struct snd_soc_component *component, unsigned int reg,
+			 unsigned int value)
+{
+	int ret = 0;
+	u8 data[2];
+	u16 page;
+	u16 device;
+	unsigned int reg_no;
+	struct aic31xx_priv *aic31xx = snd_soc_component_get_drvdata(component);
+	struct i2c_client *i2cdev;
+
+	if (!aic31xx) {
+		return -ENODEV;
+	}
+
+	page = (reg & 0x3f800) >> 11;
+	/* bit7 is zero while using MAKE_REG */
+	/* bit7 is used by soc-cache to store page */
+	if (reg & 0x80)
+		page = 1;
+	device = (reg & 0x700) >> 8;
+	reg_no = reg & 0x7f;
+
+	dev_dbg(component->dev, "AIC Write dev %#x page %d reg %#x val %#x\n",
+		device, page, reg_no, value);
+
+	i2cdev = aic31xx->adc_control_data[device];
+	if (!i2cdev) {
+		dev_err(component->dev,
+			"Error: AIC Write dev %#x page %d reg %#x val %#x (no i2c device)\n",
+			device, page, reg_no, value);
+		return -ENODEV;
+	}
+
+	mutex_lock(&aic31xx->codecMutex);
+
+	if (aic31xx->adc_page_no[device] != page)
+		adc31xx_change_page(device, component, page);
+
+	/*
+	 * data is
+	 *   D15..D8 register offset
+	 *   D7...D0 register data
+	 */
+	data[0] = reg_no;
+	data[1] = value;
+
+	if (i2c_master_send(i2cdev, data, 2) != 2) {
+		dev_err(component->dev, "Error in i2c write in i2c dev: %x \n",
+			device);
+
+		ret = -EIO;
+	} else if ((page < 2) && !((page == 0) && (reg == 1))) {
+		/* Shadow the first two pages only */
+		aic31xx_write_reg_cache(component, device, page, reg_no, value);
+	}
+
+	mutex_unlock(&aic31xx->codecMutex);
+
+	return ret;
+}
