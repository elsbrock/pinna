+static int aic31xx_dai_set_tdm_slot(struct snd_soc_dai *dai,
+				    unsigned int tx_mask,
+				    unsigned int rx_mask,
+				    int slots, int slot_width)
+
+{
+	struct snd_soc_component *component = dai->component;
+	struct aic31xx_priv *aic31xx = snd_soc_component_get_drvdata(component);
+
+	dev_dbg(component->dev, "tx_mask=%u rx_mask=%u slots=%d slot_width=%d\n",
+		tx_mask, rx_mask, slots, slot_width);
+
+	aic31xx->tdm_rx_mask = rx_mask;
+	aic31xx->tdm_slot_width = slot_width;
+
+	return 0;
+}
+static int aic31xx_dai_apply_tdm_slot(struct snd_soc_component *component)
+{
+	int i, mic_pos = 0, swap_channels = 0;
+	struct aic31xx_priv *aic31xx = snd_soc_component_get_drvdata(component);
+#ifdef CONFIG_ACPI
+	struct i2c_client *i2cdev = aic31xx->adc_control_data[0];
+
+	int ret = acpi_get_mic_pos(&i2cdev->dev, &mic_pos);
+	if (ret) {
+		dev_err(component->dev, "Can't get mic position, so use the default position.\n", ret);
+		mic_pos = 0;
+	}
+#endif
+
+	if (mic_pos == 0) {
+		if (aic31xx->tdm_rx_mask == 0x40) {
+			dev_info(component->dev, "linein enabled slot_width=%d\n",
+				aic31xx->tdm_slot_width);
+			swap_channels = 0x1 << ADC_TDM_CHANNEL_SWAP_SHIFT;
+		}
+
+		for (i = 0; i < NUM_ADC3101; i++) {
+			u8 enable_channels = ~(aic31xx->tdm_rx_mask >> (i * 2)) & ADC_TDM_MASK;
+			snd_soc_component_write(component, ADC_I2S_TDM_CTRL(i),
+				(enable_channels << ADC_TDM_CHANNEL_EN_SHIFT) | EARLY_3STATE_ENABLED | swap_channels);
+			snd_soc_component_write(component, ADC_CH_OFFSET_1(i),
+				(2 * i * aic31xx->tdm_slot_width) | aic31xx->dsp_a_val);
+		}
+	} else if (mic_pos == 1) {
+		u8 mic_pos_offset[] = {
+			0x00, 0x90, 0x30, 0x30,
+			0x48, 0x00, 0x18, 0x60
+		};
+		for (i = 0; i < NUM_ADC3101; i++) {
+			u8 enable_channels = ~(aic31xx->tdm_rx_mask >> (i * 2)) & 0x3;
+			/* ADC_A: left=MIC_8, right=MIC_1
+			 * Set it to be left=MIC_1, right=MIC_8, and then swap left and right channels.
+			 * ADC_B: left=MIC_6, right=MIC_3
+			 * Set it to be left=MIC_3, right=MIC_6, and then swap left and right channels.
+			 * ADC_C: left=MIC_5, right=MIC_4
+			 * Set it to be left=MIC_4, right=MIC_5, and then swap left and right channels.
+			 * ADC_D: left=MIC_7, right=MIC_2
+			 * Set it to be left=MIC_2, right=MIC_7, and then swap left and right channels.
+			 */
+			snd_soc_component_write(component, ADC_CH_OFFSET_1(i), mic_pos_offset[2*i]);
+			snd_soc_component_write(component, ADC_CH_OFFSET_2(i), mic_pos_offset[2*i + 1]);
+			snd_soc_component_update_bits(component, ADC_I2S_TDM_CTRL(i),
+					0x3 << ADC_TDM_CHANNEL_EN_SHIFT,
+					enable_channels << ADC_TDM_CHANNEL_EN_SHIFT);
+			snd_soc_component_update_bits(component, ADC_I2S_TDM_CTRL(i),
+					0x1 << ADC_TDM_CHANNEL_SWAP_SHIFT,
+					0x1 << ADC_TDM_CHANNEL_SWAP_SHIFT);
+			snd_soc_component_update_bits(component, ADC_I2S_TDM_CTRL(i),
+					0x1 << ADC_TDM_EN_SHIFT,
+					0x1 << ADC_TDM_EN_SHIFT);
+		}
+	}
+
+	return 0;
+}
+
+static void tlv320aic3101_save_settings(struct snd_soc_component *component)
+{
+	int i;
+
+	for (i = 0; i < NUM_ADC3101; i++) {
+		/* Save left and right ADC PGA input selection */
+		pga1_input_sel_l[i] = snd_soc_component_read(component, ADC_LEFT_PGA_SEL_1(i));
+		pga1_input_sel_r[i] = snd_soc_component_read(component, ADC_RIGHT_PGA_SEL_1(i));
+		pga2_input_sel_l[i] = snd_soc_component_read(component, ADC_LEFT_PGA_SEL_2(i));
+		pga2_input_sel_r[i] = snd_soc_component_read(component, ADC_RIGHT_PGA_SEL_2(i));
+
+		/* Save PGA gain */
+		mic_pga_l[i] = snd_soc_component_read(component, ADC_LEFT_APGA_CTRL(i));
+		mic_pga_r[i] = snd_soc_component_read(component, ADC_RIGHT_APGA_CTRL(i));
+	}
+}
+
+static void tlv320aic3101_adc_cfg(struct snd_soc_component *component)
+{
+	int i;
+
+	for (i = 0; i < NUM_ADC3101; i++) {
+		/* Setup left and right ADC PGA input selection */
+		snd_soc_component_write(component, ADC_LEFT_PGA_SEL_1(i), pga1_input_sel_l[i]);
+		snd_soc_component_write(component, ADC_RIGHT_PGA_SEL_1(i), pga1_input_sel_r[i]);
+		snd_soc_component_write(component, ADC_LEFT_PGA_SEL_2(i), pga2_input_sel_l[i]);
+		snd_soc_component_write(component, ADC_RIGHT_PGA_SEL_2(i), pga2_input_sel_r[i]);
+
+		/* Setup PGA gain */
+		snd_soc_component_write(component, ADC_LEFT_APGA_CTRL(i), mic_pga_l[i]);
+		snd_soc_component_write(component, ADC_RIGHT_APGA_CTRL(i), mic_pga_r[i]);
+
+		/* Unmute ADC channels and set fine gain */
+		snd_soc_component_write(component, ADC_ADC_FGA(i), 0x00);
+	}
+}
+
+/*
+ * This function is to set the hardware parameters for aic31xx.  The
+ * functions set the sample rate and audio serial data word length.
+ */
+static int aic31xx_hw_params(struct snd_pcm_substream *substream,
+			     struct snd_pcm_hw_params *params,
+			     struct snd_soc_dai *dai)
+{
+	struct snd_soc_component *component = dai->component;
+	u8 data = 0;
+	int i;
+
+	dev_dbg(component->dev, "%s: ##- Data length: %x\n", __func__,
+		params_format(params));
+
+	/* DOUT disable: bus keeper disabled */
+	for (i = 0; i < NUM_ADC3101; i++)
+		snd_soc_component_write(component, ADC_DOUT_CTRL(i), 0x10);
+
+	switch (params_format(params)) {
+	case SNDRV_PCM_FORMAT_S16_LE:
+		break;
+	case SNDRV_PCM_FORMAT_S20_3LE:
+		data |= (AIC31XX_WORD_LEN_20BITS <<
+				AIC31XX_IFACE1_DATALEN_SHIFT);
+		break;
+	case SNDRV_PCM_FORMAT_S24_LE:
+	case SNDRV_PCM_FORMAT_S24_3LE:
+		data |= (AIC31XX_WORD_LEN_24BITS <<
+				AIC31XX_IFACE1_DATALEN_SHIFT);
+		break;
+	case SNDRV_PCM_FORMAT_S32_LE:
+		data |= (AIC31XX_WORD_LEN_32BITS <<
+				AIC31XX_IFACE1_DATALEN_SHIFT);
+		break;
+	}
+	for (i = 0; i < NUM_ADC3101; i++)
+		snd_soc_component_update_bits(component, ADC_INTERFACE_CTRL_1(i),
+				    AIC31XX_IFACE1_DATALEN_MASK, data);
+
+	/* Apply gains and unmute */
+	tlv320aic3101_adc_cfg(component);
+
+	/* Enable NADC of master */
+	snd_soc_component_update_bits(component, ADC_ADC_NADC(0), ADC_ENABLE_NADC,
+		ADC_ENABLE_NADC);
+
+	/* mandatory delay to allow ADC clocks to synchronize */
+	mdelay(100);
+
+	/* Set mic position on TDM slots */
+	aic31xx_dai_apply_tdm_slot(component);
+
+	/* # Turn Douts back on */
+	/* DOUT: Primary Output Enable, bus keeper disabled */
+	for (i = 0; i < NUM_ADC3101; i++)
+		snd_soc_component_write(component, ADC_DOUT_CTRL(i), 0x12);
+
+	return 0;
+}
+
+/*
+ * aic31xx_dai_set_fmt
+ *
+ * This function is to set the DAI format.
+ * Note that if the first ADC is used as master, and the others as slaves,
+ * please call set_pll() before set_fmt().
+ */
+static int aic31xx_dai_set_fmt(struct snd_soc_dai *codec_dai,
+		unsigned int fmt)
+{
+	struct snd_soc_component *component = codec_dai->component;
+	struct aic31xx_priv *aic31xx = snd_soc_component_get_drvdata(component);
+	const struct adc31xx_rate_divs *divs = NULL;
+	u8 iface_reg1 = 0;
+	u8 iface_reg3 = AIC31XX_ADC2BCLK; /* Default value */
+	u8 dsp_a_val = 0;
+	int i;
+
+	dev_dbg(component->dev, "%s:+ %x\n", __func__, fmt);
+
+	/* set master/slave audio interface */
+	switch (fmt & SND_SOC_DAIFMT_MASTER_MASK) {
+	case SND_SOC_DAIFMT_CBM_CFM:
+		iface_reg1 = AIC31XX_BCLK_MASTER | AIC31XX_WCLK_MASTER;
+		break;
+	case SND_SOC_DAIFMT_CBS_CFS:
+		iface_reg1 &= ~(AIC31XX_BCLK_MASTER | AIC31XX_WCLK_MASTER);
+		break;
+	case SND_SOC_DAIFMT_CBS_CFM:
+		iface_reg1 = AIC31XX_BCLK_MASTER;
+		iface_reg1 &= ~(AIC31XX_WCLK_MASTER);
+		break;
+	default:
+		dev_alert(component->dev, "Invalid DAI master/slave interface\n");
+		return -EINVAL;
+	}
+	/* interface format */
+	switch (fmt & SND_SOC_DAIFMT_FORMAT_MASK) {
+	case SND_SOC_DAIFMT_I2S:
+		break;
+	case SND_SOC_DAIFMT_DSP_A:
+		dsp_a_val = 0x1;
+		fallthrough;
+	case SND_SOC_DAIFMT_DSP_B:
+		switch (fmt & SND_SOC_DAIFMT_INV_MASK) {
+		case SND_SOC_DAIFMT_NB_NF:
+			break;
+		case SND_SOC_DAIFMT_IB_NF:
+			iface_reg3 |= AIC31XX_BCLKINV_MASK;
+			break;
+		default:
+			return -EINVAL;
+		}
+		iface_reg1 |= (AIC31XX_DSP_MODE <<
+				AIC31XX_IFACE1_DATATYPE_SHIFT);
+		iface_reg1 |= (AIC31XX_3STATES <<
+				AIC31XX_IFACE1_3STATES_SHIFT);
+		break;
+	case SND_SOC_DAIFMT_RIGHT_J:
+		iface_reg1 |= (AIC31XX_RIGHT_JUSTIFIED_MODE <<
+				AIC31XX_IFACE1_DATATYPE_SHIFT);
+		break;
+	case SND_SOC_DAIFMT_LEFT_J:
+		iface_reg1 |= (AIC31XX_LEFT_JUSTIFIED_MODE <<
+				AIC31XX_IFACE1_DATATYPE_SHIFT);
+		break;
+	default:
+		dev_alert(component->dev, "Invalid DAI interface format\n");
+		return -EINVAL;
+	}
+
+	/* Store 1 bclk offset for Ch_OffSet_1 */
+	aic31xx->dsp_a_val = dsp_a_val;
+
+	if (iface_reg1 & AIC31XX_BCLK_MASTER) {
+		int bclk_out = 0;
+		/* Calcualte the BCLK out of the first component */
+		for (i = 0; i < ARRAY_SIZE(aic31xx_divs_pll); i++) {
+			if ((aic31xx_divs_pll[i].rate == aic31xx->freq_out)
+			    && (aic31xx_divs_pll[i].mclk == aic31xx->freq_in)) {
+				divs = &aic31xx_divs_pll[i];
+				bclk_out = (aic31xx->freq_in * divs->pll_r *
+					    divs->pll_j + aic31xx->freq_in/10000 *
+					    divs->pll_r * divs->pll_d) /
+					(divs->pll_p * divs->nadc * divs->bdiv_n);
+				divs = NULL;
+				break;
+			}
+		}
+		dev_info(component->dev, "%s: InFreq %d bclk_out %d\n", __func__, aic31xx->freq_in, bclk_out);
+
+		/* Find the settings of the slave codecs*/
+		for (i = 0; i < ARRAY_SIZE(aic31xx_divs_bclk); i++) {
+			if ((aic31xx_divs_bclk[i].rate == aic31xx->freq_out)
+				&& (aic31xx_divs_bclk[i].mclk == bclk_out)) {
+					divs = &aic31xx_divs_bclk[i];
+					break;
+			}
+		}
+
+		if (i == ARRAY_SIZE(aic31xx_divs_bclk)) {
+			dev_err(component->dev, "No matching bclk\n");
+			return -EINVAL;
+		}
+	}
+
+	for (i = 0; i < NUM_ADC3101; i++) {
+		/* Inverted BCLK flag */
+		snd_soc_component_write(component, ADC_INTERFACE_CTRL_2(i), iface_reg3);
+		if (i == 0) {
+			/* Set Format and Master mode */
+			snd_soc_component_write(component, ADC_INTERFACE_CTRL_1(0),
+				iface_reg1);
+
+			if (iface_reg1 & AIC31XX_BCLK_MASTER) {
+				/* Enable BCLK and WCLK out when the component is powered down */
+				snd_soc_component_write(component, ADC_INTERFACE_CTRL_2(0),
+					iface_reg3|AIC31XX_BCLK_WCLK_ACTIVE);
+				/* If the first ADC is BCLK master
+				 * power BCLK N divider up. Already programmed in set_pll
+				 */
+				snd_soc_component_update_bits(component, ADC_BCLK_N_DIV(0),
+					AIC31XX_BCLK_N_POWER_MASK,
+					AIC31XX_BCLK_N_POWER_MASK);
+			}
+		} else {
+			/* Only 1st component can be master */
+			snd_soc_component_write(component, ADC_INTERFACE_CTRL_1(i),
+				iface_reg1 & (~(AIC31XX_BCLK_MASTER | AIC31XX_WCLK_MASTER)));
+			if (divs) {
+				/* CODEC_CLKIN = BCLK */
+				snd_soc_component_write(component, ADC_CLKGEN_MUX(i),
+					AIC31XX_CODEC_CLKIN_BCLK);
+				/*  BCLK Divider */
+				snd_soc_component_write(component, ADC_BCLK_N_DIV(i), divs->bdiv_n);
+				/* P and R divider value */
+				snd_soc_component_write(component, ADC_PLL_PROG_PR(i),
+						(divs->pll_p & 0x7) << 4 | divs->pll_r);
+				/* AOSR */
+				snd_soc_component_write(component, ADC_ADC_AOSR(i), divs->aosr & 0xff);
+				/* NADC divider value */
+				snd_soc_component_write(component, ADC_ADC_NADC(i),
+						0x80 | (divs->nadc & 0x7f));
+				/* MADC divider value */
+				snd_soc_component_write(component, ADC_ADC_MADC(i),
+						0x80 | (divs->madc & 0x7f));
+			}
+		}
+
+		/* Power-up Left ADC and Right ADC */
+		snd_soc_component_write(component, ADC_ADC_DIGITAL(i), 0XC2);
+	}
+
+	dev_dbg(component->dev, "%s:- \n", __func__);
+
+	return 0;
+}
