+ */
+
+static int aic31xx_component_probe(struct snd_soc_component *component)
+{
+	return tlv320aic3101_init(component);
+}
+
+/*
+ * Remove aic31xx soc device
+ */
+static void aic31xx_component_remove(struct snd_soc_component *component)
+{
+	struct aic31xx_priv *aic31xx = snd_soc_component_get_drvdata(component);
+
+	dev_dbg(component->dev, "%s\n", __func__);
+
+	/* Switch off master clock */
+	clk_disable_unprepare(aic31xx->mclk);
+}
+
+static const struct snd_soc_component_driver soc_component_driver_aic31xx = {
+	.probe			= aic31xx_component_probe,
+	.remove			= aic31xx_component_remove,
