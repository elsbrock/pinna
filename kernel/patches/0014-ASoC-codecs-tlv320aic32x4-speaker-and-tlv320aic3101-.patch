From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Simon Elsbrock <simon@iodev.org>
Date: Sun, 15 Nov 2026 13:46:21 +0100
Subject: [PATCH 14/27] ASoC: codecs: tlv320aic32x4 speaker and tlv320aic3101
 microphone ADC support

Ported from LibreEcho-Linux release/0.14.5 (Linux 6.1.178) to Linux 6.12.
---
 sound/soc/codecs/Kconfig                |   26 +
 sound/soc/codecs/Makefile               |    1 +
 sound/soc/codecs/tlv320aic3101-amazon.c | 2324 +++++++++++++++++++++++
 sound/soc/codecs/tlv320aic3101.h        |  606 ++++++
 sound/soc/codecs/tlv320aic32x4-clk.c    |   13 +-
 sound/soc/codecs/tlv320aic32x4.c        | 1076 ++++++++++-
 sound/soc/codecs/tlv320aic32x4.h        |    6 +
 7 files changed, 4009 insertions(+), 43 deletions(-)
 create mode 100644 sound/soc/codecs/tlv320aic3101-amazon.c
 create mode 100644 sound/soc/codecs/tlv320aic3101.h

diff --git a/sound/soc/codecs/Kconfig b/sound/soc/codecs/Kconfig
index 399dcf3d1..27f153d1b 100644
--- a/sound/soc/codecs/Kconfig
+++ b/sound/soc/codecs/Kconfig
@@ -2014,6 +2014,23 @@ config SND_SOC_TLV320ADC3XXX
 	 Enable support for Texas Instruments TLV320ADC3001 and TLV320ADC3101
 	 ADCs.
 
+config SND_SOC_TLV320AIC3101_AMAZON
+	tristate "Amazon multi-ADC TLV320AIC3101 codec"
+	depends on I2C
+	depends on COMMON_CLK
+	depends on GPIOLIB
+	help
+	  Enable the Amazon TLV320AIC3101 capture driver. This preserves the
+	  release control names, DAPM routes, DSP tuning, clock programming and
+	  aggregation of four stereo ADC3101 devices into one capture DAI.
+
+config SND_SOC_8_MICS
+	bool "Amazon TLV320AIC3101 four-ADC/8-microphone routing"
+	depends on SND_SOC_TLV320AIC3101_AMAZON
+	help
+	  Build the Amazon codec with ADC_A through ADC_D and its 8-microphone
+	  userspace and machine-driver ABI.
+
 config SND_SOC_TLV320AIC23
 	tristate
 
@@ -2040,6 +2057,15 @@ config SND_SOC_TLV320AIC32X4
 	tristate
 	depends on COMMON_CLK
 
+config SND_SOC_TLV320AIC32X4_PRB25_DIAG
+	bool "TLV320AIC32x4 PRB_P25 internal-beep diagnostic"
+	depends on SND_SOC_TLV320AIC32X4
+	help
+	  Add a momentary ALSA control that runs one bounded PRB_P25 internal
+	  beep transaction through the bound codec regmap. This is intended
+	  only for controlled hardware boundary diagnosis and is not a normal
+	  playback feature.
+
 config SND_SOC_TLV320AIC32X4_I2C
 	tristate "Texas Instruments TLV320AIC32x4 audio CODECs - I2C"
 	depends on I2C
diff --git a/sound/soc/codecs/Makefile b/sound/soc/codecs/Makefile
index 47c621b3a..8cbf63ac1 100644
--- a/sound/soc/codecs/Makefile
+++ b/sound/soc/codecs/Makefile
@@ -706,6 +706,7 @@ obj-$(CONFIG_SND_SOC_TAS2770) += snd-soc-tas2770.o
 obj-$(CONFIG_SND_SOC_TFA9879)	+= snd-soc-tfa9879.o
 obj-$(CONFIG_SND_SOC_TFA989X)	+= snd-soc-tfa989x.o
 obj-$(CONFIG_SND_SOC_TLV320ADC3XXX)	+= snd-soc-tlv320adc3xxx.o
+obj-$(CONFIG_SND_SOC_TLV320AIC3101_AMAZON) += tlv320aic3101-amazon.o
 obj-$(CONFIG_SND_SOC_TLV320AIC23)	+= snd-soc-tlv320aic23.o
 obj-$(CONFIG_SND_SOC_TLV320AIC23_I2C)	+= snd-soc-tlv320aic23-i2c.o
 obj-$(CONFIG_SND_SOC_TLV320AIC23_SPI)	+= snd-soc-tlv320aic23-spi.o
