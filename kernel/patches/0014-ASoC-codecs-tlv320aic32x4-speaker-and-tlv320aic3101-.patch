+
+static int aic31xx_suspend(struct snd_soc_component *component)
+{
+	dev_dbg(component->dev, "%s: Entered\n", __func__);
+
+	aic31xx_set_bias_level(component, SND_SOC_BIAS_OFF);
+	dev_dbg(component->dev, "%s: Exiting\n", __func__);
+	return 0;
+}
+
+static int aic31xx_resume(struct snd_soc_component *component)
+{
+	dev_dbg(component->dev, "%s: Entered\n", __func__);
+
+	dev_dbg(component->dev, "%s: Exiting\n", __func__);
+
+	return 0;
+}
