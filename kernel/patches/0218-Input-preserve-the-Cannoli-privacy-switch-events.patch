+	 */
+	ret = devm_add_action_or_reset(dev, gpio_privacy_cancel_work, p);
 	if (ret)
 		return ret;
-
-	for (i = 0; i < p->state->ndescs; i++) {
-		irq = gpiod_to_irq(p->state->desc[i]);
-		if (irq < 0)
-			return dev_err_probe(dev, irq, "state line %d has no IRQ\n", i);
-		ret = devm_request_irq(dev, irq, gpio_privacy_irq,
-				       IRQF_TRIGGER_RISING | IRQF_TRIGGER_FALLING,
-				       "gpio-privacy", p);
+	if (p->child_events) {
+		ret = gpio_privacy_request_event_irq(p, &p->state_event,
+						     "gpio-privacy-state");
 		if (ret)
 			return ret;
+		ret = gpio_privacy_request_event_irq(p, &p->button_event,
+						     "gpio-privacy-button");
+	} else {
+		ret = gpio_privacy_request_legacy_irqs(p);
 	}
+	if (ret)
+		return ret;
+	if (p->child_events && gpio_privacy_read(p) == 1)
+		gpio_privacy_state_event(&p->state_event);
 
 	device_init_wakeup(dev, device_property_read_bool(dev, "wakeup-source"));
-
 	return 0;
 }
 
