diff --git a/arch/arm/boot/dts/mediatek/mt8519.dtsi b/arch/arm/boot/dts/mediatek/mt8519.dtsi
new file mode 100755
index 000000000..e8ea7545e
--- /dev/null
+++ b/arch/arm/boot/dts/mediatek/mt8519.dtsi
@@ -0,0 +1,1373 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Copyright (C) 2021 MediaTek Inc.
+ * Author: Joe Yang <joe.yang@mediatek.com>
+ */
+
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/memory/mt8519-memory-port.h>
+#include <dt-bindings/phy/phy.h>
+#include <dt-bindings/pinctrl/mt8519-pinfunc.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/clock/mt8519-clk.h>
+#include <dt-bindings/power/mt8519-power.h>
+#include <dt-bindings/interconnect/mtk,mt8519-emi.h>
+#include <dt-bindings/soc/mediatek,boot-mode.h>
+#include <dt-bindings/reset/ti-syscon.h>
+
+/ {
+	model = "MT8519";
+	compatible = "mediatek,mt8519";
+	interrupt-parent = <&gic>;
+	#address-cells = <2>;
+	#size-cells = <2>;
+
+	aliases {
+		i2c0 = &i2c0;
+		i2c1 = &i2c1;
+		i2c2 = &i2c2;
+		i2c3 = &i2c3;
+		i2c4 = &i2c4;
+		serial0 = &uart0;
+		serial1 = &uart1;
+		serial2 = &uart2;
+	};
+
+	/* ATF logger SW IRQ number 227 = 32 + 195 */
+	atf_logger {
+		compatible = "mediatek,atf_logger";
+		interrupts = <GIC_SPI 195 IRQ_TYPE_EDGE_RISING>;
+	};
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu0: cpu@0 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a55";
+			reg = <0x0>;
+			enable-method = "psci";
+			cpu-release-addr = <0x0 0x40000200>;
+			clock-frequency = <1700000000>;
+			cpu-idle-states = <&cpuoff &clusteroff &mcusysoff>;
+			performance-domains = <&performance 0>;
+			capacity-dmips-mhz = <1024>;
+			#cooling-cells = <2>;
+		};
+
+		cpu1: cpu@1 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a55";
+			reg = <0x0100>;
+			enable-method = "psci";
+			cpu-release-addr = <0x0 0x40000200>;
+			clock-frequency = <1700000000>;
+			cpu-idle-states = <&cpuoff &clusteroff &mcusysoff>;
+			performance-domains = <&performance 0>;
+			capacity-dmips-mhz = <1024>;
+		};
+
+		cpu2: cpu@2 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a55";
+			reg = <0x0200>;
+			enable-method = "psci";
+			cpu-release-addr = <0x0 0x40000200>;
+			clock-frequency = <1700000000>;
+			cpu-idle-states = <&cpuoff &clusteroff &mcusysoff>;
+			performance-domains = <&performance 0>;
+			capacity-dmips-mhz = <1024>;
+		};
+
+		cpu3: cpu@3 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a55";
+			reg = <0x0300>;
+			enable-method = "psci";
+			cpu-release-addr = <0x0 0x40000200>;
+			clock-frequency = <1700000000>;
+			cpu-idle-states = <&cpuoff &clusteroff &mcusysoff>;
+			performance-domains = <&performance 0>;
+			capacity-dmips-mhz = <1024>;
+		};
+
+		cpu-map {
+			cluster0 {
+				core0 {
+					cpu = <&cpu0>;
+				};
+				core1 {
+					cpu = <&cpu1>;
+				};
+				core2 {
+					cpu = <&cpu2>;
+				};
+				core3 {
+					cpu = <&cpu3>;
+				};
+			};
+		};
+
+		idle-states {
+			entry-method = "psci";
+
+			cpuoff: cpuoff {
+				compatible = "arm,idle-state";
+				local-timer-stop;
+				arm,psci-suspend-param = <0x00010001>;
+				entry-latency-us = <100>;
+				exit-latency-us = <250>;
+				min-residency-us = <1600>;
+			};
+
+			clusteroff: clusteroff {
+				compatible = "arm,idle-state";
+				local-timer-stop;
+				arm,psci-suspend-param = <0x01010001>;
+				entry-latency-us = <100>;
+				exit-latency-us = <350>;
+				min-residency-us = <2100>;
+			};
+
+			mcusysoff: mcusysoff {
+				compatible = "arm,idle-state";
+				local-timer-stop;
+				arm,psci-suspend-param = <0x01010002>;
+				entry-latency-us = <300>;
+				exit-latency-us = <1200>;
+				min-residency-us = <2600>;
+			};
+		};
+	};
+
+	clocks {
+		clk_null: clk_null {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <0>;
+		};
+
+		clk26m: clk26m {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <26000000>;
+		};
+
+		clk13m: clk13m {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <13000000>;
+		};
+
+		clk32k: clk32k {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <32768>;
+		};
+	};
+
+	extcon_usb: extcon_iddig {
+		compatible = "linux,extcon-usb-gpio";
+		status = "disabled";
+	};
+
+	firmware: firmware {
+		optee {
+			compatible = "linaro,optee-tz";
+			method = "smc";
+			clocks = <&topckgen CLK_TOP_ECC_SEL>,
+				 <&topckgen CLK_TOP_GCPU_SEL>,
+				 <&infracfg_ao CLK_INFRA_AO_GCPU_SET>;
+			clock-names = "ECC",
+				      "GCPU",
+				      "GCPU_B";
+		};
+	};
+
+	mtee {
+		compatible = "mediatek,mtee";
+		status = "disabled";
+	};
+
+	pmu {
+		compatible = "arm,armv8-pmuv3",
+			     "arm,cortex-a7-pmu";
+		interrupt-parent = <&gic>;
+		interrupts = <GIC_PPI 7 IRQ_TYPE_LEVEL_HIGH>;
+	};
+
+	pmu-dsu-0 {
+		compatible = "arm,dsu-pmu";
+		interrupts = <GIC_SPI 18 IRQ_TYPE_LEVEL_HIGH>;
+		cpus = <&cpu0>, <&cpu1>, <&cpu2>, <&cpu3>;
+	};
+
+	psci {
+		compatible = "arm,psci-1.0";
+		method = "smc";
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		atf-logbuf-memory@42fc0000 {
+			compatible = "mediatek,mt8512-atf-logbuf-memory";
+			no-map;
+			reg = <0 0x42fc0000 0 0x40000>;
+		};
+
+		atf-reserved-memory@43000000 {
+			compatible = "mediatek,mt8512-atf-reserved-memory";
+			no-map;
+			reg = <0 0x43000000 0 0x30000>;
+		};
+
+		optee-reserved-memory@43040000 {
+			compatible = "mediatek,mt8519-optee-reserved-memory";
+			no-map;
+			reg = <0 0x43040000 0 0x00300000>;
+		};
+
+		mboot_params_reserved_memory {
+			compatible = "mediatek,mt8519-mboot_params_reserved-memory";
+			no-map;
+			reg = <0 0x44400000 0 0x10000>;
+		};
+
+		ramoops@0x44410000 {
+			compatible = "ramoops";
+			no-map;
+			reg = <0 0x44410000 0 0xe0000>;
+			console-size = <0x40000>;
+			pmsg-size = <0x10000>;
+			record-size = <0x1000>;
+			ftrace-size = <0x1000>;
+		};
+
+		minidump_reserved_memory {
+			compatible = "mediatek,mt8519-minidump_reserved-memory";
+			no-map;
+			reg = <0 0x444f0000 0 0x10000>;
+		};
+
+		tinysys_mem_reserved: tinysys_mem_region {
+			compatible = "mediatek,tinysys-reserved-memory";
+			no-map;
+			reg = <0 0x48000000 0 0x0E0000>;
+		};
