+
+&spi {
+	pinctrl-names = "default";
+	pinctrl-0 = <&spim_pins>;
+	status = "disabled";
+
+	spidev: spi@0 {
+		compatible = "mediatek,spi-mt65xx-test";
+		reg = <0>;
+		spi-max-frequency = <10000000>;
+	};
+};
+
+&spis {
+	pinctrl-names = "default";
+	pinctrl-0 = <&spis_pins>;
+	status = "disabled";
+
+	slave: spis@0 {
+		compatible = "spi-slave-mt27xx-test";
+		reg = <0>;
+	};
+};
+
+&ssusb {
+	/*vusb33-supply = <&mt6395_vio33>;*/
+	dr_mode = "otg"; /* 1: host, 2: device, 3 dual-mode */
+	extcon = <&extcon_usb>;
+	vbus-supply = <&usb_p1_vbus>;
+	maximum-speed = "high-speed";
+	mediatek,force-vbus;
+	phys = <&u2port0 PHY_TYPE_USB2>,
+			<&u2port1 PHY_TYPE_USB2>;
+	/*enable-manual-drd;*/
+	status = "okay";
+};
+
+&usb_host0 {
+	vbus-supply = <&usb_p1_vbus>;
+};
+
+&u3phy0 {
+	status = "okay";
+};
+
+&uart2 {
+	status = "okay";
+};
+
+#include "mt6395.dtsi"
