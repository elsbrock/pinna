diff --git a/arch/arm/boot/dts/mediatek/cannoli-cheesecake.dtsi b/arch/arm/boot/dts/mediatek/cannoli-cheesecake.dtsi
new file mode 100644
index 000000000..c633d00d4
--- /dev/null
+++ b/arch/arm/boot/dts/mediatek/cannoli-cheesecake.dtsi
@@ -0,0 +1,1192 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+
+#include "mt8519-amzn.dtsi"
+#include <dt-bindings/gpio/amzncpld-gpio.h>
+#include <dt-bindings/input/linux-event-codes.h>
+
+/ {
+	aliases {
+		ringled0 = &lp5036_i2c0_31;
+		display0 = &disp_lp5036_i2c0_30;
+		display1 = &disp_lp5036_i2c0_32;
+		display2 = &disp_lp5036_i2c0_33;
+	};
+
+	chosen {
+		bootargs = "";
+		atag,chipid = <0x6000000 0x19850000 0x8a0000 0xca0000 0x0>;
+	};
+
+	led_power: fixedregulator@6 {
+		compatible = "regulator-fixed";
+		regulator-name = "led_power";
+		gpio = <&pio 64 GPIO_ACTIVE_HIGH>;
+		startup-delay-us = <10000>;
+		enable-active-high;
+		regulator-boot-on;
+		pinctrl-names = "default";
+		pinctrl-0 = <&led_power_pins>;
+		status = "okay";
+	};
+
+	reset_adc: fixedregulator@7 {
+		compatible = "regulator-fixed";
+		regulator-name = "reset_adc";
+		gpio = <&cpld AMZ_CPLD_GPIO_ADC_RST GPIO_ACTIVE_HIGH>;
+		startup-delay-us = <10000>;
+		enable-active-high;
+		status = "okay";
+	};
+
+	disp_power: fixedregulator@8 {
+		compatible = "regulator-fixed";
+		regulator-name = "disp_power";
+		gpio = <&pio 17 GPIO_ACTIVE_HIGH>;
+		startup-delay-us = <10000>;
+		enable-active-high;
+		regulator-boot-on;
+		pinctrl-names = "default";
+		pinctrl-0 = <&disp_power_pins>;
+		status = "okay";
+	};
+
+	therm_sel: fixedregulator@9 {
+		compatible = "regulator-fixed";
+		regulator-name = "therm_sel";
+		gpio = <&pio 62 GPIO_ACTIVE_HIGH>;
+		startup-delay-us = <0>;
+		enable-active-high;
+		regulator-boot-on;
+		status = "okay";
+	};
+
+	sound: sound {
+		compatible = "mediatek,mt8519-mendocino";
+		mediatek,platform = <&afe>;
+		mediatek,adsp-platform = <&adsp_pcm>;
+
+		/* Spkr Out - over etdm2 */
+		mediatek,etdm2-out-audio-codec = <&max98396_1_dac>;
+		mediatek,etdm2-out-audio-codec-name = "max98396_1-dac";
+		mediatek,etdm2-out-codec-dai-name = "max98396-aif1-a";
+
+		/* etdmout2 fix format */
+		mediatek,etdm2-out-fix-rate = <96000>;
+		mediatek,etdm2-out-fix-channels = <2>;
+		mediatek,etdm2-out-fix-bit-width = <32>;
+
+		/* Mic In - ADC5140 */
+		mediatek,etdm1-in-audio-codec = <&tlv320adc5140_1>;
+		mediatek,etdm1-in-audio-codec-name = "tlv320adc5140_1";
+		mediatek,etdm1-in-codec-dai-name = "tlv320adc5140-codec-a";
+		mediatek,etdm1-in-format = "dsp_b";
+		mediatek,etdm1-in-bck-inverse=<1>;
+		mediatek,etdm1-in-mclk-multiplier=<256>;
+		mediatek,etdm1-in-master-clock=<0>;
+
+		/* etdmin1 fix format */
+		mediatek,etdm1-in-fix-channels=<4>;
+		mediatek,etdm1-in-fix-rate = <96000>;
+		mediatek,etdm1-in-fix-bit-width = <32>;
+
+		/* etdmin2 fix format */
+		mediatek,etdm2-in-fix-rate = <96000>;
+		mediatek,etdm2-in-fix-channels = <2>;
+		mediatek,etdm2-in-fix-bit-width = <32>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&aud_pins_default>;
+		status = "okay";
+
+		woofer_irq-gpios = <&pio 7 1>;
+		/* debounce time in microseconds */
+		woofer-irq-debounce = <512000>;
+	};
+
+	therm0: thermistor_0 {
+		compatible = "murata,ncp03wf104";
+		#thermal-sensor-cells = <0>;
+		pullup-uv = <1800000>;
+		pullup-ohm = <100000>;
+		pulldown-ohm = <0>;
+		io-channels = <&auxadc 0>;
+		mux-supply = <&therm_sel>;
+		read-state = <0>;
+		settle-time-ms = <5>;
+	};
+
+	therm1: thermistor_1 {
+		compatible = "murata,ncp03wf104";
+		#thermal-sensor-cells = <0>;
+		pullup-uv = <1800000>;
+		pullup-ohm = <100000>;
+		pulldown-ohm = <0>;
+		io-channels = <&auxadc 0>;
+		mux-supply = <&therm_sel>;
+		read-state = <1>;
+		settle-time-ms = <5>;
+	};
+
+	therm2: thermistor_2 {
+		compatible = "murata,ncp03wf104";
+		#thermal-sensor-cells = <0>;
+		pullup-uv = <1800000>;
+		pullup-ohm = <100000>;
+		pulldown-ohm = <0>;
+		io-channels = <&auxadc 1>;
+		mux-supply = <&therm_sel>;
+		read-state = <1>;
+		settle-time-ms = <5>;
+	};
+
+	therm3: thermistor_3 {
+		compatible = "murata,ncp03wf104";
+		#thermal-sensor-cells = <0>;
+		pullup-uv = <1800000>;
+		pullup-ohm = <100000>;
+		pulldown-ohm = <0>;
+		io-channels = <&auxadc 2>;
+	};
+
+	therm4: thermistor_4 {
+		compatible = "murata,ncp03wf104";
+		#thermal-sensor-cells = <0>;
+		pullup-uv = <1800000>;
+		pullup-ohm = <100000>;
+		pulldown-ohm = <0>;
+		io-channels = <&auxadc 3>;
+	};
+
+	wifi_temp_sensor: wifi_temp_sensor {
+		compatible = "amazon,wifi_temp_sensor";
+		#thermal-sensor-cells = <0>;
+	};
+
+	/* bottom */
+	case_virtual_sensor: case-virtual-sensor {
+		compatible = "amazon,virtual_sensor";
+		#thermal-sensor-cells = <0>;
+
+		zone-list {
+			zone-names = "ap_ntc0", "ap_ntc1", "ap_ntc2", "ap_ntc3", "ap_ntc4", "wifi_temp", "soc_max";
+			ap_ntc0 = <1 37000 976 802 (-40000) 125000>;
+			ap_ntc1 = <1 83300 680 (-262) (-40000) 125000>;
+			ap_ntc2 = <0 0 0 0 (-40000) 125000>;
+			ap_ntc3 = <1 89300 2 (-389) (-40000) 125000>;
+			ap_ntc4 = <1 28100 547 666 (-40000) 125000>;
+			wifi_temp = <0 0 0 0 0 0>;
+			soc_max = <1 63200 0 138 0 0>;
+		};
+	};
+
+	/* top */
+	skin_virtual_sensor: skin-virtual-sensor {
+		compatible = "amazon,virtual_sensor";
+		#thermal-sensor-cells = <0>;
+
+		zone-list {
+			zone-names = "ap_ntc0", "ap_ntc1", "ap_ntc2", "ap_ntc3", "ap_ntc4", "wifi_temp", "soc_max";
+			ap_ntc0 = <1 31200 1000 981 (-40000) 125000>;
+			ap_ntc1 = <1 86300 24 (-279) (-40000) 125000>;
+			ap_ntc2 = <0 0 0 0 (-40000) 125000>;
+			ap_ntc3 = <1 90600 3 (-339) (-40000) 125000>;
+			ap_ntc4 = <1 36000 895 469 (-40000) 125000>;
+			wifi_temp = <0 0 0 0 0 0>;
+			soc_max = <1 76200 279 115 0 0>;
+		};
+	};
+
+	back_virtual_sensor: back-virtual-sensor {
+		compatible = "amazon,virtual_sensor";
+		#thermal-sensor-cells = <0>;
+
+		zone-list {
+			zone-names = "ap_ntc0", "ap_ntc1", "ap_ntc2", "ap_ntc3", "ap_ntc4", "wifi_temp", "soc_max";
+			ap_ntc0 = <1 (-15800) 549 568 (-40000) 125000>;
+			ap_ntc1 = <1 79100 869 100 (-40000) 125000>;
+			ap_ntc2 = <0 0 0 0 (-40000) 125000>;
+			ap_ntc3 = <1 75000 873 100 (-40000) 125000>;
+			ap_ntc4 = <1 19500 970 200 (-40000) 125000>;
+			wifi_temp = <0 0 0 0 0 0>;
+			soc_max = <1 96500 233 50 0 0>;
+		};
+	};
+
+	display_virtual_sensor: display-virtual-sensor {
+		compatible = "amazon,virtual_sensor";
+		#thermal-sensor-cells = <0>;
+
+		zone-list {
+			zone-names = "ap_ntc0", "ap_ntc1", "ap_ntc2", "ap_ntc3", "ap_ntc4", "wifi_temp", "soc_max";
+			ap_ntc0 = <1 9400 921 1 (-40000) 125000>;
+			ap_ntc1 = <1 9400 921 1 (-40000) 125000>;
+			ap_ntc2 = <1 9400 921 940 (-40000) 125000>;
+			ap_ntc3 = <1 9400 921 1 (-40000) 125000>;
+			ap_ntc4 = <1 9400 921 1 (-40000) 125000>;
+			wifi_temp = <0 0 0 0 0 0>;
+			soc_max = <0 0 0 0 0 0>;
+		};
+	};
+
+	cpu_virtual_sensor: cpu-virtual-sensor {
+		compatible = "amazon,virtual_sensor";
+		#thermal-sensor-cells = <0>;
+
+		zone-list {
+			zone-names = "ap_ntc0", "ap_ntc1", "ap_ntc2", "ap_ntc3", "ap_ntc4", "wifi_temp", "soc_max";
+			ap_ntc0 = <0 0 0 0 (-40000) 125000>;
+			ap_ntc1 = <0 0 0 0 (-40000) 125000>;
+			ap_ntc2 = <0 0 0 0 (-40000) 125000>;
+			ap_ntc3 = <0 0 0 0 (-40000) 125000>;
+			ap_ntc4 = <0 0 0 0 (-40000) 125000>;
+			wifi_temp = <0 0 0 0 0 0>;
+			soc_max = <0 0 1000 1000 0 0>;
+		};
+	};
+
+	cpufilter_virtual_sensor: cpufilter-virtual-sensor {
+		compatible = "amazon,virtual_sensor";
+		#thermal-sensor-cells = <0>;
+		moving-average-prop = <1000 5 100 0>;
+
+		zone-list {
+			zone-names = "ap_ntc0", "ap_ntc1", "ap_ntc2", "ap_ntc3", "ap_ntc4", "wifi_temp", "soc_max";
+			ap_ntc0 = <0 0 0 0 (-40000) 125000>;
+			ap_ntc1 = <0 0 0 0 (-40000) 125000>;
+			ap_ntc2 = <0 0 0 0 (-40000) 125000>;
+			ap_ntc3 = <0 0 0 0 (-40000) 125000>;
+			ap_ntc4 = <0 0 0 0 (-40000) 125000>;
+			wifi_temp = <0 0 0 0 0 0>;
+			soc_max = <0 0 1000 1000 0 0>;
+		};
+	};
+
+	wifi_cooler: wifi {
+		compatible = "amazon,thermal_cooler";
+		#cooling-cells = <2>;
+		max_state = <8>;
+	};
+
+	audio_cooler: audio_cooler {
+		compatible = "amazon,thermal_cooler";
+		#cooling-cells = <2>;
+		max_level = <3>;
+		max_state = <8>;
+	};
+
+	led_cooler: led_cooler {
+		compatible = "amazon,thermal_cooler";
+		#cooling-cells = <2>;
+		max_state = <3>;
+	};
+
+	display_cooler: display_cooler {
+		compatible = "amazon,thermal_cooler";
+		#cooling-cells = <2>;
+		max_state = <3>;
+	};
+
+	usb_p1_vbus: usb_vbus1@0 {
+		compatible = "regulator-fixed";
+		regulator-name = "usb1_vbus";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		gpio = <&pio 20 0>;
+		enable-active-high;
+	};
+
+	gpio_keys: gpio-keys {
+		compatible = "gpio-keys";
+		autorepeat;
+		status = "okay";
+
+		volumeup_button: button@0 {
+			debounce-interval = <50>;
+			label = "volumeup";
+			linux,input-type = <0x1>;
+			linux,code = <115>;
+			gpios = <&cpld AMZ_CPLD_GPIO_BTN_VOL_UP_L GPIO_ACTIVE_LOW>;
+			swdebounce-interval = <100>;
+			dyndebounce-interval = <0>;
+			dyndebounce-duration = <10000>;		/* 10 sec */
+		};
+
+		volumedown_button: button@1 {
+			debounce-interval = <50>;
+			label = "volumedown";
+			linux,input-type = <0x1>;
+			linux,code = <114>;
+			gpios = <&cpld AMZ_CPLD_GPIO_BTN_VOL_DN_L GPIO_ACTIVE_LOW>;
+			swdebounce-interval = <100>;
+			dyndebounce-interval = <0>;
+			dyndebounce-duration = <10000>;		/* 10 sec */
+		};
+
+		action_button: button@2 {
+			debounce-interval = <50>;
+			label = "action";
+			linux,input-type = <0x1>;
+			linux,code = <138>;
+			gpios = <&cpld AMZ_CPLD_GPIO_BTN_ACT_L GPIO_ACTIVE_LOW>;
+			swdebounce-interval = <100>;
+			dyndebounce-interval = <0>;
+			dyndebounce-duration = <10000>;		/* 10 sec */
+		};
+	};
+
+	gpio_privacy: gpio-privacy {
+		compatible = "gpio-privacy";
+		status="okay";
+
+		enable-gpio = <&cpld AMZ_CPLD_GPIO_SW_MUTE_SET GPIO_ACTIVE_HIGH>;
+		enable-gpio-toggle-duration = <50>;
+
+		state_event {
+			label = "mute state";
+			linux,input-type = <EV_SW>;
+			linux,code = <0x0e>;
+
+			gpios = <&cpld AMZ_CPLD_GPIO_MUTE_STATE_L GPIO_ACTIVE_LOW>;
+
+		};
+
+		button_event {
+			label = "mute";
+			linux,input-type = <EV_KEY>;
+			linux,code = <KEY_MUTE>;
+			debounce-interval = <50>;
+
+			gpios = <&cpld AMZ_CPLD_GPIO_BTN_MUTE_L GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	led_sku_bias: led-sku-bias {
+		compatible = "led-sku-bias";
+		pinctrl-names = "default", "sku_bias_enabled", "sku_bias_disabled";
+		pinctrl-0 = <&led_sku_bias_disabled>;
+		pinctrl-1 = <&led_sku_bias_enabled>;
+		pinctrl-2 = <&led_sku_bias_disabled>;
+		status="okay";
+	};
+};
+
+&adsp {
+	status = "okay";
+};
+
+&adsp_pcm {
+	mediatek,tdmin-mem-type = <2>;
+	mediatek,ul9-mem-type = <2>;
+	mediatek,ul2-mem-type = <2>;
+	mediatek,dl2-mem-type = <2>;
+	mediatek,dsp-boot-run = <0>;
+	status = "okay";
+};
+
+&adsp_mem_reserved {
+	reg = <0 0x50000000 0 0xf00000>;
+};
+
+#include "cannoli_cheesecake_thermal_zones.dtsi"
+
+&afe {
+	mediatek,etdm-out-data-modes = <0 1>;
+	mediatek,etdm2-out-force-on;
+	mediatek,etdm2-out-force-format = "i2s";
+	mediatek,etdm2-out-force-rate = <96000>;
+	mediatek,etdm2-out-force-channels = <2>;
+	mediatek,etdm2-out-force-bit-width = <32>;
+	mediatek,etdm1-in-force-on;
+	mediatek,etdm1-in-force-mclk-freq = <24576000>;
+	mediatek,etdm1-in-force-format = "dsp_b";
+	mediatek,etdm1-in-force-bck-inverse;
+	mediatek,etdm1-in-force-rate = <96000>;
+	mediatek,etdm1-in-force-channels = <4>;
+	mediatek,etdm1-in-force-bit-width = <32>;
+	mediatek,etdm1-in-force-master-clock = <0>;
+	mediatek,gasrc0-fix-rate = <0 96000>;
+	mediatek,gasrc1-fix-rate = <0 96000>;
+	mediatek,gasrc2-fix-rate = <0 96000>;
+	mediatek,gasrc3-fix-rate = <0 96000>;
+	status = "okay";
+};
+
+&audio_asrc {
+	status = "disabled";
+};
+
+&auxadc {
+	expected-divider-voltage-raw = <900>;
+	ref-voltage-adc-channel = <1>;
+	has-error-correction;
+	status = "okay";
+};
+
+&dramc {
+	dram_type = <2>;
+	support_ch_cnt = <2>;
+	ch_cnt = <2>;
+	rk_cnt = <1>; /* dummy */
+	mr_cnt = <4>;
+	freq_cnt = <2>;
+	rk_size = <0x40000000>;  /* dummy */
+	mr = <0 0 0 0 0 0 0 0>;  /* dummy */
+	freq_step = <3200 2400>;
+};
+
+&extcon_usb {
+	id-gpios = <&pio 16 GPIO_ACTIVE_HIGH>;
+	vbus-gpios = <&pio 19 0>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&usbextcon_pins_default>;
+	wakeup-source;
+	status = "okay";
+};
+
+&hifidsp_audio_ipi {
+	status = "okay";
+};
+
+&i2c0 {
+	lp5036_i2c0_31: lp5036@31 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	compatible = "ti,lp5036";
+	reg = <0x31>;
+	vled-supply = <&led_power>;
+	regmap-read-cache-disable;
+	status = "disabled";
+		led@0 {
+			reg = <0>;
+			label = "ledmod_0";
+			ti,led-module = <3>;
+			rgb-map = /bits/ 8 <1 0 2>;
+			linux,default-trigger = "boot-anim";
+		};
+		led@1 {
+			reg = <1>;
+			label = "ledmod_1";
+			ti,led-module = <4>;
+			rgb-map = /bits/ 8 <1 0 2>;
+			linux,default-trigger = "boot-anim";
+		};
+		led@2 {
+			reg = <2>;
+			label = "ledmod_2";
+			ti,led-module = <5>;
+			rgb-map = /bits/ 8 <1 0 2>;
+			linux,default-trigger = "boot-anim";
+		};
+		led@3 {
+			reg = <3>;
+			label = "ledmod_3";
+			ti,led-module = <6>;
+			rgb-map = /bits/ 8 <1 0 2>;
+			linux,default-trigger = "boot-anim";
