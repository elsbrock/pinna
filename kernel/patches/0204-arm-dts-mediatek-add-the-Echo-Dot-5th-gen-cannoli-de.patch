+
+#include <dt-bindings/thermal/thermal.h>
+
+/ {
+
+	thermal_zones: thermal-zones {
+		soc_max {
+			polling-delay = <500>; /* milliseconds */
+			polling-delay-passive = <200>; /* milliseconds */
+			thermal-sensors = <&thermal 255>;
+			sustainable-power = <1500>;
+		};
+
+		cpu_little0 {
+			polling-delay = <1000>; /* milliseconds */
+			polling-delay-passive = <1000>; /* milliseconds */
+			thermal-sensors = <&thermal 0>;
+		};
+
+		ADSP {
+			polling-delay = <1000>; /* milliseconds */
+			polling-delay-passive = <1000>; /* milliseconds */
+			thermal-sensors = <&thermal 1>;
+		};
+
+		IPNNA {
+			polling-delay = <1000>; /* milliseconds */
+			polling-delay-passive = <1000>; /* milliseconds */
+			thermal-sensors = <&thermal 2>;
+		};
+
+		cpu_little1 {
+			polling-delay = <1000>; /* milliseconds */
+			polling-delay-passive = <1000>; /* milliseconds */
+			thermal-sensors = <&thermal 3>;
+		};
+
+		cpu_little2 {
+			polling-delay = <1000>; /* milliseconds */
+			polling-delay-passive = <1000>; /* milliseconds */
+			thermal-sensors = <&thermal 4>;
+		};
+
+		cpu_little3 {
+			polling-delay = <1000>; /* milliseconds */
+			polling-delay-passive = <1000>; /* milliseconds */
+			thermal-sensors = <&thermal 5>;
+		};
+
+		skin_virtual {
+			polling-delay = <15000>;
+			polling-delay-passive = <15000>;
+			policy = "step_wise";
+			thermal-sensors = <&skin_virtual_sensor>;
+
+			trips {
+				svt_trip_critical1: trip-point@0 {
+					temperature = <60000>;
+					hysteresis = <500>;
+					type = "critical";
+				};
+			};
+		};
+
+		case_virtual {
+			polling-delay = <15000>;
+			polling-delay-passive = <15000>;
+			policy = "step_wise";
+			thermal-sensors = <&case_virtual_sensor>;
+
+			trips {
+				cvt_trip_critical1: trip-point@0 {
+					temperature = <60000>;
+					hysteresis = <500>;
+					type = "critical";
+				};
+			};
+		};
+
+		back_virtual: back_virtual {
+			polling-delay = <15000>;
+			polling-delay-passive = <15000>;
+			policy = "step_wise";
+			thermal-sensors = <&back_virtual_sensor>;
+
+			trips {
+				bvt_trip_critical1: trip-point@0 {
+					temperature = <60000>;
+					hysteresis = <500>;
+					type = "critical";
+				};
+			};
+		};
+
+		display_virtual: display_virtual {
+			polling-delay = <15000>;
+			polling-delay-passive = <15000>;
+			policy = "step_wise";
+			thermal-sensors = <&display_virtual_sensor>;
+
+			trips {
+				btvt_trip_critical1: trip-point@0 {
+					temperature = <60000>;
+					hysteresis = <500>;
+					type = "critical";
+				};
+			};
+		};
+
+		cpu_virtual: cpu_virtual {
+			polling-delay = <15000>;
+			polling-delay-passive = <15000>;
+			policy = "step_wise";
+			thermal-sensors = <&cpu_virtual_sensor>;
+
+			trips {
+				cpuvt_trip_critical1: trip-point@0 {
+					temperature = <97000>;
+					hysteresis = <500>;
+					type = "critical";
+				};
+			};
+		};
+
+		cpufilter_virtual: cpufilter_virtual {
+			polling-delay = <15000>;
+			polling-delay-passive = <15000>;
+			policy = "step_wise";
+			thermal-sensors = <&cpufilter_virtual_sensor>;
+		};
+
+		wifi_temp {
+			polling-delay = <0>;
+			polling-delay-passive = <0>;
+			policy = "step_wise";
+			thermal-sensors = <&wifi_temp_sensor>;
+		};
+
+		amp_temp {
+			polling-delay = <0>;
+			polling-delay-passive = <0>;
+			policy = "step_wise";
+			thermal-sensors = <&max98396_1_dac>;
+		};
+
+		ap_ntc0: ap_ntc0 {
+			polling-delay = <1000>; /* milliseconds */
+			polling-delay-passive = <1000>; /* milliseconds */
+			thermal-sensors = <&therm0>;
+		};
+
+		ap_ntc1: ap_ntc1 {
+			polling-delay = <1000>; /* milliseconds */
+			polling-delay-passive = <1000>; /* milliseconds */
+			thermal-sensors = <&therm1>;
+		};
+
+		ap_ntc2: ap_ntc2 {
+			polling-delay = <1000>; /* milliseconds */
+			polling-delay-passive = <1000>; /* milliseconds */
+			thermal-sensors = <&therm2>;
+		};
+
+		ap_ntc3: ap_ntc3 {
+			polling-delay = <1000>; /* milliseconds */
+			polling-delay-passive = <1000>; /* milliseconds */
+			thermal-sensors = <&therm3>;
+		};
+
+		ap_ntc4: ap_ntc4 {
+			polling-delay = <1000>; /* milliseconds */
+			polling-delay-passive = <1000>; /* milliseconds */
+			thermal-sensors = <&therm4>;
+		};
+	};
+};
diff --git a/arch/arm/boot/dts/mediatek/mt6395.dtsi b/arch/arm/boot/dts/mediatek/mt6395.dtsi
new file mode 100644
index 000000000..6188c321f
--- /dev/null
+++ b/arch/arm/boot/dts/mediatek/mt6395.dtsi
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Copyright (C) 2021 MediaTek Inc.
+ */
+
+&mt6395 {
+	mt6395_vproc: mt6395_buck1 {
+		regulator-compatible = "mt6395_buck1";
+		regulator-name = "VPROC";
+		regulator-min-microvolt = <600000>;
+		regulator-max-microvolt = <1393750>;
+		/*
+		 * There are 4 levels for mt6395_buck1
+		 * (1) 5000 uV/us
+		 * (2) 10000 uV/us
+		 * (3) 15000 uV/us
+		 * (4) 20000 uV/us
+		 */
+		regulator-ramp-delay = <20000>; /* uV/us */
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	mt6395_avdd2: mt6395_buck2 {
+		regulator-compatible = "mt6395_buck2";
+		regulator-name = "AVDD2";
+		regulator-min-microvolt = <1100000>;
+		regulator-max-microvolt = <1100000>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	mt6395_vio18: mt6395_buck3 {
+		regulator-compatible = "mt6395_buck3";
+		regulator-name = "VIO18";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	mt6395_vio33: mt6395_buck4 {
+		regulator-compatible = "mt6395_buck4";
+		regulator-name = "VIO33";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	mt6395_ldo1: mt6395_ldo1 {
+		regulator-compatible = "mt6395_ldo1";
+		regulator-name = "mt6395_ldo1";
+		regulator-min-microvolt = <1200000>;
+		regulator-max-microvolt = <1200000>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+};
diff --git a/arch/arm/boot/dts/mediatek/mt8519-amzn.dtsi b/arch/arm/boot/dts/mediatek/mt8519-amzn.dtsi
new file mode 100644
index 000000000..044913a11
--- /dev/null
+++ b/arch/arm/boot/dts/mediatek/mt8519-amzn.dtsi
@@ -0,0 +1,338 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+
+#include "mt8519.dtsi"
+
+/ {
+	aliases {
+		serial0 = &uart0;
+	};
+
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0 0x40000000 0 0x20000000>;
+	};
+
+	sdio_fixed_3v3: fixedregulator@0 {
+		compatible = "regulator-fixed";
+		regulator-name = "sdio_power";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		enable-active-high;
+	};
+
+	sdio_fixed_1v8_io: fixedregulator@1 {
+		compatible = "regulator-fixed";
+		regulator-name = "sdio_io";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		startup-delay-us = <200000>;
+		enable-active-high;
+		gpio = <&pio 68 0>;     /* WIFICHIP RST_WIFI0_L */
+	};
+
+	/* WoW */
+	mediatek,mt7663-wifi {
+		compatible = "mediatek,mt7663_wifi_ctrl";
+		interrupt-parent = <&pio>;
+		interrupts = <71 IRQ_TYPE_EDGE_FALLING>; /* WOW IRQ */
+		status = "okay";
+	};
+
+	/* WoBLE */
+	mediatek,mt76xx-bt {
+		compatible = "mediatek,mt76xx_bt_ctrl";
+		interrupt-parent = <&pio>;
+		interrupts = <70 IRQ_TYPE_EDGE_FALLING>; /* WOBLE IRQ */
+		status = "okay";
+	};
+};
+
+&i2c0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c0_pin>;
+	status = "okay";
+};
+
+&i2c1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c1_pin>;
+	status = "okay";
+	clock-frequency = <1000000>;
+
+	mt6395: mt6395@62 {
+		compatible = "mediatek,mt6395-regulator";
+		mt6395,irq-gpios = <&pio 49 0x0>;
+		reg = <0x62>;
+		status = "okay";
+		pinctrl-names = "default";
+		pinctrl-0 = <&pmic_pins_eint>;
+	};
+};
+
+&i2c2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c2_pin>;
+	status = "okay";
+};
+
+&i2c3 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c3_pin>;
+	status = "disabled";
+};
+
+&i2c4 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c4_pin>;
+	status = "disabled";
+};
+
+&nandc {
+	pinctrl-names = "default", "state_drive_high";
+	pinctrl-0 = <&nandc_pins_default>;
+	pinctrl-1 = <&nandc_pins_drive_high>;
+	status = "okay";
+};
+
+&mmc1 {
+	status = "okay";
+	pinctrl-names = "default", "state_uhs", "state_eint", "state_dat1";
+	pinctrl-0 = <&mmc1_pins_default>;
+	pinctrl-1 = <&mmc1_pins_uhs>;
+	pinctrl-2 = <&mmc1_pins_eint>;
+	pinctrl-3 = <&mmc1_pins_dat1>;
+	eint-gpios = <&pio 79 0>;
+	bus-width = <4>;
+	max-frequency = <200000000>;
+	cap-sd-highspeed;
+	cap-sdio-async-int;
+	sd-uhs-sdr104;
+	sd-uhs-sdr50;
+	sd-uhs-sdr25;
+	keep-power-in-suspend;
+	enable-sdio-wakeup;
+	cap-sdio-irq;
+	no-mmc;
+	no-sd;
+	non-removable;
+	vmmc-supply = <&sdio_fixed_3v3>;
+	vqmmc-supply = <&sdio_fixed_1v8_io>;
+};
+
+&auxadc {
+	status = "okay";
+};
+
+&pwm {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pwm_pins_default>;
+	invert = <1>;
+	status = "okay";
+};
+
+&pio {
+	pinctrl-names = "default";
+
+	dsp_uart_pin: dsp_uart_pin {
+		pins_rx {
+			pinmux = <PINMUX_GPIO14__FUNC_ADSP_URXD0>;
+			input-enable;
+			bias-pull-up;
+		};
+		pins_tx {
+			pinmux = <PINMUX_GPIO15__FUNC_ADSP_UTXD0>;
+		};
+	};
+
+	i2c0_pin: i2c0_pin {
+		pins_bus {
+			pinmux = <PINMUX_GPIO52__FUNC_SCL0>,
+				 <PINMUX_GPIO53__FUNC_SDA0>;
+			bias-pull-up = <MTK_PULL_SET_RSEL_111>;
+			mediatek,drive-strength-adv = <7>;
+		};
+	};
+
+	i2c1_pin: i2c1_pin {
+		pins_bus {
+			pinmux = <PINMUX_GPIO54__FUNC_SCL1>,
+				 <PINMUX_GPIO55__FUNC_SDA1>;
+			bias-pull-up = <MTK_PULL_SET_RSEL_111>;
+			mediatek,drive-strength-adv = <7>;
+		};
+	};
+
+	i2c2_pin: i2c2_pin {
+		pins_bus {
+			pinmux = <PINMUX_GPIO66__FUNC_SCL2>,
+				 <PINMUX_GPIO67__FUNC_SDA2>;
+			bias-pull-up = <MTK_PULL_SET_RSEL_111>;
+			mediatek,drive-strength-adv = <7>;
+		};
+	};
+
+	i2c3_pin: i2c3_pin {
+		pins_bus {
+			pinmux = <PINMUX_GPIO94__FUNC_SCL3>,
+				 <PINMUX_GPIO95__FUNC_SDA3>;
+			bias-pull-up = <MTK_PULL_SET_RSEL_111>;
+			mediatek,drive-strength-adv = <7>;
+		};
+	};
+
+	i2c4_pin: i2c4_pin {
+		pins_bus {
+			pinmux = <PINMUX_GPIO4__FUNC_SDA4>,
+				 <PINMUX_GPIO5__FUNC_SCL4>;
+			bias-pull-up = <MTK_PULL_SET_RSEL_111>;
+			mediatek,drive-strength-adv = <7>;
+		};
+	};
+
+	mmc1_pins_default: mmc1default {
+		pins_clk {
+			pinmux = <PINMUX_GPIO81__FUNC_MSDC1_CLK>;
+			drive-strength = <MTK_DRIVE_6mA>;
+			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
+		};
+
+		pins_cmd_dat {
+			pinmux = <PINMUX_GPIO80__FUNC_MSDC1_DAT0>,
+				<PINMUX_GPIO79__FUNC_MSDC1_DAT1>,
+				<PINMUX_GPIO78__FUNC_MSDC1_DAT2>,
+				<PINMUX_GPIO77__FUNC_MSDC1_DAT3>,
+				<PINMUX_GPIO82__FUNC_MSDC1_CMD>;
+			input-enable;
+			drive-strength = <MTK_DRIVE_6mA>;
+			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
+		};
+	};
+
+	mmc1_pins_uhs: mmc1 {
+		pins_clk {
+			pinmux = <PINMUX_GPIO81__FUNC_MSDC1_CLK>;
+			drive-strength = <MTK_DRIVE_6mA>;
+			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
+		};
+
+		pins_cmd_dat {
+			pinmux = <PINMUX_GPIO80__FUNC_MSDC1_DAT0>,
+				<PINMUX_GPIO79__FUNC_MSDC1_DAT1>,
+				<PINMUX_GPIO78__FUNC_MSDC1_DAT2>,
+				<PINMUX_GPIO77__FUNC_MSDC1_DAT3>,
+				<PINMUX_GPIO82__FUNC_MSDC1_CMD>;
+			input-enable;
+			drive-strength = <MTK_DRIVE_6mA>;
+			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
+		};
+	};
+
+	mmc1_pins_eint: dat1_eint {
+		pins_dat1 {
+			pinmux = <PINMUX_GPIO79__FUNC_GPIO79>;
+			input-enable;
+			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
+		};
+	};
+
+	mmc1_pins_dat1: sdio_dat1 {
+		pins_dat1 {
+			pinmux = <PINMUX_GPIO79__FUNC_MSDC1_DAT1>;
+			input-enable;
+			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
+		};
+	};
+
+	nandc_pins_default: nandcdefault {
+		pins_dat {
+			pinmux = <PINMUX_GPIO25__FUNC_SNFI_MISO>,
+				<PINMUX_GPIO26__FUNC_SNFI_WP>,
+				<PINMUX_GPIO27__FUNC_SNFI_HOLD>,
+				<PINMUX_GPIO22__FUNC_SNFI_MOSI>;
+			input-enable;
+		};
+
+		pins_cmd {
+			pinmux = <PINMUX_GPIO24__FUNC_SNFI_CS>,
+				<PINMUX_GPIO23__FUNC_SNFI_CLK>;
+			bias-pull-up;
+		};
+	};
+
+	nandc_pins_drive_high: nandchigh {
+		pins_dat {
+			pinmux = <PINMUX_GPIO25__FUNC_SNFI_MISO>,
+				<PINMUX_GPIO26__FUNC_SNFI_WP>,
+				<PINMUX_GPIO27__FUNC_SNFI_HOLD>,
+				<PINMUX_GPIO22__FUNC_SNFI_MOSI>;
+			drive-strength = <MTK_DRIVE_4mA>;
+			input-enable;
+		};
+
+		pins_cmd {
+			pinmux = <PINMUX_GPIO24__FUNC_SNFI_CS>,
+				<PINMUX_GPIO23__FUNC_SNFI_CLK>;
+			drive-strength = <MTK_DRIVE_4mA>;
+			bias-pull-up;
+		};
+	};
+
+	spim_pins: spim{
+		pins_spim{
+			pinmux = <PINMUX_GPIO8__FUNC_SPIM0_MO>,
+				 <PINMUX_GPIO9__FUNC_SPIM0_MI>,
+				 <PINMUX_GPIO10__FUNC_SPIM0_CSB>,
+				 <PINMUX_GPIO11__FUNC_SPIM0_CLK>;
+			bias-disable;
+		};
+	};
+
+	spis_pins: spis0 {
+		pins_spis {
+			pinmux = <PINMUX_GPIO83__FUNC_SPIS0_SI>,
+				<PINMUX_GPIO84__FUNC_SPIS0_SO>,
+				<PINMUX_GPIO85__FUNC_SPIS0_CSB>,
+				<PINMUX_GPIO86__FUNC_SPIS0_CLK>;
+			bias-disable;
+			input-enable;
+		};
+	};
+
+	pmic_pins_eint: pmic_pins_eint{
+		pmic_pins {
+			pinmux = <PINMUX_GPIO49__FUNC_GPIO49>;
+			bias-disable;
+		};
+	};
+
+	uart1_pin: uart1_pin {
+		uart1_pins {
+			pinmux = <PINMUX_GPIO14__FUNC_URXD2>,
+				 <PINMUX_GPIO15__FUNC_UTXD2>;
+		};
+	};
+
+	pwm_pins_default: pwmdefault {
+		pins_cmd_dat {
+			pinmux = <PINMUX_GPIO6__FUNC_PWM_2>;
+		};
+	};
+};
+
+&uart0 {
+	status = "okay";
+};
+
+&uart1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart1_pin>;
+	status = "disabled";
+};
+
+&uart2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&dsp_uart_pin>;
+	status = "disabled";
+};
+
+#include "mt6395.dtsi"
