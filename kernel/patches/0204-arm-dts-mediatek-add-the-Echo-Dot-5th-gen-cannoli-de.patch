+				 <&infracfg_ao CLK_INFRA_AO_MSDC1_SET>,
+				 <&infracfg_ao CLK_INFRA_AO_MSDC1_SRC_SET>;
+			clock-names = "source", "hclk", "source_cg";
+			status = "disabled";
+		};
+
+		u3phy0: usb-phy@11e00000 {
+			compatible = "mediatek,generic-tphy-v2";
+			#address-cells = <2>;
+			#size-cells = <2>;
+			ranges;
+			status = "disabled";
+
+			u2port0: usb-phy@11e00000 {
+				reg = <0 0x11e00000 0 0x700>;
+				clocks = <&topckgen CLK_TOP_RG_SSUSB_PHY_REF_CK_EN>;
+				clock-names = "ref";
+				#phy-cells = <1>;
+				status = "okay";
+			};
+
+			u2port1: usb-phy@11e10000 {
+				reg = <0 0x11e10000 0 0x700>;
+				clocks = <&topckgen CLK_TOP_SSUSB_U2_PHY_REF_CK_1P>;
+				clock-names = "ref";
+				#phy-cells = <1>;
+				status = "okay";
+			};
+
+		};
+
+		tinysys_ipc: tinysys-ipc {
+		        compatible = "amazon,mt8519-tinysys-ipc";
+			memory-region-rx = <&tinysys_ipc_rx_reserved>;
+			memory-region-tx = <&tinysys_ipc_tx_reserved>;
+		        status = "okay";
+		};
+	};
+
+	adsp_pcm: adsp_pcm {
+		compatible = "mediatek,mt8519-adsp-pcm";
+		status = "disabled";
+	};
+
+	hifidsp_audio_ipi: hifidsp_audio_ipi {
+		compatible = "mediatek,hifidsp-audio-ipi";
+		status = "disabled";
+	};
+
+	met {
+		met_emi: met_emi {
+			compatible = "mediatek,met_emi";
+			emi_num = <1>;
+			dram_num = <2>;
+			dramc_ver = <2>;
+			/* 0: dram ebg, 1:emi_freq, 2: DRAMC_DCM_CTRL 3:chn_emi_low_effi */
+			/* 4: SLC */
+			met_emi_support_list = <0x4>;
+			cen_emi_reg_base = <0x10219000>;
+			cen_emi_reg_size = <0x1000>;
+			chn_emi_reg_base = <0x1022D000 0x10235000>;
+			chn_emi_reg_size = <0x1000>;
+			dramc_nao_reg_base = <0x1022C000 0x10234000>;
+			dramc_nao_reg_size = <0x1000>;
+			dramc_ao_reg_base = <0x1022A000 0x10232000>;
+			dramc_ao_reg_size = <0x2000>;
+			ddrphy_ao_reg_base = <0x10228000 0x10230000>;
+			ddrphy_ao_reg_size = <0x2000>;
+			ddrphy_ao_misc_cg_ctrl0 = <0x284>;
+			ddrphy_ao_misc_cg_ctrl2 = <0x28c>;
+			dram_freq_default = <6400>;
+			ddr_ratio_default = <8>;
+			dram_type_default = <8>;
+			apmixedsys_reg_base = <0x1000C000>;
+			apmixedsys_reg_size = <0x410>;
+			slc_pmu_reg_base = <0x10342000 0x10343000>;
+			slc_pmu_reg_size = <0x1000>;
+		};
+	};
+
+	ice: ice_debug {
+		compatible = "mediatek,ice_debug";
+		clocks = <&infracfg_ao CLK_INFRA_AO_DEBUGSYS_SET>;
+		clock-names = "ice_dbg";
+	};
+
+	mtk_lpm: mtk_lpm {
+		compatible = "mediatek,mtk-lpm";
+		suspend-method = "enable";
+	};
+};
