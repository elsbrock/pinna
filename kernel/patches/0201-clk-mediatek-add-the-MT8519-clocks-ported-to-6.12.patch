+		0, 0, 22, 0x0394, 24, 0, 0, 0, 0x0394, 0, 0, 0, 0),
+};
+
+/*
+ * topckgen and infracfg_ao are the declarative kind 6.12 drives with
+ * mtk_clk_simple_probe; apmixedsys (the PLLs) keeps its own probe, as the
+ * MT8167 sibling does, because mtk_clk_desc carries no PLL table.
+ */
+static const struct mtk_clk_desc topck_desc = {
+	.clks = top_clks,
+	.num_clks = ARRAY_SIZE(top_clks),
+	.factor_clks = top_divs,
+	.num_factor_clks = ARRAY_SIZE(top_divs),
+	.mux_clks = top_mtk_muxes,
+	.num_mux_clks = ARRAY_SIZE(top_mtk_muxes),
+	.composite_clks = top_composites,
+	.num_composite_clks = ARRAY_SIZE(top_composites),
+	.clk_lock = &mt8519_clk_lock,
+};
+
+static const struct mtk_clk_desc infra_ao_desc = {
+	.clks = infra_ao_clks,
+	.num_clks = ARRAY_SIZE(infra_ao_clks),
+	.clk_lock = &mt8519_clk_lock,
+};
+
+static const struct of_device_id of_match_clk_mt8519[] = {
+	{ .compatible = "mediatek,mt8519-topckgen", .data = &topck_desc },
+	{ .compatible = "mediatek,mt8519-infracfg_ao", .data = &infra_ao_desc },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, of_match_clk_mt8519);
+
+static struct platform_driver clk_mt8519_drv = {
+	.probe = mtk_clk_simple_probe,
+	.remove = mtk_clk_simple_remove,
+	.driver = {
+		.name = "clk-mt8519",
+		.of_match_table = of_match_clk_mt8519,
+	},
+};
+
+static int clk_mt8519_apmixed_probe(struct platform_device *pdev)
+{
+	struct clk_hw_onecell_data *clk_data;
+	struct device_node *node = pdev->dev.of_node;
+	struct device *dev = &pdev->dev;
+	int r;
+
+	clk_data = mtk_devm_alloc_clk_data(dev, CLK_APMIXED_NR_CLK);
+	if (!clk_data)
+		return -ENOMEM;
+
+	r = mtk_clk_register_plls(node, plls, ARRAY_SIZE(plls), clk_data);
+	if (r)
+		return r;
+
+	r = of_clk_add_hw_provider(node, of_clk_hw_onecell_get, clk_data);
+	if (r)
+		goto unregister_plls;
+
+	return 0;
+
+unregister_plls:
+	mtk_clk_unregister_plls(plls, ARRAY_SIZE(plls), clk_data);
+	return r;
+}
+
+static const struct of_device_id of_match_clk_mt8519_apmixed[] = {
+	{ .compatible = "mediatek,mt8519-apmixedsys" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, of_match_clk_mt8519_apmixed);
+
+static struct platform_driver clk_mt8519_apmixed_drv = {
+	.probe = clk_mt8519_apmixed_probe,
+	.driver = {
+		.name = "clk-mt8519-apmixed",
+		.of_match_table = of_match_clk_mt8519_apmixed,
+	},
+};
+
+static struct platform_driver * const clk_mt8519_drivers[] = {
+	&clk_mt8519_drv,
+	&clk_mt8519_apmixed_drv,
+};
+
+static int __init clk_mt8519_init(void)
+{
+	return platform_register_drivers(clk_mt8519_drivers,
+					 ARRAY_SIZE(clk_mt8519_drivers));
+}
+
+static void __exit clk_mt8519_exit(void)
+{
+	platform_unregister_drivers(clk_mt8519_drivers,
+				    ARRAY_SIZE(clk_mt8519_drivers));
+}
+
+arch_initcall(clk_mt8519_init);
+module_exit(clk_mt8519_exit);
+MODULE_DESCRIPTION("MediaTek MT8519 clocks driver");
+MODULE_LICENSE("GPL");
