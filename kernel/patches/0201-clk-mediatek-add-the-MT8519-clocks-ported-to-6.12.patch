diff --git a/drivers/clk/mediatek/clk-mt8519-imp_iic_wrap_ao.c b/drivers/clk/mediatek/clk-mt8519-imp_iic_wrap_ao.c
new file mode 100644
index 000000000..5c77417fa
--- /dev/null
+++ b/drivers/clk/mediatek/clk-mt8519-imp_iic_wrap_ao.c
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: GPL-2.0-only
+//
+// Copyright (c) 2021 MediaTek Inc.
+// Author:Wentao He <wentao.he@mediatek.com>
+
+#include <linux/clk-provider.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+
+#include "clk-mtk.h"
+#include "clk-gate.h"
+
+#include <dt-bindings/clock/mt8519-clk.h>
+
+static const struct mtk_gate_regs imp_iic_wrap_ao_cg_regs = {
+	.set_ofs = 0xe00,
+	.clr_ofs = 0xe00,
+	.sta_ofs = 0xe00,
+};
+
+#define GATE_imp_iic_wrap_ao(_id, _name, _parent, _shift)			\
+	GATE_MTK(_id, _name, _parent, &imp_iic_wrap_ao_cg_regs, _shift, &mtk_clk_gate_ops_no_setclr)
+
+#define GATE_imp_iic_wrap_ao_flags(_id, _name, _parent, _shift, _flag)		\
+	GATE_MTK_FLAGS(_id, _name, _parent, &imp_iic_wrap_ao_cg_regs, _shift, \
+	&mtk_clk_gate_ops_no_setclr, _flag)
+
+
+
+static const struct mtk_gate imp_iic_wrap_ao_clks[] = {
+	GATE_imp_iic_wrap_ao_flags(CLK_IMP_IIC_WRAP_AO_AP_CLOCK_I2C0_RO,
+		"imp_iic_wrap_ao_ap_clock_i2c0_ro", "infra_ao_i2c0_bclk_ck", 0, CLK_IS_CRITICAL),
+	GATE_imp_iic_wrap_ao_flags(CLK_IMP_IIC_WRAP_AO_AP_CLOCK_I2C1_RO,
+		"imp_iic_wrap_ao_ap_clock_i2c1_ro", "infra_ao_i2c0_bclk_ck", 1, CLK_IS_CRITICAL),
+	GATE_imp_iic_wrap_ao_flags(CLK_IMP_IIC_WRAP_AO_AP_CLOCK_I2C2_RO,
+		"imp_iic_wrap_ao_ap_clock_i2c2_ro", "infra_ao_i2c0_bclk_ck", 2, CLK_IS_CRITICAL),
+};
+
+static const struct mtk_clk_desc imp_iic_wrap_ao_desc = {
+	.clks = imp_iic_wrap_ao_clks,
+	.num_clks = ARRAY_SIZE(imp_iic_wrap_ao_clks),
+};
+
+static const struct of_device_id of_match_clk_mt8519_imp_iic_wrap_ao[] = {
+	{
+		.compatible = "mediatek,mt8519-imp_iic_wrap_ao",
+		.data = &imp_iic_wrap_ao_desc,
+	}, {
+		/* sentinel */
+	}
+};
+
+static struct platform_driver clk_mt8519_imp_iic_wrap_ao_drv = {
+	.probe = mtk_clk_simple_probe,
+	.driver = {
+		.name = "clk-mt8519-imp_iic_wrap_ao",
+		.of_match_table = of_match_clk_mt8519_imp_iic_wrap_ao,
+	},
+};
+
+static int __init clk_mt8519_imp_iic_wrap_ao_init(void)
+{
+	return platform_driver_register(&clk_mt8519_imp_iic_wrap_ao_drv);
+}
+
+static void __exit clk_mt8519_imp_iic_wrap_ao_exit(void)
+{
+	platform_driver_unregister(&clk_mt8519_imp_iic_wrap_ao_drv);
+}
+
+arch_initcall(clk_mt8519_imp_iic_wrap_ao_init);
+module_exit(clk_mt8519_imp_iic_wrap_ao_exit);
+MODULE_LICENSE("GPL");
