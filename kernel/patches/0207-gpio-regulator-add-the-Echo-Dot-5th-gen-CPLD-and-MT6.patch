+};
+
+static const struct amzncpld_regs cpld45165_regs = {
+	.reg_io = 0xF0,
+	.reg_mute_l = 0xF1,
+	.reg_interrupt_1 = 0xF2,
+	.reg_mute = 0xF3,
+	.reg_i2c = 0xF4,
+	.reg_interrupt = 0xF5,
+	.reg_i2c_exp = 0xF6,
+
+	.mask_mute_state_delta = BIT(0),
+	.mask_mute_int = BIT(1),
+	.mask_action_int = BIT(2),
+	.mask_vol_up_int = BIT(3),
+	.mask_vol_dn_int = BIT(4),
+	.mask_ext_int = BIT(6),
+
+	.mask_btn_mute_l = BIT(1),
+	.mask_btn_act_l = BIT(2),
+	.mask_btn_vol_up_l = BIT(3),
+	.mask_btn_vol_dn_l = BIT(4),
+	.mask_ext_int_l = BIT(6),
+	.mask_mute_state_l = BIT(5),
+	.mask_mute_pwm_l = BIT(5),
+	.mask_sw_mute_set = BIT(1),
+	.mask_adc_rst = BIT(2),
+
+	.bit_interrupt_clear = 0,
+	.bit_sw_mute_set = 1,
+	.bit_sw_mute_dir = 2,
+	.bit_adc_rst = 3,
