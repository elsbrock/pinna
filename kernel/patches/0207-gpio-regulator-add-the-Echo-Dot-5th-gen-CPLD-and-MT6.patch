+	unsigned short reg_mute_l;
+	unsigned short reg_interrupt_1;
+	unsigned short reg_mute;
+	unsigned short reg_i2c;
+	unsigned short reg_interrupt;
+	unsigned short reg_i2c_exp;
+
+	/* reg_interrupt */
+	unsigned long mask_mute_state_delta;
+	unsigned long mask_mute_int;
+	unsigned long mask_action_int;
+	unsigned long mask_vol_up_int;
+	unsigned long mask_vol_dn_int;
+	unsigned long mask_ext_int;
+
+	/* reg_io */
+	unsigned long mask_btn_mute_l;
+	unsigned long mask_btn_act_l;
+	unsigned long mask_btn_vol_up_l;
+	unsigned long mask_btn_vol_dn_l;
+	unsigned long mask_ext_int_l;
+
+	/* reg_mute_l */
+	unsigned long mask_mute_state_l;
+
+	/* reg_i2c_exp */
+	unsigned long mask_mute_pwm_l;
+
+	unsigned long mask_sw_mute_set;
+	unsigned long mask_adc_rst;
+
+	unsigned long bit_interrupt_clear;
+	unsigned long bit_sw_mute_set;
+	unsigned long bit_sw_mute_dir;
+	unsigned long bit_adc_rst_dir;
+	unsigned long bit_adc_rst;
+	unsigned long bit_ext_int_mask;
+};
+
