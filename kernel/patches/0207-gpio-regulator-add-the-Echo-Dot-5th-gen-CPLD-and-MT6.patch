+
+struct amzncpld_data {
+	struct device *dev;
+	struct i2c_client *client;
+	struct mutex lock;
+	struct mutex irq_lock;
+	struct mutex i2c_lock;
+	struct regmap_irq_chip_data *irq_data;
+	struct gpio_chip gpio_chip;
+	struct timer_list key_timer;
+	struct delayed_work work;
+	unsigned int sw_debounce_ms;	/* msecs */
+	char irq_type[AMZ_CPLD_GPIO_NR];
+	bool irq_mask[AMZ_CPLD_GPIO_NR];
+	bool ext_irq_mask_pending;
+	bool wakeup_capable;
+	enum cpld_model model_id;
+	const struct amzncpld_regs *regs;
+};
+
+static int amzncpld_read_reg(struct i2c_client *client,
+			   uint32_t reg)
+{
+	return i2c_smbus_read_byte_data(client, reg);
+}
+
+static int amzncpld_set_bit(struct i2c_client *client,
+			    uint32_t reg, uint8_t bit,
+			    uint8_t value)
+{
+	struct amzncpld_data *data = dev_get_drvdata(&client->dev);
+	uint8_t val, mask = 1 << bit;
+	int ret;
+
+	mutex_lock(&data->i2c_lock);
+	val = i2c_smbus_read_byte_data(client, reg);
+	if (val < 0) {
+		mutex_unlock(&data->i2c_lock);
+		return val;
+	}
+
+	val = (val & ~mask) | ((value << bit) & mask);
+	ret = i2c_smbus_write_byte_data(client, reg, val);
+	mutex_unlock(&data->i2c_lock);
+	return ret;
+}
+
+static int amzncpld_gpio_get_direction(struct gpio_chip *chip, unsigned int offset)
+{
+	struct amzncpld_data *data = gpiochip_get_data(chip);
+
+	switch (offset) {
+	case AMZ_CPLD_GPIO_SW_MUTE_SET:
+		if (data->model_id != CPLD45165)
+			return 0;
+
+		if (amzncpld_read_reg(data->client, data->regs->reg_i2c) &
+		    data->regs->bit_sw_mute_dir)
+			return 0;
+		else
+			return 1;
+	case AMZ_CPLD_GPIO_ADC_RST:
+		if (amzncpld_read_reg(data->client, data->regs->reg_i2c) &
+		    data->regs->bit_adc_rst_dir)
+			return 0;
+		else
+			return 1;
+	case AMZ_CPLD_GPIO_BTN_VOL_DN_L:
+	case AMZ_CPLD_GPIO_BTN_VOL_UP_L:
+	case AMZ_CPLD_GPIO_BTN_ACT_L:
+	case AMZ_CPLD_GPIO_BTN_MUTE_L:
+	case AMZ_CPLD_GPIO_MUTE_STATE_L:
+	case AMZ_CPLD_GPIO_INT_STATUS:
+	case AMZ_CPLD_GPIO_MUTE_STATE:
+	case AMZ_CPLD_GPIO_MUTE_PWM_L:
+		return 1;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int amzncpld_gpio_direction_output(struct gpio_chip *chip,
+				     unsigned int offset, int value)
+{
+	struct amzncpld_data *data = gpiochip_get_data(chip);
+
+	switch (offset) {
+	case AMZ_CPLD_GPIO_SW_MUTE_SET:
+		if (data->model_id != CPLD45165)
+			return 0;
+
+		if (amzncpld_set_bit(data->client, data->regs->reg_i2c,
+				     data->regs->bit_sw_mute_dir, 0x1))
+			return -EIO;
+		return amzncpld_set_bit(data->client, data->regs->reg_i2c,
+					data->regs->bit_sw_mute_set, !!value);
+	case AMZ_CPLD_GPIO_ADC_RST:
+		if (amzncpld_set_bit(data->client, data->regs->reg_i2c,
+				     data->regs->bit_adc_rst_dir, 0x1))
+			return -EIO;
+		return amzncpld_set_bit(data->client, data->regs->reg_i2c,
+					data->regs->bit_adc_rst, !!value);
+	default:
+		return -EINVAL;
+	}
+}
+
+static int amzncpld_gpio_direction_input(struct gpio_chip *chip,
+				      unsigned int offset)
+{
+	struct amzncpld_data *data = gpiochip_get_data(chip);
+
+	switch (offset) {
+	case AMZ_CPLD_GPIO_BTN_VOL_DN_L:
+	case AMZ_CPLD_GPIO_BTN_VOL_UP_L:
+	case AMZ_CPLD_GPIO_BTN_ACT_L:
+	case AMZ_CPLD_GPIO_BTN_MUTE_L:
+	case AMZ_CPLD_GPIO_MUTE_STATE_L:
+	case AMZ_CPLD_GPIO_INT_STATUS:
+	case AMZ_CPLD_GPIO_MUTE_STATE:
+	case AMZ_CPLD_GPIO_MUTE_PWM_L:
+		return 0;
+	case AMZ_CPLD_GPIO_ADC_RST:
+		return amzncpld_set_bit(data->client, data->regs->reg_i2c,
+					data->regs->bit_adc_rst_dir, 0);
+	case AMZ_CPLD_GPIO_SW_MUTE_SET:
+		if (data->model_id != CPLD45165)
+			return 0;
+		return amzncpld_set_bit(data->client, data->regs->reg_i2c,
+					data->regs->bit_sw_mute_dir, 0);
+	default:
+		return 1;
+	}
+}
+
+static void amzncpld_gpio_set(struct gpio_chip *chip, unsigned int offset,
+			  int value)
+{
+	struct amzncpld_data *data = gpiochip_get_data(chip);
+
+	switch (offset) {
+	case AMZ_CPLD_GPIO_SW_MUTE_SET:
+		amzncpld_set_bit(data->client, data->regs->reg_i2c,
+				 data->regs->bit_sw_mute_set, !!(value));
+		return;
+	case AMZ_CPLD_GPIO_ADC_RST:
+		amzncpld_set_bit(data->client, data->regs->reg_i2c,
+				 data->regs->bit_adc_rst, !!(value));
+		return;
+	default:
+		return;
+	}
+}
+
+static int amzncpld_gpio_get(struct gpio_chip *chip, unsigned int offset)
+{
+	u32 reg;
+	struct amzncpld_data *data = gpiochip_get_data(chip);
+
+	switch (offset) {
+	case AMZ_CPLD_GPIO_BTN_MUTE_L:
+		reg = amzncpld_read_reg(data->client, data->regs->reg_io) &
+		      data->regs->mask_btn_mute_l;
+		break;
+	case AMZ_CPLD_GPIO_BTN_ACT_L:
+		if (data->model_id != CPLD45165)
+			return -EINVAL;
+
+		reg = amzncpld_read_reg(data->client, data->regs->reg_io) &
+		      data->regs->mask_btn_act_l;
+		break;
+	case AMZ_CPLD_GPIO_BTN_VOL_UP_L:
+		reg = amzncpld_read_reg(data->client, data->regs->reg_io) &
+		      data->regs->mask_btn_vol_up_l;
+		break;
+	case AMZ_CPLD_GPIO_BTN_VOL_DN_L:
+		reg = amzncpld_read_reg(data->client, data->regs->reg_io) &
+		      data->regs->mask_btn_vol_dn_l;
+		break;
+	case AMZ_CPLD_GPIO_MUTE_STATE_L:
+		reg = amzncpld_read_reg(data->client, data->regs->reg_mute_l) &
+		      data->regs->mask_mute_state_l;
+		break;
+	case AMZ_CPLD_GPIO_INT_STATUS:
+		reg = amzncpld_read_reg(data->client,
+					data->regs->reg_interrupt_1) &
+		      data->regs->mask_ext_int_l;
+		break;
+	case AMZ_CPLD_GPIO_MUTE_PWM_L:
+		reg = amzncpld_read_reg(data->client, data->regs->reg_i2c_exp) &
+		      data->regs->mask_mute_pwm_l;
+		break;
+	case AMZ_CPLD_GPIO_SW_MUTE_SET:
+		reg = amzncpld_read_reg(data->client, data->regs->reg_i2c) &
+		      data->regs->mask_sw_mute_set;
+		break;
+	case AMZ_CPLD_GPIO_ADC_RST:
+		reg = amzncpld_read_reg(data->client, data->regs->reg_i2c) &
+		      data->regs->mask_adc_rst;
+		break;
+	default :
+		return -EINVAL;
+	}
+
+	return !!reg;
+}
+
+static void amzncpld_irq_mask(struct irq_data *d)
+{
+	struct gpio_chip *gc = irq_data_get_irq_chip_data(d);
+	struct amzncpld_data *chip = gpiochip_get_data(gc);
+
+	chip->irq_mask[d->hwirq] = true;
+	if (chip->model_id == CPLD45575 && d->hwirq == AMZ_CPLD_GPIO_INT_STATUS)
+		chip->ext_irq_mask_pending = true;
+}
+
+static void amzncpld_irq_unmask(struct irq_data *d)
+{
+	struct gpio_chip *gc = irq_data_get_irq_chip_data(d);
+	struct amzncpld_data *chip = gpiochip_get_data(gc);
+
+	chip->irq_mask[d->hwirq] = false;
+	if (chip->model_id == CPLD45575 && d->hwirq == AMZ_CPLD_GPIO_INT_STATUS)
+		chip->ext_irq_mask_pending = true;
+}
+
+static void amzncpld_irq_bus_lock(struct irq_data *d)
+{
+	struct gpio_chip *gc = irq_data_get_irq_chip_data(d);
+	struct amzncpld_data *chip = gpiochip_get_data(gc);
+
+	mutex_lock(&chip->irq_lock);
+}
+
+static void amzncpld_irq_bus_sync_unlock(struct irq_data *d)
+{
+	struct gpio_chip *gc = irq_data_get_irq_chip_data(d);
+	struct amzncpld_data *chip = gpiochip_get_data(gc);
+
+	if (chip->model_id == CPLD45575 &&
+	    d->hwirq == AMZ_CPLD_GPIO_INT_STATUS &&
+	    chip->ext_irq_mask_pending) {
+		if (chip->irq_mask[d->hwirq])
+			amzncpld_set_bit(chip->client, chip->regs->reg_i2c,
+					 chip->regs->bit_ext_int_mask, 1);
+		else
+			amzncpld_set_bit(chip->client, chip->regs->reg_i2c,
+					 chip->regs->bit_ext_int_mask, 0);
+		chip->ext_irq_mask_pending = false;
+	}
+	mutex_unlock(&chip->irq_lock);
+}
+
+static int amzncpld_irq_set_type(struct irq_data *d, unsigned int type)
+{
+	struct gpio_chip *gc = irq_data_get_irq_chip_data(d);
+	struct amzncpld_data *chip = gpiochip_get_data(gc);
+
+	chip->irq_type[d->hwirq] = type;
+
+	return 0;
+}
+
+static struct irq_chip amzncpld_irq_chip = {
+	.name			= "cpld",
+	.irq_mask		= amzncpld_irq_mask,
+	.irq_unmask		= amzncpld_irq_unmask,
+	.irq_bus_lock		= amzncpld_irq_bus_lock,
+	.irq_bus_sync_unlock	= amzncpld_irq_bus_sync_unlock,
+	.irq_set_type		= amzncpld_irq_set_type,
+};
+
+static inline int cpld_generic_handle_irq(unsigned int irq)
+{
+	int ret;
+	unsigned long flags;
+
+	local_irq_save(flags);
+	ret = generic_handle_irq(irq);
+	local_irq_restore(flags);
+
+	return ret;
+}
+
+static int amzncpld_clear_irqs(struct amzncpld_data *data)
+{
+	int ret;
+	ret = amzncpld_set_bit(data->client, data->regs->reg_i2c,
+			       data->regs->bit_interrupt_clear , 0x1);
+	if (ret < 0) {
+		dev_err(&data->client->dev, "failed to clear irq %d\n", ret);
+		return ret;
+	}
+
+	usleep_range(1000, 1100);
+
+	ret = amzncpld_set_bit(data->client, data->regs->reg_i2c,
+			       data->regs->bit_interrupt_clear , 0);
+	if (ret < 0) {
+		dev_err(&data->client->dev, "failed to clear irq %d\n", ret);
+		return ret;
+	}
+
+	return 0;
+}
+
+struct amzncpld_irq_handler {
+	int model_bit;
+	u8 irq_bit;
+	int gpio_num;
+};
+
+static void amzncpld_handle_ext_irqs(struct amzncpld_data *data, u8 pending)
+{
+	/*
+	 * Incase of gpios we have to detect and handle the rising and falling
+	 * edge of interrupt by handling nested irq twice for every interrupt
+	 * event.
+	 */
+	if (!data->irq_mask[AMZ_CPLD_GPIO_INT_STATUS] &&
+	    pending & data->regs->mask_ext_int) {
+		u8 gpio_int;
+
+		switch (data->irq_type[AMZ_CPLD_GPIO_INT_STATUS]) {
+		case IRQ_TYPE_EDGE_RISING:
+		case IRQ_TYPE_LEVEL_HIGH:
+			gpio_int = (pending & data->regs->mask_ext_int);
+			break;
+		case IRQ_TYPE_EDGE_FALLING:
+		case IRQ_TYPE_LEVEL_LOW:
+			gpio_int = !(pending & data->regs->mask_ext_int);
+			break;
+		case IRQ_TYPE_EDGE_BOTH:
+		default:
+			gpio_int = 1;
+		}
+
+		if (gpio_int)
+			cpld_generic_handle_irq(
+				irq_find_mapping(data->gpio_chip.irq.domain,
+				AMZ_CPLD_GPIO_INT_STATUS));
+	}
+}
+
+static void amzncpld_handle_irqs(struct amzncpld_data *data, u8 pending)
+{
+	int i;
+	struct amzncpld_irq_handler irq_handlers[] = {
+		{
+			.model_bit = BIT(CPLD45575) | BIT(CPLD45165),
+			.irq_bit = data->regs->mask_mute_int,
+			.gpio_num = AMZ_CPLD_GPIO_BTN_MUTE_L,
+		},
+		{
+			.model_bit = BIT(CPLD45165),
+			.irq_bit = data->regs->mask_action_int,
+			.gpio_num = AMZ_CPLD_GPIO_BTN_ACT_L,
+		},
+		{
+			.model_bit = BIT(CPLD45575) | BIT(CPLD45165),
+			.irq_bit = data->regs->mask_vol_up_int,
+			.gpio_num = AMZ_CPLD_GPIO_BTN_VOL_UP_L,
+		},
+		{
+			.model_bit = BIT(CPLD45575) | BIT(CPLD45165),
+			.irq_bit = data->regs->mask_vol_dn_int,
+			.gpio_num = AMZ_CPLD_GPIO_BTN_VOL_DN_L,
+		},
+		{
+			.model_bit = BIT(CPLD45575) | BIT(CPLD45165),
+			.irq_bit = data->regs->mask_mute_state_delta,
+			.gpio_num = AMZ_CPLD_GPIO_MUTE_STATE_L,
+		},
+		{
+			.model_bit = BIT(CPLD45575) | BIT(CPLD45165),
+			.irq_bit = data->regs->mask_ext_int,
+			.gpio_num = AMZ_CPLD_GPIO_INT_STATUS,
+		},
+	};
+
+	for (i = 0; i < ARRAY_SIZE(irq_handlers); i++) {
+		struct amzncpld_irq_handler *mapping = &irq_handlers[i];
+
+		if (BIT(data->model_id) & mapping->model_bit &&
+		    !data->irq_mask[mapping->gpio_num] &&
+		    mapping->irq_bit & pending) {
+			cpld_generic_handle_irq(
+				irq_find_mapping(data->gpio_chip.irq.domain,
+				mapping->gpio_num));
+		}
+	}
+
+	/*
+	 * Incase of gpios we have to detect and handle the rising and falling
+	 * edge of interrupt by handling nested irq twice for every interrupt
+	 * event.
+	 */
+	amzncpld_handle_ext_irqs(data, pending);
+
+	dev_dbg(data->dev, "%s: irqs handled=0x%x\n", __func__, pending);
+}
+
+static inline int amzncpld_irq_status_read_and_clear(struct amzncpld_data *data,
+						     u8* status)
+{
+	int ret;
+
+	ret = amzncpld_read_reg(data->client, data->regs->reg_interrupt);
+	if (unlikely(ret < 0))
+		return ret;
+	*status = ret;
+
+	/*
+	 * XXX: Due to the current version of cpld hardware design flaw if
+	 * another interrupt raises the time between read interrupt status
+	 * register and clear interrupt, we lose the newly raised interrupts.
+	 * This lose of critical irqs should be fixed up by sending bogus
+	 * interrupts once all the interrupts are cleared.
+	 */
+	ret = amzncpld_clear_irqs(data);
+	if (unlikely(ret))
+		return ret;
+
+	return 0;
+}
+
+static void amzncpld_irq_work_func(struct work_struct *work)
+{
+	u8 irq_mask, cur_status_mask;
+	u8 cur_status, prev_status = 0, pending = 0;
+	struct amzncpld_data *data = container_of(work, struct amzncpld_data,
+						  work.work);
+	const int sleep_us = AMZ_CPLD_INTERRUPT_POLLING_INTERVAL_MS * 1000;
+
+	irq_mask = data->regs->mask_mute_int | data->regs->mask_vol_up_int |
+		   data->regs->mask_vol_dn_int | data->regs->mask_ext_int |
+		   data->regs->mask_mute_state_delta |
+		   data->regs->mask_action_int;
+
+	if (amzncpld_irq_status_read_and_clear(data, &cur_status))
+		goto out;
+	cur_status &= irq_mask;
+
+	dev_dbg(data->dev, "%s: enter cur_status=0x%x\n", __func__, cur_status);
+
+	if (!cur_status) {
+		/*
+		 * cpld finally cleared all the interrupt so the kernel recieved
+		 * the rising edge interrupt as an indication. The hardware's
+		 * flaw and the workaround inevitably bring another problem
+		 * where the workaround can clear unhandled irq, which can
+		 * happen to any types of interrupts.  Among the all interrupt
+		 * types, a missing mute_state_delta interrupt is crucial as a
+		 * missed interrupt causes privacy state mis-representation.
+		 * Forefully raise the mute_state_delta interrupt to avoid the
+		 * problem.  It will be bogus interrupt for most of time  and
+		 * fix up of the missing mute state delta happens rarely. The
+		 * bogus interrupt is not harmful as the consumer of this driver
+		 * should rely on the mute state upon the interrupt receiption.
+		 */
+		pending = data->regs->mask_mute_state_delta;
+		goto rising_edge;
+	}
+
+	/* Handle the currently pending interrupts first such as button press */
+	amzncpld_handle_irqs(data, cur_status);
+
+	/*
+	 * Flawed cpld hardware doesn't allow software to clear the interrupt
+	 * when a button is pressed. This is an ugly workaround to keep trying
+	 * clear the button interrupt.
+	 */
+	while (1) {
+		if (amzncpld_irq_status_read_and_clear(data, &cur_status))
+			goto out;
+		cur_status &= irq_mask;
+
+		if (prev_status != cur_status) {
+			dev_dbg(data->dev,
+				"%s: prev_status=0x%x -> cur_status=0x%x\n",
+				__func__, prev_status, cur_status);
+			prev_status = cur_status;
+		}
+
+		cur_status_mask = cur_status & (data->regs->mask_ext_int |
+			data->regs->mask_mute_state_delta |
+			data->regs->mask_vol_up_int |
+			data->regs->mask_vol_dn_int);
+
+		if (!cur_status) {
+			break;
+		} else if (cur_status_mask) {
+			amzncpld_handle_irqs(data, cur_status_mask);
+		} else {
+			pending |= cur_status;
+		}
+		usleep_range(sleep_us, sleep_us + 10000);
+	}
+
+rising_edge:
+	/* Interrupt is cleared as the button released */
+	dev_dbg(data->dev, "%s: pending irqs=0x%x\n", __func__, pending);
+
+	if (pending)
+		amzncpld_handle_irqs(data, pending);
+out:
+	if (data->wakeup_capable)
+		pm_relax(&data->client->dev);
+
+	dev_dbg(data->dev, "%s: exit\n", __func__);
+}
+
+static irqreturn_t amzncpld_irq_handler(int irq, void *d)
+{
+	bool ret;
+	struct amzncpld_data *data = d;
+
+	dev_dbg(data->dev, "%s: enter\n", __func__);
+
+	if (data->wakeup_capable)
+		pm_stay_awake(&data->client->dev);
+
+	ret = mod_delayed_work(system_wq, &data->work,
+			       msecs_to_jiffies(data->sw_debounce_ms));
+
+	dev_dbg(data->dev, "%s: mod_delayed_work ret=%d exit\n", __func__, ret);
+
+	return IRQ_HANDLED;
+}
+
+static int amzncpld_irq_setup(struct amzncpld_data *data)
+{
+	struct i2c_client *client = data->client;
+	int ret;
+
+	if (client->irq) {
+		mutex_init(&data->irq_lock);
+
+		INIT_DELAYED_WORK(&data->work, amzncpld_irq_work_func);
+		ret = devm_request_threaded_irq(&client->dev,
+					client->irq,
+					   NULL,
+					   amzncpld_irq_handler,
+					   IRQF_ONESHOT | IRQF_SHARED,
+					   dev_name(&client->dev), data);
+		if (ret) {
+			dev_err(&client->dev, "failed to request irq %d\n",
+				client->irq);
+			return ret;
+		}
+
+		/* 6.12: the irq domain is set up by gpiochip_add_data from
+		 * gpio_chip.irq (populated in amzncpld_gpio_init); the threaded
+		 * handler above demuxes into it. gpiochip_irqchip_add() and
+		 * gpiochip_set_chained_irqchip() were removed upstream.
+		 */
+
+	/* Schedule irq work func to clear interrupt status at boot time */
+		mod_delayed_work(system_wq,
+			 &data->work, msecs_to_jiffies(data->sw_debounce_ms));
+	}
+
+	return 0;
+}
+
+static int amzncpld_gpio_init(struct amzncpld_data *cpld)
+{
+	int ret = 0;
+
+	cpld->gpio_chip.parent = cpld->dev;
+	cpld->gpio_chip.owner = THIS_MODULE;
+	cpld->gpio_chip.label = DEVICE_NAME;
+	cpld->gpio_chip.ngpio = AMZ_CPLD_GPIO_NR;
+	cpld->gpio_chip.get_direction = amzncpld_gpio_get_direction;
+	cpld->gpio_chip.direction_input = amzncpld_gpio_direction_input;
+	cpld->gpio_chip.direction_output = amzncpld_gpio_direction_output;
+	cpld->gpio_chip.set = amzncpld_gpio_set;
+	cpld->gpio_chip.get = amzncpld_gpio_get;
+	cpld->gpio_chip.base = -1;
+	cpld->gpio_chip.can_sleep = 1;
+
+	if (cpld->client->irq) {
+		struct gpio_irq_chip *girq = &cpld->gpio_chip.irq;
+
+		girq->chip = &amzncpld_irq_chip;
+		girq->handler = handle_simple_irq;
+		girq->default_type = IRQ_TYPE_NONE;
+		girq->threaded = true;
+	}
+
+	ret = devm_gpiochip_add_data(cpld->dev, &cpld->gpio_chip, cpld);
+	if (ret < 0) {
+		dev_err(&cpld->client->dev, "failed to add gpiochip %d\n", ret);
+		goto out;
+	}
+
+	ret = amzncpld_irq_setup(cpld);
+	if (ret) {
+		dev_err(&cpld->client->dev,
+			"failed to initialize gpio irq, ret=%d\n", ret);
+	}
+out:
+	return ret;
+
+}
+
+static int amzncpld_probe(struct i2c_client *client)
+{
+	int ret = 0;
+	struct amzncpld_data *data = devm_kzalloc(&client->dev,
+						 sizeof(struct amzncpld_data),
+						 GFP_KERNEL);
+	if (!data) {
+		dev_err(&client->dev,
+			"Failed to allocate memory for cpld data, ret=%d\n",
+			ret);
+		ret = -ENOMEM;
+		goto out;
+	}
+
+	if (!i2c_check_functionality(client->adapter, I2C_FUNC_SMBUS_BYTE_DATA)) {
+		dev_err(&client->dev,
+			"Required i2c functionality is not supported\n");
+		return -EIO;
+	}
+
+	data->client = client;
+	data->dev = &client->dev;
+	const struct i2c_device_id *id = i2c_client_get_device_id(client);
+
+	data->model_id = id->driver_data;
+
+	mutex_init(&data->lock);
+	mutex_init(&data->i2c_lock);
+	if (of_property_read_u32(client->dev.of_node, "swdebounce-interval",
+				&data->sw_debounce_ms))
+		data->sw_debounce_ms = 50;
+
+	data->wakeup_capable = of_property_read_bool(client->dev.of_node,
+						"wakeup-source");
+	i2c_set_clientdata(client, data);
+
+	if (data->model_id == CPLD45575) {
+		data->regs = &cpld45575_regs;
+	} else if (data->model_id == CPLD45165) {
+		data->regs = &cpld45165_regs;
+	} else {
+		dev_err(&client->dev,
+			"unknown cpld model_id=%d\n", data->model_id);
+		ret = -EINVAL;
+		goto out;
+	}
+
+	ret = amzncpld_gpio_init(data);
+	if (ret) {
+		dev_err(&client->dev,
+			"failed to initialize gpio, ret=%d\n", ret);
+		goto out;
+	}
+
+	device_init_wakeup(&client->dev, data->wakeup_capable);
+
+	dev_info(&client->dev,
+		 "%s cpld chip model=%d sw_debounce_ms=%d probed\n",
+		 client->name, data->sw_debounce_ms, data->model_id);
+out:
+	return ret;
+}
+
+static void amzncpld_remove(struct i2c_client *client)
+{
+}
+
+#ifdef CONFIG_PM_SLEEP
+static int amzncpld_suspend(struct device *dev)
+{
+	struct amzncpld_data *data = dev_get_drvdata(dev);
+
+	if (device_may_wakeup(dev)) {
+		enable_irq_wake(data->client->irq);
+	}
+
+	return 0;
+}
+
+static int amzncpld_resume(struct device *dev)
+{
+	struct amzncpld_data *data = dev_get_drvdata(dev);
+
+	if (device_may_wakeup(dev)) {
+		disable_irq_wake(data->client->irq);
+	}
+
+	return 0;
+}
+
+static SIMPLE_DEV_PM_OPS(amzncpld_pm_ops, amzncpld_suspend, amzncpld_resume);
+#endif
+
+static struct i2c_device_id amzncpld_id[] = {
+	{ "cpld45575", CPLD45575 },
+	{ "cpld45165", CPLD45165 },
+	{ }
+};
+
+MODULE_DEVICE_TABLE(i2c, amzncpld_id);
+
+static const struct of_device_id amzncpld_of_match[] = {
+	{ .compatible = "amzn,cpld45575"},
+	{ .compatible = "amzn,cpld45165"},
+	{},
+};
+MODULE_DEVICE_TABLE(of, amzncpld_of_match);
+
+static struct i2c_driver amzncpld_driver = {
+	.driver = {
+		.name = "amzn_cpld",
+		.of_match_table = of_match_ptr(amzncpld_of_match),
+#ifdef CONFIG_PM_SLEEP
+		.pm = &amzncpld_pm_ops,
+#endif
+	},
+	.probe = amzncpld_probe,
+	.remove = amzncpld_remove,
+	.id_table = amzncpld_id,
+};
+
+module_i2c_driver(amzncpld_driver);
+
+MODULE_AUTHOR("Yadwinder Singh Brar <ybbrar@amazon.com>");
+MODULE_DESCRIPTION("Amazon Custom CPLD Driver");
+MODULE_LICENSE("GPL v2");
