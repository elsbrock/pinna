+	.reg_io = 0xF0,
+	.reg_mute_l = 0xF1,
+	.reg_interrupt_1 = 0xF2,
+	.reg_mute = 0xF3,
+	.reg_i2c = 0xF4,
+	.reg_interrupt = 0xF5,
+	.reg_i2c_exp = 0xF6,
+
+	.mask_mute_state_delta = BIT(0),
+	.mask_mute_int = BIT(1),
+	.mask_action_int = 0,	/* unused */
+	.mask_vol_up_int = BIT(2),
+	.mask_vol_dn_int = BIT(3),
+	.mask_ext_int = BIT(4),
+	.mask_btn_mute_l = BIT(1),
+	.mask_btn_act_l = 0,	/* unused */
+	.mask_btn_vol_up_l = BIT(2),
+	.mask_btn_vol_dn_l = BIT(3),
+	.mask_ext_int_l = BIT(4),
+	.mask_mute_state_l = BIT(5),
+	.mask_mute_pwm_l = BIT(5),
+	.mask_sw_mute_set = BIT(1),
+	.mask_adc_rst = BIT(2),
+
+	.bit_interrupt_clear = 0,
+	.bit_sw_mute_set = 1,
+	.bit_sw_mute_dir = 0,	/* unused */
+	.bit_adc_rst_dir = 2,
