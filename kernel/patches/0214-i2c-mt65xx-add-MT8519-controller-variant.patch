From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Simon Elsbrock <simon@iodev.org>
Date: Tue, 24 Nov 2026 18:00:00 +0100
Subject: [PATCH] i2c: mt65xx: add MT8519 controller variant

Add the MT8519 controller data and preserve its 16-byte FIFO path for short
transfers. Longer transfers continue to use DMA. The existing compatibles
retain DMA by default. Also support the vendor's optional shared-channel FIFO
clear mode.

---
--- a/drivers/i2c/busses/i2c-mt65xx.c
+++ b/drivers/i2c/busses/i2c-mt65xx.c
@@ -39,6 +39,7 @@
 #define I2C_SOFT_RST			0x0001
 #define I2C_HANDSHAKE_RST		0x0020
 #define I2C_FIFO_ADDR_CLR		0x0001
+#define I2C_FIFO_ADDR_CLR_MCH		0x0004
 #define I2C_DELAY_LEN			0x0002
 #define I2C_ST_START_CON		0x8001
 #define I2C_FS_START_CON		0x1800
@@ -268,6 +269,7 @@
 	unsigned char ltiming_adjust: 1;
 	unsigned char apdma_sync: 1;
 	unsigned char max_dma_support;
+	unsigned char fifo_size;
 };
 
 struct mtk_i2c_ac_timing {
@@ -295,6 +297,7 @@
 	struct clk_bulk_data clocks[I2C_MT65XX_CLK_MAX]; /* clocks for i2c */
 	bool have_pmic;			/* can use i2c pins from PMIC */
 	bool use_push_pull;		/* IO config push-pull mode */
+	bool enable_multi_user;
 
 	u16 irq_stat;			/* interrupt status */
 	unsigned int clk_src_div;
@@ -359,6 +362,20 @@
 
 static const struct i2c_adapter_quirks mt8183_i2c_quirks = {
 	.flags = I2C_AQ_NO_ZERO_LEN,
+};
+
+static const struct mtk_i2c_compatible mt8519_compat = {
+	.regs = mt_i2c_regs_v3,
+	.pmic_i2c = 0,
+	.dcm = 0,
+	.auto_restart = 1,
+	.aux_len_reg = 1,
+	.timing_adjust = 1,
+	.dma_sync = 0,
+	.ltiming_adjust = 1,
+	.apdma_sync = 0,
+	.max_dma_support = 36,
+	.fifo_size = 16,
 };
 
