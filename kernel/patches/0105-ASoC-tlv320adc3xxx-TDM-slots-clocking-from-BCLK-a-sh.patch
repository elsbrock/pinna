 		if (!adc3xxx->use_pll) {
 			snd_soc_dapm_add_routes(dapm, adc3xxx_pll_intercon,
@@ -1237,7 +1305,9 @@ static int adc3xxx_hw_params(struct snd_pcm_substream *substream,
 			adc3xxx->use_pll = 1;
 		}
