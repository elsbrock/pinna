+/*
+ * The left channel is sent in the first active slot and the right channel in
+ * the slot directly following it. DOUT is released outside of the active
+ * slots so that several codecs can share one data line.
+ */
+static int adc3xxx_set_dai_tdm_slot(struct snd_soc_dai *dai,
+				    unsigned int tx_mask, unsigned int rx_mask,
+				    int slots, int slot_width)
+{
+	struct snd_soc_component *component = dai->component;
+	struct adc3xxx *adc3xxx = snd_soc_component_get_drvdata(component);
+	unsigned int first, offset = 0, tdm_ctrl = 0, tristate = 0;
+
+	if (slots) {
+		if (!tx_mask || slot_width <= 0) {
+			dev_err(component->dev, "Invalid TDM configuration\n");
+			return -EINVAL;
+		}
+
+		first = __ffs(tx_mask);
+		offset = first * slot_width;
+		if (first >= slots || offset > 0xff ||
+		    (tx_mask & ~(0x3 << first))) {
+			dev_err(component->dev, "Unsupported TDM slot mask %#x\n",
+				tx_mask);
+			return -EINVAL;
+		}
+
+		if (!(tx_mask & BIT(first + 1)))
+			tdm_ctrl = ADC3XXX_TDM_RIGHT_DISABLE;
+		tristate = ADC3XXX_DOUT_3STATE;
+	}
+
+	adc3xxx->tdm_slots = slots;
+	adc3xxx->tdm_slot_width = slot_width;
+
+	snd_soc_component_update_bits(component, ADC3XXX_INTERFACE_CTRL_1,
+				      ADC3XXX_DOUT_3STATE, tristate);
+	snd_soc_component_write(component, ADC3XXX_CH_OFFSET_1, offset);
+	snd_soc_component_update_bits(component, ADC3XXX_I2S_TDM_CTRL,
+				      ADC3XXX_TDM_RIGHT_DISABLE |
+				      ADC3XXX_TDM_LEFT_DISABLE |
+				      ADC3XXX_TDM_TIME_SLOT_MODE, tdm_ctrl);
+
+	return 0;
+}
+
 static const struct snd_soc_dai_ops adc3xxx_dai_ops = {
 	.hw_params	= adc3xxx_hw_params,
 	.set_sysclk	= adc3xxx_set_dai_sysclk,
 	.set_fmt	= adc3xxx_set_dai_fmt,
+	.set_tdm_slot	= adc3xxx_set_dai_tdm_slot,
 };
 
