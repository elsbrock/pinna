+/*
+ * Without MCLK the bit clock feeds the ADC clock dividers directly, so the
+ * number of bit clocks per frame has to be NADC * MADC * AOSR.
+ */
+static int adc3xxx_get_bclk_divs(struct device *dev, unsigned int rate,
+				 unsigned int ratio,
+				 struct adc3xxx_rate_divs *divs)
+{
+	unsigned int aosr, div;
+
+	for (aosr = rate > 48000 ? 64 : 128; aosr >= 32; aosr /= 2) {
+		if (ratio % aosr)
+			continue;
+
+		div = ratio / aosr;
+		memset(divs, 0, sizeof(*divs));
+		divs->rate = rate;
+		divs->aosr = aosr;
+		divs->madc = div % 2 ? div : 2;
+		divs->nadc = div / divs->madc;
+		/*
+		 * MADC * AOSR / 32 must cover the instruction count of the
+		 * default processing block (resource class 6).
+		 */
+		if (divs->madc * aosr / 32 >= 6 &&
+		    divs->madc <= ADC3XXX_MADC_MASK &&
+		    divs->nadc <= ADC3XXX_NADC_MASK)
+			return 0;
+	}
+
+	dev_err(dev, "Unsupported BCLK to sample rate ratio %u\n", ratio);
+	return -EINVAL;
 }
 
