+int mtk_nfc_set_erase_worn_block(struct mtd_info *mtd, loff_t ofs)
+{
+	return mtk_nfc_set_worn_op(mtd, ofs, ERASE_MODE);
+}
+EXPORT_SYMBOL_GPL(mtk_nfc_set_erase_worn_block);
