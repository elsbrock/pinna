+	NFI_CTRL_BASE_INFO = 10,
+	NFI_CTRL_NFI_IRQ,
+	NFI_CTRL_ECC_IRQ,
+	NFI_CTRL_ECC_PAGE_IRQ,
+	NFI_CTRL_DMA,
+	NFI_BURST_EN,
+	NFI_ADDR_ALIGNMENT_EN,
+	NFI_BYTE_RW_EN,
+	NFI_CRC_EN,
+	NFI_CTRL_RANDOMIZE,
+	NFI_CTRL_RANDOMIZE_SEL, /* 20 */
+	NFI_CTRL_IO_FORMAT,
+	NFI_CTRL_ECC,
+	NFI_CTRL_ECC_MODE,
+	NFI_CTRL_ECC_DECODE_MODE,
+	NFI_CTRL_ECC_GET_ECC_EN,
+	NFI_CTRL_ECC_GET_ECC_INFO,
+	NFI_CTRL_ECC_ERRNUM0,
+	NFI_CTRL_ECC_GET_STATUS,
+	NFI_CTRL_BAD_MARK_SWAP,
+	NFI_CTRL_BAD_MARK_SWAP_GET_SWAP_EN,
+	NFI_CTRL_IOCON,
+	NFI_BLOCK_PAGES_INFO,
+
+	SNFI_CTRL_BASE_INFO = 40,
+	SNFI_CTRL_OP_MODE,
+	SNFI_CTRL_RX_MODE,
+	SNFI_CTRL_TX_MODE,
+	SNFI_CTRL_DELAY_MODE,
+	SNFI_CTRL_4FIFO_EN,
+	SNFI_CTRL_GF_CONFIG,
+	SNFI_CTRL_SAMPLE_DELAY,
+	SNFI_CTRL_LATCH_LATENCY,
+	SNFI_CTRL_MAC_QPI_MODE,
+
+	CHIP_CTRL_OPS_CACHE = 60,
+	CHIP_CTRL_OPS_MULTI,
+	CHIP_CTRL_PSLC_MODE,
+	CHIP_CTRL_DRIVE_STRENGTH,
+	CHIP_CTRL_DDR_MODE,
+	CHIP_CTRL_DEVICE_RESET,
+	CHIP_CTRL_ONDIE_ECC,
+	CHIP_CTRL_TIMING_MODE,
+	CHIP_CTRL_MAX_FREQ,
+	CHIP_CTRL_DELAY_MODE,
+	CHIP_CTRL_PERF_INFO,
+	CHIP_CTRL_PERF_INFO_CLEAR,
+	CHIP_CTRL_GET_STATUS
+};
+
+struct nfiecc_status {
+	u32 corrected;
+	u32 failed;
+	u32 bitflips;
+};
+
+struct chip_status {
+	u32 corrected;
+	u32 failed;
+};
+
+enum snfi_ctrl_op_mode {
+	SNFI_CUSTOM_MODE,
+	SNFI_AUTO_MODE,
+	SNFI_MAC_MODE
+};
+
+enum snfi_ctrl_rx_mode {
