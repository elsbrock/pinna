+
+void nand_high_clock_sel(void)
+{
+#ifndef NANDX_FPGA_ENV
+	nandx_set_bits32(NAND_CLK_BASE + 0xb8, 0x7 << 8, 0x7 << 8);
+	nandx_set_bits32(NAND_CLK_BASE + 0xb4, 0x7 << 8, 0x5 << 8);
+	nandx_set_bits32(NAND_CLK_BASE + 0x4, 0x1 << 29, 0x1 << 29);
+
+	nandx_set_bits32(NAND_CLK_BASE + 0xb8, 0x7, 0x7);
+	nandx_set_bits32(NAND_CLK_BASE + 0xb4, 0x7, 0x2);
+	nandx_set_bits32(NAND_CLK_BASE + 0x4, 0x1 << 28, 0x1 << 28);
+#endif
+}
+
+void nand_hard_reset(void)
+{
+	u32 val;
+
+	val = readl(IO_PHYS + 0x1130);
+	val |= BIT(15);
+	writel(val, IO_PHYS + 0x1130);
+
+	nandx_udelay(5);
+
+	val = readl(IO_PHYS + 0x1130);
+	val &= ~BIT(15);
+	writel(val, IO_PHYS + 0x1130);
+}
+
+void nand_gpio_init(int nand_type, int pinmux_group)
+{
+	pr_debug("gpio init, nand type:0x%x, pinmux group:0x%x.\n",
+		 nand_type, pinmux_group);
+
+#ifndef NANDX_FPGA_ENV
+	if (nand_type == NAND_SPI) {
+		/* Pinmux */
+		nandx_set_bits32(GPIO_BASE + 0x3B0,
+			(0x7 << 28) | (0x7 << 24) | (0x7 << 20),
+			(0x2 << 28) | (0x2 << 24) | (0x2 << 20));
+		nandx_set_bits32(GPIO_BASE + 0x3C0,
+			(0x7 << 8) | (0x7 << 4) | (0x7 << 0),
+			(0x2 << 8) | (0x2 << 4) | (0x2 << 0));
+
+		/* driving */
+		nandx_set_bits32(IO_PHYS + 0x1E10170, 0x7C08, 0x0);
+		nandx_set_bits32(IO_PHYS + 0x1E10010, 0x38000, 0x8000);
+		nandx_set_bits32(IO_PHYS + 0x1E10020, 0x1FFFC0, 0x49240);
+
+	} else if (nand_type == NAND_SLC) {
+		/* Pinmux */
+		nandx_set_bits32(GPIO_BASE + 0x3A0,
+		(0x7 << 28) | (0x7 << 24),
+			(0x1 << 28) | (0x1 << 24));
+		nandx_set_bits32(GPIO_BASE + 0x3B0, 0x77777777, 0x11111111);
+		nandx_set_bits32(GPIO_BASE + 0x3C0, 0x77777, 0x11111);
+
+		/* driving */
+		nandx_set_bits32(IO_PHYS + 0x1E10170, 0x7FFF, 0x0);
+		nandx_set_bits32(IO_PHYS + 0x1E10010, 0x3FFFFFC0, 0x9249240);
+		nandx_set_bits32(IO_PHYS + 0x1E10020, 0x1FFFFF, 0x49249);
+	}
+#endif
+}
+
+void nand_clock_init(int nand_type, int sel, u32 *rate)
+{
+	if ((nand_type != NAND_SPI) && (nand_type != NAND_SLC))
+		pr_err("nand type not support!\n");
+
+#ifndef NANDX_FPGA_ENV
+	pr_debug("%s sel:%d!\n", __func__, sel);
+
+	if (nand_type == NAND_SPI) {
+		nandx_set_bits32(NAND_CLK_BASE + 0x118, 0x7 << 8, 0x7 << 8);
+		nandx_set_bits32(NAND_CLK_BASE + 0x114, 0x7 << 8, sel << 8);
+		nandx_set_bits32(NAND_CLK_BASE + 0xc, BIT(3), BIT(3));
+
+		if (rate == NULL)
+			return;
+
+		switch (sel) {
+		case 0:
+			*rate = 26 * 1000 * 1000;
+			break;
+		case 1:
+			*rate = 52 * 1000 * 1000;
+			break;
+		case 2:
+			*rate = 62 * 1000 * 1000;
+			break;
+		case 3:
+			*rate = 68 * 1000 * 1000;
+			break;
+		case 4:
+			*rate = 78 * 1000 * 1000;
+			break;
+		case 5:
+			*rate = 91 * 1000 * 1000;
+			break;
+		case 6:
+			*rate = 104 * 1000 * 1000;
+			break;
+		case 7:
+			*rate = 124 * 1000 * 1000;
+			break;
+		default:
+			break;
+		}
+	} else if (nand_type == NAND_SLC) {
+		nandx_set_bits32(NAND_CLK_BASE + 0x118, 0x7, 0x7);
+		nandx_set_bits32(NAND_CLK_BASE + 0x114, 0x7, sel);
+		nandx_set_bits32(NAND_CLK_BASE + 0xc, BIT(2), BIT(2));
+
+		if (rate == NULL)
+			return;
+
+		switch (sel) {
+		case 0:
+			*rate = 26 * 1000 * 1000;
+			break;
+		case 1:
+			*rate = 91 * 1000 * 1000;
+			break;
+		case 2:
+			*rate = 156 * 1000 * 1000;
+			break;
+		case 3:
+			*rate = 182 * 1000 * 1000;
+			break;
+		case 4:
+			*rate = 200 * 1000 * 1000;
+			break;
+		case 5:
+			*rate = 312 * 1000 * 1000;
+			break;
+		case 6:
+			*rate = 250 * 1000 * 1000;
+			break;
+		case 7:
+			*rate = 364 * 1000 * 1000;
+			break;
+		default:
+			break;
+		}
+	}
+#else
+	*rate = 26 * 1000 * 1000;
+#endif
+
+}
+
+void nand_cg_switch(int nand_type, int gate, bool enable)
+{
+	/* NOTE: all cg should be enabled in nand_clock_init. */
+}
+
+#endif
