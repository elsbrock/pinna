+	CHIP_TIMING_MODE4,
+	CHIP_TIMING_MODE5,
+};
+
+/**
+ * chip_ctrl_freq_setting - nand devices max frequencies,
+ * derive from device datasheet.
+ */
+enum chip_ctrl_freq_setting {
+	SNAND_FREQ_26M = 0,
+	SNAND_FREQ_52M,
+	SNAND_FREQ_60M,
+	SNAND_FREQ_78M,
+	SNAND_FREQ_83M,
+	SNAND_FREQ_91M,
+	SNAND_FREQ_100M,
+	SNAND_FREQ_104M,
+	SNAND_FREQ_108M,
+	SNAND_FREQ_120M,
+	SNAND_FREQ_133M,
+	SNAND_FREQ_166M
+};
+
+enum chip_ctrl_delay_mode {
+	SNAND_DELAY_MODE0 = 0,
+	SNAND_DELAY_MODE1,
