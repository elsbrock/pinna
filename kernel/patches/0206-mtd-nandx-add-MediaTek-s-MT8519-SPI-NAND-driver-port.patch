+};
+
+/**
+ * nand_performance - performance information
+ */
+struct nand_performance {
+	struct page_performance page_perf;
+
+	int read_speed;
+	int write_speed;
+	int erase_speed;
+};
+
+/**
+ * nandx_info - basic information
+ */
+struct nandx_info {
