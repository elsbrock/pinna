+int mtk_nfc_set_write_worn_page(struct mtd_info *mtd, loff_t ofs)
+{
+	return mtk_nfc_set_worn_op(mtd, ofs, WRITE_MODE);
+}
+EXPORT_SYMBOL_GPL(mtk_nfc_set_write_worn_page);
