+static int nandx_enable_clk(struct nandx_clk *clk)
+{
+	int ret;
+
+	ret = clk_prepare_enable(clk->nfi_clk);
+	if (ret) {
+		pr_info("failed to enable nfi clk\n");
+		return ret;
+	}
+
+	ret = clk_prepare_enable(clk->nfi_hclk);
+	if (ret) {
+		pr_info("failed to enable nfi hclk\n");
+		goto disable_nfi_clk;
+	}
+
+	ret = clk_prepare_enable(clk->ecc_clk);
+	if (ret) {
+		pr_info("failed to enable ecc clk\n");
+		goto disable_hclk_sel;
+	}
+
+	if (nand_types_support() &  BIT(NAND_SPI)) {
+		ret = clk_prepare_enable(clk->snfi_clk);
+		if (ret) {
+			pr_info("failed to enable snfi clk\n");
+			goto disable_ecc_clk;
+		}
+
+		ret = clk_prepare_enable(clk->snfi_clk_sel);
+		if (ret) {
+			pr_info("failed to enable snfi clk sel\n");
+			goto disable_snfi_clk;
+		}
+	}
+
+#if NANDX_IC_HAS_2XCLK
+	ret = clk_prepare_enable(clk->nfi2x_clk_sel);
+#else
+	ret = clk_prepare_enable(clk->nfi1x_clk_sel);
+#endif
+	if (ret) {
+		pr_info("failed to enable nfi1x/nfi2x clk sel\n");
+		if (nand_types_support() &	BIT(NAND_SPI))
+			goto disable_snfi_clk_sel;
+		else
+			goto disable_ecc_clk;
+	}
+
+	return 0;
+
+disable_snfi_clk_sel:
+	clk_disable_unprepare(clk->snfi_clk_sel);
+disable_snfi_clk:
+	clk_disable_unprepare(clk->snfi_clk);
+disable_ecc_clk:
+	clk_disable_unprepare(clk->ecc_clk);
+disable_hclk_sel:
+	clk_disable_unprepare(clk->nfi_hclk);
+disable_nfi_clk:
+	clk_disable_unprepare(clk->nfi_clk);
+
+	return ret;
+}
+
+static void nandx_disable_clk(struct nandx_clk *clk)
+{
+#if NANDX_IC_HAS_2XCLK
+	clk_disable_unprepare(clk->nfi2x_clk_sel);
+#else
+	clk_disable_unprepare(clk->nfi1x_clk_sel);
+#endif
+	clk_disable_unprepare(clk->nfi_clk);
+	clk_disable_unprepare(clk->nfi_hclk);
+	clk_disable_unprepare(clk->ecc_clk);
+	if (nand_types_support() &  BIT(NAND_SPI))
+		clk_disable_unprepare(clk->snfi_clk);
+		clk_disable_unprepare(clk->snfi_clk_sel);
+}
