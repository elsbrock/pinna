+/**
+ * nfi_io_format - nfi format for accessing data
+ */
+struct nfi_io_format {
+	int fdm_size;
+	int fdm_ecc_size;
+	int sec_spare_size;
+	int sec_size;
+	int cus_sec_en;
+	int cus_sec_size;
+	int last_cus_sec_en;
+	int last_cus_sec_size;
