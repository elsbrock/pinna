+#ifndef CONFIG_MTK_NAND_FPGA
+static int nandx_clk_sel(struct nandx_nfc *nfc)
+{
+	int arg, ret;
+	int chip_max_freq;
+
+	ret = nandx_ioctl(CHIP_CTRL_MAX_FREQ , &chip_max_freq);
+	if (ret)
+		return ret;
+
+#if NANDX_IC_HAS_2XCLK
+	clk_set_parent(nfc->clk.nfi2x_clk_sel,
+		nfc->clk.nfi2x_clk_parent);
+	nfc->res->clock_1x =
+		clk_get_rate(nfc->clk.nfi2x_clk_parent) / 2;
+#else
+	if (chip_max_freq >= SNAND_FREQ_91M) {
+		clk_set_parent(nfc->clk.nfi1x_clk_sel,
+			nfc->clk.nfi1x_clk_parent_91m);
+		nfc->res->clock_1x =
+		clk_get_rate(nfc->clk.nfi1x_clk_parent_91m);
+	} else if (chip_max_freq >= SNAND_FREQ_52M) {
+		clk_set_parent(nfc->clk.nfi1x_clk_sel,
+			nfc->clk.nfi1x_clk_parent_78m);
+		nfc->res->clock_1x =
+		clk_get_rate(nfc->clk.nfi1x_clk_parent_78m);
+	} else {
+		clk_set_parent(nfc->clk.nfi1x_clk_sel,
+			nfc->clk.nfi1x_clk_parent_26m);
+		nfc->res->clock_1x =
+		clk_get_rate(nfc->clk.nfi1x_clk_parent_26m);
+	}
+#endif
+
+	if ((nand_types_support() &  BIT(NAND_SPI))
+		&& (!IS_ERR(nfc->pinctrl)
+		&& !IS_ERR(nfc->pins_drive_high))) {
+		if (chip_max_freq >= SNAND_FREQ_91M)
+			clk_set_parent(nfc->clk.snfi_clk_sel,
+				nfc->clk.snfi_parent_91m);
+		else if (chip_max_freq >= SNAND_FREQ_78M)
+			clk_set_parent(nfc->clk.snfi_clk_sel,
+				nfc->clk.snfi_parent_78m);
+		else if (chip_max_freq >= SNAND_FREQ_52M)
+			clk_set_parent(nfc->clk.snfi_clk_sel,
+				nfc->clk.snfi_parent_52m);
+		else
+			clk_set_parent(nfc->clk.snfi_clk_sel,
+				nfc->clk.snfi_parent_26m);
+		pinctrl_select_state(nfc->pinctrl, nfc->pins_drive_high);
+
+		ret = nandx_ioctl(CHIP_CTRL_DELAY_MODE, &arg);
+		if (ret)
+			return ret;
+		ret = nandx_ioctl(SNFI_CTRL_DELAY_MODE, &arg);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+#endif
