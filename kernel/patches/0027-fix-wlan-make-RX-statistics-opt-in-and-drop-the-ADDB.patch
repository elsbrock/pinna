+/* /sys/module/wlan_mt/parameters/rx_stat_period_ms */
+extern unsigned int echo_rx_stat_period_ms;
+
+/*
+ * Rate-limited RX anomaly lines (ECHO_WLAN_RXHIF, ECHO_WLAN_RX_BA): printed
+ * when rx_stat_period_ms is set, pr_debug otherwise.
+ */
+#define ECHO_RX_LOG(_fmt, ...) \
