From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Simon Elsbrock <simon@iodev.org>
Date: Sun, 15 Nov 2026 13:46:20 +0100
Subject: [PATCH 11/27] leds: is31fl32xx, lp55xx: LED ring support

Ported from LibreEcho's Linux tree (release 0.14.5, Linux 6.1.178) to Linux 6.12.
---
 drivers/leds/leds-is31fl32xx.c    | 233 +++++++++++++++++++++++++++++-
 drivers/leds/leds-lp55xx-common.c |  27 +++-
 drivers/leds/leds-lp55xx-common.h |   3 +
 3 files changed, 260 insertions(+), 3 deletions(-)

diff --git a/drivers/leds/leds-is31fl32xx.c b/drivers/leds/leds-is31fl32xx.c
index 8793330dd..c5371fa74 100644
--- a/drivers/leds/leds-is31fl32xx.c
+++ b/drivers/leds/leds-is31fl32xx.c
@@ -14,6 +14,7 @@
 #include <linux/kernel.h>
 #include <linux/leds.h>
 #include <linux/module.h>
+#include <linux/mutex.h>
 #include <linux/of.h>
 
 /* Used to indicate a device has no such register */
@@ -43,6 +44,12 @@ struct is31fl32xx_priv {
 	const struct is31fl32xx_chipdef *cdef;
 	struct i2c_client *client;
 	unsigned int num_leds;
+	struct mutex frame_lock;
+	u8 channel_offset;
+	u8 frame[36];
+	u8 scale[36];		/* per-channel output current: Imax/(scale+1) */
+	bool scale_valid;	/* scale[] matches the latched LED control regs */
+	bool boot_animation;
 	struct is31fl32xx_led_data leds[];
 };
 
@@ -285,12 +292,33 @@ static int is31fl32xx_software_shutdown(struct is31fl32xx_priv *priv,
 static int is31fl32xx_init_regs(struct is31fl32xx_priv *priv)
 {
 	const struct is31fl32xx_chipdef *cdef = priv->cdef;
+	unsigned int i;
 	int ret;
 
 	ret = is31fl32xx_reset_regs(priv);
 	if (ret)
 		return ret;
 
+	/*
+	 * Resetting the controller does not make the initial PWM frame explicit.
+	 * Stage an all-off frame before exposing any enabled channels.  The
+	 * IS31FL3216 custom reset already performs this step while shutdown is
+	 * asserted, so avoid duplicating its writes here.
+	 */
+	if (!cdef->reset_func) {
+		for (i = 0; i < cdef->channels; i++) {
+			ret = is31fl32xx_write(priv,
+					       cdef->pwm_register_base + i,
+					       0x00);
+			if (ret)
+				return ret;
+		}
+
+		ret = is31fl32xx_write(priv, cdef->pwm_update_reg, 0);
+		if (ret)
+			return ret;
+	}
+
 	/*
 	 * Set enable bit for all channels.
 	 * We will control state with PWM registers alone.
@@ -324,6 +352,192 @@ static int is31fl32xx_init_regs(struct is31fl32xx_priv *priv)
 	return 0;
 }
 
+/*
+ * LibreEcho's userspace renders the 12 RGB pixels atomically.  Keep this
+ * board-specific interface on the I2C device while retaining the standard
+ * per-channel LED class interface for DTs that describe child LEDs.
+ *
+ * Each IS31FL3236 output also has a current setting in its LED control
+ * register (SL bits: Imax, Imax/2, Imax/3, Imax/4).  The 8-bit PWM alone gives
+ * only a couple of usable steps at sleep-light brightness, so the scaled frame
+ * lets userspace pick PWM and current together per channel.  The chip latches
+ * PWM and LED control registers on the same Update write, so a scale change
+ * never shows a mismatched intermediate frame.
+ */
+#define IS31FL3236_CTRL_OUT_ON		BIT(0)
+#define IS31FL3236_CTRL_SL_SHIFT	1
+#define IS31FL3236_SCALE_MAX		3
+
+static int is31fl3236_update_frame(struct is31fl32xx_priv *priv,
+				   const u8 *frame, const u8 *scale)
+{
+	const struct is31fl32xx_chipdef *cdef = priv->cdef;
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(priv->frame); i++) {
+		u8 channel = (i + priv->channel_offset) % ARRAY_SIZE(priv->frame);
+
+		if (priv->scale_valid && priv->scale[i] == scale[i])
+			continue;
+		/* Until the Update write lands the cache no longer matches. */
+		priv->scale_valid = false;
+		ret = is31fl32xx_write(priv,
+				       cdef->led_control_register_base + channel,
+				       IS31FL3236_CTRL_OUT_ON |
+				       (scale[i] << IS31FL3236_CTRL_SL_SHIFT));
+		if (ret)
+			return ret;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(priv->frame); i++) {
+		u8 channel = (i + priv->channel_offset) % ARRAY_SIZE(priv->frame);
+
+		ret = is31fl32xx_write(priv,
+				       cdef->pwm_register_base + channel,
+				       frame[i]);
+		if (ret)
+			return ret;
+	}
+
+	ret = is31fl32xx_write(priv, cdef->pwm_update_reg, 0);
+	if (ret)
+		return ret;
+	memcpy(priv->frame, frame, sizeof(priv->frame));
+	memcpy(priv->scale, scale, sizeof(priv->scale));
+	priv->scale_valid = true;
+	return 0;
+}
+
+static ssize_t frame_show(struct device *dev, struct device_attribute *attr,
+			  char *buf)
+{
+	struct is31fl32xx_priv *priv = dev_get_drvdata(dev);
+	ssize_t len;
+
+	mutex_lock(&priv->frame_lock);
+	bin2hex(buf, priv->frame, sizeof(priv->frame));
+	len = sizeof(priv->frame) * 2;
+	buf[len++] = '\n';
+	buf[len] = '\0';
+	mutex_unlock(&priv->frame_lock);
+	return len;
+}
+
+/* Parse exactly @len bytes of hex, allowing one trailing newline. */
+static int is31fl3236_parse_hex(const char *buf, size_t count, u8 *out,
+				size_t len)
+{
+	size_t hex_len = count;
+
+	if (hex_len && buf[hex_len - 1] == '\n')
+		hex_len--;
+	if (hex_len != len * 2)
+		return -EINVAL;
+	return hex2bin(out, buf, len);
+}
+
+/* Legacy 36-byte PWM frame: every channel at full current. */
+static ssize_t frame_store(struct device *dev, struct device_attribute *attr,
+			   const char *buf, size_t count)
+{
+	struct is31fl32xx_priv *priv = dev_get_drvdata(dev);
+	u8 frame[ARRAY_SIZE(priv->frame)];
+	static const u8 full[ARRAY_SIZE(priv->scale)];
+	int ret;
+
+	ret = is31fl3236_parse_hex(buf, count, frame, sizeof(frame));
+	if (ret)
+		return ret;
+
+	mutex_lock(&priv->frame_lock);
+	ret = is31fl3236_update_frame(priv, frame, full);
+	mutex_unlock(&priv->frame_lock);
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_RW(frame);
+
+/*
+ * scaled_frame: 36 PWM bytes followed by 36 current-scale bytes, as 144 hex
+ * characters.  Scale n drives the channel at Imax/(n+1), n = 0..3.
+ */
+static ssize_t scaled_frame_show(struct device *dev,
+				 struct device_attribute *attr, char *buf)
+{
+	struct is31fl32xx_priv *priv = dev_get_drvdata(dev);
+	ssize_t len;
+
+	mutex_lock(&priv->frame_lock);
+	bin2hex(buf, priv->frame, sizeof(priv->frame));
+	len = sizeof(priv->frame) * 2;
+	bin2hex(buf + len, priv->scale, sizeof(priv->scale));
+	len += sizeof(priv->scale) * 2;
+	buf[len++] = '\n';
+	buf[len] = '\0';
+	mutex_unlock(&priv->frame_lock);
+	return len;
+}
+
+static ssize_t scaled_frame_store(struct device *dev,
+				  struct device_attribute *attr,
+				  const char *buf, size_t count)
+{
+	struct is31fl32xx_priv *priv = dev_get_drvdata(dev);
+	u8 data[ARRAY_SIZE(priv->frame) + ARRAY_SIZE(priv->scale)];
+	const u8 *scale = data + ARRAY_SIZE(priv->frame);
+	unsigned int i;
+	int ret;
+
+	ret = is31fl3236_parse_hex(buf, count, data, sizeof(data));
+	if (ret)
+		return ret;
+	for (i = 0; i < ARRAY_SIZE(priv->scale); i++)
+		if (scale[i] > IS31FL3236_SCALE_MAX)
+			return -EINVAL;
+
+	mutex_lock(&priv->frame_lock);
+	ret = is31fl3236_update_frame(priv, data, scale);
+	mutex_unlock(&priv->frame_lock);
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_RW(scaled_frame);
+
+static ssize_t boot_animation_show(struct device *dev,
+				   struct device_attribute *attr, char *buf)
+{
+	struct is31fl32xx_priv *priv = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%u\n", priv->boot_animation);
+}
+
+static ssize_t boot_animation_store(struct device *dev,
+				    struct device_attribute *attr,
+				    const char *buf, size_t count)
+{
+	struct is31fl32xx_priv *priv = dev_get_drvdata(dev);
+	bool enabled;
+	int ret;
+
+	ret = kstrtobool(buf, &enabled);
+	if (ret)
+		return ret;
+	/* Userspace claims the ring by writing 0 before its first frame. */
+	priv->boot_animation = enabled;
+	return count;
+}
+static DEVICE_ATTR_RW(boot_animation);
+
+static struct attribute *is31fl3236_attrs[] = {
+	&dev_attr_frame.attr,
+	&dev_attr_scaled_frame.attr,
+	&dev_attr_boot_animation.attr,
+	NULL,
+};
+
+static const struct attribute_group is31fl3236_attr_group = {
+	.attrs = is31fl3236_attrs,
+};
+
 static int is31fl32xx_parse_child_dt(const struct device *dev,
 				     const struct device_node *child,
 				     struct is31fl32xx_led_data *led_data)
@@ -426,7 +640,7 @@ static int is31fl32xx_probe(struct i2c_client *client)
 	cdef = device_get_match_data(dev);
 
 	count = of_get_available_child_count(dev_of_node(dev));
-	if (!count)
+	if (!count && cdef != &is31fl3236_cdef)
 		return -EINVAL;
 
 	priv = devm_kzalloc(dev, struct_size(priv, leds, count),
@@ -436,6 +650,15 @@ static int is31fl32xx_probe(struct i2c_client *client)
 
 	priv->client = client;
 	priv->cdef = cdef;
+	mutex_init(&priv->frame_lock);
+	if (cdef == &is31fl3236_cdef) {
+		of_property_read_u8(dev_of_node(dev), "channel-offset",
+				    &priv->channel_offset);
+		priv->channel_offset %= ARRAY_SIZE(priv->frame);
+		priv->boot_animation =
+			of_property_read_bool(dev_of_node(dev),
+					      "play-boot-animation");
+	}
 	i2c_set_clientdata(client, priv);
 
 	ret = is31fl32xx_init_regs(priv);
@@ -446,6 +669,14 @@ static int is31fl32xx_probe(struct i2c_client *client)
 	if (ret)
 		return ret;
 
+	if (cdef == &is31fl3236_cdef) {
+		ret = devm_device_add_group(dev, &is31fl3236_attr_group);
+		if (ret)
+			return ret;
+		dev_info(dev,
+			 "36-channel atomic frame interface ready\n");
+	}
+
 	return 0;
 }
 
diff --git a/drivers/leds/leds-lp55xx-common.c b/drivers/leds/leds-lp55xx-common.c
index fd447eb7e..2c215a4a8 100644
--- a/drivers/leds/leds-lp55xx-common.c
+++ b/drivers/leds/leds-lp55xx-common.c
@@ -19,6 +19,7 @@
 #include <linux/leds.h>
 #include <linux/module.h>
 #include <linux/platform_data/leds-lp55xx.h>
+#include <linux/regulator/consumer.h>
 #include <linux/slab.h>
 #include <linux/gpio/consumer.h>
 #include <dt-bindings/leds/leds-lp55xx.h>
@@ -989,6 +990,9 @@ static void lp55xx_deinit_device(struct lp55xx_chip *chip)
 
 	if (pdata->enable_gpiod)
 		gpiod_set_value(pdata->enable_gpiod, 0);
+
+	if (chip->vdd)
+		regulator_disable(chip->vdd);
 }
 
 static int lp55xx_init_device(struct lp55xx_chip *chip)
@@ -1006,6 +1010,22 @@ static int lp55xx_init_device(struct lp55xx_chip *chip)
 	if (!pdata || !cfg)
 		return -EINVAL;
 
+	chip->vdd = devm_regulator_get_optional(dev, "vdd");
+	if (IS_ERR(chip->vdd)) {
+		ret = PTR_ERR(chip->vdd);
+		if (ret == -ENODEV)
+			chip->vdd = NULL;
+		else
+			return dev_err_probe(dev, ret,
+					     "failed to get VDD supply\n");
+	}
+	if (chip->vdd) {
+		ret = regulator_enable(chip->vdd);
+		if (ret)
+			return dev_err_probe(dev, ret,
+					     "failed to enable VDD supply\n");
+	}
+
 	if (pdata->enable_gpiod) {
 		gpiod_direction_output(pdata->enable_gpiod, 0);
 
@@ -1027,7 +1047,7 @@ static int lp55xx_init_device(struct lp55xx_chip *chip)
 	ret = lp55xx_detect_device(chip);
 	if (ret) {
 		dev_err(dev, "device detection err: %d\n", ret);
-		goto err;
+		goto err_supply;
 	}
 
 	/* chip specific initialization */
@@ -1041,7 +1061,10 @@ static int lp55xx_init_device(struct lp55xx_chip *chip)
 
 err_post_init:
 	lp55xx_deinit_device(chip);
-err:
+	return ret;
+err_supply:
+	if (chip->vdd)
+		regulator_disable(chip->vdd);
 	return ret;
 }
 
diff --git a/drivers/leds/leds-lp55xx-common.h b/drivers/leds/leds-lp55xx-common.h
index 8fd64ec40..3471d5b27 100644
--- a/drivers/leds/leds-lp55xx-common.h
+++ b/drivers/leds/leds-lp55xx-common.h
@@ -96,6 +96,7 @@ static LP55XX_DEV_ATTR_RW(master_fader##nr, show_master_fader##nr,	\
 
 struct lp55xx_led;
 struct lp55xx_chip;
+struct regulator;
 
 /*
  * struct lp55xx_reg
@@ -190,6 +191,7 @@ struct lp55xx_engine {
  * @engine_idx : Selected engine number
  * @engines    : Engine structure for the device attribute R/W interface
  * @fw         : Firmware data for running a LED pattern
+ * @vdd        : Optional shared hardware-enable/supply regulator
  */
 struct lp55xx_chip {
 	struct i2c_client *cl;
@@ -200,6 +202,7 @@ struct lp55xx_chip {
 	enum lp55xx_engine_index engine_idx;
 	struct lp55xx_engine engines[LP55XX_ENGINE_MAX];
 	const struct firmware *fw;
+	struct regulator *vdd;
 };
 
 /*
