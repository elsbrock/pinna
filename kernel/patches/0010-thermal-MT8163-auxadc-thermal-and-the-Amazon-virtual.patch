@@ -1133,6 +1193,10 @@ static int mtk_thermal_get_calibration_data(struct device *dev,
 }
 
 static const struct of_device_id mtk_thermal_of_match[] = {
+	{
+		.compatible = "mediatek,mt8163-thermal",
+		.data = (void *)&mt8163_thermal_data,
