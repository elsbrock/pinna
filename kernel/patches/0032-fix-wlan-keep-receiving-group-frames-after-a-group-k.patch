From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Simon Elsbrock <simon@iodev.org>
Date: Sat, 21 Nov 2026 00:56:29 +0100
Subject: [PATCH 32/32] fix(wlan): keep receiving group frames after a group key
 rekey

The MT8163 Wi-Fi firmware keeps its group replay counter when a new
group key (GTK) goes in. An access point that restarts the packet number
with every new GTK, such as a FRITZ!Box that rekeys every 600 s, then
has every group frame dropped as a replay: broadcasts and multicast,
including ARP, DHCP and mDNS, until the station reassociates. Every
reassociation also loses the firmware's multicast filter, which the
driver sends only from ndo_set_rx_mode.

TECHO5 measured both on an Echo Dot (2nd gen) with the same firmware
(WIFI_RAM_CODE_8163): IPv4 broadcasts fell from 7-15 per 30 s to 0
after each rekey, and multicast fell from 76 to 3 per minute after a
reassociation (techo5-dot issue #45). Pinna's driver has the same code:
mtk_cfg80211_add_key is the vendor's, unchanged since the import.

This ports TECHO5's fix (techo5-dot PR #49,
tools/linux/kernel-patches/0049-wlan-group-key-rekey.patch, MIT) from
Amazon's Linux 3.18 to 6.12:

- Before a GTK from a rekey goes in, remove the other group key slots,
  so the group key table is empty for a moment.
- Install that GTK again 10 s and 20 s later: in a few percent of the
  rekeys the old key's counter survives the first step. A
  (re)association, a disconnection or any other key operation drops the
  pending install.
- Send the multicast filter again once the first GTK after a pairwise
  key is in.

Only the station's add_key changes; the setup hotspot goes through
mtk_p2p_cfg80211_add_key. Differences from the 3.18 patch: the driver
path, the link_id argument and the offsetof key length that the import
already had. On 6.12, cfg80211 calls add_key and del_key with the wiphy
mutex held, so cancel_delayed_work_sync waits under it. That is safe:
the work takes neither the wiphy mutex nor the RTNL, and kalIoctl waits
only for the driver's tx thread, which doesn't take them either. The one
cfg80211 call in the driver that takes the wiphy mutex,
cfg80211_sched_scan_stopped, already runs from its own work item.

Built for the device. Not run on a device.
---
 .../mt_wifi/wlan/os/linux/gl_cfg80211.c       | 161 ++++++++++++++++++
 .../drv_wlan/mt_wifi/wlan/os/linux/gl_init.c  |   1 +
 .../drv_wlan/mt_wifi/wlan/os/linux/gl_kal.c   |   2 +
 .../mt_wifi/wlan/os/linux/include/gl_kal.h    |   3 +
 4 files changed, 167 insertions(+)

diff --git a/drivers/misc/mediatek/mt8163-connectivity/conn_soc/drv_wlan/mt_wifi/wlan/os/linux/gl_cfg80211.c b/drivers/misc/mediatek/mt8163-connectivity/conn_soc/drv_wlan/mt_wifi/wlan/os/linux/gl_cfg80211.c
index 8a6afc19c..e3202ec88 100644
--- a/drivers/misc/mediatek/mt8163-connectivity/conn_soc/drv_wlan/mt_wifi/wlan/os/linux/gl_cfg80211.c
+++ b/drivers/misc/mediatek/mt8163-connectivity/conn_soc/drv_wlan/mt_wifi/wlan/os/linux/gl_cfg80211.c
@@ -157,6 +157,106 @@ mtk_cfg80211_change_iface(struct wiphy *wiphy,
 	return 0;
 }
 
+/* Slot of the GTK installed last, 0xff after a pairwise key (new association). */
+static UINT_8 gucLastGroupKeyId = 0xff;
+
+/* Second install of a rekey GTK. In a few percent of the rekeys the hardware keeps the group replay
+ * counter of the old GTK although the group key table was empty when the new GTK went in, and drops
+ * every group frame until the PN of the new GTK passes that value (about one rekey interval). Some
+ * seconds later the AP sends with the new GTK only: removing and installing it once more then resets
+ * the counter, and if that fails as well the counter can only stay at a PN of the new GTK, which the
+ * next group frames pass. Every other key operation, (dis)connection or roaming drops the pending
+ * install. Downside: after the second install, group frames received since the rekey can be replayed
+ * once until the next group frame arrives.
+ */
+#define GTK_REINSTALL_DELAY_MS 10000
+#define GTK_REINSTALL_COUNT 2
+
+static void gtkReinstallWorkQueue(struct work_struct *work);
+static DECLARE_DELAYED_WORK(grGtkReinstallWork, gtkReinstallWorkQueue);
+static PARAM_KEY_T rGtkReinstallKey;
+static P_GLUE_INFO_T prGtkReinstallGlue;
+static atomic_t rGtkKeyGeneration = ATOMIC_INIT(0);
+static int i4GtkReinstallGeneration;
+static UINT_8 ucGtkReinstallLeft;
+static BOOLEAN fgGtkReinstallRetried;
+
+/* drop a pending second install; called from (dis)connection and roaming in the tx thread */
+VOID mtk_cfg80211_gtk_reinstall_invalidate(VOID)
+{
+	atomic_inc(&rGtkKeyGeneration);
+}
+
+/* Drop a pending second install and wait for a running one; not from the tx thread, which the work
+ * waits for in kalIoctl. cfg80211 calls add_key and del_key with the wiphy mutex held. Waiting here
+ * is safe because the work takes neither the wiphy mutex nor the RTNL, and neither does the tx thread
+ * while it serves kalIoctl.
+ */
+VOID mtk_cfg80211_gtk_reinstall_cancel(VOID)
+{
+	atomic_inc(&rGtkKeyGeneration);
+	cancel_delayed_work_sync(&grGtkReinstallWork);
+	kalMemZero(&rGtkReinstallKey, sizeof(PARAM_KEY_T));
+}
+
+static void gtkReinstallWorkQueue(struct work_struct *work)
+{
+	P_GLUE_INFO_T prGlueInfo = prGtkReinstallGlue;
+	PARAM_REMOVE_KEY_T rRemoveKey;
+	WLAN_STATUS rStatus;
+	UINT_32 u4Len = 0;
+	UINT_8 ucKeyId = (UINT_8) (rGtkReinstallKey.u4KeyIndex & 0xff);
+	UINT_8 i, ucId;
+
+	down(&g_halt_sem);
+	if (g_u4HaltFlag) {
+		up(&g_halt_sem);
+		goto out;
+	}
+	up(&g_halt_sem);
+
+	if (!prGlueInfo || atomic_read(&rGtkKeyGeneration) != i4GtkReinstallGeneration ||
+	    prGlueInfo->eParamMediaStateIndicated != PARAM_MEDIA_STATE_CONNECTED)
+		goto out;
+
+	/* empty the group key table as before the first install, the slot of this GTK last */
+	for (i = 1; i <= 4; i++) {
+		ucId = (ucKeyId + i) % 4;
+		kalMemZero(&rRemoveKey, sizeof(PARAM_REMOVE_KEY_T));
+		rRemoveKey.u4Length = sizeof(PARAM_REMOVE_KEY_T);
+		rRemoveKey.u4KeyIndex = ucId;
+		COPY_MAC_ADDR(rRemoveKey.arBSSID, rGtkReinstallKey.arBSSID);
+		rStatus = kalIoctl(prGlueInfo, wlanoidSetRemoveKey, &rRemoveKey, rRemoveKey.u4Length,
+				   FALSE, FALSE, TRUE, FALSE, &u4Len);
+		if (rStatus != WLAN_STATUS_SUCCESS) {
+			DBGLOG(RSN, WARN, "group key %u not installed again, removing key %u failed: %x\n",
+			       ucKeyId, ucId, rStatus);
+			goto out;
+		}
+	}
+
+	rStatus = kalIoctl(prGlueInfo, wlanoidSetAddKey, &rGtkReinstallKey, rGtkReinstallKey.u4Length,
+			   FALSE, FALSE, TRUE, FALSE, &u4Len);
+	if (rStatus != WLAN_STATUS_SUCCESS) {
+		DBGLOG(RSN, WARN, "installing group key %u again failed: %x\n", ucKeyId, rStatus);
+		if (!fgGtkReinstallRetried) {
+			fgGtkReinstallRetried = TRUE;
+			schedule_delayed_work(&grGtkReinstallWork, msecs_to_jiffies(1000));
+			return;
+		}
+		goto out;
+	}
+	DBGLOG(RSN, INFO, "group key %u installed again\n", ucKeyId);
+
+	if (--ucGtkReinstallLeft > 0) {
+		schedule_delayed_work(&grGtkReinstallWork, msecs_to_jiffies(GTK_REINSTALL_DELAY_MS));
+		return;
+	}
+
+out:
+	kalMemZero(&rGtkReinstallKey, sizeof(PARAM_KEY_T));
+}
+
 /*----------------------------------------------------------------------------*/
 /*!
  * @brief This routine is responsible for adding key
@@ -180,6 +280,9 @@ mtk_cfg80211_add_key(struct wiphy *wiphy,
 	UINT_32 u4BufLen = 0;
 	UINT_8 tmp1[8];
 	UINT_8 tmp2[8];
+	BOOLEAN fgGtk;
+	BOOLEAN fgFirstGroupKey = FALSE;
+	BOOLEAN fgRekeyGroupKey = FALSE;
 
 	prGlueInfo = (P_GLUE_INFO_T) wiphy_priv(wiphy);
 	ASSERT(prGlueInfo);
@@ -215,6 +318,15 @@ mtk_cfg80211_add_key(struct wiphy *wiphy,
 		/* rKey.u4KeyIndex |= BIT(31);//Enable BIT 31 will make tx use bc key id,should use pairwise key id 0 */
 	}
 
+	/* Only a GTK (slot 0 to 3, TKIP or CCMP) takes part in the group rekey handling below. Any other
+	 * group key, such as an IGTK in slot 4 or 5 right after the GTK when PMF is on, neither removes
+	 * group key slots nor drops a pending second install.
+	 */
+	fgGtk = !(rKey.u4KeyIndex & BIT(31)) && key_index < 4 &&
+		(params->cipher == WLAN_CIPHER_SUITE_TKIP || params->cipher == WLAN_CIPHER_SUITE_CCMP);
+	if ((rKey.u4KeyIndex & BIT(31)) || fgGtk)
+		mtk_cfg80211_gtk_reinstall_cancel();
+
 	if (params->key) {
 		/* rKey.aucKeyMaterial[0] = kalMemAlloc(params->key_len, VIR_MEM_TYPE); */
 		kalMemCopy(rKey.aucKeyMaterial, params->key, params->key_len);
@@ -230,11 +342,58 @@ mtk_cfg80211_add_key(struct wiphy *wiphy,
 	rKey.u4Length = offsetof(PARAM_KEY_T, aucKeyMaterial) +
 			rKey.u4KeyLength;
 
+	/* The hardware keeps a group replay counter that a new GTK does not reset, while the AP restarts
+	 * the PN at 0 with each new GTK, so every group frame would be dropped after a group rekey. Before
+	 * a GTK from a group rekey goes in, remove every other group key slot, so the group key table is
+	 * empty for a moment. Nothing is removed for the first GTK after a PTK (a new association).
+	 */
+	if (rKey.u4KeyIndex & BIT(31)) {
+		gucLastGroupKeyId = 0xff;
+	} else if (fgGtk) {
+		fgRekeyGroupKey = (gucLastGroupKeyId != 0xff);
+		if (fgRekeyGroupKey) {
+			PARAM_REMOVE_KEY_T rRemoveKey;
+			UINT_32 u4RemoveLen = 0;
+			UINT_8 ucId;
+
+			for (ucId = 0; ucId < 4; ucId++) {
+				if (ucId == key_index)
+					continue;
+				kalMemZero(&rRemoveKey, sizeof(PARAM_REMOVE_KEY_T));
+				rRemoveKey.u4Length = sizeof(PARAM_REMOVE_KEY_T);
+				rRemoveKey.u4KeyIndex = ucId;
+				COPY_MAC_ADDR(rRemoveKey.arBSSID, rKey.arBSSID);
+				kalIoctl(prGlueInfo, wlanoidSetRemoveKey, &rRemoveKey, rRemoveKey.u4Length,
+					 FALSE, FALSE, TRUE, FALSE, &u4RemoveLen);
+			}
+			DBGLOG(RSN, INFO, "group keys other than %u removed before adding it\n", key_index);
+		}
+		fgFirstGroupKey = (gucLastGroupKeyId == 0xff);
+		gucLastGroupKeyId = key_index;
+	}
+
 	rStatus = kalIoctl(prGlueInfo, wlanoidSetAddKey, &rKey, rKey.u4Length, FALSE, FALSE, TRUE, FALSE, &u4BufLen);
 
 	if (rStatus == WLAN_STATUS_SUCCESS)
 		i4Rslt = 0;
 
+	if (fgRekeyGroupKey && i4Rslt == 0) {
+		rGtkReinstallKey = rKey;
+		prGtkReinstallGlue = prGlueInfo;
+		i4GtkReinstallGeneration = atomic_read(&rGtkKeyGeneration);
+		ucGtkReinstallLeft = GTK_REINSTALL_COUNT;
+		fgGtkReinstallRetried = FALSE;
+		schedule_delayed_work(&grGtkReinstallWork, msecs_to_jiffies(GTK_REINSTALL_DELAY_MS));
+	}
+
+	/* The firmware loses the multicast filter on every (re)association, and the driver only sends it
+	 * from ndo_set_rx_mode. Send it again once the handshake has installed the first group key: then
+	 * multicast (mDNS, router adverts) is not filtered out after a reassociation or roaming.
+	 * wlanSetMulticastList only schedules the work that sends it, so it is safe to call here.
+	 */
+	if (fgFirstGroupKey && ndev->netdev_ops->ndo_set_rx_mode)
+		ndev->netdev_ops->ndo_set_rx_mode(ndev);
+
 	return i4Rslt;
 }
 
@@ -290,6 +449,8 @@ int mtk_cfg80211_del_key(struct wiphy *wiphy, struct net_device *ndev,
 	prGlueInfo = (P_GLUE_INFO_T) wiphy_priv(wiphy);
 	ASSERT(prGlueInfo);
 
+	mtk_cfg80211_gtk_reinstall_cancel();
+
 	kalMemZero(&rRemoveKey, sizeof(PARAM_REMOVE_KEY_T));
 	if (mac_addr)
 		COPY_MAC_ADDR(rRemoveKey.arBSSID, mac_addr);
diff --git a/drivers/misc/mediatek/mt8163-connectivity/conn_soc/drv_wlan/mt_wifi/wlan/os/linux/gl_init.c b/drivers/misc/mediatek/mt8163-connectivity/conn_soc/drv_wlan/mt_wifi/wlan/os/linux/gl_init.c
index 5c5c4d92a..e83188831 100644
--- a/drivers/misc/mediatek/mt8163-connectivity/conn_soc/drv_wlan/mt_wifi/wlan/os/linux/gl_init.c
+++ b/drivers/misc/mediatek/mt8163-connectivity/conn_soc/drv_wlan/mt_wifi/wlan/os/linux/gl_init.c
@@ -4243,6 +4243,7 @@ static VOID wlanRemove(VOID)
 	}
 
 	flush_delayed_work(&sched_workq);
+	mtk_cfg80211_gtk_reinstall_cancel();
 
 	DBGLOG(INIT, INFO, "down g_halt_sem...\n");
 	down(&g_halt_sem);
diff --git a/drivers/misc/mediatek/mt8163-connectivity/conn_soc/drv_wlan/mt_wifi/wlan/os/linux/gl_kal.c b/drivers/misc/mediatek/mt8163-connectivity/conn_soc/drv_wlan/mt_wifi/wlan/os/linux/gl_kal.c
index f118f069e..e083c4f39 100644
--- a/drivers/misc/mediatek/mt8163-connectivity/conn_soc/drv_wlan/mt_wifi/wlan/os/linux/gl_kal.c
+++ b/drivers/misc/mediatek/mt8163-connectivity/conn_soc/drv_wlan/mt_wifi/wlan/os/linux/gl_kal.c
@@ -1662,6 +1662,7 @@ kalIndicateStatusAndComplete(IN P_GLUE_INFO_T prGlueInfo, IN WLAN_STATUS eStatus
 	case WLAN_STATUS_MEDIA_CONNECT:
 
 		prGlueInfo->eParamMediaStateIndicated = PARAM_MEDIA_STATE_CONNECTED;
+		mtk_cfg80211_gtk_reinstall_invalidate();
 
 		/* indicate assoc event */
 		wlanQueryInformation(prGlueInfo->prAdapter, wlanoidQueryBssid, &arBssid[0], sizeof(arBssid), &bufLen);
@@ -1780,6 +1781,7 @@ kalIndicateStatusAndComplete(IN P_GLUE_INFO_T prGlueInfo, IN WLAN_STATUS eStatus
 		}
 
 		prGlueInfo->eParamMediaStateIndicated = PARAM_MEDIA_STATE_DISCONNECTED;
+		mtk_cfg80211_gtk_reinstall_invalidate();
 
 		break;
 
diff --git a/drivers/misc/mediatek/mt8163-connectivity/conn_soc/drv_wlan/mt_wifi/wlan/os/linux/include/gl_kal.h b/drivers/misc/mediatek/mt8163-connectivity/conn_soc/drv_wlan/mt_wifi/wlan/os/linux/include/gl_kal.h
index 678de5962..67e94ca67 100644
--- a/drivers/misc/mediatek/mt8163-connectivity/conn_soc/drv_wlan/mt_wifi/wlan/os/linux/include/gl_kal.h
+++ b/drivers/misc/mediatek/mt8163-connectivity/conn_soc/drv_wlan/mt_wifi/wlan/os/linux/include/gl_kal.h
@@ -567,6 +567,9 @@ extern UINT_32 u4MemAllocCnt, u4MemFreeCnt;
 extern struct semaphore g_halt_sem;
 extern int g_u4HaltFlag;
 
+VOID mtk_cfg80211_gtk_reinstall_invalidate(VOID);
+VOID mtk_cfg80211_gtk_reinstall_cancel(VOID);
+
 extern struct delayed_work sched_workq;
 
 #if defined(MT6620) && CFG_MULTI_ECOVER_SUPPORT
-- 
