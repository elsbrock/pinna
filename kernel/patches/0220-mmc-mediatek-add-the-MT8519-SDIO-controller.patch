From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Simon Elsbrock <simon@iodev.org>
Date: Tue, 24 Nov 2026 19:30:00 +0100
Subject: [PATCH] mmc: mediatek: add the MT8519 SDIO controller

Use the MT8519 controller data from Amazon's 5.4 mtk-sdio driver. The
board already supplies both register regions, clocks and SDIO capabilities;
its compatible previously had no host match.

Mainline selects combined command/data tuning from async_fifo and data_tune,
and the board's no-mmc selects the 64-step delay range. Its initial patch
register value also preserves the BSP's disabled v3_plus behavior. These
paths provide the three BSP-specific tuning flags without changing existing
SoCs or introducing another tuning implementation.

Source: Echo_Dot_5th_Gen_src-6.5.7.1-20251027, mtk-sdio.{c,h}.
---
diff --git a/drivers/mmc/host/mtk-sd.c b/drivers/mmc/host/mtk-sd.c
--- a/drivers/mmc/host/mtk-sd.c
+++ b/drivers/mmc/host/mtk-sd.c
@@ -639,6 +639,19 @@
 	.stop_clk_fix = true,
 };
 
+static const struct mtk_mmc_compatible mt8519_compat = {
+	.clk_div_bits = 12,
+	.recheck_sdio_irq = false,
+	.hs400_tune = false,
+	.pad_tune_reg = MSDC_PAD_TUNE0,
+	.async_fifo = true,
+	.data_tune = true,
+	.busy_check = true,
+	.stop_clk_fix = true,
+	.enhance_rx = true,
+	.support_64g = false,
+};
+
 static const struct of_device_id msdc_of_ids[] = {
 	{ .compatible = "mediatek,mt2701-mmc", .data = &mt2701_compat},
 	{ .compatible = "mediatek,mt2712-mmc", .data = &mt2712_compat},
@@ -652,6 +665,7 @@
 	{ .compatible = "mediatek,mt8173-mmc", .data = &mt8173_compat},
 	{ .compatible = "mediatek,mt8183-mmc", .data = &mt8183_compat},
 	{ .compatible = "mediatek,mt8516-mmc", .data = &mt8516_compat},
+	{ .compatible = "mediatek,mt8519-sdio", .data = &mt8519_compat},
 
 	{}
 };
diff --git a/Documentation/devicetree/bindings/mmc/mtk-sd.yaml b/Documentation/devicetree/bindings/mmc/mtk-sd.yaml
--- a/Documentation/devicetree/bindings/mmc/mtk-sd.yaml
+++ b/Documentation/devicetree/bindings/mmc/mtk-sd.yaml
@@ -25,6 +25,7 @@
           - mediatek,mt8173-mmc
           - mediatek,mt8183-mmc
           - mediatek,mt8516-mmc
+          - mediatek,mt8519-sdio
       - items:
           - const: mediatek,mt7623-mmc
           - const: mediatek,mt2701-mmc
@@ -41,7 +42,7 @@
     minItems: 1
     items:
       - description: base register (required).
-      - description: top base register (required for MT8183).
+      - description: top base register (required for MT8183 and MT8519).
 
   clocks:
     description:
@@ -191,6 +192,7 @@
             - mediatek,mt8188-mmc
             - mediatek,mt8195-mmc
             - mediatek,mt8516-mmc
+            - mediatek,mt8519-sdio
     then:
       properties:
         clocks:
@@ -232,7 +234,9 @@
       properties:
         compatible:
           contains:
-            const: mediatek,mt8183-mmc
+            enum:
+              - mediatek,mt8183-mmc
+              - mediatek,mt8519-sdio
     then:
       properties:
         reg:
