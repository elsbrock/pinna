From 2fb701662bfcffcb07a84823ec93314bc5cb80f8 Mon Sep 17 00:00:00 2001
From: Simon Elsbrock <simon@iodev.org>
Date: Sun, 15 Nov 2026 12:05:47 +0100
Subject: [PATCH 5/9] fix(wlan): deliver RX frames to the stack in order

kalRxIndicatePkts() hands each frame to netif_rx_ni(), which the 6.1
compat header maps to netif_rx(). On 3.18, netif_rx_ni() ran the
NET_RX softirq inline before returning, so every frame reached TCP
before the next one was queued. On 6.1, netif_rx() only queues to the
current CPU's backlog; local_bh_enable() then leaves the backlog to
ksoftirqd whenever ksoftirqd is runnable on that CPU (softirq.c,
ksoftirqd_running(), added in 4.9). The driver main thread is not
pinned, so the next batch can be queued on another CPU and processed
first. TCP sees those frames out of order, sends SACKs, and the sender
retransmits and shrinks its window. ICMP does not care about order,
which fits ping working while TCP downloads collapse with about half
the segments out of order.

Deliver each batch with netif_receive_skb() under local_bh_disable(),
the way mac80211's ieee80211_rx_ni() does: frames reach the stack
synchronously, in the order the reorder queue released them, on
whatever CPU the thread runs on. Fall back to netif_rx() if ever
called with interrupts disabled.

The ECHO_WLAN_RXSTAT "ind" line from the previous patch shows how
often batches changed CPU and how often ksoftirqd was runnable.
---
 .../drv_wlan/mt_wifi/wlan/os/linux/gl_kal.c   | 27 ++++++++++++++-----
 1 file changed, 21 insertions(+), 6 deletions(-)

diff --git a/drivers/misc/mediatek/mt8163-connectivity/conn_soc/drv_wlan/mt_wifi/wlan/os/linux/gl_kal.c b/drivers/misc/mediatek/mt8163-connectivity/conn_soc/drv_wlan/mt_wifi/wlan/os/linux/gl_kal.c
index 1378b9284..f118f069e 100644
--- a/drivers/misc/mediatek/mt8163-connectivity/conn_soc/drv_wlan/mt_wifi/wlan/os/linux/gl_kal.c
+++ b/drivers/misc/mediatek/mt8163-connectivity/conn_soc/drv_wlan/mt_wifi/wlan/os/linux/gl_kal.c
@@ -1472,6 +1472,7 @@ WLAN_STATUS kalRxIndicatePkts(IN P_GLUE_INFO_T prGlueInfo, IN PVOID apvPkts[], I
 	UINT_8 ucIdx = 0;
 	struct net_device *prNetDev = prGlueInfo->prDevHandler;
 	struct sk_buff *prSkb = NULL;
+	BOOLEAN fgSync;
 
 	ASSERT(prGlueInfo);
 	ASSERT(apvPkts);
@@ -1501,6 +1502,19 @@ WLAN_STATUS kalRxIndicatePkts(IN P_GLUE_INFO_T prGlueInfo, IN PVOID apvPkts[], I
 		put_cpu();
 	}
 
+	/*
+	 * Hand the frames to the stack synchronously, in the order the reorder
+	 * queue released them.  netif_rx() only queues to this CPU's backlog;
+	 * since 4.9 local_bh_enable() leaves that backlog to ksoftirqd while it
+	 * is runnable, and this thread may run on another CPU for the next
+	 * batch, whose backlog is processed first.  TCP then sees the batches
+	 * out of order (3.18's netif_rx_ni() always ran the softirq inline).
+	 * mac80211 delivers the same way (ieee80211_rx_ni()).
+	 */
+	fgSync = !in_hardirq() && !irqs_disabled();
+	if (fgSync)
+		local_bh_disable();
+
 	for (ucIdx = 0; ucIdx < ucPktNum; ucIdx++) {
 		prSkb = apvPkts[ucIdx];
 #if DBG
@@ -1593,16 +1607,17 @@ WLAN_STATUS kalRxIndicatePkts(IN P_GLUE_INFO_T prGlueInfo, IN PVOID apvPkts[], I
 #endif
 
 
-		if (!in_interrupt()) {
-			glIndicateWoWPacket(prSkb);
-			netif_rx_ni(prSkb);	/* only in non-interrupt context */
-		} else {
-			glIndicateWoWPacket(prSkb);
+		glIndicateWoWPacket(prSkb);
+		if (fgSync)
+			netif_receive_skb(prSkb);
+		else
 			netif_rx(prSkb);
-		}
 		wlanReturnPacket(prGlueInfo->prAdapter, NULL);
 	}
 
+	if (fgSync)
+		local_bh_enable();
+
 	return WLAN_STATUS_SUCCESS;
 }
 
