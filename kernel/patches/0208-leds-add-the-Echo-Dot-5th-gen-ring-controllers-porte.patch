+static ssize_t global_current_store(struct device *dev,
+					struct device_attribute *attr,
+					const char *buf,
+					size_t len)
+{
+	struct aw210xx *priv = i2c_get_clientdata(to_i2c_client(dev));
+	uint8_t val;
+	ssize_t ret;
+
+	ret = kstrtou8(buf, 10, &val);
+	if (ret) {
+		dev_err(dev, "AW210xx: Invalid input to store GCCR\n");
+		return ret;
+	}
+	if (val < 0 || val > 255) {
+		dev_err(dev, "AW210xx: Invalid input to store GCCR\n");
+		ret = -EINVAL;
+		return ret;
+	}
+
+	mutex_lock(&priv->lock);
+
+	ret = regmap_write(priv->regmap, priv->gccr_reg, val);
+	if (ret)
+		dev_err(&priv->client->dev, "Cannot write GCCR\n");
+
+	mutex_unlock(&priv->lock);
+
+	return len;
+}
+
+static ssize_t global_current_show(struct device *dev,
+				   struct device_attribute *attr,
+				   char *buf)
+{
+	struct aw210xx *priv = i2c_get_clientdata(to_i2c_client(dev));
+	int val = 0;
+	ssize_t ret;
+
+	mutex_lock(&priv->lock);
+
+	ret = regmap_read(priv->regmap, priv->gccr_reg, &val);
+	if (ret) {
+		dev_err(dev, "Cannot read GCCR\n");
+		mutex_unlock(&priv->lock);
+		return ret;
+	}
+
+	mutex_unlock(&priv->lock);
+
+	ret = scnprintf(buf, PAGE_SIZE, "%d\n", val);
+
+	return ret;
+}
+
+static DEVICE_ATTR_RW(global_current);
