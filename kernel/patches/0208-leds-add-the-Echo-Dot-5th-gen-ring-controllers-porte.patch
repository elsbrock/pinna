+static int aw210xx_frame_brightness_set(struct led_classdev *led_cdev,
+				enum led_brightness brt_val)
+{
+	struct led_classdev_frame *ledframe_cdev = lcdev_to_framecdev(led_cdev);
+	struct aw210xx_led *led = ledframe_cdev_to_led(ledframe_cdev);
+
+	return aw210xx_brightness_set(led, brt_val);
