+
+static enum led_brightness aw210xx_brightness_get(struct aw210xx_led *led)
+{
+	unsigned int brt_val = 0;
+	u8 reg_val, led_offset;
+	int ret;
+
+	mutex_lock(&led->priv->lock);
+	led_offset = led->led_number;
+
+	if (led->ctrl_bank_enabled == e_ctrl_bank_full) {
+		reg_val = led->priv->bank_brt_reg;
+	} else if (led->ctrl_bank_enabled == e_ctrl_bank_brightness) {
+		/* AW21018 has two regs for BR (BRxxL BRxxH), only used BRxxL*/
+		if (led->priv->model_id == AW21018)
+			led_offset = (led->led_number * 2);
+		reg_val = led->priv->led_brightness0_reg + led_offset;
+	} else {
+		// TODO: update to bulk read for 3x led number
+		/* AW21018 has two regs for BR (BRxxL BRxxH), only used BRxxL*/
+		if (led->priv->model_id == AW21018)
+			led_offset = (led->led_number * 2);
+		reg_val = led->priv->led_brightness0_reg + led_offset;
+	}
+
+	ret = regmap_read(led->priv->regmap, reg_val, &brt_val);
+
+	mutex_unlock(&led->priv->lock);
+
+	return brt_val;
+}
+
+static enum led_brightness aw210xx_rgb_brightness_get(struct led_classdev *led_cdev)
+{
+	struct led_classdev_rgb *rgbled_cdev = lcdev_to_rgbcdev(led_cdev);
+	struct aw210xx_led *led = rgbled_cdev_to_led(rgbled_cdev);
+
+	return aw210xx_brightness_get(led);
+}
+
+static enum led_brightness aw210xx_frame_brightness_get(struct led_classdev *led_cdev)
+{
+	struct led_classdev_frame *ledframe_cdev = lcdev_to_framecdev(led_cdev);
+	struct aw210xx_led *led = ledframe_cdev_to_led(ledframe_cdev);
+
+	return aw210xx_brightness_get(led);
+}
+
+static int aw210xx_set_frame(struct led_classdev_frame *ledframe_cdev)
+{
+	struct aw210xx_led *led = ledframe_cdev_to_led(ledframe_cdev);
+	struct aw210xx *priv = led->priv;
+	int ret, scaled_value;
+	int i, c_index;
+	u8 frame[AW210xx_MAX_LED_CHANNELS] = {0};
+
+	for (i = 0; i < priv->num_of_led_channels; i++) {
+		if (priv->ledcalibenable) {
+			scaled_value = (int) priv->ledpwmscalingrgb[i % LED_CALIB_COLOR_COUNT] *
+				ledframe_cdev->new_frame[i] / LED_PWM_MAX_SCALING;
+			ledframe_cdev->new_frame[i] = min_t(int, scaled_value,
+					(int) priv->ledpwmmaxlimiterrgb[i % LED_CALIB_COLOR_COUNT]);
+		}
+
+		c_index = ledframe_cdev->channel_map[i];
+		frame[c_index] = ledframe_cdev->new_frame[i];
+	}
+
+	mutex_lock(&led->priv->lock);
+	ret = regmap_bulk_write(priv->regmap, priv->mix_out0_reg, frame, priv->num_of_led_channels);
+	if (ret)
+		dev_err(&priv->client->dev, "Cannot update LED Frame\n");
+
+	mutex_unlock(&led->priv->lock);
+
+	return ret;
+}
+
+static struct led_frame_ops aw210xx_frame_ops = {
+	.set_frame =  aw210xx_set_frame,
+};
+
+static int aw210xx_enable(struct aw210xx *priv)
+{
+	int ret;
+
+	if (priv->regulator) {
+		ret = regulator_enable(priv->regulator);
+		if (ret) {
+			dev_err(&priv->client->dev, "Failed to enable regulator\n");
+			return ret;
+		}
+	}
+
+	if (priv->enable_gpio) {
+		ret = gpiod_direction_output(priv->enable_gpio, 1);
+		/* tEN_H = 500 us*/
+		usleep_range(500, 700);
+		if (ret) {
+			dev_err(&priv->client->dev, "Unable to set enable gpio\n");
+			return ret;
+		}
+	} else {
+		ret = regmap_write(priv->regmap, priv->reset_reg, AW210xx_SW_RESET);
+		if (ret) {
+			dev_err(&priv->client->dev, "Cannot reset the device\n");
+			return ret;
+		}
+	}
+
+	ret = regmap_write(priv->regmap, priv->gcr_reg, AW210xx_CHIP_ENABLE);
+	if (ret)
+		dev_err(&priv->client->dev, "Cannot write ctrl enable\n");
+
+	ret = regmap_write(priv->regmap, priv->gccr_reg, AW210xx_STARTUP_BR);
+	if (ret)
+		dev_err(&priv->client->dev, "Cannot write global current control\n");
+
+	ret = regmap_write(priv->regmap, priv->gcr2_reg, AW210xx_RGBMD_ENABLE);
+	if (ret)
+		dev_err(&priv->client->dev, "Cannot write brightness group\n");
+
+	return ret;
+}
+
+static struct led_rgb_ops aw210xx_rgb_ops = {
+	.set_color = aw210xx_set_color,
+	.set_red_brightness = aw210xx_set_red,
+	.set_green_brightness = aw210xx_set_green,
+	.set_blue_brightness = aw210xx_set_blue,
+};
+
+static void aw210xx_set_led_values(struct aw210xx *priv)
+{
+	if (priv->model_id == AW21024 || priv->model_id == AW21036) {
+		priv->led_brightness0_reg = AW21036_REG_BR_BASE;
+		priv->mix_out0_reg = AW21036_REG_COL_BASE;
+		priv->bank_brt_reg = AW21036_REG_FADEL;
+		priv->bank_mix_reg = AW21036_REG_GCOLR;
+		priv->reset_reg = AW21036_REG_RST;
+		priv->update_reg = AW21036_REG_UPDATE;
+		priv->bank_gcfg0_reg = AW21036_REG_GCFG0;
+		priv->bank_gcfg1_reg = AW21036_REG_GCFG1;
+		priv->gcr_reg = AW21036_REG_GCR;
+		priv->gccr_reg = AW21036_REG_GCCR;
+		priv->gcr2_reg = AW21036_REG_GCR2;
+		priv->wbr_reg = AW21036_REG_WBR;
+	} else {
+		priv->led_brightness0_reg = AW21018_REG_BR_BASE;
+		priv->mix_out0_reg = AW21018_REG_SL_BASE;
+		priv->bank_brt_reg = AW21018_REG_GBRL;
+		priv->bank_mix_reg = AW21018_REG_GSLR;
+		priv->reset_reg = AW21018_REG_RST;
+		priv->update_reg = AW21018_REG_UPDATE;
+		priv->bank_gcfg0_reg = AW21018_REG_GCFG;
+		priv->bank_gcfg1_reg = 0;
+		priv->gcr_reg = AW21018_REG_GCR;
+		priv->gccr_reg = AW21018_REG_GCCR;
+		priv->gcr2_reg = AW21018_REG_GCR2;
+		priv->wbr_reg = 0;
+	}
+}
+
+static int aw210xx_set_banks(struct aw210xx_led *led)
+{
+	struct aw210xx *led_priv;
+	int ret;
+
+	if (!led->ctrl_bank_enabled)
+		return 0;
+
+	led_priv = led->priv;
+
+	/*for aw210xx, every GE bit control 3 channal output*/
+	if (led_priv->model_id == AW21018)
+		ret = regmap_write(led_priv->regmap, led_priv->bank_gcfg0_reg,
+				   AW21018_GCFG0_BR_GROUP);
+		if (ret) {
+			dev_err(&led_priv->client->dev,
+				"AW21018: Cannot write REG_GCFG0\n");
+		}
+	else if (led_priv->model_id == AW21024) {
+		ret = regmap_write(led_priv->regmap, led_priv->bank_gcfg0_reg,
+				   AW21024_GCFG0_BR_GROUP);
+		if (ret) {
+			dev_err(&led_priv->client->dev,
+				"AW21024: Cannot write REG_GCFG0\n");
+		}
+		ret = regmap_write(led_priv->regmap, led_priv->bank_gcfg1_reg,
+				   AW21024_GCFG1_BR_GROUP);
+		if (ret) {
+			dev_err(&led_priv->client->dev,
+				"AW21024: Cannot write REG_GCFG1\n");
+		}
+	} else {
+		ret = regmap_write(led_priv->regmap, led_priv->bank_gcfg0_reg,
+				   AW21036_GCFG0_BR_GROUP);
+		if (ret) {
+			dev_err(&led_priv->client->dev,
+				"AW21036: Cannot write REG_GCFG0\n");
+		}
+		ret = regmap_write(led_priv->regmap, led_priv->bank_gcfg1_reg,
+				   AW21036_GCFG1_BR_GROUP);
+		if (ret) {
+			dev_err(&led_priv->client->dev,
+				"AW21036: Cannot write REG_GCFG1\n");
+		}
+	}
+
+	return ret;
+}
+
+static irqreturn_t disp_fault_handler(int irq, void *private)
+{
+	struct aw210xx *priv = private;
+	int ret;
+
+	if (regulator_is_enabled(priv->regulator) > 0) {
+		dev_err(&priv->client->dev, "== OVER VOLTAGE IN AW210XX | disabling LED regulator to cut power ==\n");
+		ret = regulator_disable(priv->regulator);
+		if (ret) {
+			dev_err(&priv->client->dev, "Failed to disable regulator\n");
+			return IRQ_NONE;
+			}
+	}
+
+	return IRQ_HANDLED;
+}
+
+static int aw210xx_init(struct aw210xx *priv)
+{
+	int i;
+	int ret;
+	struct aw210xx_led *led;
+	struct led_classdev *led_cdev;
+
+	aw210xx_set_led_values(priv);
+
+	ret = aw210xx_enable(priv);
+	if (ret)
+		return ret;
+
+	if (priv->disp_fault_gpio) {
+		ret = gpiod_to_irq(priv->disp_fault_gpio);
+		if (ret < 0) {
+			dev_err(&priv->client->dev, "Failed to get irq from disp_fault_gpio %d\n", ret);
+		} else {
+			priv->disp_fault_irq = ret;
+		}
+
+		if (priv->disp_fault_irq) {
+			ret = devm_request_irq(&priv->client->dev, priv->disp_fault_irq, &disp_fault_handler,
+				IRQF_TRIGGER_LOW, "display_fault", priv);
+			if (ret < 0)
+				dev_err(&priv->client->dev, "Failed to request irq");
+		}
+	}
+
+	for (i = 0; i < priv->num_of_leds; i++) {
+		led = &priv->leds[i];
+		led->priv = priv;
+
+		if (led->led_type == e_led_frame) {
+			led->frame_cdev.ops = &aw210xx_frame_ops;
+			led_cdev = &led->frame_cdev.led_cdev;
+			led_cdev->name = led->label;
+			led_cdev->brightness_set_blocking = aw210xx_frame_brightness_set;
+			led_cdev->brightness_get = aw210xx_frame_brightness_get;
+			ret = led_classdev_frame_register(&priv->client->dev, &led->frame_cdev);
+			if (ret) {
+				dev_err(&priv->client->dev, "led frame register err: %d\n", ret);
+				while (--i >= 0) {
+					led = &priv->leds[i];
+					led_classdev_frame_unregister(&led->frame_cdev);
+				}
+				return ret;
+			}
+
+			led->ctrl_bank_enabled = e_ctrl_bank_full;
+			ret = aw210xx_set_banks(led);
+			if (ret)
+				dev_err(&priv->client->dev, "Cannot set banks\n");
+
+			aw210xx_brightness_set(led, AW210xx_STARTUP_BR);
+
+			continue;
+		}
+
+		led->rgb_cdev.ops = &aw210xx_rgb_ops;
+		led_cdev = &led->rgb_cdev.led_cdev;
+		led_cdev->name = led->label;
+		led_cdev->brightness_set_blocking = aw210xx_rgb_brightness_set;
+		led_cdev->brightness_get = aw210xx_rgb_brightness_get;
+
+		ret = led_classdev_rgb_register(&priv->client->dev, &led->rgb_cdev);
+		if (ret) {
+			dev_err(&priv->client->dev, "led register err: %d\n", ret);
+			while (--i >= 0) {
+				led = &priv->leds[i];
+				led_classdev_rgb_unregister(&led->rgb_cdev);
+			}
+			return ret;
+		}
+		aw210xx_brightness_set(led, AW210xx_STARTUP_BR);
+		led->ctrl_bank_enabled = e_ctrl_bank_brightness;
+	}
+
+	ret = regmap_write(priv->regmap, priv->update_reg, AW210xx_UPDATE_TRIGGER);
+	if (ret)
+		dev_err(&priv->client->dev, "Cannot write update register\n");
+
+	return ret;
+}
+
+static void aw210xx_convert_to_rgb(u8 *rgb_array, int bitmap)
+{
+	int i;
+
+	for (i = 0; i < LED_CALIB_COLOR_COUNT; i++)
+		/*
+		 * extract R, G, B value from bitmap(0xRRGGBB) and assign
+		 * to rgb_array {R, G, B}
+		 */
+		rgb_array[i] = (bitmap & (BYTE_MASK << 8 *
+				(LED_CALIB_COLOR_COUNT - i - 1))) >>
+				8 * (LED_CALIB_COLOR_COUNT - i - 1);
+}
+
+static void aw210xx_initialize_led_calibrations(struct aw210xx *priv)
+{
+	priv->ledcalibenable = ledcalibparams[INDEX_LEDCALIBENABLE];
+
+	if (priv->ledcalibenable) {
+		aw210xx_convert_to_rgb(priv->ledpwmscalingrgb,
+					ledcalibparams[INDEX_PWMSCALING]);
+		aw210xx_convert_to_rgb(priv->ledpwmmaxlimiterrgb,
+					ledcalibparams[INDEX_PWMMAXLIMIT]);
+	} else {
+		aw210xx_convert_to_rgb(priv->ledpwmscalingrgb,
+					LED_PWM_SCALING_DEFAULT);
+		aw210xx_convert_to_rgb(priv->ledpwmmaxlimiterrgb,
+					LED_PWM_MAX_LIMIT_DEFAULT);
+	}
+}
