+	  ISSI IS31FL3246 RGB LED controller, an Echo Dot (5th gen) ring revision.
+
+config LEDS_AW210XX
+	tristate "LED support for Awinic AW210xx (MT8519 Echo ring)"
+	depends on I2C && OF
+	select REGMAP_I2C
+	select LEDS_CLASS_RGB
+	select LEDS_CLASS_FRAME
+	help
+	  Awinic AW21036 RGB LED controller, an Echo Dot (5th gen) ring revision.
+
+config LEDS_CLASS_FRAME
+	tristate "Frame LED Class Support"
+	help
+	  Amazon's frame LED class (Echo ring frame interface).
