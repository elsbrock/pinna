+static int
+__is31fl3246_get_individual_rgb_brightness(struct led_classdev_rgb *rgbled_cdev,
+					   enum e_rgb_map_idx led_color,
+					   enum led_brightness *brightness)
+{
+	struct is31fl3246_led *led = rgbled_cdev_to_led(rgbled_cdev);
+	struct is31fl3246 *priv = led->priv;
+	u8 led_offset;
