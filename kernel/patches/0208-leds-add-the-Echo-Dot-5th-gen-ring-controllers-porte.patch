From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Simon Elsbrock <simon@iodev.org>
Date: Sat, 21 Nov 2026 17:21:38 +0100
Subject: [PATCH] leds: add the Echo Dot (5th gen) ring controllers, ported to
 6.12

The light ring's board revisions that the mainline LP5036 does not cover: the
ISSI IS31FL3246 and the Awinic AW21036, from Amazon's 5.4 release, with the
two small LED classes they sit on -- Amazon's RGB LED class and its frame LED
class (the ring's frame-channel interface). The classes port with no change;
the two controllers only need the 6.12 i2c probe (no id argument, fetched with
i2c_client_get_device_id) and void remove. Off in every current variant.

With the mainline LP5036 (already enabled), this covers all three of cannoli's
ring LED controllers; which one a unit carries is read from its board.
---
 drivers/leds/Kconfig            |   28 +
 drivers/leds/Makefile           |    4 +
 drivers/leds/led-class-frame.c  |  217 ++++
 drivers/leds/led-class-rgb.c    |  347 +++++++
 drivers/leds/leds-aw210xx.c     | 1586 +++++++++++++++++++++++++++++
 drivers/leds/leds-is31fl3246.c  | 1686 +++++++++++++++++++++++++++++++
 include/linux/led-class-frame.h |   87 ++
 include/linux/led-class-rgb.h   |  101 ++
 8 files changed, 4056 insertions(+)
 create mode 100644 drivers/leds/led-class-frame.c
 create mode 100644 drivers/leds/led-class-rgb.c
 create mode 100644 drivers/leds/leds-aw210xx.c
 create mode 100644 drivers/leds/leds-is31fl3246.c
 create mode 100644 include/linux/led-class-frame.h
 create mode 100644 include/linux/led-class-rgb.h

diff --git a/drivers/leds/Kconfig b/drivers/leds/Kconfig
index b784bb74a..fb80185bc 100644
--- a/drivers/leds/Kconfig
+++ b/drivers/leds/Kconfig
@@ -974,3 +974,31 @@ comment "Simple LED drivers"
 source "drivers/leds/simple/Kconfig"
 
 endif # NEW_LEDS
+
+config LEDS_CLASS_RGB
+	tristate "RGB LED Class Support"
+	help
+	  Amazon's RGB LED class (Echo ring controllers).
+
+config LEDS_IS31FL3246
+	tristate "LED support for ISSI IS31FL3246 (MT8519 Echo ring)"
+	depends on I2C && OF
+	select REGMAP_I2C
+	select LEDS_CLASS_RGB
+	select LEDS_CLASS_FRAME
