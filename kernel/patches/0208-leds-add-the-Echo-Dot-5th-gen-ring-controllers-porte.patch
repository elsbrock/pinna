+	mutex_lock(&led->priv->lock);
+	ret = regmap_read(priv->regmap, led_color_reg, brightness);
+	mutex_unlock(&led->priv->lock);
+	if (ret)
+		dev_err(&priv->client->dev,
+			"Cannot read LED value. eRgbMapIdx=%d ret=%d\n",
+			led_color, ret);
