+	}
+
+	ret = regmap_write(priv->regmap, REG_UPDATE, IS31FL3246_UPDATE_TRIGGER);
+	if (ret)
+		dev_err(&priv->client->dev, "Cannot write update register\n");
+
+out:
+	mutex_unlock(&led->priv->lock);
+	return ret;
+}
