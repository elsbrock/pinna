+/**
+ * struct aw210xx -
+ * @enable_gpio: Hardware enable gpio
+ * @disp_fault_gpio: display fault from gpio
+ * @regulator: LED supply regulator pointer
+ * @client: Pointer to the I2C client
+ * @regmap: Devices register map
+ * @dev: Pointer to the devices device struct
+ * @lock: Lock for reading/writing the device
+ * @model_id: ID of the device
+ * @leds: Array of LED strings
+ */
+struct aw210xx {
+	struct gpio_desc *enable_gpio;
+	struct gpio_desc *disp_fault_gpio;
+	struct regulator *regulator;
+	struct i2c_client *client;
+	struct regmap *regmap;
+	struct device *dev;
+	struct mutex lock;
+	enum aw210xx_model model_id;
+	int disp_fault_irq;
+	int max_leds;
+	int num_of_leds;
+	int num_of_led_channels;
+	int led_max_brightness;
+
+	u8 led_brightness0_reg;
+	u8 mix_out0_reg;
+	u8 bank_brt_reg;
+	u8 bank_mix_reg;
+	u8 reset_reg;
+	u8 update_reg;
+	u8 bank_gcfg0_reg;
+	u8 bank_gcfg1_reg;
+	u8 gcr_reg;
+	u8 gccr_reg;
+	u8 gcr2_reg;
+	u8 wbr_reg;
+
+	int ledcalibenable;
+	u8 ledpwmmaxlimiterrgb[LED_CALIB_COLOR_COUNT];
+	u8 ledpwmscalingrgb[LED_CALIB_COLOR_COUNT];
+	/* This needs to be at the end of the struct */
+	struct aw210xx_led leds[];
+};
