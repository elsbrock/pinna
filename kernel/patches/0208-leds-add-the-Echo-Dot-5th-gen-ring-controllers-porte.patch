+static ssize_t whitebalance_store(struct device *dev,
+					struct device_attribute *attr,
+					const char *buf,
+					size_t len)
+{
+	struct aw210xx *priv = i2c_get_clientdata(to_i2c_client(dev));
+	ssize_t ret;
+	int red, green, blue;
+	u8 wb_array[e_rgb_map_idx_count] = {0};
+
+	if (sscanf(buf, "%d %d %d", &red, &green, &blue) != 3) {
+		dev_err(dev, "AW210xx: unable to parse whitebalance input\n");
+		ret = -EINVAL;
+		return ret;
+	}
+
+	if (red < 0 || red > 255 || green < 0 || green > 255 || blue < 0 || blue > 255) {
+		dev_err(dev, "AW210xx: Invalid input to store whitebalance\n");
+		ret = -EINVAL;
+		return ret;
+	}
+
+	wb_array[0] = red;
+	wb_array[1] = green;
+	wb_array[2] = blue;
+
+	mutex_lock(&priv->lock);
+
+	ret = regmap_bulk_write(priv->regmap, priv->wbr_reg, wb_array,
+				e_rgb_map_idx_count);
+	if (ret)
+		dev_err(&priv->client->dev, "Cannot write whitebalance reg\n");
+
+	mutex_unlock(&priv->lock);
+
+	return len;
+}
+
+static ssize_t whitebalance_show(struct device *dev,
+				   struct device_attribute *attr,
+				   char *buf)
+{
+	struct aw210xx *priv = i2c_get_clientdata(to_i2c_client(dev));
+	ssize_t ret;
+	u8 wb_array[e_rgb_map_idx_count] = {0};
+
+	mutex_lock(&priv->lock);
+
+	ret = regmap_bulk_read(priv->regmap, priv->wbr_reg, wb_array,
+				e_rgb_map_idx_count);
+	if (ret)
+		dev_err(dev, "Cannot bulk read REG_WBR\n");
+
+	mutex_unlock(&priv->lock);
+
+	ret = scnprintf(buf + ret, PAGE_SIZE, "%d %d %d\n", wb_array[0], wb_array[1],
+			wb_array[2]);
+
+	return ret;
+}
