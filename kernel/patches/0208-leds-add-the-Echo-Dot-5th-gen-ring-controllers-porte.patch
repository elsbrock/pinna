+static int aw210xx_brightness_set(struct aw210xx_led *led,
+				enum led_brightness brt_val)
+{
+	struct aw210xx *priv = led->priv;
+	int ret = 0;
+	u8 reg_val, led_offset;
+	u64 brt_limit = 255;
+
+	/*calculate the real brightness*/
+	brt_limit = div_u64(brt_val*priv->led_max_brightness, 255);
+
+	mutex_lock(&led->priv->lock);
+	led_offset = led->led_number;
+
+	if (led->ctrl_bank_enabled == e_ctrl_bank_full) {
+		reg_val = led->priv->bank_brt_reg;
+	} else if (led->ctrl_bank_enabled == e_ctrl_bank_brightness) {
+		/* AW21018 has two regs for BR (BRxxL BRxxH), only used BRxxL*/
+		if (led->priv->model_id == AW21018)
+			led_offset = (led->led_number * 2);
+		reg_val = led->priv->led_brightness0_reg + led_offset;
+	} else {
+		// TODO: Update to bulk write for 3x led number
+		/* AW21018 has two regs for BR (BRxxL BRxxH), only used BRxxL*/
+		if (led->priv->model_id == AW21018)
+			led_offset = (led->led_number * 2);
+		reg_val = led->priv->led_brightness0_reg + led_offset;
+	}
+
+	ret = regmap_write(led->priv->regmap, reg_val, brt_limit);
+	if (ret)
+		dev_err(&led->priv->client->dev, "Cannot write brightness register\n");
+
+	ret = regmap_write(led->priv->regmap, led->priv->update_reg, AW210xx_UPDATE_TRIGGER);
+	if (ret)
+		dev_err(&led->priv->client->dev, "Cannot write update register\n");
+
+	mutex_unlock(&led->priv->lock);
+
+	return ret;
+}
