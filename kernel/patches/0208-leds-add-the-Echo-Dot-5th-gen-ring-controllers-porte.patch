+static int aw210xx_rgb_brightness_set(struct led_classdev *led_cdev,
+				enum led_brightness brt_val)
+{
+	struct led_classdev_rgb *rgbled_cdev = lcdev_to_rgbcdev(led_cdev);
+	struct aw210xx_led *led = rgbled_cdev_to_led(rgbled_cdev);
+
+	return aw210xx_brightness_set(led, brt_val);
+}
