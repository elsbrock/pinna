+#if LINUX_VERSION_CODE < KERNEL_VERSION(7, 3, 0)
+/*
+ * Before 7.3 the driver chooses the cookie of a remain-on-channel request
+ * or a management frame and returns it. Any nonzero value unique among the
+ * pending ones will do; the driver reports it back unchanged.
+ */
+static u64 mtk_cfg80211_next_cookie(void)
+{
+	static atomic64_t last = ATOMIC64_INIT(0);
+	u64 cookie;
+
+	do {
+		cookie = atomic64_inc_return(&last);
+	} while (!cookie);
+
+	return cookie;
+}
+
+int mtk_cfg80211_remain_on_channel_cookie_out(struct wiphy *wiphy, struct wireless_dev *wdev,
+					      struct ieee80211_channel *chan,
+					      unsigned int duration, u64 *cookie)
+{
+	*cookie = mtk_cfg80211_next_cookie();
+	return mtk_cfg80211_remain_on_channel(wiphy, wdev, chan, duration, *cookie, NULL);
+}
+
+int mtk_cfg80211_mgmt_tx_cookie_out(struct wiphy *wiphy, struct wireless_dev *wdev,
+				    struct cfg80211_mgmt_tx_params *params, u64 *cookie)
+{
+	*cookie = mtk_cfg80211_next_cookie();
+	return mtk_cfg80211_mgmt_tx(wiphy, wdev, params, *cookie);
+}
+
+int mtk_p2p_cfg80211_remain_on_channel_cookie_out(struct wiphy *wiphy,
+						  struct wireless_dev *wdev,
+						  struct ieee80211_channel *chan,
+						  unsigned int duration, u64 *cookie)
+{
+	*cookie = mtk_cfg80211_next_cookie();
+	return mtk_p2p_cfg80211_remain_on_channel(wiphy, wdev, chan, duration, *cookie, NULL);
+}
+
+int mtk_p2p_cfg80211_mgmt_tx_cookie_out(struct wiphy *wiphy, struct wireless_dev *wdev,
+					struct cfg80211_mgmt_tx_params *params, u64 *cookie)
+{
+	*cookie = mtk_cfg80211_next_cookie();
+	return mtk_p2p_cfg80211_mgmt_tx(wiphy, wdev, params, *cookie);
+}
+#endif
+
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 17, 0)
+/* Before 6.17 a wiphy has one radio: the driver's radio_idx -1 means all. */
+int mtk_p2p_cfg80211_set_wiphy_params_no_radio(struct wiphy *wiphy, u32 changed)
+{
+	return mtk_p2p_cfg80211_set_wiphy_params(wiphy, -1, changed);
+}
+
+int mtk_p2p_cfg80211_set_txpower_no_radio(struct wiphy *wiphy, struct wireless_dev *wdev,
+					  enum nl80211_tx_power_setting type, int mbm)
+{
+	return mtk_p2p_cfg80211_set_txpower(wiphy, wdev, -1, type, mbm);
+}
+
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 14, 0)
+int mtk_p2p_cfg80211_get_txpower_no_radio(struct wiphy *wiphy, struct wireless_dev *wdev,
+					  int *dbm)
+{
+	return mtk_p2p_cfg80211_get_txpower(wiphy, wdev, -1, 0, dbm);
+}
+#else
+int mtk_p2p_cfg80211_get_txpower_no_radio(struct wiphy *wiphy, struct wireless_dev *wdev,
+					  unsigned int link_id, int *dbm)
+{
+	return mtk_p2p_cfg80211_get_txpower(wiphy, wdev, -1, link_id, dbm);
+}
+#endif
+#endif
