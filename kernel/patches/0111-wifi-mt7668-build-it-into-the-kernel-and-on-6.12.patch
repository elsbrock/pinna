@@ -0,0 +1,116 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * The kernel APIs this driver was ported to (Linux 7.3, lidar-mainline), and
+ * the older kernels it also builds on (Pinna's 6.12, ADR 0031). The driver
+ * keeps the 7.3 signatures. On an older kernel the cfg80211 ops tables name
+ * the wrappers in gl_cfg80211_compat.c instead, which adapt the arguments:
+ *
+ *   7.3   the core assigns the cookie of remain_on_channel and mgmt_tx and
+ *         passes it in (914781c72813); before, the driver returns one.
+ *   7.1   the key and station ops, and cfg80211_new_sta()/cfg80211_del_sta(),
+ *         take the wireless_dev; before, the net_device.
+ *   6.17  set_wiphy_params, set_tx_power and get_tx_power take radio_idx.
+ *   6.16  from_timer() became timer_container_of().
+ *   6.14  get_tx_power takes link_id.
