+/*
+ * How long a received frame may wait behind a reorder hole before the hole is
+ * given up.  mac80211 uses 100 ms (HT_RX_REORDER_BUF_TIMEOUT); the vendor
+ * code used QM_RX_BA_ENTRY_MISS_TIMEOUT_MS (1 s), checked only on arrivals.
+ * /sys/module/wlan_mt/parameters/rx_reorder_timeout_ms
+ */
+static unsigned int rx_reorder_timeout_ms = 100;
+module_param(rx_reorder_timeout_ms, uint, 0644);
+MODULE_PARM_DESC(rx_reorder_timeout_ms, "ms a frame may wait behind an RX reorder hole (10-2000)");
+
+static TIMER_T g_rRxReorderTimer;
+
+static UINT_32 qmRxReorderTimeoutMs(VOID)
+{
+	UINT_32 u4Ms = READ_ONCE(rx_reorder_timeout_ms);
+
+	return clamp_t(UINT_32, u4Ms, 10, 2000);
+}
