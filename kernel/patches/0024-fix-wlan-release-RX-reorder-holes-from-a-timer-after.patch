+/*----------------------------------------------------------------------------*/
+/*!
+* \brief TRUE if a frame in the reorder queue has waited for the hold limit.
+*/
+/*----------------------------------------------------------------------------*/
+static BOOLEAN qmReorderQueHasExpired(IN P_QUE_T prReorderQue, IN OS_SYSTIME rCurrentTime)
+{
+	P_QUE_ENTRY_T prEntry;
+	UINT_32 u4TimeoutMs = qmRxReorderTimeoutMs();
+
+	for (prEntry = prReorderQue->prHead; prEntry; prEntry = prEntry->prNext) {
+		if (CHECK_FOR_TIMEOUT(rCurrentTime, ((P_SW_RFB_T) prEntry)->rEchoBaTime,
+				      MSEC_TO_SYSTIME(u4TimeoutMs)))
+			return TRUE;
+	}
+	return FALSE;
+}
