+/*----------------------------------------------------------------------------*/
+/*!
+* \brief Release frames that waited too long behind a reorder hole when no
+*        further frame arrives (the sender stalls while its data is held).
+*
+* Runs as a cnmTimer callback, i.e. in the driver main thread like the RX path.
+*/
+/*----------------------------------------------------------------------------*/
+static VOID qmRxReorderTimeout(IN P_ADAPTER_T prAdapter, IN ULONG ulData)
+{
+	P_QUE_MGT_T prQM = &prAdapter->rQM;
+	P_RX_CTRL_T prRxCtrl = &prAdapter->rRxCtrl;
+	QUE_T rReturnedQue;
+	BOOLEAN fgIsTimeout, fgWaiting = FALSE;
+	OS_SYSTIME rCurrentTime, rOldest = 0;
+	UINT_32 i, u4Released, u4NextMs;
+
+	QUEUE_INITIALIZE(&rReturnedQue);
+
+	for (i = 0; i < CFG_NUM_OF_RX_BA_AGREEMENTS; i++) {
+		P_RX_BA_ENTRY_T prRxBaEntry = &prQM->arRxBaTable[i];
+
+		if (!prRxBaEntry->fgIsValid || QUEUE_IS_EMPTY(&prRxBaEntry->rReOrderQue))
+			continue;
+		qmPopOutDueToFallWithin(prRxBaEntry, &rReturnedQue, &fgIsTimeout);
+	}
+
+	u4Released = rReturnedQue.u4NumElem;
+	if (u4Released) {
+		g_rEchoRxStat.u4BaTimerRelease += u4Released;
+		prRxCtrl->ucNumIndPacket = 0;
+		prRxCtrl->ucNumRetainedPacket = 0;
+		wlanProcessQueuedSwRfb(prAdapter, (P_SW_RFB_T) QUEUE_GET_HEAD(&rReturnedQue));
+		if (prRxCtrl->ucNumIndPacket > 0) {
+			RX_ADD_CNT(prRxCtrl, RX_DATA_INDICATION_COUNT, prRxCtrl->ucNumIndPacket);
+			kalRxIndicatePkts(prAdapter->prGlueInfo, prRxCtrl->apvIndPacket,
+					  (UINT_32) prRxCtrl->ucNumIndPacket);
+			prRxCtrl->ucNumIndPacket = 0;
+		}
+	}
+
+	/* re-arm for the oldest frame still waiting */
+	GET_CURRENT_SYSTIME(&rCurrentTime);
+	for (i = 0; i < CFG_NUM_OF_RX_BA_AGREEMENTS; i++) {
+		P_RX_BA_ENTRY_T prRxBaEntry = &prQM->arRxBaTable[i];
+		P_QUE_ENTRY_T prEntry;
+
+		if (!prRxBaEntry->fgIsValid)
+			continue;
+		for (prEntry = prRxBaEntry->rReOrderQue.prHead; prEntry; prEntry = prEntry->prNext) {
+			OS_SYSTIME rTime = ((P_SW_RFB_T) prEntry)->rEchoBaTime;
+
+			if (!fgWaiting || TIME_BEFORE(rTime, rOldest))
+				rOldest = rTime;
+			fgWaiting = TRUE;
+		}
+	}
+	if (fgWaiting) {
+		u4NextMs = (UINT_32) (rOldest + qmRxReorderTimeoutMs() - rCurrentTime);
+		if ((INT_32) u4NextMs < 10)
+			u4NextMs = 10;
+		cnmTimerStartTimer(prAdapter, &g_rRxReorderTimer, u4NextMs);
+	}
+}
+
+/*----------------------------------------------------------------------------*/
+/*!
+* \brief Make sure the reorder hold timer runs while frames wait behind a hole.
+*/
+/*----------------------------------------------------------------------------*/
+static VOID qmRxReorderArmTimer(IN P_ADAPTER_T prAdapter, IN P_RX_BA_ENTRY_T prReorderQueParm)
+{
+	if (QUEUE_IS_EMPTY(&prReorderQueParm->rReOrderQue))
+		return;
+	if (!timerPendingTimer(&g_rRxReorderTimer))
+		cnmTimerStartTimer(prAdapter, &g_rRxReorderTimer, qmRxReorderTimeoutMs());
+}
+
 VOID qmPopOutDueToFallAhead(IN P_RX_BA_ENTRY_T prReorderQueParm, OUT P_QUE_T prReturnedQue)
 {
 	P_SW_RFB_T prReorderedSwRfb;
