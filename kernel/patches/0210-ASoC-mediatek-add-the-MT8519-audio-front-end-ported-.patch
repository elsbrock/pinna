+static int mt8519_snd_soc_dapm_get_enum_double(struct snd_kcontrol *kcontrol,
+	struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_dapm_context *dapm =
+		snd_soc_dapm_kcontrol_dapm(kcontrol);
+	struct snd_soc_component *comp = snd_soc_dapm_to_component(dapm);
+	struct mtk_base_afe *afe = snd_soc_component_get_drvdata(comp);
+	int ret;
+
+	mt8519_afe_enable_reg_rw_clk(afe);
+
+	ret = snd_soc_dapm_get_enum_double(kcontrol, ucontrol);
+
+	mt8519_afe_disable_reg_rw_clk(afe);
+
+	return ret;
+}
+
+static int mt8519_snd_soc_dapm_put_enum_double(struct snd_kcontrol *kcontrol,
+	struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_dapm_context *dapm =
+		snd_soc_dapm_kcontrol_dapm(kcontrol);
+	struct snd_soc_component *comp = snd_soc_dapm_to_component(dapm);
+	struct mtk_base_afe *afe = snd_soc_component_get_drvdata(comp);
+	int ret;
+
+	mt8519_afe_enable_reg_rw_clk(afe);
+
+	ret = snd_soc_dapm_put_enum_double(kcontrol, ucontrol);
+
+	mt8519_afe_disable_reg_rw_clk(afe);
+
+	return ret;
+}
