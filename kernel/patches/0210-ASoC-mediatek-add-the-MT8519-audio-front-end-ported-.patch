+	mt8519_afe_set_clk_parent(afe,
+		priv->clocks[MT8519_CLK_I2SOUT_M_SEL],
+		(rate % 8000) ?
+		priv->clocks[MT8519_CLK_AUD1] :
+		priv->clocks[MT8519_CLK_AUD2]);
+	mt8519_afe_set_clk_rate(afe,
+		priv->clocks[MT8519_CLK_APLL12_DIV2],
+		mclk);
+
+	if (!slave_mode)
+		mt8519_afe_enable_etdm(afe, MT8519_ETDM2,
