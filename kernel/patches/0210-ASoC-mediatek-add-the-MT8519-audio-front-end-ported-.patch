+static bool mt8519_afe_gasrc_is_rx_tracking(int fs_timing)
+{
+	if ((fs_timing == MT8519_FS_ETDMIN1_1X_EN) ||
+		(fs_timing == MT8519_FS_ETDMIN2_1X_EN) ||
+		(fs_timing == MT8519_FS_AMIC_1X_EN_ASYNC))
+		return true;
+	else
+		return false;
+}
+
+static void mt8519_afe_gasrc_enable_iir(struct mtk_base_afe *afe,
+	int gasrc_id)
+{
+	unsigned int ctrl_reg = 0;
+
+	if (gasrc_id < 0)
+		return;
+
+	ctrl_reg = gasrc_ctrl_reg[gasrc_id].con0;
+
+	regmap_update_bits(afe->regmap, ctrl_reg,
+		GASRC_NEW_CON0_CHSET0_IIR_STAGE_MASK,
+		GASRC_NEW_CON0_CHSET0_IIR_STAGE(8));
+
+	regmap_update_bits(afe->regmap, ctrl_reg,
+		GASRC_NEW_CON0_CHSET0_CLR_IIR_HISTORY,
+		GASRC_NEW_CON0_CHSET0_CLR_IIR_HISTORY);
+
+	regmap_update_bits(afe->regmap, ctrl_reg,
+		GASRC_NEW_CON0_CHSET0_IIR_EN,
+		GASRC_NEW_CON0_CHSET0_IIR_EN);
+}
+
+static void mt8519_afe_gasrc_disable_iir(struct mtk_base_afe *afe,
+	int gasrc_id)
+{
+	unsigned int ctrl_reg = 0;
+
+	if (gasrc_id < 0)
+		return;
+
+	ctrl_reg = gasrc_ctrl_reg[gasrc_id].con0;
+
+	regmap_update_bits(afe->regmap, ctrl_reg,
+		GASRC_NEW_CON0_CHSET0_IIR_EN, 0);
+}
