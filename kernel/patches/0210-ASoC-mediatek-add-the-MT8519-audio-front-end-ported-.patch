+			if (force_apply_in_change)
+				mt8519_afe_etdm2_in_force_on(afe);
+		}
+
+		return 0;
+	}
+
+	mt8519_afe_enable_main_clk(afe);
+
+	if (stream == SNDRV_PCM_STREAM_PLAYBACK ||
+	    clk_mode == MT8519_ETDM_SHARED_CLOCK) {
+		mt8519_afe_enable_clk(afe,
+			afe_priv->clocks[MT8519_CLK_I2SOUT_MCK]);
+		mt8519_afe_enable_top_cg(afe, MT8519_TOP_CG_I2S_OUT);
+	}
+
+	if (stream == SNDRV_PCM_STREAM_CAPTURE ||
+	    clk_mode == MT8519_ETDM_SHARED_CLOCK) {
+		mt8519_afe_enable_clk(afe,
+			afe_priv->clocks[MT8519_CLK_I2SIN_MCK]);
+		mt8519_afe_enable_top_cg(afe, MT8519_TOP_CG_I2S_IN);
+	}
+
+	return 0;
+}
