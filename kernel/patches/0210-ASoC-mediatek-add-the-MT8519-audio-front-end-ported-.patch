+	struct mt8519_afe_private *afe_priv = afe->platform_priv;
+	int i;
+
+	if (!afe_priv)
+		return;
+
+	for (i = 0; i < MT8519_AFE_DEBUGFS_NUM; i++)
+		debugfs_remove(afe_priv->debugfs_dentry[i]);
+#endif
