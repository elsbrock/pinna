+static int mt8519_afe_gasrc_get_freq_val(unsigned int rate,
+	unsigned int cali_cycles)
+{
+	int i;
+	const struct mt8519_afe_gasrc_freq *freq_palette = NULL;
+	int tbl_size = 0;
+
+	if (cali_cycles == 48) {
+		freq_palette =
+			mt8519_afe_gasrc_freq_palette_49m_45m_48_cycles;
+		tbl_size = ARRAY_SIZE(
+			mt8519_afe_gasrc_freq_palette_49m_45m_48_cycles);
+	} else {
+		freq_palette =
+			mt8519_afe_gasrc_freq_palette_49m_45m_64_cycles;
+		tbl_size = ARRAY_SIZE(
+			mt8519_afe_gasrc_freq_palette_49m_45m_64_cycles);
+	}
+
+	for (i = 0; i < tbl_size; i++)
+		if (freq_palette[i].rate == rate)
+			return freq_palette[i].freq_val;
+
+	return -EINVAL;
+}
+
+static int mt8519_afe_gasrc_get_period_val(unsigned int rate,
+	bool op_freq_45m, unsigned int cali_cycles)
+{
+	int i;
+	const struct mt8519_afe_gasrc_freq *period_palette = NULL;
+	int tbl_size = 0;
+
+	if (cali_cycles == 48) {
+		period_palette =
+			mt8519_afe_gasrc_period_palette_49m_48_cycles;
+		tbl_size = ARRAY_SIZE(
+			mt8519_afe_gasrc_period_palette_49m_48_cycles);
+	} else if (cali_cycles == 441) {
+		period_palette =
+			mt8519_afe_gasrc_period_palette_45m_441_cycles;
+		tbl_size = ARRAY_SIZE(
+			mt8519_afe_gasrc_period_palette_45m_441_cycles);
+	} else {
+		if (op_freq_45m) {
+			period_palette =
+				mt8519_afe_gasrc_period_palette_45m_64_cycles;
+			tbl_size = ARRAY_SIZE(
+				mt8519_afe_gasrc_period_palette_45m_64_cycles);
+		} else {
+			period_palette =
+				mt8519_afe_gasrc_period_palette_49m_64_cycles;
+			tbl_size = ARRAY_SIZE(
+				mt8519_afe_gasrc_period_palette_49m_64_cycles);
+		}
+	}
+
+	for (i = 0; i < tbl_size; i++) {
+		if (period_palette[i].rate == rate)
+			return period_palette[i].freq_val;
+	}
+
+	return -EINVAL;
+}
