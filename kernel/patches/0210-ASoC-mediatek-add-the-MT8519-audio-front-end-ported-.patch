+static unsigned int get_top_cg_on_val(unsigned int cg_type)
+{
+	switch (cg_type) {
+	case MT8519_TOP_CG_A1SYS_TIMING:
+	case MT8519_TOP_CG_A2SYS_TIMING:
+	case MT8519_TOP_CG_26M_TIMING:
+	case MT8519_TOP_CG_LP_MODE:
+		return get_top_cg_mask(cg_type);
+	default:
+		return 0;
+	}
+}
+
+static unsigned int get_top_cg_off_val(unsigned int cg_type)
+{
+	switch (cg_type) {
+	case MT8519_TOP_CG_A1SYS_TIMING:
+	case MT8519_TOP_CG_A2SYS_TIMING:
+	case MT8519_TOP_CG_26M_TIMING:
+	case MT8519_TOP_CG_LP_MODE:
+		return 0;
+	default:
+		return get_top_cg_mask(cg_type);
+	}
+}
