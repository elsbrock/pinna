+static int mt8519_afe_int_adda_startup(struct snd_pcm_substream *substream,
+	struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt8519_afe_private *afe_priv = afe->platform_priv;
+	unsigned int stream = substream->stream;
+
+	dev_dbg(dai->dev, "%s\n", __func__);
+
+	mt8519_afe_enable_main_clk(afe);
+	mt8519_afe_enable_clk(afe, afe_priv->clocks[MT8519_CLK_TOP_AUD_26M]);
+
+	if (stream == SNDRV_PCM_STREAM_PLAYBACK) {
+		mt8519_afe_enable_top_cg(afe, MT8519_TOP_CG_DAC);
+		mt8519_afe_enable_top_cg(afe, MT8519_TOP_CG_DAC_PREDIS);
+		mt8519_afe_enable_top_cg(afe, MT8519_TOP_CG_DL_ASRC);
+	} else if (stream == SNDRV_PCM_STREAM_CAPTURE) {
+		mt8519_afe_enable_top_cg(afe, MT8519_TOP_CG_ADC);
+	}
+
+	return 0;
+}
+
+static void mt8519_afe_int_adda_shutdown(struct snd_pcm_substream *substream,
+	struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt8519_afe_private *afe_priv = afe->platform_priv;
+	unsigned int stream = substream->stream;
+	unsigned int rate = substream->runtime->rate;
+
+	dev_dbg(dai->dev, "%s, rate:%u\n", __func__, rate);
+
+	if (stream == SNDRV_PCM_STREAM_PLAYBACK) {
+		mt8519_afe_disable_top_cg(afe, MT8519_TOP_CG_DL_ASRC);
+		mt8519_afe_disable_top_cg(afe, MT8519_TOP_CG_DAC_PREDIS);
+		mt8519_afe_disable_top_cg(afe, MT8519_TOP_CG_DAC);
+	} else if (stream == SNDRV_PCM_STREAM_CAPTURE) {
+		mt8519_afe_disable_top_cg(afe, MT8519_TOP_CG_ADC);
+	}
+
+	if (!mt8519_afe_is_int_1x_en_low_power(afe)) {
+		if (rate % 8000)
+			mt8519_afe_disable_apll_associated_cfg(afe,
+				MT8519_AFE_APLL1);
+		else
+			mt8519_afe_disable_apll_associated_cfg(afe,
+				MT8519_AFE_APLL2);
+	}
+
+	mt8519_afe_disable_clk(afe, afe_priv->clocks[MT8519_CLK_TOP_AUD_26M]);
+	mt8519_afe_disable_main_clk(afe);
+}
+
+static int mt8519_afe_int_adda_prepare(struct snd_pcm_substream *substream,
+	struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	unsigned int stream = substream->stream;
+	unsigned int rate = substream->runtime->rate;
+
+	dev_info(dai->dev, "%s stream %d, rate = %d\n", __func__, stream, rate);
+
+	if (!mt8519_afe_is_int_1x_en_low_power(afe)) {
+		if (rate % 8000)
+			mt8519_afe_enable_apll_associated_cfg(afe,
+				MT8519_AFE_APLL1);
+		else
+			mt8519_afe_enable_apll_associated_cfg(afe,
+				MT8519_AFE_APLL2);
+	}
+
+	if (stream == SNDRV_PCM_STREAM_CAPTURE)
+		return 0;
+
+	regmap_update_bits(afe->regmap, ASMO_TIMING_CON0,
+		ASMO_TIMING_CON0_ASMO0_MODE_MASK,
+		ASMO_TIMING_CON0_ASMO0_MODE_VAL(mt8519_afe_fs_timing(rate)));
+
+	return 0;
+}
