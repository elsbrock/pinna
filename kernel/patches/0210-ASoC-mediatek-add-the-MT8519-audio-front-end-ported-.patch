+int mt8519_afe_init_audio_clk(struct mtk_base_afe *afe)
+{
+#ifdef COMMON_CLOCK_FRAMEWORK_API
+	size_t i;
+	struct mt8519_afe_private *afe_priv = afe->platform_priv;
+
+	for (i = 0; i < ARRAY_SIZE(aud_clks); i++) {
+		afe_priv->clocks[i] = devm_clk_get(afe->dev, aud_clks[i]);
+		if (IS_ERR(afe_priv->clocks[i])) {
+			dev_info(afe->dev, "%s devm_clk_get %s fail\n",
+				__func__, aud_clks[i]);
+			return PTR_ERR(afe_priv->clocks[i]);
+		}
+	}
+#endif
+	return 0;
+}
+
+int mt8519_afe_enable_clk(struct mtk_base_afe *afe, struct clk *clk)
+{
+#ifdef COMMON_CLOCK_FRAMEWORK_API
+	int ret;
+
+	if (clk) {
+		ret = clk_prepare_enable(clk);
+		if (ret) {
+			dev_info(afe->dev, "Failed to enable clk\n");
+			return ret;
+		}
+	} else {
+		dev_info(afe->dev, "null clk\n");
+	}
+#endif
+	return 0;
+}
+
+void mt8519_afe_disable_clk(struct mtk_base_afe *afe, struct clk *clk)
+{
+#ifdef COMMON_CLOCK_FRAMEWORK_API
+	if (clk)
+		clk_disable_unprepare(clk);
+	else
+		dev_info(afe->dev, "null clk\n");
+#endif
+}
