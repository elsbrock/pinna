+static int mt8519_afe_gasrc_string_to_id(const char *name)
+{
+	int gasrc_id = -1;
+
+	if (strstr(name, "GASRC0"))
+		gasrc_id = MT8519_GASRC0;
+	else if (strstr(name, "GASRC1"))
+		gasrc_id = MT8519_GASRC1;
+	else if (strstr(name, "GASRC2"))
+		gasrc_id = MT8519_GASRC2;
+	else if (strstr(name, "GASRC3"))
+		gasrc_id = MT8519_GASRC3;
+
+	return gasrc_id;
+}
