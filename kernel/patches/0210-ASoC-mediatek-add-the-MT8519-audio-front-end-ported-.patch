+static int mt8519_afe_handle_etdm_force_on(struct mtk_base_afe *afe,
+	bool probe)
+{
+	struct mt8519_afe_private *priv = afe->platform_priv;
+	struct mt8519_etdm_data *etdm1 = &priv->etdm_data[MT8519_ETDM1];
+	struct mt8519_etdm_data *etdm2 = &priv->etdm_data[MT8519_ETDM2];
+	bool force_apply_etdm1_in;
+	bool force_apply_etdm2_out;
+	bool force_apply_etdm2_in;
+
+	force_apply_etdm1_in =
+		(etdm1->force_on[SNDRV_PCM_STREAM_CAPTURE] &&
+		 (!probe ||
+		  etdm1->force_on_policy[SNDRV_PCM_STREAM_CAPTURE] ==
+		  MT8519_ETDM_FORCE_ON_DEFAULT));
+
+	force_apply_etdm2_out =
+		(etdm2->force_on[SNDRV_PCM_STREAM_PLAYBACK] &&
+		 (!probe ||
+		  etdm2->force_on_policy[SNDRV_PCM_STREAM_PLAYBACK] ==
+		  MT8519_ETDM_FORCE_ON_DEFAULT)) ||
+		(etdm2->force_on[SNDRV_PCM_STREAM_CAPTURE] &&
+		 (!probe ||
+		  etdm2->force_on_policy[SNDRV_PCM_STREAM_CAPTURE] ==
+		  MT8519_ETDM_FORCE_ON_DEFAULT) &&
+		 (etdm2->clock_mode == MT8519_ETDM_SHARED_CLOCK));
+
+	force_apply_etdm2_in =
+		(etdm2->force_on[SNDRV_PCM_STREAM_CAPTURE] &&
+		 (!probe ||
+		  etdm2->force_on_policy[SNDRV_PCM_STREAM_CAPTURE] ==
+		  MT8519_ETDM_FORCE_ON_DEFAULT)) ||
+		(etdm2->force_on[SNDRV_PCM_STREAM_PLAYBACK] &&
+		 (!probe ||
+		  etdm2->force_on_policy[SNDRV_PCM_STREAM_PLAYBACK] ==
+		  MT8519_ETDM_FORCE_ON_DEFAULT) &&
+		 (etdm2->clock_mode == MT8519_ETDM_SHARED_CLOCK));
+
+	if (!force_apply_etdm1_in &&
+	    !force_apply_etdm2_out &&
+	    !force_apply_etdm2_in)
+		return 0;
+
+	mt8519_afe_enable_main_clk(afe);
+
+	if (force_apply_etdm1_in)
+		mt8519_afe_etdm1_in_force_on(afe);
+
+	if (force_apply_etdm2_out)
+		mt8519_afe_etdm2_out_force_on(afe);
+
+	if (force_apply_etdm2_in)
+		mt8519_afe_etdm2_in_force_on(afe);
+
+	return 0;
+}
+
+static int mt8519_afe_handle_etdm_force_off(struct mtk_base_afe *afe)
+{
+	struct mt8519_afe_private *priv = afe->platform_priv;
+	struct mt8519_etdm_data *etdm1 = &priv->etdm_data[MT8519_ETDM1];
+	struct mt8519_etdm_data *etdm2 = &priv->etdm_data[MT8519_ETDM2];
+	bool force_apply_etdm1_in;
+	bool force_apply_etdm2_out;
+	bool force_apply_etdm2_in;
+	bool need_tuner = false;
+	unsigned int rate;
+
+	force_apply_etdm1_in = etdm1->force_on[SNDRV_PCM_STREAM_CAPTURE];
+
+	force_apply_etdm2_out = etdm2->force_on[SNDRV_PCM_STREAM_PLAYBACK] ||
+		(etdm2->force_on[SNDRV_PCM_STREAM_CAPTURE] &&
+		(etdm2->clock_mode == MT8519_ETDM_SHARED_CLOCK));
+
+	force_apply_etdm2_in = etdm2->force_on[SNDRV_PCM_STREAM_CAPTURE] ||
+		(etdm2->force_on[SNDRV_PCM_STREAM_PLAYBACK] &&
+		(etdm2->clock_mode == MT8519_ETDM_SHARED_CLOCK));
+
+	if (!force_apply_etdm1_in &&
+	    !force_apply_etdm2_out &&
+	    !force_apply_etdm2_in)
+		return 0;
+
+	if (force_apply_etdm1_in) {
+		rate = etdm1->force_rate[SNDRV_PCM_STREAM_CAPTURE];
+
+		mt8519_afe_disable_etdm(afe, MT8519_ETDM1,
+			SNDRV_PCM_STREAM_CAPTURE);
+
+		need_tuner = (mt8519_afe_is_int_1x_en_low_power(afe)
+			  && !mt8519_afe_is_etdm_low_power(afe, MT8519_ETDM1,
+					SNDRV_PCM_STREAM_CAPTURE))
+			 || (!mt8519_afe_is_int_1x_en_low_power(afe)
+			   && mt8519_afe_is_etdm_low_power(afe, MT8519_ETDM1,
+					SNDRV_PCM_STREAM_CAPTURE));
+
+		if (need_tuner) {
+			if (rate % 8000) {
+				mt8519_afe_disable_apll_associated_cfg(
+					afe, MT8519_AFE_APLL1);
+			} else {
+				mt8519_afe_disable_apll_associated_cfg(
+					afe, MT8519_AFE_APLL2);
+			}
+		}
+
+		mt8519_afe_disable_top_cg(afe, MT8519_TOP_CG_TDM_IN);
+		mt8519_afe_disable_clk(afe, priv->clocks[MT8519_CLK_TDMIN_MCK]);
+
+		etdm1->force_on_status[SNDRV_PCM_STREAM_CAPTURE] = false;
+	}
+
+	if (force_apply_etdm2_out) {
+		rate = etdm2->force_rate[SNDRV_PCM_STREAM_PLAYBACK];
+
+		mt8519_afe_disable_etdm(afe, MT8519_ETDM2,
+			SNDRV_PCM_STREAM_PLAYBACK);
+
+		need_tuner = (mt8519_afe_is_int_1x_en_low_power(afe)
+			  && !mt8519_afe_is_etdm_low_power(afe, MT8519_ETDM2,
+					SNDRV_PCM_STREAM_PLAYBACK))
+			 || (!mt8519_afe_is_int_1x_en_low_power(afe)
+			   && mt8519_afe_is_etdm_low_power(afe, MT8519_ETDM2,
+					SNDRV_PCM_STREAM_PLAYBACK));
+
+		if (need_tuner) {
+			if (rate % 8000) {
+				mt8519_afe_disable_apll_associated_cfg(
+					afe, MT8519_AFE_APLL1);
+			} else {
+				mt8519_afe_disable_apll_associated_cfg(
+					afe, MT8519_AFE_APLL2);
+			}
+		}
+
+		mt8519_afe_disable_top_cg(afe, MT8519_TOP_CG_I2S_OUT);
+		mt8519_afe_disable_clk(afe,
+			priv->clocks[MT8519_CLK_I2SOUT_MCK]);
+
+		etdm2->force_on_status[SNDRV_PCM_STREAM_PLAYBACK] = false;
+	}
+
+	if (force_apply_etdm2_in) {
+		rate = etdm2->force_rate[SNDRV_PCM_STREAM_CAPTURE];
+
+		mt8519_afe_disable_etdm(afe, MT8519_ETDM2,
+			SNDRV_PCM_STREAM_CAPTURE);
+
+		need_tuner = (mt8519_afe_is_int_1x_en_low_power(afe)
+			  && !mt8519_afe_is_etdm_low_power(afe, MT8519_ETDM2,
+					SNDRV_PCM_STREAM_CAPTURE))
+			 || (!mt8519_afe_is_int_1x_en_low_power(afe)
+			   && mt8519_afe_is_etdm_low_power(afe, MT8519_ETDM2,
+					SNDRV_PCM_STREAM_CAPTURE));
+
+		if (need_tuner) {
+			if (rate % 8000) {
+				mt8519_afe_disable_apll_associated_cfg(
+					afe, MT8519_AFE_APLL1);
+			} else {
+				mt8519_afe_disable_apll_associated_cfg(
+					afe, MT8519_AFE_APLL2);
+			}
+		}
+
+		mt8519_afe_disable_top_cg(afe, MT8519_TOP_CG_I2S_IN);
+		mt8519_afe_disable_clk(afe, priv->clocks[MT8519_CLK_I2SIN_MCK]);
+
+		etdm2->force_on_status[SNDRV_PCM_STREAM_CAPTURE] = false;
+	}
+
+	if (rate % 8000)
+		mt8519_afe_disable_clk(afe, priv->clocks[MT8519_CLK_FA2SYS]);
+
+	mt8519_afe_disable_main_clk(afe);
+
+	return 0;
+}
