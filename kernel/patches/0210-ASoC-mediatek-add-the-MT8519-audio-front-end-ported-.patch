+static int mt8519_afe_etdm1_prepare(struct snd_pcm_substream *substream,
+	struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt8519_afe_private *afe_priv = afe->platform_priv;
+	struct mt8519_be_dai_data *be =
+		&afe_priv->be_data[dai->id - MT8519_AFE_BACKEND_BASE];
+	unsigned int etdm_set = MT8519_ETDM1;
+	struct mt8519_etdm_data *etdm_data = &afe_priv->etdm_data[etdm_set];
+	unsigned int clk_mode = etdm_data->clock_mode;
+	unsigned int stream = substream->stream;
+	bool apply_in_change = (stream == SNDRV_PCM_STREAM_CAPTURE) ||
+		(clk_mode == MT8519_ETDM_SHARED_CLOCK);
+	bool need_tuner = false;
+	bool slave_mode = etdm_data->slave_mode[stream];
+	unsigned int rate = substream->runtime->rate;
+	unsigned int mclk = afe_priv->etdm_data[etdm_set].mclk_freq[stream];
+	int ret;
+
+	dev_dbg(dai->dev, "%s stream %u clk_mode %u occupied %d\n",
+		__func__, stream, clk_mode, etdm_data->occupied[stream]);
+
+	if (etdm_data->occupied[stream] || be->prepared[stream]) {
+		dev_info(afe->dev, "%s '%s' prepared %d, occupied %d\n",
+			__func__, snd_pcm_stream_str(substream),
+			be->prepared[stream], etdm_data->occupied[stream]);
+		return 0;
+	}
+
+	if (apply_in_change)
+		mt8519_afe_inc_etdm_occupy(afe, etdm_set,
+			SNDRV_PCM_STREAM_CAPTURE);
+
+	if (etdm_data->force_on[stream]) {
+		if (apply_in_change && slave_mode)
+			mt8519_afe_enable_etdm(afe, etdm_set,
+				SNDRV_PCM_STREAM_CAPTURE);
+		return 0;
+	}
+
+	if (apply_in_change) {
+		ret = mt8519_afe_prepare_etdm_in(afe, substream, dai,
+						 etdm_set);
+		if (ret)
+			return ret;
+	}
+
+	if (rate % 8000)
+		mt8519_afe_enable_clk(afe, afe_priv->clocks[MT8519_CLK_FA2SYS]);
+
+	if (apply_in_change) {
+		if (mclk == 0)
+			mclk = MT8519_ETDM1_IN_MCLK_MULTIPLIER * rate;
+
+		need_tuner =
+			(mt8519_afe_is_int_1x_en_low_power(afe)
+			&& !mt8519_afe_is_etdm_low_power(afe, etdm_set,
+				SNDRV_PCM_STREAM_CAPTURE))
+			|| (!mt8519_afe_is_int_1x_en_low_power(afe)
+			&& mt8519_afe_is_etdm_low_power(afe, etdm_set,
+				SNDRV_PCM_STREAM_CAPTURE));
+
+		if (need_tuner) {
+			if (rate % 8000) {
+				mt8519_afe_enable_apll_associated_cfg(afe,
+					MT8519_AFE_APLL1);
+			} else {
+				mt8519_afe_enable_apll_associated_cfg(afe,
+					MT8519_AFE_APLL2);
+			}
+		}
+
+		mt8519_afe_set_clk_parent(afe,
+			afe_priv->clocks[MT8519_CLK_TDMIN_M_SEL],
+			(rate % 8000) ?
+			afe_priv->clocks[MT8519_CLK_AUD1] :
+			afe_priv->clocks[MT8519_CLK_AUD2]);
+		mt8519_afe_set_clk_rate(afe,
+			afe_priv->clocks[MT8519_CLK_APLL12_DIV1],
+			mclk);
+		mt8519_afe_enable_etdm(afe, etdm_set,
+			SNDRV_PCM_STREAM_CAPTURE);
+	}
+
+	be->prepared[stream] = true;
+
+	return 0;
+}
