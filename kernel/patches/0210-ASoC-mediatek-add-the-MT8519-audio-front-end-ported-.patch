+int mt8519_afe_is_top_cg_on(struct mtk_base_afe *afe, unsigned int cg_type)
+{
+	struct mt8519_afe_private *afe_priv = afe->platform_priv;
+
+	return afe_priv->top_cg_ref_cnt[cg_type];
+}
