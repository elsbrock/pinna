+
+bool mt8519_afe_rate_supported(unsigned int rate, unsigned int id)
+{
+	switch (id) {
+	case MT8519_AFE_IO_ETDM1_IN:
+	case MT8519_AFE_IO_ETDM2_OUT:
+	case MT8519_AFE_IO_ETDM2_IN:
+		if (rate >= 8000 && rate <= 384000)
+			return true;
+		break;
+	case MT8519_AFE_IO_DMIC:
+	case MT8519_AFE_IO_PCM1:
+	case MT8519_AFE_IO_INT_ADDA:
+		if (rate >= 8000 && rate <= 48000)
+			return true;
+		break;
+	default:
+		break;
+	}
+
+	return false;
+}
+
+bool mt8519_afe_channel_supported(unsigned int channel, unsigned int id)
+{
+	switch (id) {
+	case MT8519_AFE_IO_ETDM1_IN:
+		if (channel >= 1 && channel <= 16)
+			return true;
+		break;
+	case MT8519_AFE_IO_ETDM2_OUT:
+	case MT8519_AFE_IO_ETDM2_IN:
+		if (channel >= 1 && channel <= 8)
+			return true;
+		break;
+	case MT8519_AFE_IO_DMIC:
+		if (channel >= 1 && channel <= 8)
+			return true;
+		break;
+	case MT8519_AFE_IO_PCM1:
+	case MT8519_AFE_IO_INT_ADDA:
+		if (channel >= 1 && channel <= 2)
+			return true;
+		break;
+	default:
+		break;
+	}
+
+	return false;
+}
