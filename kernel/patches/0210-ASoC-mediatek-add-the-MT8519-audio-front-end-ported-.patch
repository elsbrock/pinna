+static int mt8519_afe_component_probe(struct snd_soc_component *component)
+{
+	int ret;
+	struct mtk_base_afe *afe = snd_soc_component_get_drvdata(component);
+
+	ret = mt8519_afe_add_controls(component);
+	if (ret)
+		return ret;
+
+	ret = mt8519_afe_handle_etdm_force_on(afe, true);
+	if (ret)
+		return ret;
+
+	return 0;
+}
+
+static snd_pcm_uframes_t mt8519_afe_pcm_pointer(struct snd_soc_component *comp,
+						struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = substream->private_data;
+	if (snd_soc_rtd_to_cpu(rtd, 0)->id >= MT8519_AFE_MEMIF_NUM)
+		return 0;
+	return mtk_afe_pcm_pointer(comp, substream);
+}
