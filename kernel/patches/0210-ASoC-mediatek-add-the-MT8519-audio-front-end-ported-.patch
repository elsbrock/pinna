+static bool mt8519_afe_gasrc_found_iir_coeff_table_id(int input_rate,
+	int output_rate, int *table_id)
+{
+	int i;
+	const struct mt8519_afe_gasrc_iir_coeff_table_id *table =
+		mt8519_afe_gasrc_iir_coeff_table_ids;
+
+	if (!table_id)
+		return false;
+
+	/* no need to apply iir for up-sample */
+	if (input_rate <= output_rate)
+		return false;
+
+	for (i = 0; i < ARRAY_SIZE(mt8519_afe_gasrc_iir_coeff_table_ids); i++) {
+		if ((table[i].input_rate == input_rate) &&
+			(table[i].output_rate == output_rate)) {
+			*table_id = table[i].table_id;
+			return true;
+		}
+	}
+
+	return false;
+}
+
+static bool mt8519_afe_gasrc_fill_iir_coeff_table(struct mtk_base_afe *afe,
+	int gasrc_id, int table_id)
+{
+	const unsigned int *table;
+	unsigned int ctrl_reg;
+	int i;
+
+	if ((table_id < 0) ||
+		(table_id >= MT8519_AFE_GASRC_IIR_TABLES))
+		return false;
+
+	if (gasrc_id < 0)
+		return false;
+
+	dev_dbg(afe->dev, "%s [%d] table_id %d\n",
+		__func__, gasrc_id, table_id);
+
+	table = &mt8519_afe_gasrc_iir_coeffs[table_id][0];
+
+	/* enable access for iir sram */
+	ctrl_reg = gasrc_ctrl_reg[gasrc_id].con0;
+	regmap_update_bits(afe->regmap, ctrl_reg,
+		GASRC_NEW_CON0_COEFF_SRAM_CTRL,
+		GASRC_NEW_CON0_COEFF_SRAM_CTRL);
+
+	/* fill coeffs from addr 0 */
+	ctrl_reg = gasrc_ctrl_reg[gasrc_id].con11;
+	regmap_write(afe->regmap, ctrl_reg, 0);
+
+	/* fill all coeffs */
+	ctrl_reg = gasrc_ctrl_reg[gasrc_id].con10;
+	for (i = 0; i < IIR_NUMS; i++)
+		regmap_write(afe->regmap, ctrl_reg, table[i]);
+
+	/* disable access for iir sram */
+	ctrl_reg = gasrc_ctrl_reg[gasrc_id].con0;
+	regmap_update_bits(afe->regmap, ctrl_reg,
+		GASRC_NEW_CON0_COEFF_SRAM_CTRL, 0);
+
+	return true;
+}
+
+static bool mt8519_afe_load_gasrc_iir_coeff_table(struct mtk_base_afe *afe,
+	int gasrc_id, int input_rate, int output_rate)
+{
+	int table_id;
+
+	if (mt8519_afe_gasrc_found_iir_coeff_table_id(input_rate,
+			output_rate, &table_id)) {
+		return mt8519_afe_gasrc_fill_iir_coeff_table(afe,
+			gasrc_id, table_id);
+	}
+
+	return false;
+}
+
+static void mt8519_afe_adjust_gasrc_cali_cycles(struct mtk_base_afe *afe,
+	struct snd_soc_dai *dai, int fs_timing, unsigned int rate)
+{
+	struct mt8519_afe_private *afe_priv = afe->platform_priv;
+	const int gasrc_id = mt8519_dai_num_to_gasrc(dai->id);
+	unsigned int *cali_cycles;
+
+	if (gasrc_id < 0)
+		return;
+
+	cali_cycles = &(afe_priv->gasrc_data[gasrc_id].cali_cycles);
+
+	if (fs_timing == MT8519_FS_AMIC_1X_EN_ASYNC) {
+		switch (rate) {
+		case 8000:
+		case 16000:
+		case 32000:
+			*cali_cycles = 64;
+			break;
+		case 48000:
+			*cali_cycles = 48;
+			break;
+		default:
+			*cali_cycles = 64;
+			break;
+		}
+	}
+
+	dev_dbg(afe->dev, "%s [%d] cali_cycles %u\n",
+		__func__, gasrc_id, *cali_cycles);
+}
+
+static int mt8519_afe_configure_gasrc(struct mtk_base_afe *afe,
+	struct snd_pcm_substream *substream,
+	struct snd_soc_dai *dai)
+{
+	struct mt8519_afe_private *afe_priv = afe->platform_priv;
+	struct snd_pcm_runtime * const runtime = substream->runtime;
+	unsigned int stream = substream->stream;
+	const int gasrc_id = mt8519_dai_num_to_gasrc(dai->id);
+	struct mt8519_gasrc_data *gasrc_data;
+	int mux;
+	int input_fs = 0, output_fs = 0;
+	int input_rate = 0, output_rate = 0;
+	int fix_input_rate = 0, fix_output_rate = 0;
+	unsigned int val = 0;
+	unsigned int mask = 0;
+	struct snd_soc_pcm_runtime *be = substream->private_data;
+	struct snd_pcm_substream *paired_substream = NULL;
+	bool duplex;
+	bool *gasrc_op_freq_45m;
+	unsigned int *cali_cycles;
+
+	if (gasrc_id < 0)
+		return -EINVAL;
+
+	gasrc_data = &afe_priv->gasrc_data[gasrc_id];
+
+	mux = mt8519_afe_get_gasrc_mux_config(afe, gasrc_id, stream);
+	duplex = gasrc_data->duplex;
+	gasrc_op_freq_45m = &(gasrc_data->op_freq_45m);
+	cali_cycles = &(gasrc_data->cali_cycles);
+	fix_input_rate = gasrc_data->fix_input_rate;
+	fix_output_rate = gasrc_data->fix_output_rate;
+
+	dev_dbg(dai->dev, "%s [%d] %s fix_input_rate %d, fix_output_rate %d\n",
+		__func__, gasrc_id, PCM_STREAM_STR(substream->stream),
+		fix_input_rate, fix_output_rate);
+
+	if (stream == SNDRV_PCM_STREAM_PLAYBACK) {
+		if (fix_input_rate) {
+			input_fs = mt8519_afe_fs_timing(fix_input_rate);
+			input_rate = fix_input_rate;
+		} else {
+			input_fs = mt8519_afe_fs_timing(runtime->rate);
+			input_rate = runtime->rate;
+		}
+		*gasrc_op_freq_45m = (input_rate % 8000);
+
+		if (fix_output_rate) {
+			output_fs = mt8519_afe_fs_timing(fix_output_rate);
+			output_rate = fix_output_rate;
+		} else {
+			if (duplex) {
+				paired_substream =
+					snd_soc_dpcm_get_substream(be,
+					SNDRV_PCM_STREAM_CAPTURE);
+				output_fs =
+					mt8519_afe_gasrc_get_output_fs(
+					paired_substream, dai->id,
+					paired_substream->runtime->rate);
+				output_rate =
+					mt8519_afe_gasrc_get_output_rate(
+					paired_substream, dai->id,
+					paired_substream->runtime->rate);
+			} else {
+				output_fs =
+					mt8519_afe_gasrc_get_output_fs(
+					substream, dai->id, runtime->rate);
+				output_rate =
+					mt8519_afe_gasrc_get_output_rate(
+					substream, dai->id, runtime->rate);
+			}
+		}
+	} else if (stream == SNDRV_PCM_STREAM_CAPTURE) {
+		if (fix_output_rate) {
+			output_fs = mt8519_afe_fs_timing(fix_output_rate);
+			output_rate = fix_output_rate;
+		} else {
+			output_fs = mt8519_afe_fs_timing(runtime->rate);
+			output_rate = runtime->rate;
+		}
+		*gasrc_op_freq_45m = (output_rate % 8000);
+
+		if (fix_input_rate) {
+			input_fs = mt8519_afe_fs_timing(fix_input_rate);
+			input_rate = fix_input_rate;
+		} else {
+			if (duplex) {
+				paired_substream =
+					snd_soc_dpcm_get_substream(be,
+					SNDRV_PCM_STREAM_PLAYBACK);
+				input_fs =
+					mt8519_afe_gasrc_get_input_fs(
+					paired_substream, dai->id,
+					paired_substream->runtime->rate);
+				input_rate =
+					mt8519_afe_gasrc_get_input_rate(
+					paired_substream, dai->id,
+					paired_substream->runtime->rate);
+			} else {
+				input_fs =
+					mt8519_afe_gasrc_get_input_fs(
+					substream, dai->id, runtime->rate);
+				input_rate =
+					mt8519_afe_gasrc_get_input_rate(
+					substream, dai->id, runtime->rate);
+			}
+		}
+	}
+
+	dev_dbg(dai->dev, "%s [%d] %s input_fs 0x%x, output_fs 0x%x\n",
+		__func__, gasrc_id, PCM_STREAM_STR(substream->stream),
+		input_fs, output_fs);
+	dev_dbg(dai->dev, "%s [%d] %s input_rate %d, output_rate %d\n",
+		__func__, gasrc_id, PCM_STREAM_STR(substream->stream),
+		input_rate, output_rate);
+	dev_dbg(dai->dev, "%s [%d] %s gasrc_op_freq_45m %d\n",
+		__func__, gasrc_id, PCM_STREAM_STR(substream->stream),
+		*gasrc_op_freq_45m);
+
+	if (mt8519_afe_load_gasrc_iir_coeff_table(afe, gasrc_id,
+			input_rate, output_rate)) {
+		mt8519_afe_gasrc_enable_iir(afe, gasrc_id);
+		gasrc_data->iir_on = true;
+	} else {
+		mt8519_afe_gasrc_disable_iir(afe, gasrc_id);
+		gasrc_data->iir_on = false;
+	}
+
+	/* INT_ADDA ADC (RX Tracking of 26m) */
+	if (stream == SNDRV_PCM_STREAM_CAPTURE)
+		mt8519_afe_adjust_gasrc_cali_cycles(afe, dai,
+			input_fs, output_rate);
+
+	mt8519_afe_gasrc_set_input_fs(afe, dai, input_fs);
+	mt8519_afe_gasrc_set_output_fs(afe, dai, output_fs);
+
+	gasrc_data->cali_tx = false;
+	gasrc_data->cali_rx = false;
+	if (stream == SNDRV_PCM_STREAM_PLAYBACK) {
+		if (mt8519_afe_gasrc_is_tx_tracking(output_fs))
+			gasrc_data->cali_tx = true;
+		else
+			gasrc_data->cali_tx = false;
+	} else if (stream == SNDRV_PCM_STREAM_CAPTURE) {
+		if (mt8519_afe_gasrc_is_rx_tracking(input_fs))
+			gasrc_data->cali_rx = true;
+		else
+			gasrc_data->cali_rx = false;
+
+		gasrc_data->cali_tx = false;
+	}
+
+	dev_dbg(dai->dev, "%s [%d] %s cali_tx %d, cali_rx %d\n",
+		__func__, gasrc_id, PCM_STREAM_STR(substream->stream),
+		gasrc_data->cali_tx, gasrc_data->cali_rx);
+
+	switch (mux) {
+	case MUX_GASRC_8CH:
+	case MUX_GASRC_6CH:
+	case MUX_GASRC_4CH:
+		gasrc_data->one_heart = true;
+		break;
+	case MUX_GASRC_2CH:
+		gasrc_data->one_heart = false;
+		break;
+	default:
+		gasrc_data->one_heart = false;
+		break;
+	}
+
+	if (gasrc_data->one_heart && (gasrc_id != MT8519_GASRC0))
+		regmap_update_bits(afe->regmap, gasrc_ctrl_reg[gasrc_id].con0,
+			GASRC_NEW_CON0_ONE_HEART, GASRC_NEW_CON0_ONE_HEART);
+
+	if (stream == SNDRV_PCM_STREAM_PLAYBACK) {
+		mt8519_afe_gasrc_set_tx_mode_fs(afe,
+			dai, input_rate, output_rate);
+		if (gasrc_data->cali_tx) {
+			mt8519_afe_gasrc_sel_cali_clk(afe,
+				dai, *gasrc_op_freq_45m);
+			mt8519_afe_gasrc_sel_lrck(afe, dai, output_fs);
+		}
+	} else if (stream == SNDRV_PCM_STREAM_CAPTURE) {
+		mt8519_afe_gasrc_set_rx_mode_fs(afe,
+			dai, input_rate, output_rate);
+		if (gasrc_data->cali_rx) {
+			mt8519_afe_gasrc_sel_cali_clk(afe,
+				dai, *gasrc_op_freq_45m);
+			mt8519_afe_gasrc_sel_lrck(afe, dai, input_fs);
+		}
+	}
+
+	if (gasrc_data->cali_tx || gasrc_data->cali_rx) {
+
+		val = (*gasrc_op_freq_45m) ?
+			GASRC_NEW_CON7_FREQ_CALC_DENOMINATOR_45M :
+			GASRC_NEW_CON7_FREQ_CALC_DENOMINATOR_49M;
+		mask = GASRC_NEW_CON7_FREQ_CALC_DENOMINATOR_MASK;
+		regmap_update_bits(afe->regmap, gasrc_ctrl_reg[gasrc_id].con7,
+			mask, val);
+
+		val = GASRC_NEW_CON6_FREQ_CALI_CYCLE(*cali_cycles) |
+				GASRC_NEW_CON6_COMP_FREQ_RES_EN |
+				GASRC_NEW_CON6_FREQ_CALI_BP_DGL |
+				GASRC_NEW_CON6_CALI_USE_FREQ_OUT |
+				GASRC_NEW_CON6_FREQ_CALI_AUTO_RESTART;
+		mask = GASRC_NEW_CON6_FREQ_CALI_CYCLE_MASK |
+				GASRC_NEW_CON6_COMP_FREQ_RES_EN |
+				GASRC_NEW_CON6_FREQ_CALI_BP_DGL |
+				GASRC_NEW_CON6_CALI_USE_FREQ_OUT |
+				GASRC_NEW_CON6_FREQ_CALI_AUTO_RESTART;
+
+		regmap_update_bits(afe->regmap, gasrc_ctrl_reg[gasrc_id].con6,
+			mask, val);
+	}
+
+	return 0;
+}
+
+static int mt8519_afe_enable_gasrc(struct snd_soc_dai *dai, int stream)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt8519_afe_private *afe_priv = afe->platform_priv;
+	const int gasrc_id = mt8519_dai_num_to_gasrc(dai->id);
+	struct mt8519_gasrc_data *gasrc_data;
+	unsigned int ctrl_reg = 0;
+	unsigned int val = 0;
+	int ret = 0, counter;
+	bool re_enable = false;
+
+	if (gasrc_id < 0)
+		return -EINVAL;
+
+	gasrc_data = &afe_priv->gasrc_data[gasrc_id];
+
+	if (gasrc_data->re_enable[stream]) {
+		re_enable = true;
+		gasrc_data->re_enable[stream] = false;
+	}
+
+	counter = atomic_add_return(1, &gasrc_data->ref_cnt);
+	if (counter != 1 && !re_enable)
+		return 0;
+
+	dev_dbg(dai->dev, "%s [%d] one_heart %d re_enable %d\n",
+		__func__, gasrc_id, gasrc_data->one_heart, re_enable);
+
+	if (gasrc_data->cali_tx || gasrc_data->cali_rx) {
+		if (gasrc_data->one_heart)
+			ctrl_reg = gasrc_ctrl_reg[MT8519_GASRC0].con6;
+		else
+			ctrl_reg = gasrc_ctrl_reg[gasrc_id].con6;
+
+		val = GASRC_NEW_CON6_CALI_EN;
+		regmap_update_bits(afe->regmap, ctrl_reg, val, val);
+
+		val = GASRC_NEW_CON6_AUTO_TUNE_FREQ2 |
+				GASRC_NEW_CON6_AUTO_TUNE_FREQ3;
+		regmap_update_bits(afe->regmap, ctrl_reg, val, val);
+	}
+
+	if (gasrc_data->one_heart)
+		ctrl_reg = gasrc_ctrl_reg[MT8519_GASRC0].con0;
+	else
+		ctrl_reg = gasrc_ctrl_reg[gasrc_id].con0;
+
+	val = GASRC_NEW_CON0_ASM_ON;
+	regmap_update_bits(afe->regmap, ctrl_reg, val, val);
+
+	return ret;
+}
+
+static int mt8519_afe_disable_gasrc(struct snd_soc_dai *dai, bool directly)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt8519_afe_private *afe_priv = afe->platform_priv;
+	const int gasrc_id = mt8519_dai_num_to_gasrc(dai->id);
+	struct mt8519_gasrc_data *gasrc_data;
+	unsigned int ctrl_reg = 0;
+	unsigned int val = 0;
+	int ret = 0, counter;
+
+	if (gasrc_id < 0)
+		return -EINVAL;
+
+	gasrc_data = &afe_priv->gasrc_data[gasrc_id];
+
+	if (!directly) {
+		counter = atomic_sub_return(1, &gasrc_data->ref_cnt);
+		if (counter < 0) {
+			atomic_add(1, &gasrc_data->ref_cnt);
+			return 0;
+		} else if (counter > 0)
+			return 0;
+	}
+
+	dev_dbg(dai->dev, "%s [%d] one_heart %d directly %d\n",
+		__func__, gasrc_id, gasrc_data->one_heart, directly);
+
+	if (gasrc_data->one_heart)
+		ctrl_reg = gasrc_ctrl_reg[MT8519_GASRC0].con0;
+	else
+		ctrl_reg = gasrc_ctrl_reg[gasrc_id].con0;
+
+	val = GASRC_NEW_CON0_ASM_ON;
+	regmap_update_bits(afe->regmap, ctrl_reg, val, 0);
+
+	if (gasrc_data->cali_tx || gasrc_data->cali_rx) {
+		if (gasrc_data->one_heart)
+			ctrl_reg = gasrc_ctrl_reg[MT8519_GASRC0].con6;
+		else
+			ctrl_reg = gasrc_ctrl_reg[gasrc_id].con6;
+
+		val = GASRC_NEW_CON6_CALI_EN;
+		regmap_update_bits(afe->regmap, ctrl_reg, val, 0);
+	}
+
+	if (gasrc_data->iir_on)
+		mt8519_afe_gasrc_disable_iir(afe, gasrc_id);
+
+	return ret;
+}
+
+static int mt8519_afe_gasrc_startup(struct snd_pcm_substream *substream,
+	struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt8519_afe_private *afe_priv = afe->platform_priv;
+	const int gasrc_id = mt8519_dai_num_to_gasrc(dai->id);
+
+	dev_info(dai->dev, "%s [%d] %s\n", __func__,
+		gasrc_id, PCM_STREAM_STR(substream->stream));
+
+	mt8519_afe_enable_main_clk(afe);
+
+	mt8519_afe_enable_clk(afe, afe_priv->clocks[MT8519_CLK_FASM_L]);
+	mt8519_afe_enable_clk(afe, afe_priv->clocks[MT8519_CLK_FASM_M]);
+	mt8519_afe_enable_clk(afe, afe_priv->clocks[MT8519_CLK_FASM_H]);
+
+	switch (gasrc_id) {
+	case MT8519_GASRC0:
+		mt8519_afe_enable_top_cg(afe, MT8519_TOP_CG_GASRC0);
+		break;
+	case MT8519_GASRC1:
+		mt8519_afe_enable_top_cg(afe, MT8519_TOP_CG_GASRC1);
+		break;
+	case MT8519_GASRC2:
+		mt8519_afe_enable_top_cg(afe, MT8519_TOP_CG_GASRC2);
+		break;
+	case MT8519_GASRC3:
+		mt8519_afe_enable_top_cg(afe, MT8519_TOP_CG_GASRC3);
+		break;
+	default:
+		break;
+	}
+
+	return 0;
+}
+
+static void mt8519_afe_gasrc_shutdown(struct snd_pcm_substream *substream,
+	struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt8519_afe_private *afe_priv = afe->platform_priv;
+	const int gasrc_id = mt8519_dai_num_to_gasrc(dai->id);
+	struct mt8519_gasrc_data *gasrc_data;
+
+	if (gasrc_id < 0)
+		return;
+
+	gasrc_data = &afe_priv->gasrc_data[gasrc_id];
+
+	dev_info(dai->dev, "%s [%d] %s\n", __func__,
+		gasrc_id, PCM_STREAM_STR(substream->stream));
+
+	gasrc_data->re_enable[substream->stream] = false;
+
+	switch (gasrc_id) {
+	case MT8519_GASRC0:
+		mt8519_afe_disable_top_cg(afe, MT8519_TOP_CG_GASRC0);
+		break;
+	case MT8519_GASRC1:
+		mt8519_afe_disable_top_cg(afe, MT8519_TOP_CG_GASRC1);
+		break;
+	case MT8519_GASRC2:
+		mt8519_afe_disable_top_cg(afe, MT8519_TOP_CG_GASRC2);
+		break;
+	case MT8519_GASRC3:
+		mt8519_afe_disable_top_cg(afe, MT8519_TOP_CG_GASRC3);
+		break;
+	default:
+		break;
+	}
+
+	mt8519_afe_disable_clk(afe, afe_priv->clocks[MT8519_CLK_FASM_H]);
+	mt8519_afe_disable_clk(afe, afe_priv->clocks[MT8519_CLK_FASM_M]);
+	mt8519_afe_disable_clk(afe, afe_priv->clocks[MT8519_CLK_FASM_L]);
+
+	mt8519_afe_disable_main_clk(afe);
+}
+
+static int mt8519_afe_gasrc_prepare(struct snd_pcm_substream *substream,
+	struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt8519_afe_private *afe_priv = afe->platform_priv;
+	const int gasrc_id = mt8519_dai_num_to_gasrc(dai->id);
+	struct mt8519_gasrc_data *gasrc_data;
+	int counter;
+
+	if (gasrc_id < 0)
+		return -EINVAL;
+
+	gasrc_data = &afe_priv->gasrc_data[gasrc_id];
+
+	gasrc_data->duplex = false;
+	gasrc_data->op_freq_45m = false;
+	gasrc_data->cali_cycles = 64;
+	gasrc_data->re_enable[substream->stream] = false;
+
+	counter = atomic_read(&gasrc_data->ref_cnt);
+
+	if (snd_soc_dai_stream_active(dai, SNDRV_PCM_STREAM_CAPTURE) && snd_soc_dai_stream_active(dai, SNDRV_PCM_STREAM_PLAYBACK))
+		gasrc_data->duplex = true;
+
+	dev_info(dai->dev, "%s [%d] %s duplex %d\n", __func__,
+		gasrc_id, PCM_STREAM_STR(substream->stream),
+		gasrc_data->duplex);
+
+	if (gasrc_data->duplex && counter > 0) {
+		mt8519_afe_disable_gasrc(dai, true);
+		gasrc_data->re_enable[substream->stream] = true;
+	}
+
+	mt8519_afe_reset_gasrc(afe, dai);
+	mt8519_afe_clear_gasrc(afe, dai);
+	mt8519_afe_gasrc_use_sel(afe, dai, true);
+	mt8519_afe_configure_gasrc(afe, substream, dai);
+
+	return 0;
+}
+
+static int mt8519_afe_gasrc_trigger(struct snd_pcm_substream *substream,
+	int cmd, struct snd_soc_dai *dai)
+{
+	int ret = 0;
+
+	dev_dbg(dai->dev, "%s [%d] %s cmd %d\n", __func__,
+		mt8519_dai_num_to_gasrc(dai->id),
+		PCM_STREAM_STR(substream->stream), cmd);
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+		ret = mt8519_afe_enable_gasrc(dai, substream->stream);
+		break;
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+		ret = mt8519_afe_disable_gasrc(dai, false);
+		break;
+	default:
+		break;
+	}
+
+	return ret;
+}
+
+static int mt8519_afe_configure_multi_in(struct mtk_base_afe *afe,
+	unsigned int channels,
+	unsigned int bit_width,
+	unsigned int period_size,
+	bool spdif_input)
+{
+	struct mt8519_afe_private *afe_priv = afe->platform_priv;
+	struct mt8519_multi_in_data *multi_in = &afe_priv->multi_in_data;
+	unsigned int val;
+	unsigned int period_bytes;
+
+	val = AFE_MPHONE_MULTI_CON0_SDATA0_SEL(0) |
+	      AFE_MPHONE_MULTI_CON0_SDATA1_SEL(1) |
+	      AFE_MPHONE_MULTI_CON0_SDATA2_SEL(2) |
+	      AFE_MPHONE_MULTI_CON0_SDATA3_SEL(3);
+
+	if (spdif_input) {
+		if (bit_width == 32) {
+			val |= AFE_MPHONE_MULTI_CON0_24BIT_DATA;
+
+			period_bytes = period_size * 4 * channels;
+		} else if (bit_width == 24) {
+			val |= AFE_MPHONE_MULTI_CON0_24BIT_DATA;
+
+			period_bytes = period_size * 3 * channels;
+		} else {
+			val |= AFE_MPHONE_MULTI_CON0_16BIT_DATA |
+			       AFE_MPHONE_MULTI_CON0_16BIT_SWAP;
+
+			period_bytes = period_size * 4 * channels;
+		}
+	} else {
+		if (bit_width == 24) {
+			val |= AFE_MPHONE_MULTI_CON0_24BIT_DATA;
+
+			period_bytes = period_size * 3 * channels;
+		} else {
+			val |= AFE_MPHONE_MULTI_CON0_16BIT_DATA;
+
+			period_bytes = period_size * 4 * channels;
+		}
+	}
+
+	if (period_bytes >= 1024) {
+		val |= AFE_MPHONE_MULTI_CON0_256DWORD_PERIOD;
+
+		multi_in->period_update_bytes = 1024;
+	} else if (period_bytes >= 512) {
+		val |= AFE_MPHONE_MULTI_CON0_128DWORD_PERIOD;
+
+		multi_in->period_update_bytes = 512;
+	} else if (period_bytes >= 256) {
+		val |= AFE_MPHONE_MULTI_CON0_64DWORD_PERIOD;
+
+		multi_in->period_update_bytes = 256;
+	} else {
+		val |= AFE_MPHONE_MULTI_CON0_32DWORD_PERIOD;
+
+		multi_in->period_update_bytes = 128;
+	}
+
+	multi_in->notify_irq_count = period_bytes /
+		multi_in->period_update_bytes;
+
+	regmap_update_bits(afe->regmap, AFE_MPHONE_MULTI_CON0,
+			   AFE_MPHONE_MULTI_CON0_SET_MASK, val);
+
+	val = AFE_MPHONE_MULTI_CON1_CH_NUM(channels) |
+	      AFE_MPHONE_MULTI_CON1_BIT_NUM(bit_width) |
+	      AFE_MPHONE_MULTI_CON1_SYNC_ON;
+
+	if (spdif_input) {
+		if (bit_width == 32) {
+			val |= AFE_MPHONE_MULTI_CON1_NON_COMPACT_MODE |
+			       AFE_MPHONE_MULTI_CON1_24BIT_SWAP_BYPASS |
+			       AFE_MPHONE_MULTI_CON1_LRCK_32_CYCLE;
+		} else if (bit_width == 24) {
+			val |= AFE_MPHONE_MULTI_CON1_COMPACT_MODE |
+			       AFE_MPHONE_MULTI_CON1_24BIT_SWAP_BYPASS |
+			       AFE_MPHONE_MULTI_CON1_LRCK_32_CYCLE;
+		} else {
+			val |= AFE_MPHONE_MULTI_CON1_NON_COMPACT_MODE |
+			       AFE_MPHONE_MULTI_CON1_LRCK_32_CYCLE;
+		}
+	} else {
+		val |= AFE_MPHONE_MULTI_CON1_HBR_MODE;
+
+		if (bit_width == 32) {
+			val |= AFE_MPHONE_MULTI_CON1_NON_COMPACT_MODE |
+			       AFE_MPHONE_MULTI_CON1_LRCK_32_CYCLE;
+		} else if (bit_width == 24) {
+			val |= AFE_MPHONE_MULTI_CON1_COMPACT_MODE |
+			       AFE_MPHONE_MULTI_CON1_24BIT_SWAP_BYPASS |
+			       AFE_MPHONE_MULTI_CON1_LRCK_32_CYCLE;
+		} else {
+			val |= AFE_MPHONE_MULTI_CON1_NON_COMPACT_MODE |
+			       AFE_MPHONE_MULTI_CON1_LRCK_16_CYCLE;
+		}
+
+		if (multi_in->format == MT8519_MULTI_IN_FORMAT_I2S) {
+			val |= AFE_MPHONE_MULTI_CON1_DELAY_DATA |
+			       AFE_MPHONE_MULTI_CON1_LEFT_ALIGN;
+		} else if (multi_in->format == MT8519_MULTI_IN_FORMAT_LJ) {
+			val |= AFE_MPHONE_MULTI_CON1_LEFT_ALIGN |
+			       AFE_MPHONE_MULTI_CON1_LRCK_INV;
+		} else if (multi_in->format == MT8519_MULTI_IN_FORMAT_RJ) {
+			val |= AFE_MPHONE_MULTI_CON1_LRCK_INV;
+		}
+
+		if (multi_in->bck_inv)
+			val ^= AFE_MPHONE_MULTI_CON1_BCK_INV;
+
+		if (multi_in->lrck_inv)
+			val ^= AFE_MPHONE_MULTI_CON1_LRCK_INV;
+	}
+
+	regmap_update_bits(afe->regmap, AFE_MPHONE_MULTI_CON1,
+			   AFE_MPHONE_MULTI_CON1_SET_MASK, val);
+
+	multi_in->current_irq_count = 0;
+
+	return 0;
+}
+
+static int mt8519_afe_enable_multi_in(struct mtk_base_afe *afe)
+{
+	regmap_update_bits(afe->regmap, AFE_MPHONE_MULTI_CON0,
+			   AFE_MPHONE_MULTI_CON0_EN,
+			   AFE_MPHONE_MULTI_CON0_EN);
+
+	return 0;
+}
+
+static int mt8519_afe_disable_multi_in(struct mtk_base_afe *afe)
+{
+	struct mt8519_afe_private *afe_priv = afe->platform_priv;
+
+	regmap_update_bits(afe->regmap, AFE_MPHONE_MULTI_CON0,
+			   AFE_MPHONE_MULTI_CON0_EN, 0x0);
+
+	afe_priv->multi_in_data.current_irq_count = 0;
+
+	return 0;
+}
