+static int mt8519_afe_etdm1_startup(struct snd_pcm_substream *substream,
+	struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt8519_afe_private *afe_priv = afe->platform_priv;
+	struct mt8519_etdm_data *etdm_data =
+		&afe_priv->etdm_data[MT8519_ETDM1];
+	unsigned int clk_mode = etdm_data->clock_mode;
+	unsigned int stream = substream->stream;
+
+	dev_dbg(dai->dev, "%s stream %u clk_mode %u\n",
+		__func__, stream, clk_mode);
+
+	if (etdm_data->force_on[stream]) {
+		bool force_apply_in_change =
+			!etdm_data->force_on_status[SNDRV_PCM_STREAM_CAPTURE]
+			&&
+			(etdm_data->force_on_policy[SNDRV_PCM_STREAM_CAPTURE]
+			 == MT8519_ETDM_FORCE_ON_1ST_TRIGGER);
+
+		if (force_apply_in_change) {
+			mt8519_afe_enable_main_clk(afe);
+
+			if (force_apply_in_change)
+				mt8519_afe_etdm1_in_force_on(afe);
+		}
+
+		return 0;
+	}
+
+	mt8519_afe_enable_main_clk(afe);
+
+	if (stream == SNDRV_PCM_STREAM_PLAYBACK)
+		dev_info(dai->dev, "%s stream %u is not supported!\n",
+		__func__, stream);
+
+	if (stream == SNDRV_PCM_STREAM_CAPTURE ||
+	    clk_mode == MT8519_ETDM_SHARED_CLOCK) {
+		mt8519_afe_enable_clk(afe,
+			afe_priv->clocks[MT8519_CLK_TDMIN_MCK]);
+		mt8519_afe_enable_top_cg(afe, MT8519_TOP_CG_TDM_IN);
+	}
+
+	return 0;
+}
