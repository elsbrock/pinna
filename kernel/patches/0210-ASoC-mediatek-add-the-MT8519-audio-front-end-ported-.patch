+static int mt8519_afe_multi_in_set_fmt(struct snd_soc_dai *dai,
+	unsigned int fmt)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt8519_afe_private *afe_priv = afe->platform_priv;
+
+	dev_dbg(dai->dev, "%s fmt 0x%x\n", __func__, fmt);
+
+	switch (fmt & SND_SOC_DAIFMT_FORMAT_MASK) {
+	case SND_SOC_DAIFMT_I2S:
+		afe_priv->multi_in_data.format = MT8519_MULTI_IN_FORMAT_I2S;
+		break;
+	case SND_SOC_DAIFMT_LEFT_J:
+		afe_priv->multi_in_data.format = MT8519_MULTI_IN_FORMAT_LJ;
+		break;
+	case SND_SOC_DAIFMT_RIGHT_J:
+		afe_priv->multi_in_data.format = MT8519_MULTI_IN_FORMAT_RJ;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	switch (fmt & SND_SOC_DAIFMT_INV_MASK) {
+	case SND_SOC_DAIFMT_NB_NF:
+		afe_priv->multi_in_data.bck_inv = false;
+		afe_priv->multi_in_data.lrck_inv = false;
+		break;
+	case SND_SOC_DAIFMT_NB_IF:
+		afe_priv->multi_in_data.bck_inv = false;
+		afe_priv->multi_in_data.lrck_inv = true;
+		break;
+	case SND_SOC_DAIFMT_IB_NF:
+		afe_priv->multi_in_data.bck_inv = true;
+		afe_priv->multi_in_data.lrck_inv = false;
+		break;
+	case SND_SOC_DAIFMT_IB_IF:
+		afe_priv->multi_in_data.bck_inv = true;
+		afe_priv->multi_in_data.lrck_inv = true;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int mt8519_afe_multi_in_trigger(struct snd_pcm_substream *substream,
+	int cmd, struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+
+	dev_dbg(dai->dev, "%s cmd %d\n", __func__, cmd);
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+		mt8519_afe_enable_multi_in(afe);
+		break;
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+		mt8519_afe_disable_multi_in(afe);
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int mt8519_afe_handle_etdm_force_on(struct mtk_base_afe *afe,
+	bool probe);
+
+static int mt8519_afe_handle_etdm_force_off(struct mtk_base_afe *afe);
+
+static int mt8519_afe_dai_suspend(struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = dev_get_drvdata(dai->dev);
+	struct mt8519_afe_private *afe_priv = afe->platform_priv;
+	int i;
+#ifdef CONFIG_MTK_HIFIXDSP_SUPPORT
+	struct mt8519_adsp_data *adsp_data = &(afe_priv->adsp_data);
+#endif
+
+	dev_info(afe->dev, "%s, dai %d suspend %d , c_active:%d, p_active:%d\n",
+		__func__, dai->id, afe->suspended,
+		snd_soc_dai_stream_active(dai, SNDRV_PCM_STREAM_CAPTURE), snd_soc_dai_stream_active(dai, SNDRV_PCM_STREAM_PLAYBACK));
+	for (i = 0; i < snd_soc_dai_active(dai); i++)
+		mt8519_afe_disable_main_clk(afe);
+
+
+	if (afe->suspended)
+		return 0;
+
+#ifdef CONFIG_MTK_HIFIXDSP_SUPPORT
+	/* if ADSP HOSTLESS is active, not do register coverage */
+	if (adsp_data->adsp_on && adsp_data->adsp_active()) {
+		afe->suspended = true;
+		return 0;
+	}
+#endif
+
+	mt8519_afe_handle_etdm_force_off(afe);
+
+	mt8519_afe_enable_main_clk(afe);
+
+	/* do afe suspend */
+	mtk_afe_dai_suspend(dai);
+
+	mt8519_afe_disable_main_clk(afe);
+
+	mt8519_afe_disable_top_cg(afe, MT8519_TOP_CG_AFE_CONN);
+	mt8519_afe_disable_top_cg(afe, MT8519_TOP_CG_AFE);
+	mt8519_afe_disable_top_cg(afe, MT8519_TOP_CG_A1SYS_HOPPING);
+	mt8519_afe_disable_top_cg(afe, MT8519_TOP_CG_A1SYS);
+	mt8519_afe_disable_clk(afe, afe_priv->clocks[MT8519_CLK_TOP_AUD_BUS]);
+
+	dev_dbg(afe->dev, "%s dai %d <<\n", __func__, dai->id);
+
+	return 0;
+}
+
+static int mt8519_afe_dai_resume(struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = dev_get_drvdata(dai->dev);
+	struct mt8519_afe_private *afe_priv = afe->platform_priv;
+	int i;
+#ifdef CONFIG_MTK_HIFIXDSP_SUPPORT
+	struct mt8519_adsp_data *adsp_data = &(afe_priv->adsp_data);
+#endif
+
+	dev_info(afe->dev, "%s, dai %d suspend %d , c_active:%d, p_active:%d\n",
+		__func__, dai->id, afe->suspended,
+		snd_soc_dai_stream_active(dai, SNDRV_PCM_STREAM_CAPTURE), snd_soc_dai_stream_active(dai, SNDRV_PCM_STREAM_PLAYBACK));
+	for (i = 0; i < snd_soc_dai_active(dai); i++)
+		mt8519_afe_enable_main_clk(afe);
+
+	if (!afe->suspended)
+		return 0;
+
+#ifdef CONFIG_MTK_HIFIXDSP_SUPPORT
+	/* if ADSP HOSTLESS is active, not do register coverage */
+	if (adsp_data->adsp_on && adsp_data->adsp_active()) {
+		afe->suspended = false;
+		return 0;
+	}
+#endif
+
+	mt8519_afe_enable_clk(afe, afe_priv->clocks[MT8519_CLK_TOP_AUD_BUS]);
+	mt8519_afe_enable_top_cg(afe, MT8519_TOP_CG_A1SYS);
+	mt8519_afe_enable_top_cg(afe, MT8519_TOP_CG_A1SYS_HOPPING);
+	mt8519_afe_enable_top_cg(afe, MT8519_TOP_CG_AFE);
+	mt8519_afe_enable_top_cg(afe, MT8519_TOP_CG_AFE_CONN);
+
+	mt8519_afe_enable_main_clk(afe);
+
+	/* do afe suspend */
+	mtk_afe_dai_resume(dai);
+
+	mt8519_afe_disable_main_clk(afe);
+
+	mt8519_afe_handle_etdm_force_on(afe, false);
+
+	dev_dbg(afe->dev, "%s dai %d<<\n", __func__, dai->id);
+
+	return 0;
+}
