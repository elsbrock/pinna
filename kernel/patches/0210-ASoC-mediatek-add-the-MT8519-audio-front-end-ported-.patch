+static struct snd_soc_dai *mt8519_get_be_cpu_dai(
+	struct snd_pcm_substream *be_substream,
+	char *dai_name)
+{
+	struct snd_soc_dpcm *dpcm_be;
+	struct snd_soc_dpcm *dpcm_fe;
+	struct snd_soc_pcm_runtime *be = be_substream->private_data;
+	struct snd_soc_pcm_runtime *fe;
+	int stream = be_substream->stream;
+
+	list_for_each_entry(dpcm_fe, &be->dpcm[stream].fe_clients, list_fe) {
+		fe = dpcm_fe->fe;
+
+		list_for_each_entry(dpcm_be,
+			&fe->dpcm[stream].be_clients, list_be) {
+			if (!strcmp(snd_soc_rtd_to_cpu(dpcm_be->be, 0)->name, dai_name))
+				return snd_soc_rtd_to_cpu(dpcm_be->be, 0);
+		}
+	}
+
+	return NULL;
+}
+
+static bool mt8519_be_cpu_dai_matched(struct snd_soc_dapm_widget *w,
+	int dai_id, int stream)
+{
+	struct snd_soc_dapm_path *path;
+	struct snd_soc_dai *dai;
+	bool ret = false;
+	bool playback = (stream == SNDRV_PCM_STREAM_PLAYBACK) ? true : false;
+
+	if (!w)
+		return false;
+
+	if (w->is_ep)
+		return false;
+
+	if (playback) {
+		snd_soc_dapm_widget_for_each_source_path(w, path) {
+			if (path && path->source) {
+				if (!path->connect)
+					continue;
+
+				dai = path->source->priv;
+				if (dai && dai_id == dai->id)
+					return true;
+
+				ret = mt8519_be_cpu_dai_matched(path->source,
+						dai_id, stream);
+				if (ret)
+					return ret;
+			}
+		}
+	} else {
+		snd_soc_dapm_widget_for_each_sink_path(w, path) {
+			if (path && path->sink) {
+				if (!path->connect)
+					continue;
+
+				dai = path->sink->priv;
+				if (dai && dai_id == dai->id)
+					return true;
+
+				ret = mt8519_be_cpu_dai_matched(path->sink,
+						dai_id, stream);
+				if (ret)
+					return ret;
+			}
+		}
+	}
+
+	return false;
+}
+
+static bool mt8519_be_cpu_dai_connected(
+	struct snd_pcm_substream *be_substream,
+	char *dai_name, int stream, int dai_id)
+{
+	struct snd_soc_dai *dai =
+		mt8519_get_be_cpu_dai(be_substream, dai_name);
+	struct snd_soc_dapm_widget *w = NULL;
+
+	if (dai == NULL)
+		return false;
+
+	if (stream == SNDRV_PCM_STREAM_PLAYBACK)
+		w = snd_soc_dai_get_widget(dai, SNDRV_PCM_STREAM_PLAYBACK);
+	else if (stream == SNDRV_PCM_STREAM_CAPTURE)
+		w = snd_soc_dai_get_widget(dai, SNDRV_PCM_STREAM_CAPTURE);
+
+	return mt8519_be_cpu_dai_matched(w, dai_id, stream);
+}
+
+static bool mt8519_get_be_cpu_dai_rate(struct snd_pcm_substream *be_substream,
+	char *dai_name, int stream, int dai_id, unsigned int *rate)
+{
+	struct snd_soc_dai *dai = mt8519_get_be_cpu_dai(be_substream, dai_name);
+	bool ret = false;
+
+	if (!rate)
+		return ret;
+
+	ret = mt8519_be_cpu_dai_connected(be_substream,
+			dai_name, stream, dai_id);
+	if (!ret)
+		return false;
+
+	*rate = be_substream->runtime->rate;
+
+	return ret;
+}
+
+static int mt8519_afe_gasrc_get_input_rate(
+	struct snd_pcm_substream *substream, int dai_id, unsigned int rate)
+{
+	unsigned int input_rate;
+
+	if (mt8519_get_be_cpu_dai_rate(substream, "INT ADDA",
+			SNDRV_PCM_STREAM_CAPTURE, dai_id, &input_rate))
+		return input_rate;
+	else if (mt8519_get_be_cpu_dai_rate(substream, "ETDM1_IN",
+			SNDRV_PCM_STREAM_CAPTURE, dai_id, &input_rate))
+		return input_rate;
+	else if (mt8519_get_be_cpu_dai_rate(substream, "ETDM2_IN",
+			SNDRV_PCM_STREAM_CAPTURE, dai_id, &input_rate))
+		return input_rate;
+	else if (mt8519_get_be_cpu_dai_rate(substream, "DMIC",
+			SNDRV_PCM_STREAM_CAPTURE, dai_id, &input_rate))
+		return input_rate;
+
+	return rate;
+}
+
+static int mt8519_afe_gasrc_get_output_rate(
+	struct snd_pcm_substream *substream, int dai_id, unsigned int rate)
+{
+	unsigned int output_rate;
+
+	if (mt8519_get_be_cpu_dai_rate(substream, "ETDM2_OUT",
+			SNDRV_PCM_STREAM_PLAYBACK, dai_id, &output_rate))
+		return output_rate;
+
+	if (mt8519_get_be_cpu_dai_rate(substream, "INT ADDA",
+			SNDRV_PCM_STREAM_PLAYBACK, dai_id, &output_rate))
+		return output_rate;
+
+	return rate;
+}
+
+static int mt8519_afe_gasrc_get_input_fs(struct snd_pcm_substream *substream,
+	int dai_id, unsigned int rate)
+{
+	struct snd_soc_pcm_runtime *rtd = substream->private_data;
+	struct snd_soc_component *component =
+		snd_soc_rtdcom_lookup(rtd, AFE_PCM_NAME);
+	struct mtk_base_afe *afe = snd_soc_component_get_drvdata(component);
+	struct mt8519_afe_private *afe_priv = afe->platform_priv;
+	int fs;
+	struct mt8519_etdm_data *etdm_data;
+	int be_rate;
+
+	fs = mt8519_afe_fs_timing(rate);
+
+	if (mt8519_be_cpu_dai_connected(substream, "INT ADDA",
+			SNDRV_PCM_STREAM_CAPTURE, dai_id))
+		fs = MT8519_FS_AMIC_1X_EN_ASYNC;
+
+	if (mt8519_be_cpu_dai_connected(substream, "ETDM1_IN",
+			SNDRV_PCM_STREAM_CAPTURE, dai_id)) {
+		etdm_data = &afe_priv->etdm_data[MT8519_ETDM1];
+		if (etdm_data->slave_mode[substream->stream]) {
+			fs = MT8519_FS_ETDMIN1_1X_EN;
+		} else {
+			be_rate = mt8519_afe_gasrc_get_input_rate(substream,
+				dai_id, rate);
+			fs = mt8519_afe_fs_timing(be_rate);
+		}
+	}
+
+	if (mt8519_be_cpu_dai_connected(substream, "ETDM2_IN",
+			SNDRV_PCM_STREAM_CAPTURE, dai_id)) {
+		etdm_data = &afe_priv->etdm_data[MT8519_ETDM2];
+		if (etdm_data->slave_mode[substream->stream]) {
+			fs = MT8519_FS_ETDMIN2_1X_EN;
+		} else {
+			be_rate = mt8519_afe_gasrc_get_input_rate(substream,
+				dai_id, rate);
+			fs = mt8519_afe_fs_timing(be_rate);
+		}
+	}
+
+	if (mt8519_be_cpu_dai_connected(substream, "DMIC",
+			SNDRV_PCM_STREAM_CAPTURE, dai_id)) {
+		be_rate = mt8519_afe_gasrc_get_input_rate(substream,
+			dai_id, rate);
+		fs = mt8519_afe_fs_timing(be_rate);
+	}
+
+	return fs;
+}
+
+static int mt8519_afe_gasrc_get_output_fs(struct snd_pcm_substream *substream,
+	int dai_id, unsigned int rate)
+{
+	struct snd_soc_pcm_runtime *rtd = substream->private_data;
+	struct snd_soc_component *component =
+		snd_soc_rtdcom_lookup(rtd, AFE_PCM_NAME);
+	struct mtk_base_afe *afe = snd_soc_component_get_drvdata(component);
+	struct mt8519_afe_private *afe_priv = afe->platform_priv;
+	int fs;
+	struct mt8519_etdm_data *etdm_data;
+	int be_rate;
+
+	fs = mt8519_afe_fs_timing(rate);
+
+	if (mt8519_be_cpu_dai_connected(substream, "ETDM2_OUT",
+		SNDRV_PCM_STREAM_PLAYBACK, dai_id)) {
+		etdm_data = &afe_priv->etdm_data[MT8519_ETDM2];
+		if (etdm_data->slave_mode[substream->stream]) {
+			fs = MT8519_FS_ETDMOUT2_1X_EN;
+		} else {
+			be_rate = mt8519_afe_gasrc_get_output_rate(substream,
+				dai_id, rate);
+			fs = mt8519_afe_fs_timing(be_rate);
+		}
+	}
+
+	if (mt8519_be_cpu_dai_connected(substream, "INT ADDA",
+		SNDRV_PCM_STREAM_PLAYBACK, dai_id)) {
+		be_rate = mt8519_afe_gasrc_get_output_rate(substream,
+			dai_id, rate);
+		fs = mt8519_afe_fs_timing(be_rate);
+	}
+
+	return fs;
+}
