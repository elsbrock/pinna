+	.probe = mt8519_afe_component_probe,
+	.pointer = mt8519_afe_pcm_pointer,
+	.ack = mtk_afe_pcm_ack,
+	.copy = mt8519_afe_pcm_copy,
+	.pcm_construct = mtk_afe_pcm_new,
+	.pcm_destruct = mtk_afe_pcm_free,
+	.dapm_widgets = mt8519_afe_pcm_widgets,
+	.num_dapm_widgets = ARRAY_SIZE(mt8519_afe_pcm_widgets),
+	.dapm_routes = mt8519_afe_pcm_routes,
+	.num_dapm_routes = ARRAY_SIZE(mt8519_afe_pcm_routes),
+};
+
+static int mt8519_afe_pcm_dev_probe(struct platform_device *pdev)
+{
+	int ret, i, sel_irq;
+	unsigned int irq_id;
+	struct mtk_base_afe *afe;
+	struct mt8519_afe_private *afe_priv;
+	struct resource *res;
+
+	dev_info(&pdev->dev, "%s(), ++\n", __func__);
+
+	ret = dma_set_mask_and_coherent(&pdev->dev, DMA_BIT_MASK(33));
+	if (ret)
+		return ret;
+
+	afe = devm_kzalloc(&pdev->dev, sizeof(*afe), GFP_KERNEL);
+	if (!afe)
+		return -ENOMEM;
+
+	afe->platform_priv = devm_kzalloc(&pdev->dev, sizeof(*afe_priv),
+					  GFP_KERNEL);
+	afe_priv = afe->platform_priv;
+	if (!afe_priv)
+		return -ENOMEM;
+
+	spin_lock_init(&afe_priv->afe_ctrl_lock);
+
+	mutex_init(&afe_priv->afe_clk_mutex);
+
+	mutex_init(&afe_priv->block_dpidle_mutex);
+
+	afe->dev = &pdev->dev;
+
+	irq_id = platform_get_irq(pdev, 0);
+	if (!irq_id) {
+		dev_info(afe->dev, "np %s no irq\n", afe->dev->of_node->name);
+		return -ENXIO;
+	}
+	ret = devm_request_irq(afe->dev, irq_id, mt8519_afe_irq_handler,
+			       0, "Afe_ISR_Handle", (void *)afe);
+	if (ret) {
+		dev_info(afe->dev, "could not request_irq\n");
+		return ret;
+	}
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	afe->base_addr = devm_ioremap_resource(&pdev->dev, res);
+	if (IS_ERR(afe->base_addr))
+		return PTR_ERR(afe->base_addr);
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 1);
+	if (res) {
+		afe_priv->afe_sram_vir_addr =
+			devm_ioremap_resource(&pdev->dev, res);
+		if (!IS_ERR(afe_priv->afe_sram_vir_addr)) {
+			afe_priv->afe_sram_phy_addr = res->start;
+			afe_priv->afe_sram_size = resource_size(res);
+		}
+	}
+
+	/* initial audio related clock */
+	ret = mt8519_afe_init_audio_clk(afe);
+	if (ret) {
+		dev_info(afe->dev, "mt8519_afe_init_audio_clk fail\n");
+		return ret;
+	}
+
+#ifdef DEBUG_AFE_REGISTER_RW
+	afe->regmap = devm_regmap_init(&pdev->dev,
+		&mt8519_afe_regmap_bus, afe,
+		&mt8519_afe_regmap_config);
+#else
+#ifdef COMMON_CLOCK_FRAMEWORK_API
+	 afe->regmap = devm_regmap_init_mmio_clk(&pdev->dev,
+		"top_aud_26m", afe->base_addr,
+		&mt8519_afe_regmap_config);
+#else
+	afe->regmap = devm_regmap_init_mmio(&pdev->dev, afe->base_addr,
+		&mt8519_afe_regmap_config);
+#endif
+#endif
+	if (IS_ERR(afe->regmap))
+		return PTR_ERR(afe->regmap);
+
+	/* memif % irq initialize*/
+	afe->memif_size = MT8519_AFE_MEMIF_NUM;
+	afe->memif = devm_kcalloc(afe->dev, afe->memif_size,
+				  sizeof(*afe->memif), GFP_KERNEL);
+	if (!afe->memif)
+		return -ENOMEM;
+
+	afe->irqs_size = MT8519_AFE_IRQ_NUM;
+	afe->irqs = devm_kcalloc(afe->dev, afe->irqs_size,
+				 sizeof(*afe->irqs), GFP_KERNEL);
+	if (!afe->irqs)
+		return -ENOMEM;
+
+	for (i = 0; i < afe->irqs_size; i++)
+		afe->irqs[i].irq_data = &irq_data[i];
+
+	for (i = 0; i < afe->memif_size; i++) {
+		afe->memif[i].data = &memif_data[i];
+		sel_irq = memif_specified_irqs[i];
+		if (sel_irq >= 0) {
+			afe->memif[i].irq_usage = sel_irq;
+			afe->memif[i].const_irq = 1;
+			afe->irqs[sel_irq].irq_occupyed = true;
+		} else {
+			afe->memif[i].irq_usage = -1;
+		}
+	}
+
+	afe->mtk_afe_hardware = &mt8519_afe_hardware;
+	afe->memif_fs = mt8519_memif_fs;
+	afe->irq_fs = mt8519_irq_fs;
+
+
+	platform_set_drvdata(pdev, afe);
+	g_priv = afe;
+	pm_runtime_enable(&pdev->dev);
+	if (!pm_runtime_enabled(&pdev->dev)) {
+		dev_info(afe->dev, "%s pm_runtime not enabled\n", __func__);
+		ret = mt8519_afe_runtime_resume(&pdev->dev);
+		if (ret)
+			goto err_pm_disable;
+	}
+
+	pm_runtime_get_sync(&pdev->dev);
+
+	afe->reg_back_up_list = mt8519_afe_backup_list;
+	afe->reg_back_up_list_num = ARRAY_SIZE(mt8519_afe_backup_list);
+	afe->runtime_resume = mt8519_afe_runtime_resume;
+	afe->runtime_suspend = mt8519_afe_runtime_suspend;
+#ifdef CONFIG_MTK_HIFIXDSP_SUPPORT
+	afe_priv->adsp_data.afe_memif_set = mt8519_adsp_afe_memif_set;
+	afe_priv->adsp_data.afe_memif_enable = mt8519_adsp_afe_memif_enable;
+	afe_priv->adsp_data.afe_init = mt8519_adsp_afe_init;
+	afe_priv->adsp_data.afe_uninit = mt8519_adsp_afe_uninit;
+	afe_priv->adsp_data.afe_memif_init = mt8519_afe_memif_init;
+	afe_priv->adsp_data.afe_memif_uninit = mt8519_afe_memif_uninit;
+	afe_priv->adsp_data.afe_sram_get = mt8519_afe_sram_get;
+	afe_priv->adsp_data.afe_sram_put = mt8519_afe_sram_put;
+	afe_priv->adsp_data.afe_memif_stop = mt8519_adsp_afe_memif_stop;
+#endif
+
+	/* keep these cg open for dapm to read/write audio register */
+	mt8519_afe_enable_clk(afe, afe_priv->clocks[MT8519_CLK_TOP_AUD_BUS]);
+	mt8519_afe_enable_top_cg(afe, MT8519_TOP_CG_A1SYS);
+	mt8519_afe_enable_top_cg(afe, MT8519_TOP_CG_A1SYS_HOPPING);
+	mt8519_afe_enable_top_cg(afe, MT8519_TOP_CG_AFE);
+	mt8519_afe_enable_top_cg(afe, MT8519_TOP_CG_AFE_CONN);
+
+	mt8519_afe_parse_of(afe, pdev->dev.of_node);
+
+	ret = snd_soc_register_component(&pdev->dev,
+					 &mt8519_afe_component,
+					 mt8519_afe_pcm_dais,
+					 ARRAY_SIZE(mt8519_afe_pcm_dais));
+	if (ret)
+		goto err_component;
+
+	mt8519_afe_init_registers(afe);
+
+	mt8519_afe_init_debugfs(afe);
+
+	dev_info(&pdev->dev, "MT8519 AFE driver initialized.\n");
+	return 0;
+
+err_component:
+	snd_soc_unregister_component(&pdev->dev);
+	pm_runtime_put_sync(&pdev->dev);
+err_pm_disable:
+	pm_runtime_disable(&pdev->dev);
+	return ret;
+}
+
+static void mt8519_afe_pcm_dev_remove(struct platform_device *pdev)
+{
+	struct mtk_base_afe *afe = platform_get_drvdata(pdev);
+	struct mt8519_afe_private *afe_priv = afe->platform_priv;
+
+	mt8519_afe_cleanup_debugfs(afe);
+
+	mt8519_afe_disable_top_cg(afe, MT8519_TOP_CG_AFE_CONN);
+	mt8519_afe_disable_top_cg(afe, MT8519_TOP_CG_AFE);
+	mt8519_afe_disable_top_cg(afe, MT8519_TOP_CG_A1SYS_HOPPING);
+	mt8519_afe_disable_top_cg(afe, MT8519_TOP_CG_A1SYS);
+	mt8519_afe_disable_clk(afe, afe_priv->clocks[MT8519_CLK_TOP_AUD_BUS]);
+
+	pm_runtime_put_sync(&pdev->dev);
+	pm_runtime_disable(&pdev->dev);
+	if (!pm_runtime_status_suspended(&pdev->dev))
+		mt8519_afe_runtime_suspend(&pdev->dev);
+
+	snd_soc_unregister_component(&pdev->dev);
+}
+
+static const struct of_device_id mt8519_afe_pcm_dt_match[] = {
+	{ .compatible = "mediatek,mt8519-afe-pcm", },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt8519_afe_pcm_dt_match);
+
+static const struct dev_pm_ops mt8519_afe_pm_ops = {
+	SET_RUNTIME_PM_OPS(mt8519_afe_dev_runtime_suspend,
+			   mt8519_afe_dev_runtime_resume, NULL)
+};
+
+static struct platform_driver mt8519_afe_pcm_driver = {
+	.driver = {
+		   .name = "mt8519-afe-pcm",
+		   .of_match_table = mt8519_afe_pcm_dt_match,
+#if IS_ENABLED(CONFIG_PM)
+		   .pm = &mt8519_afe_pm_ops,
+#endif
+	},
+	.probe = mt8519_afe_pcm_dev_probe,
+	.remove = mt8519_afe_pcm_dev_remove,
+};
+
+module_platform_driver(mt8519_afe_pcm_driver);
+
+MODULE_DESCRIPTION("Mediatek ALSA SoC AFE platform driver");
+MODULE_AUTHOR("Jia Zeng <jia.zeng@mediatek.com>");
+MODULE_LICENSE("GPL v2");
