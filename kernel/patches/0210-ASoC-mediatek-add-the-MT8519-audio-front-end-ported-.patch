+static int mt8519_afe_query_gasrc_mux(int gasrc_id, int idx)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(gasrc_mux_maps); i++)
+		if ((gasrc_mux_maps[i].gasrc_id == gasrc_id) &&
+			(gasrc_mux_maps[i].idx == idx))
+			return gasrc_mux_maps[i].mux;
+
+	return -EINVAL;
+}
+
+static int mt8519_afe_get_gasrc_mux_config(struct mtk_base_afe *afe,
+	int gasrc_id, unsigned int stream)
+{
+	struct mt8519_afe_private *afe_priv = afe->platform_priv;
+	int input_mux;
+	int output_mux;
+
+	if (gasrc_id < 0)
+		return -EINVAL;
+
+	if (stream == SNDRV_PCM_STREAM_PLAYBACK) {
+		input_mux = mt8519_afe_query_gasrc_mux(gasrc_id,
+			afe_priv->gasrc_data[gasrc_id].input_mux);
+		if (input_mux < 0)
+			return -EINVAL;
+		else
+			return input_mux;
+	} else if (stream == SNDRV_PCM_STREAM_CAPTURE) {
+		output_mux = mt8519_afe_query_gasrc_mux(gasrc_id,
+			afe_priv->gasrc_data[gasrc_id].output_mux);
+		if (output_mux < 0)
+			return -EINVAL;
+		else
+			return output_mux;
+	}
+
+	return -EINVAL;
+}
+
+static int mt8519_dai_num_to_gasrc(int num)
+{
+	int val = num - MT8519_AFE_IO_GASRC0;
+
+	if (val < 0 || val >= MT8519_GASRC_NUM)
+		return -EINVAL;
+
+	return val;
+}
+
+static void mt8519_afe_reset_gasrc(struct mtk_base_afe *afe,
+	struct snd_soc_dai *dai)
+{
+	const int gasrc_id = mt8519_dai_num_to_gasrc(dai->id);
+	unsigned int val = 0;
+
+	switch (gasrc_id) {
+	case MT8519_GASRC0:
+		val = GASRC_CFG0_GASRC0_SOFT_RST;
+		break;
+	case MT8519_GASRC1:
+		val = GASRC_CFG0_GASRC1_SOFT_RST;
+		break;
+	case MT8519_GASRC2:
+		val = GASRC_CFG0_GASRC2_SOFT_RST;
+		break;
+	case MT8519_GASRC3:
+		val = GASRC_CFG0_GASRC3_SOFT_RST;
+		break;
+	default:
+		return;
+	}
+
+	regmap_update_bits(afe->regmap, GASRC_CFG0, val, val);
+	regmap_update_bits(afe->regmap, GASRC_CFG0, val, 0);
+
+}
+
+static void mt8519_afe_clear_gasrc(struct mtk_base_afe *afe,
+	struct snd_soc_dai *dai)
+{
+	const int gasrc_id = mt8519_dai_num_to_gasrc(dai->id);
+	unsigned int ctrl_reg = 0;
+
+	if (gasrc_id < 0)
+		return;
+
+	ctrl_reg = gasrc_ctrl_reg[gasrc_id].con0;
+
+	regmap_update_bits(afe->regmap, ctrl_reg,
+		GASRC_NEW_CON0_CHSET_STR_CLR, GASRC_NEW_CON0_CHSET_STR_CLR);
+}
