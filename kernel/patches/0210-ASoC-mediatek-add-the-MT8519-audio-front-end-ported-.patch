+static ssize_t mt8519_afe_dump_registers(char __user *user_buf,
+					 size_t count,
+					 loff_t *pos,
+					 struct mtk_base_afe *afe,
+					 const struct afe_dump_reg_attr *regs,
+					 size_t regs_len)
+{
+	ssize_t ret, i;
+	char *buf;
+	unsigned int reg_value;
+	int n = 0;
+
+	buf = kmalloc(count, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+
+	mt8519_afe_enable_main_clk(afe);
+
+	for (i = 0; i < regs_len; i++) {
+		if (regmap_read(afe->regmap, regs[i].offset, &reg_value))
+			n += scnprintf(buf + n, count - n, "%s = N/A\n",
+				       regs[i].name);
+		else
+			n += scnprintf(buf + n, count - n, "%s = 0x%x\n",
+				       regs[i].name, reg_value);
+	}
+
+	mt8519_afe_disable_main_clk(afe);
+
+	ret = simple_read_from_buffer(user_buf, count, pos, buf, n);
+	kfree(buf);
+
+	return ret;
+}
