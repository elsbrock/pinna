+static void mt8519_afe_etdm1_shutdown(struct snd_pcm_substream *substream,
+	struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt8519_afe_private *afe_priv = afe->platform_priv;
+	struct mt8519_be_dai_data *be =
+		&afe_priv->be_data[dai->id - MT8519_AFE_BACKEND_BASE];
+	unsigned int etdm_set = MT8519_ETDM1;
+	struct mt8519_etdm_data *etdm_data = &afe_priv->etdm_data[etdm_set];
+	unsigned int clk_mode = etdm_data->clock_mode;
+	unsigned int stream = substream->stream;
+	bool reset_in_change = (stream == SNDRV_PCM_STREAM_CAPTURE) ||
+		(clk_mode == MT8519_ETDM_SHARED_CLOCK);
+	unsigned int rate = substream->runtime->rate;
+	bool need_tuner = false;
+	bool slave_mode = etdm_data->slave_mode[stream];
+
+	dev_dbg(dai->dev, "%s stream %u clk_mode %u\n",
+		__func__, stream, clk_mode);
+
+	if (reset_in_change) {
+		if ((etdm_data->occupied[stream] == 1)
+			&& !etdm_data->force_on[stream]) {
+			need_tuner = (mt8519_afe_is_int_1x_en_low_power(afe)
+				&& !mt8519_afe_is_etdm_low_power(afe, etdm_set,
+					SNDRV_PCM_STREAM_CAPTURE))
+				|| (!mt8519_afe_is_int_1x_en_low_power(afe)
+				&& mt8519_afe_is_etdm_low_power(afe, etdm_set,
+					SNDRV_PCM_STREAM_CAPTURE));
+
+			if (need_tuner) {
+				if (rate % 8000) {
+					mt8519_afe_disable_apll_associated_cfg(
+						afe, MT8519_AFE_APLL1);
+				} else {
+					mt8519_afe_disable_apll_associated_cfg(
+						afe, MT8519_AFE_APLL2);
+				}
+			}
+		}
+		mt8519_afe_dec_etdm_occupy(afe, etdm_set,
+			SNDRV_PCM_STREAM_CAPTURE);
+	}
+
+	if (etdm_data->force_on[stream] && !slave_mode)
+		return;
+
+	if (etdm_data->occupied[stream] == 0) {
+		if (reset_in_change)
+			mt8519_afe_disable_etdm(afe, etdm_set,
+				SNDRV_PCM_STREAM_CAPTURE);
+	}
+	if (etdm_data->force_on[stream] && slave_mode)
+		return;
+
+	if (reset_in_change) {
+		mt8519_afe_disable_top_cg(afe, MT8519_TOP_CG_TDM_IN);
+		mt8519_afe_disable_clk(afe,
+			afe_priv->clocks[MT8519_CLK_TDMIN_MCK]);
+	}
+
+	if (be->prepared[stream]) {
+		be->prepared[stream] = false;
+		if (rate % 8000)
+			mt8519_afe_disable_clk(afe,
+					afe_priv->clocks[MT8519_CLK_FA2SYS]);
+	}
+
+	mt8519_afe_disable_main_clk(afe);
+}
