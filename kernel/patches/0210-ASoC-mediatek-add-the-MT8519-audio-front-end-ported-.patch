+	int ret;
+
+	dev_info(dai->dev, "%s stream %u clk_mode %u occupied %d\n",
+		__func__, stream, clk_mode, etdm_data->occupied[stream]);
+
+	if (etdm_data->occupied[stream] || be->prepared[stream]) {
+		dev_info(afe->dev, "%s '%s' prepared %d, occupied %d\n",
+			__func__, snd_pcm_stream_str(substream),
+			be->prepared[stream], etdm_data->occupied[stream]);
+		return 0;
+	}
+
+	if (apply_out_change)
+		mt8519_afe_inc_etdm_occupy(afe, etdm_set,
+			SNDRV_PCM_STREAM_PLAYBACK);
+
+	if (apply_in_change)
+		mt8519_afe_inc_etdm_occupy(afe, etdm_set,
+			SNDRV_PCM_STREAM_CAPTURE);
+
+	if (etdm_data->force_on[stream]) {
+		if (apply_out_change && slave_mode)
+			mt8519_afe_enable_etdm(afe, etdm_set,
+				SNDRV_PCM_STREAM_PLAYBACK);
+		if (apply_in_change && slave_mode)
+			mt8519_afe_enable_etdm(afe, etdm_set,
+				SNDRV_PCM_STREAM_CAPTURE);
+		return 0;
+	}
+
+	if (apply_out_change) {
+		ret = mt8519_afe_prepare_etdm_out(afe, substream, dai,
+						  etdm_set);
+		if (ret)
+			return ret;
+	}
+
+	if (apply_in_change) {
+		ret = mt8519_afe_prepare_etdm_in(afe, substream, dai,
+						 etdm_set);
+		if (ret)
+			return ret;
+	}
+
+	if (rate % 8000)
+		mt8519_afe_enable_clk(afe, afe_priv->clocks[MT8519_CLK_FA2SYS]);
+
+	if (apply_out_change) {
+		if (mclk == 0)
+			mclk = MT8519_ETDM2_OUT_MCLK_MULTIPLIER * rate;
+
+		need_tuner = (mt8519_afe_is_int_1x_en_low_power(afe)
+			  && !mt8519_afe_is_etdm_low_power(afe,
+				etdm_set, SNDRV_PCM_STREAM_PLAYBACK))
+			  || (!mt8519_afe_is_int_1x_en_low_power(afe)
+			    && mt8519_afe_is_etdm_low_power(afe,
+				etdm_set, SNDRV_PCM_STREAM_PLAYBACK));
+
+		if (need_tuner) {
+			if (rate % 8000) {
+				mt8519_afe_enable_apll_associated_cfg(afe,
+					MT8519_AFE_APLL1);
+			} else {
+				mt8519_afe_enable_apll_associated_cfg(afe,
+					MT8519_AFE_APLL2);
+			}
+		}
+
+		mt8519_afe_set_clk_parent(afe,
+			afe_priv->clocks[MT8519_CLK_I2SOUT_M_SEL],
+			(rate % 8000) ?
+			afe_priv->clocks[MT8519_CLK_AUD1] :
+			afe_priv->clocks[MT8519_CLK_AUD2]);
+		mt8519_afe_set_clk_rate(afe,
+			afe_priv->clocks[MT8519_CLK_APLL12_DIV2],
+			mclk);
+		mt8519_afe_enable_etdm(afe, etdm_set,
+			SNDRV_PCM_STREAM_PLAYBACK);
+	}
+
+	if (apply_in_change) {
+		if (mclk == 0)
+			mclk = MT8519_ETDM2_IN_MCLK_MULTIPLIER * rate;
+
+		need_tuner = (mt8519_afe_is_int_1x_en_low_power(afe)
+			  && !mt8519_afe_is_etdm_low_power(afe, etdm_set,
+				SNDRV_PCM_STREAM_CAPTURE))
+			 || (!mt8519_afe_is_int_1x_en_low_power(afe)
+			   && mt8519_afe_is_etdm_low_power(afe, etdm_set,
+				SNDRV_PCM_STREAM_CAPTURE));
+
+		if (need_tuner) {
+			if (rate % 8000) {
+				mt8519_afe_enable_apll_associated_cfg(afe,
+					MT8519_AFE_APLL1);
+			} else {
+				mt8519_afe_enable_apll_associated_cfg(afe,
+					MT8519_AFE_APLL2);
+			}
+		}
+
+		mt8519_afe_set_clk_parent(afe,
+			afe_priv->clocks[MT8519_CLK_I2SIN_M_SEL],
+			(rate % 8000) ?
+			afe_priv->clocks[MT8519_CLK_AUD1] :
+			afe_priv->clocks[MT8519_CLK_AUD2]);
+		mt8519_afe_set_clk_rate(afe,
+			afe_priv->clocks[MT8519_CLK_APLL12_DIV0],
+			mclk);
+		mt8519_afe_enable_etdm(afe, etdm_set,
+			SNDRV_PCM_STREAM_CAPTURE);
+	}
+	be->prepared[stream] = true;
+
+	return 0;
+}
+
+/* be_clients will get connected after startup callback */
+static bool mt8519_match_1st_be_cpu_dai(struct snd_pcm_substream *substream,
+	char *dai_name)
+{
+	struct snd_soc_pcm_runtime *fe = substream->private_data;
+	int stream = substream->stream;
+	struct snd_soc_dpcm *dpcm;
+	int i = 0;
+
+	list_for_each_entry(dpcm, &fe->dpcm[stream].be_clients, list_be) {
+		struct snd_soc_pcm_runtime *be = dpcm->be;
+
+		if (i > 0)
+			break;
+
+		if (!strcmp(snd_soc_rtd_to_cpu(be, 0)->name, dai_name))
+			return true;
+		i++;
+	}
+
+	return false;
+}
+
+static int mt8519_memif_fs(struct snd_pcm_substream *substream,
+	unsigned int rate)
+{
+	struct snd_soc_pcm_runtime *rtd = substream->private_data;
+	struct snd_soc_component *component =
+		snd_soc_rtdcom_lookup(rtd, AFE_PCM_NAME);
+	struct mtk_base_afe *afe = snd_soc_component_get_drvdata(component);
+	struct mt8519_afe_private *afe_priv = afe->platform_priv;
+	const int dai_id = snd_soc_rtd_to_cpu(rtd, 0)->id;
+	struct mt8519_fe_dai_data *fe_data = &afe_priv->fe_data[dai_id];
+	int fs;
+
+	if (dai_id == MT8519_AFE_MEMIF_UL8)
+		return MT8519_FS_ETDMIN1_NX_EN;
+
+	if (dai_id == MT8519_AFE_MEMIF_UL3 && is_ul3_in_direct_mode(afe))
+		return MT8519_FS_ETDMIN2_NX_EN;
+
+	fs = mt8519_afe_fs_timing(rate);
+
+	if (!fe_data->slave_mode)
+		return fs;
+
+	// slave mode
+	switch (dai_id) {
+	case MT8519_AFE_MEMIF_UL2:
+	case MT8519_AFE_MEMIF_UL3:
+	case MT8519_AFE_MEMIF_UL4:
+	case MT8519_AFE_MEMIF_UL9:
+	case MT8519_AFE_MEMIF_UL10:
+		if (mt8519_match_1st_be_cpu_dai(substream, "ETDM1_IN"))
+			fs = MT8519_FS_ETDMIN1_1X_EN;
+		else if (mt8519_match_1st_be_cpu_dai(substream, "ETDM2_IN"))
+			fs = MT8519_FS_ETDMIN2_1X_EN;
+		break;
+	case MT8519_AFE_MEMIF_DLM:
+	case MT8519_AFE_MEMIF_DL2:
+	case MT8519_AFE_MEMIF_DL3:
+		if (mt8519_match_1st_be_cpu_dai(substream, "ETDM2_OUT"))
+			fs = MT8519_FS_ETDMOUT2_1X_EN;
+		break;
+	default:
+		break;
+	}
+
+	return fs;
+}
+
+static int mt8519_irq_fs(struct snd_pcm_substream *substream,
+	unsigned int rate)
+{
+	int irq_fs = mt8519_memif_fs(substream, rate);
+
+	if (irq_fs == MT8519_FS_ETDMIN1_NX_EN)
+		irq_fs = MT8519_FS_ETDMIN1_1X_EN;
+	else if (irq_fs == MT8519_FS_ETDMIN2_NX_EN)
+		irq_fs = MT8519_FS_ETDMIN2_1X_EN;
+
+	return irq_fs;
+}
+
+static int mt8519_alloc_dmabuf(struct snd_pcm_substream *substream,
+			       struct snd_pcm_hw_params *params,
+			       struct snd_soc_dai *dai)
+{
+	struct snd_soc_pcm_runtime *rtd = substream->private_data;
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt8519_afe_private *afe_priv = afe->platform_priv;
+	const int dai_id = snd_soc_rtd_to_cpu(rtd, 0)->id;
+	struct mtk_base_afe_memif *memif = &afe->memif[dai_id];
+	const struct mtk_base_memif_data *data = memif->data;
+	struct mt8519_fe_dai_data *fe_data = &afe_priv->fe_data[dai_id];
+	const size_t request_size = params_buffer_bytes(params);
+	int ret;
+
+	if (request_size > fe_data->sram_size) {
+		ret = snd_pcm_lib_malloc_pages(substream, request_size);
+		if (ret < 0) {
+			dev_info(afe->dev,
+				"%s %s malloc pages %zu bytes failed %d\n",
+				__func__, data->name, request_size, ret);
+			return ret;
+		}
+
+		fe_data->use_sram = false;
+
+		mt8519_afe_block_dpidle(afe);
+	} else {
+		struct snd_dma_buffer *dma_buf = &substream->dma_buffer;
+
+		dma_buf->dev.type = SNDRV_DMA_TYPE_DEV;
+		dma_buf->dev.dev = substream->pcm->card->dev;
+		dma_buf->area = (unsigned char *)fe_data->sram_vir_addr;
+		dma_buf->addr = fe_data->sram_phy_addr;
+		dma_buf->bytes = request_size;
+		snd_pcm_set_runtime_buffer(substream, dma_buf);
+
+		fe_data->use_sram = true;
+	}
+
+	return 0;
+}
+
+static int mt8519_free_dmabuf(struct snd_pcm_substream *substream,
+			      struct snd_soc_dai *dai)
+{
+	struct snd_soc_pcm_runtime *rtd = substream->private_data;
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt8519_afe_private *afe_priv = afe->platform_priv;
+	const int dai_id = snd_soc_rtd_to_cpu(rtd, 0)->id;
+	struct mt8519_fe_dai_data *fe_data = &afe_priv->fe_data[dai_id];
+	int ret = 0;
+
+	if (fe_data->use_sram) {
+		snd_pcm_set_runtime_buffer(substream, NULL);
+	} else {
+		ret = snd_pcm_lib_free_pages(substream);
+
+		mt8519_afe_unblock_dpidle(afe);
+	}
+
+	return ret;
+}
+
+int mt8519_afe_fe_startup(struct snd_pcm_substream *substream,
+			  struct snd_soc_dai *dai)
+{
+	struct snd_soc_pcm_runtime *rtd = substream->private_data;
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	int memif_num = snd_soc_rtd_to_cpu(rtd, 0)->id;
+	struct mtk_base_afe_memif *memif = &afe->memif[memif_num];
+	const struct snd_pcm_hardware *mtk_afe_hardware = afe->mtk_afe_hardware;
+	int ret;
+
+
+	dev_dbg(dai->dev, "%s %d\n", __func__, dai->id);
+
+	memif->substream = substream;
+
+	if (memif->data->buffer_bytes_align > 0)
+		snd_pcm_hw_constraint_step(substream->runtime, 0,
+				   SNDRV_PCM_HW_PARAM_BUFFER_BYTES,
+				   memif->data->buffer_bytes_align);
+	else
+		snd_pcm_hw_constraint_step(substream->runtime, 0,
+				   SNDRV_PCM_HW_PARAM_BUFFER_BYTES, 16);
+
+	mt8519_afe_enable_main_clk(afe);
+
+	/* enable agent */
+	regmap_update_bits(afe->regmap, memif->data->agent_disable_reg,
+			   1 << memif->data->agent_disable_shift,
+			   0 << memif->data->agent_disable_shift);
+
+	snd_soc_set_runtime_hwparams(substream, mtk_afe_hardware);
+
+	mt8519_afe_irq_direction_enable(afe,
+		memif->irq_usage,
+		MT8519_AFE_IRQ_DIR_MCU);
+
+	ret = snd_pcm_hw_constraint_integer(runtime,
+					    SNDRV_PCM_HW_PARAM_PERIODS);
+	if (ret < 0) {
+		dev_info(afe->dev, "snd_pcm_hw_constraint_integer failed\n");
+		return ret;
+	}
+
+	return ret;
+}
+
+static void mt8519_afe_fe_shutdown(struct snd_pcm_substream *substream,
+	struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+
+	dev_dbg(dai->dev, "%s %d\n", __func__, dai->id);
+
+	mtk_afe_fe_shutdown(substream, dai);
+
+	mt8519_afe_disable_main_clk(afe);
+}
+
+static int mt8519_afe_fe_hw_params(struct snd_pcm_substream *substream,
+				   struct snd_pcm_hw_params *params,
+				   struct snd_soc_dai *dai)
+{
+	struct snd_soc_pcm_runtime *rtd = substream->private_data;
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt8519_afe_private *afe_priv = afe->platform_priv;
+	const int dai_id = snd_soc_rtd_to_cpu(rtd, 0)->id;
+	struct mtk_base_afe_memif *memif = &afe->memif[dai_id];
+	const struct mtk_base_memif_data *data = memif->data;
+	struct mt8519_control_data *ctrl_data = &afe_priv->ctrl_data;
+	unsigned int channels = params_channels(params);
+	int msb_at_bit33 = 0;
+	int msb2_at_bit33 = 0;
+	int ret, fs = 0;
+
+	dev_dbg(afe->dev, "%s [%s] rate %u ch %u bit %u period %u-%u\n",
+		__func__, data->name, params_rate(params), channels,
+		params_width(params), params_period_size(params),
+		params_periods(params));
+
+	if (data->ch_num_shift >= 0)
+		regmap_update_bits(afe->regmap,
+			data->ch_num_reg,
+			data->ch_num_maskbit << data->ch_num_shift,
+			channels << data->ch_num_shift);
+
+	if (data->int_odd_shift >= 0) {
+		unsigned int odd_en = (channels == 1) ? 1 : 0;
+
+		regmap_update_bits(afe->regmap, data->int_odd_reg,
+				   1 << data->int_odd_shift,
+				   odd_en << data->int_odd_shift);
+	}
+
+	if (dai_id == MT8519_AFE_MEMIF_UL2) {
+		unsigned int val = 0;
+
+		if (!ctrl_data->bypass_cm1) {
+			regmap_update_bits(afe->regmap, ASYS_TOP_CON,
+				   ASYS_TCON_O34_O41_1X_EN_MASK,
+				   ASYS_TCON_O34_O41_1X_EN_UL2);
+
+			val |= UL_REORDER_START_DATA(8 + ctrl_data->cm1_start_ch) |
+			       UL_REORDER_CHANNEL(channels) |
+			       UL_REORDER_NO_BYPASS;
+		}
+
+		regmap_update_bits(afe->regmap, AFE_I2S_UL2_REORDER,
+				   UL_REORDER_CTRL_MASK, val);
+	} else if (dai_id == MT8519_AFE_MEMIF_UL9) {
+		unsigned int val = 0;
+
+		if (!ctrl_data->bypass_cm0) {
+			regmap_update_bits(afe->regmap, ASYS_TOP_CON,
+				   ASYS_TCON_O26_O33_1X_EN_MASK,
+				   ASYS_TCON_O26_O33_1X_EN_UL9);
+
+			if (channels > 8)
+				regmap_update_bits(afe->regmap, ASYS_TOP_CON,
+					   ASYS_TCON_O34_O41_1X_EN_MASK,
+					   ASYS_TCON_O34_O41_1X_EN_UL9);
+
+			val |= UL_REORDER_START_DATA(0) |
+			       UL_REORDER_CHANNEL(channels) |
+			       UL_REORDER_NO_BYPASS;
+		}
+
+		regmap_update_bits(afe->regmap, AFE_I2S_UL9_REORDER,
+				   UL_REORDER_CTRL_MASK, val);
+	}
+
+	/* DMA allocate */
+	ret = mt8519_alloc_dmabuf(substream, params, dai);
+
+	if (ret < 0)
+		return ret;
+
+	msb_at_bit33 = upper_32_bits(substream->runtime->dma_addr) ? 1 : 0;
+	memif->phys_buf_addr = lower_32_bits(substream->runtime->dma_addr);
+	memif->buffer_size = substream->runtime->dma_bytes;
+	msb2_at_bit33 =
+		upper_32_bits(substream->runtime->dma_addr + memif->buffer_size - 1) ? 1 : 0;
+
+#if IS_ENABLED(CONFIG_REMAP_ON_DSP_BUS)
+	memif->phys_buf_addr = afe_hal_phys_addr_cpu2dsp(memif->phys_buf_addr);
+#endif
+
+	/* start */
+	if (memif->data->reg_ofs_base >= 0)
+		regmap_write(afe->regmap, memif->data->reg_ofs_base,
+			 memif->phys_buf_addr);
+	/* end */
+	if ((memif->data->reg_ofs_base + AFE_BASE_END_OFFSET) >= 0)
+		regmap_write(afe->regmap,
+				 memif->data->reg_ofs_base + AFE_BASE_END_OFFSET,
+				 memif->phys_buf_addr + memif->buffer_size - 1);
+
+	/* set MSB to 33-bit */
+	if ((memif->data->msb_reg) >= 0 && (memif->data->msb_shift) >= 0)
+		regmap_update_bits(afe->regmap, memif->data->msb_reg,
+			       1 << memif->data->msb_shift,
+			       msb_at_bit33 << memif->data->msb_shift);
+
+	/* set buf end MSB to 33-bit */
+	if ((memif->data->msb2_reg) >= 0 && (memif->data->msb2_shift) >= 0)
+		regmap_update_bits(afe->regmap, memif->data->msb2_reg,
+			       1 << memif->data->msb2_shift,
+			       msb2_at_bit33 << memif->data->msb2_shift);
+
+	/* set channel */
+	if (memif->data->mono_shift >= 0) {
+		unsigned int mono = (params_channels(params) == 1) ? 1 : 0;
+
+		if ((memif->data->mono_reg) >= 0 && (memif->data->mono_shift) >= 0)
+			regmap_update_bits(afe->regmap, memif->data->mono_reg,
+				       1 << memif->data->mono_shift,
+				       mono << memif->data->mono_shift);
+	}
+
+	/* set rate */
+	if (memif->data->fs_shift < 0)
+		return 0;
+
+	fs = afe->memif_fs(substream, params_rate(params));
+
+	if (fs < 0)
+		return -EINVAL;
+
+	if ((memif->data->fs_reg) >= 0 && (memif->data->fs_shift) >= 0)
+		regmap_update_bits(afe->regmap, memif->data->fs_reg,
+			       memif->data->fs_maskbit << memif->data->fs_shift,
+			       fs << memif->data->fs_shift);
+
+	return 0;
+}
+
+static int mt8519_afe_fe_hw_free(struct snd_pcm_substream *substream,
+	struct snd_soc_dai *dai)
+{
+	struct snd_soc_pcm_runtime *rtd = substream->private_data;
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	const int dai_id = snd_soc_rtd_to_cpu(rtd, 0)->id;
+	struct mtk_base_afe_memif *memif = &afe->memif[dai_id];
+
+	dev_dbg(afe->dev, "%s %s\n", __func__, memif->data->name);
+
+	return mt8519_free_dmabuf(substream, dai);
+}
+
+
+static int mt8519_afe_fe_prepare(struct snd_pcm_substream *substream,
+				 struct snd_soc_dai *dai)
+{
+	struct snd_soc_pcm_runtime *rtd = substream->private_data;
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	const int dai_id = snd_soc_rtd_to_cpu(rtd, 0)->id;
+	struct mtk_base_afe_memif *memif = &afe->memif[dai_id];
+	int hd_audio = 0;
+
+	dev_dbg(dai->dev, "%s %d\n", __func__, dai->id);
+
+	/* set hd mode */
+	switch (substream->runtime->format) {
+	case SNDRV_PCM_FORMAT_S16_LE:
+		hd_audio = 0;
+		break;
+	case SNDRV_PCM_FORMAT_S32_LE:
+		hd_audio = 1;
+		break;
+	case SNDRV_PCM_FORMAT_S24_LE:
+		hd_audio = 1;
+		break;
+	case SNDRV_PCM_FORMAT_S24_3LE:
+		hd_audio = 1;
+		break;
+	default:
+		dev_err(afe->dev, "%s() error: unsupported format %d\n",
+			__func__, substream->runtime->format);
+		break;
+	}
+
+	if (memif->data->hd_reg >= 0)
+		regmap_update_bits(afe->regmap, memif->data->hd_reg,
+				       1 << memif->data->hd_shift,
+				       hd_audio << memif->data->hd_shift);
+
+	return mtk_afe_fe_prepare(substream, dai);
+}
+
+int mt8519_afe_fe_trigger(struct snd_pcm_substream *substream, int cmd,
+			  struct snd_soc_dai *dai)
+{
+	struct snd_soc_pcm_runtime *rtd = substream->private_data;
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	const int dai_id = snd_soc_rtd_to_cpu(rtd, 0)->id;
+
+	dev_info(dai->dev, "%s %d cmd %d\n", __func__, dai->id, cmd);
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+		/* enable channel merge */
+		if (dai_id == MT8519_AFE_MEMIF_UL2) {
+			regmap_update_bits(afe->regmap,
+				AFE_I2S_UL2_REORDER,
+				UL_REORDER_EN, UL_REORDER_EN);
+		} else if (dai_id == MT8519_AFE_MEMIF_UL9) {
+			regmap_update_bits(afe->regmap,
+				AFE_I2S_UL9_REORDER,
+				UL_REORDER_EN, UL_REORDER_EN);
+		}
+		break;
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+		/* disable channel merge */
+		if (dai_id == MT8519_AFE_MEMIF_UL2) {
+			regmap_update_bits(afe->regmap,
+				AFE_I2S_UL2_REORDER,
+				UL_REORDER_EN, 0x0);
+		} else if (dai_id == MT8519_AFE_MEMIF_UL9) {
+			regmap_update_bits(afe->regmap,
+				AFE_I2S_UL9_REORDER,
+				UL_REORDER_EN, 0x0);
+		}
+		break;
+	default:
+		break;
+	}
+
+	return mtk_afe_fe_trigger(substream, cmd, dai);
+}
