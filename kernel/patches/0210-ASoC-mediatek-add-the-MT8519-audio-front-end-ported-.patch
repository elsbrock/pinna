+static void mt8519_afe_etdm2_in_force_on(struct mtk_base_afe *afe)
+{
+	struct mt8519_afe_private *priv = afe->platform_priv;
+	struct mt8519_etdm_data *etdm2 = &priv->etdm_data[MT8519_ETDM2];
+	unsigned int mclk, rate;
+	bool need_tuner = false;
+	bool slave_mode = false;
+
+	mclk = etdm2->mclk_freq[SNDRV_PCM_STREAM_CAPTURE];
+	rate = etdm2->force_rate[SNDRV_PCM_STREAM_CAPTURE];
+	slave_mode = etdm2->slave_mode[SNDRV_PCM_STREAM_CAPTURE];
+
+	if (rate % 8000)
+		mt8519_afe_enable_clk(afe, priv->clocks[MT8519_CLK_FA2SYS]);
+
+	if (mclk == 0)
+		mclk = MT8519_ETDM2_IN_MCLK_MULTIPLIER * rate;
+
+	mt8519_afe_enable_clk(afe, priv->clocks[MT8519_CLK_I2SIN_MCK]);
+	mt8519_afe_enable_top_cg(afe, MT8519_TOP_CG_I2S_IN);
+
+	mt8519_afe_configure_etdm_in(afe,
+		MT8519_ETDM2,
+		rate,
+		etdm2->force_channels[SNDRV_PCM_STREAM_CAPTURE],
+		etdm2->force_bit_width[SNDRV_PCM_STREAM_CAPTURE]);
+
+	need_tuner = (mt8519_afe_is_int_1x_en_low_power(afe)
+		  && !mt8519_afe_is_etdm_low_power(afe, MT8519_ETDM2,
+			SNDRV_PCM_STREAM_CAPTURE))
+		 || (!mt8519_afe_is_int_1x_en_low_power(afe)
+		   && mt8519_afe_is_etdm_low_power(afe, MT8519_ETDM2,
+			SNDRV_PCM_STREAM_CAPTURE));
+
+	if (need_tuner) {
+		if (rate % 8000) {
+			mt8519_afe_enable_apll_associated_cfg(afe,
+				MT8519_AFE_APLL1);
+		} else {
+			mt8519_afe_enable_apll_associated_cfg(afe,
+				MT8519_AFE_APLL2);
+		}
+	}
+
+	mt8519_afe_set_clk_parent(afe,
+		priv->clocks[MT8519_CLK_I2SIN_M_SEL],
+		(rate % 8000) ?
+		priv->clocks[MT8519_CLK_AUD1] :
+		priv->clocks[MT8519_CLK_AUD2]);
+	mt8519_afe_set_clk_rate(afe,
+		priv->clocks[MT8519_CLK_APLL12_DIV0],
+		mclk);
+
+	if (!slave_mode)
+		mt8519_afe_enable_etdm(afe, MT8519_ETDM2,
+			SNDRV_PCM_STREAM_CAPTURE);
+
+	etdm2->force_on_status[SNDRV_PCM_STREAM_CAPTURE] = true;
