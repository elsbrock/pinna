+/* AFE_ADC_CLK */
+static int mt8519_afe_adc_clk_event(struct snd_soc_dapm_widget *w,
+	struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *component =
+		snd_soc_dapm_to_component(w->dapm);
+	struct mtk_base_afe *afe = snd_soc_component_get_drvdata(component);
+	struct mt8519_afe_private *afe_priv = afe->platform_priv;
+
+	dev_dbg(afe->dev, "%s, event %d\n", __func__, event);
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		mt8519_afe_enable_main_clk(afe);
+		mt8519_afe_enable_clk(afe,
+			afe_priv->clocks[MT8519_CLK_TOP_AUD_26M]);
+		mt8519_afe_enable_top_cg(afe, MT8519_TOP_CG_ADC);
+		break;
+	case SND_SOC_DAPM_POST_PMD:
+		mt8519_afe_disable_top_cg(afe, MT8519_TOP_CG_ADC);
+		mt8519_afe_disable_clk(afe,
+			afe_priv->clocks[MT8519_CLK_TOP_AUD_26M]);
+		mt8519_afe_disable_main_clk(afe);
+		break;
+	default:
+		break;
+	}
+
+	return 0;
+}
