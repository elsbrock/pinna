+		GASRC_NEW_CON0_CHSET0_IFS_SEL_MASK,
+		GASRC_NEW_CON0_CHSET0_IFS_SEL_TX);
+
+	ctrl_reg = gasrc_ctrl_reg[gasrc_id].con4;
