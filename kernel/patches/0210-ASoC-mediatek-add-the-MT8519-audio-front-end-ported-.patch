+		if (ret) {
+			dev_info(afe->dev, "Failed to set rate\n");
+			return ret;
+		}
+	}
+#endif
+	return 0;
+}
+
+int mt8519_afe_set_clk_parent(struct mtk_base_afe *afe, struct clk *clk,
+			      struct clk *parent)
+{
+#ifdef COMMON_CLOCK_FRAMEWORK_API
+	int ret;
+
+	if (clk && parent) {
+		ret = clk_set_parent(clk, parent);
+		if (ret) {
+			dev_info(afe->dev, "Failed to set parent\n");
+			return ret;
+		}
+	}
+#endif
+	return 0;
+}
