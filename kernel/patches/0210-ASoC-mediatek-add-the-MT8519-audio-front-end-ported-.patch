+static int mt8519_afe_memif_init(struct mtk_base_afe *afe, int memif_id)
+{
+	struct mtk_base_afe_memif *memif = &afe->memif[memif_id];
+
+	mt8519_afe_irq_direction_enable(afe,
+					memif->irq_usage,
+					MT8519_AFE_IRQ_DIR_DSP);
+
+	return 0;
+}
