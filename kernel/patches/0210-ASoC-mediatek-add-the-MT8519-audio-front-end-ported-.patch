+static unsigned int get_top_cg_reg(unsigned int cg_type)
+{
+	switch (cg_type) {
+	case MT8519_TOP_CG_AFE:
+	case MT8519_TOP_CG_APLL:
+	case MT8519_TOP_CG_APLL2:
+	case MT8519_TOP_CG_DAC:
+	case MT8519_TOP_CG_DAC_PREDIS:
+	case MT8519_TOP_CG_ADC:
+	case MT8519_TOP_CG_TML:
+	case MT8519_TOP_CG_UPLINK_TML:
+	case MT8519_TOP_CG_APLL_TUNER:
+	case MT8519_TOP_CG_APLL2_TUNER:
+	case MT8519_TOP_CG_SPIDFIN_TUNER_APLL:
+		return AUDIO_TOP_CON0;
+	case MT8519_TOP_CG_A1SYS_HOPPING:
+		return AUDIO_TOP_CON1;
+	case MT8519_TOP_CG_I2S_IN:
+	case MT8519_TOP_CG_TDM_IN:
+	case MT8519_TOP_CG_I2S_OUT:
+	case MT8519_TOP_CG_ASRC11:
+	case MT8519_TOP_CG_ASRC12:
+	case MT8519_TOP_CG_A1SYS:
+	case MT8519_TOP_CG_A2SYS:
+	case MT8519_TOP_CG_AFE_CONN:
+	case MT8519_TOP_CG_PCMIF:
+	case MT8519_TOP_CG_GASRC0:
+	case MT8519_TOP_CG_GASRC1:
+	case MT8519_TOP_CG_GASRC2:
+	case MT8519_TOP_CG_GASRC3:
+	case MT8519_TOP_CG_MULTI_IN:
+	case MT8519_TOP_CG_INTDIR:
+	case MT8519_TOP_CG_DL_ASRC:
+		return AUDIO_TOP_CON4;
+	case MT8519_TOP_CG_DMIC0:
+	case MT8519_TOP_CG_DMIC1:
+	case MT8519_TOP_CG_DMIC2:
+	case MT8519_TOP_CG_DMIC3:
+		return PWR2_TOP_CON0;
+	case MT8519_TOP_CG_A1SYS_TIMING:
+	case MT8519_TOP_CG_A2SYS_TIMING:
+	case MT8519_TOP_CG_26M_TIMING:
+	case MT8519_TOP_CG_LP_MODE:
+		return ASYS_TOP_CON;
+	default:
+		return 0;
+	}
+}
+
