+static int mt8519_afe_gasrc_source_mux_put(struct snd_kcontrol *kcontrol,
+	struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_dapm_context *dapm =
+		snd_soc_dapm_kcontrol_dapm(kcontrol);
+	struct snd_soc_component *comp = snd_soc_dapm_to_component(dapm);
+	struct mtk_base_afe *afe = snd_soc_component_get_drvdata(comp);
+	struct mt8519_afe_private *afe_priv = afe->platform_priv;
+	struct soc_enum *e = (struct soc_enum *)kcontrol->private_value;
+	const char *name = kcontrol->id.name;
+	int gasrc_id = mt8519_afe_gasrc_string_to_id(name);
+
+	if (gasrc_id < 0)
+		return -EINVAL;
+
+	if (ucontrol->value.enumerated.item[0] >= e->items)
