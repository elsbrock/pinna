+static int mt8519_afe_sinegen_timing_get(struct snd_kcontrol *kcontrol,
+	struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *cmpnt = snd_soc_kcontrol_component(kcontrol);
+	struct mtk_base_afe *afe = snd_soc_component_get_drvdata(cmpnt);
+	unsigned int timing;
+	unsigned int val;
+
+	mt8519_afe_enable_main_clk(afe);
+
+	regmap_read(afe->regmap, AFE_SINEGEN_CON1, &val);
+
+	mt8519_afe_disable_main_clk(afe);
+
+	val = (val & AFE_SINEGEN_CON1_TIMING_CH1_MASK) >> 16;
+
+	switch (val) {
+	case AFE_SINEGEN_CON1_TIMING_8K:
+		timing = SINEGEN_8K;
+		break;
