+static int mt8519_afe_singen_enable_get(struct snd_kcontrol *kcontrol,
+					struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *cmpnt = snd_soc_kcontrol_component(kcontrol);
+	struct mtk_base_afe *afe = snd_soc_component_get_drvdata(cmpnt);
+	unsigned int val = 0;
+
+	mt8519_afe_enable_main_clk(afe);
+
+	regmap_read(afe->regmap, AFE_SINEGEN_CON0, &val);
+
+	mt8519_afe_disable_main_clk(afe);
+
+	ucontrol->value.integer.value[0] = (val & AFE_SINEGEN_CON0_EN);
+
+	return 0;
+}
+
+static int mt8519_afe_singen_enable_put(struct snd_kcontrol *kcontrol,
+					struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *cmpnt = snd_soc_kcontrol_component(kcontrol);
+	struct mtk_base_afe *afe = snd_soc_component_get_drvdata(cmpnt);
+
+	mt8519_afe_enable_main_clk(afe);
+
+	if (ucontrol->value.integer.value[0]) {
+		mt8519_afe_enable_top_cg(afe, MT8519_TOP_CG_TML);
+
+		regmap_update_bits(afe->regmap, AFE_SINEGEN_CON0,
+				   AFE_SINEGEN_CON0_EN,
+				   AFE_SINEGEN_CON0_EN);
+	} else {
+		regmap_update_bits(afe->regmap, AFE_SINEGEN_CON0,
+				   AFE_SINEGEN_CON0_EN,
+				   0x0);
+
+		mt8519_afe_disable_top_cg(afe, MT8519_TOP_CG_TML);
+	}
+
+	mt8519_afe_disable_main_clk(afe);
+
+	return 0;
+}
+
+static int mt8519_afe_sinegen_loopback_mode_get(struct snd_kcontrol *kcontrol,
+	struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *cmpnt = snd_soc_kcontrol_component(kcontrol);
+	struct mtk_base_afe *afe = snd_soc_component_get_drvdata(cmpnt);
+	unsigned int mode;
+	unsigned int val;
+
+	mt8519_afe_enable_main_clk(afe);
+
+	regmap_read(afe->regmap, AFE_SINEGEN_CON0, &val);
+
+	mt8519_afe_disable_main_clk(afe);
+
+	mode = (val & AFE_SINEGEN_CON0_MODE_MASK) >> 27;
+
+	if (mode >= SINEGEN_NONE)
+		mode = SINEGEN_NONE;
+
+	ucontrol->value.integer.value[0] = mode;
+
+	return 0;
+}
+
+static int mt8519_afe_sinegen_loopback_mode_put(struct snd_kcontrol *kcontrol,
+	struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *cmpnt = snd_soc_kcontrol_component(kcontrol);
+	struct mtk_base_afe *afe = snd_soc_component_get_drvdata(cmpnt);
+	unsigned int mode;
+	unsigned int val;
+
+	mode = ucontrol->value.integer.value[0];
+
+	val = (mode << 27) & AFE_SINEGEN_CON0_MODE_MASK;
+
+	mt8519_afe_enable_main_clk(afe);
+
+	regmap_update_bits(afe->regmap, AFE_SINEGEN_CON0,
+			   AFE_SINEGEN_CON0_MODE_MASK, val);
+
+	mt8519_afe_disable_main_clk(afe);
+
+	return 0;
+}
