+static int mt8519_afe_etdm_set_fmt(struct snd_soc_dai *dai, unsigned int fmt)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt8519_afe_private *afe_priv = afe->platform_priv;
+	unsigned int etdm_set = (dai->id == MT8519_AFE_IO_ETDM1_IN) ?
+				 MT8519_ETDM1 : MT8519_ETDM2;
+	unsigned int stream = (dai->id == MT8519_AFE_IO_ETDM2_OUT) ?
+			       SNDRV_PCM_STREAM_PLAYBACK :
+			       SNDRV_PCM_STREAM_CAPTURE;
+
+	if (afe_priv->etdm_data[etdm_set].force_on[stream])
+		return 0;
+
+	switch (fmt & SND_SOC_DAIFMT_FORMAT_MASK) {
+	case SND_SOC_DAIFMT_I2S:
+		afe_priv->etdm_data[etdm_set].format[stream] =
+			MT8519_ETDM_FORMAT_I2S;
+		break;
+	case SND_SOC_DAIFMT_DSP_A:
+		afe_priv->etdm_data[etdm_set].format[stream] =
+			MT8519_ETDM_FORMAT_DSPA;
+		break;
+	case SND_SOC_DAIFMT_DSP_B:
+		afe_priv->etdm_data[etdm_set].format[stream] =
+			MT8519_ETDM_FORMAT_DSPB;
+		break;
+	case SND_SOC_DAIFMT_LEFT_J:
+		afe_priv->etdm_data[etdm_set].format[stream] =
+			MT8519_ETDM_FORMAT_LJ;
+		break;
+	case SND_SOC_DAIFMT_RIGHT_J:
+		afe_priv->etdm_data[etdm_set].format[stream] =
+			MT8519_ETDM_FORMAT_RJ;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	switch (fmt & SND_SOC_DAIFMT_INV_MASK) {
+	case SND_SOC_DAIFMT_NB_NF:
+		afe_priv->etdm_data[etdm_set].bck_inv[stream] = false;
+		afe_priv->etdm_data[etdm_set].lrck_inv[stream] = false;
+		break;
+	case SND_SOC_DAIFMT_NB_IF:
+		afe_priv->etdm_data[etdm_set].bck_inv[stream] = false;
+		afe_priv->etdm_data[etdm_set].lrck_inv[stream] = true;
+		break;
+	case SND_SOC_DAIFMT_IB_NF:
+		afe_priv->etdm_data[etdm_set].bck_inv[stream] = true;
+		afe_priv->etdm_data[etdm_set].lrck_inv[stream] = false;
+		break;
+	case SND_SOC_DAIFMT_IB_IF:
+		afe_priv->etdm_data[etdm_set].bck_inv[stream] = true;
+		afe_priv->etdm_data[etdm_set].lrck_inv[stream] = true;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	switch (fmt & SND_SOC_DAIFMT_MASTER_MASK) {
+	case SND_SOC_DAIFMT_CBM_CFM:
+		afe_priv->etdm_data[etdm_set].slave_mode[stream] = true;
+		break;
+	case SND_SOC_DAIFMT_CBS_CFS:
+		afe_priv->etdm_data[etdm_set].slave_mode[stream] = false;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
