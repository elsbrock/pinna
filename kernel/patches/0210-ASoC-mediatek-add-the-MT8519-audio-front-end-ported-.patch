+# SPDX-License-Identifier: GPL-2.0
+# The MT8519 audio front end (direct PCM paths), ported from Amazon's 5.4
+# release onto 6.12 ASoC (ADR 0034). Amazon's vendor common-AFE layer is
+# carried locally (vendor-*) so it does not collide with 6.12's upstream
+# sound/soc/mediatek/common/. Compile-only: not validated on hardware.
+snd-soc-mt8519-afe-objs := \
+	vendor-mtk-afe-platform-driver.o vendor-mtk-afe-fe-dai.o \
+	mt8519-afe-pcm.o mt8519-afe-controls.o mt8519-afe-utils.o mt8519-afe-debug.o
+obj-$(CONFIG_SND_SOC_MT8519) += snd-soc-mt8519-afe.o
