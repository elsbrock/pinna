From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Simon Elsbrock <simon@iodev.org>
Date: Sun, 15 Nov 2026 13:46:19 +0100
Subject: [PATCH 09/27] iio: adc: mt6577_auxadc: MT8163 support

Ported from LibreEcho-Linux release/0.14.5 (Linux 6.1.178) to Linux 6.12.
---
 drivers/iio/adc/Kconfig         | 1 +
 drivers/iio/adc/mt6577_auxadc.c | 5 +++++
 2 files changed, 6 insertions(+)

diff --git a/drivers/iio/adc/Kconfig b/drivers/iio/adc/Kconfig
index 7484dd98f..4619cd965 100644
--- a/drivers/iio/adc/Kconfig
+++ b/drivers/iio/adc/Kconfig
@@ -960,6 +960,7 @@ config MEDIATEK_MT6577_AUXADC
 	tristate "MediaTek AUXADC driver"
 	depends on ARCH_MEDIATEK || COMPILE_TEST
 	depends on HAS_IOMEM
+	default y if MACH_MT8163
 	help
 	  Say yes here to enable support for MediaTek mt65xx AUXADC.
 
diff --git a/drivers/iio/adc/mt6577_auxadc.c b/drivers/iio/adc/mt6577_auxadc.c
index 3343b54e8..c9f2f01e6 100644
--- a/drivers/iio/adc/mt6577_auxadc.c
+++ b/drivers/iio/adc/mt6577_auxadc.c
@@ -278,6 +278,10 @@ static int mt6577_auxadc_probe(struct platform_device *pdev)
 				     "failed to get auxadc base address\n");
 
 	adc_dev->adc_clk = devm_clk_get_enabled(&pdev->dev, "main");
+	/* The MT8163 vendor device tree names this clock "auxadc-main". */
+	if (IS_ERR(adc_dev->adc_clk) &&
+	    PTR_ERR(adc_dev->adc_clk) != -EPROBE_DEFER)
+		adc_dev->adc_clk = devm_clk_get_enabled(&pdev->dev, "auxadc-main");
 	if (IS_ERR(adc_dev->adc_clk))
 		return dev_err_probe(&pdev->dev, PTR_ERR(adc_dev->adc_clk),
 				     "failed to enable auxadc clock\n");
@@ -312,6 +316,7 @@ static DEFINE_SIMPLE_DEV_PM_OPS(mt6577_auxadc_pm_ops,
 				mt6577_auxadc_resume);
 
 static const struct of_device_id mt6577_auxadc_of_match[] = {
+	{ .compatible = "mediatek,mt8163-auxadc", .data = &mt8173_compat },
 	{ .compatible = "mediatek,mt2701-auxadc", .data = &mt8173_compat },
 	{ .compatible = "mediatek,mt2712-auxadc", .data = &mt8173_compat },
 	{ .compatible = "mediatek,mt7622-auxadc", .data = &mt8173_compat },
