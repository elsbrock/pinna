From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Simon Elsbrock <simon@iodev.org>
Date: Sat, 21 Nov 2026 16:14:13 +0100
Subject: [PATCH] pinctrl: mediatek: add MT8519 pin control, ported to 6.12

The MT8519's pin controller (ADR 0035), from MediaTek's pinctrl-mt8519.c in
Amazon's 5.4 release. It already uses the paris framework
(mtk_paris_pinctrl_probe, struct mtk_pin_soc), so the only change for 6.12 is
the probe signature: mtk_paris_pinctrl_probe now takes the platform device
alone and reads the SoC data from the match entry's .data, as the upstream
MT8186 driver does. The pin table header is MediaTek's, unchanged.

CONFIG_PINCTRL_MT8519 is off in every current variant.
---
 drivers/pinctrl/mediatek/Kconfig              |   10 +
 drivers/pinctrl/mediatek/Makefile             |    1 +
 drivers/pinctrl/mediatek/pinctrl-mt8519.c     |  829 ++++++++++++
 drivers/pinctrl/mediatek/pinctrl-mtk-mt8519.h | 1148 +++++++++++++++++
 4 files changed, 1988 insertions(+)
 create mode 100644 drivers/pinctrl/mediatek/pinctrl-mt8519.c
 create mode 100644 drivers/pinctrl/mediatek/pinctrl-mtk-mt8519.h

diff --git a/drivers/pinctrl/mediatek/Kconfig b/drivers/pinctrl/mediatek/Kconfig
index 7af287252..4ca5ca347 100644
--- a/drivers/pinctrl/mediatek/Kconfig
+++ b/drivers/pinctrl/mediatek/Kconfig
@@ -264,3 +264,13 @@ config PINCTRL_MT6397
 	select PINCTRL_MTK
 
 endmenu
+
+config PINCTRL_MT8519
+	bool "MediaTek MT8519 pin control"
+	depends on OF
+	depends on ARM || COMPILE_TEST
+	default ARCH_MEDIATEK
+	select PINCTRL_MTK_PARIS
+	help
+	  Say yes here to support pin controller and gpio driver
+	  on MediaTek MT8519 SoC.
diff --git a/drivers/pinctrl/mediatek/Makefile b/drivers/pinctrl/mediatek/Makefile
index 680f7e852..80ac7a7ba 100644
--- a/drivers/pinctrl/mediatek/Makefile
+++ b/drivers/pinctrl/mediatek/Makefile
@@ -37,3 +37,4 @@ obj-$(CONFIG_PINCTRL_MT8195)		+= pinctrl-mt8195.o
 obj-$(CONFIG_PINCTRL_MT8365)		+= pinctrl-mt8365.o
 obj-$(CONFIG_PINCTRL_MT8516)		+= pinctrl-mt8516.o
 obj-$(CONFIG_PINCTRL_MT6397)		+= pinctrl-mt6397.o
+obj-$(CONFIG_PINCTRL_MT8519)		+= pinctrl-mt8519.o
diff --git a/drivers/pinctrl/mediatek/pinctrl-mt8519.c b/drivers/pinctrl/mediatek/pinctrl-mt8519.c
new file mode 100644
index 000000000..7715d812a
