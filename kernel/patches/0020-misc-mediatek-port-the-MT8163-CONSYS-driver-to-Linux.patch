 .../conn_soc/common/mt8163/mtk_wcn_consys_hw.c             | 6 ++----
 .../conn_soc/drv_wlan/mt_wifi/wlan/mgmt/stats.c            | 1 +
 .../conn_soc/drv_wlan/mt_wifi/wlan/os/linux/platform.c     | 5 ++---
 10 files changed, 14 insertions(+), 19 deletions(-)

