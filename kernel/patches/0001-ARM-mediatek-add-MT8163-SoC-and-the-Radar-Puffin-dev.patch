+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+
+/ {
+	model = "MT8163";
+	compatible = "mediatek,mt8163";
+	interrupt-parent = <0x01>;
+	#address-cells = <0x02>;
+	#size-cells = <0x02>;
+	version = "evt";
+
+	cpus {
+		#address-cells = <0x01>;
+		#size-cells = <0x00>;
+
+		cpu0: cpu@0 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a53";
+			reg = <0x00>;
+			enable-method = "mt-boot";
+			cpu-idle-states = <0x02 0x02 0x03 0x03 0x03>;
+			cpu-release-addr = <0x00 0x40000200>;
+			clock-frequency = <1300000000>;
+		};
+
+		cpu1: cpu@1 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a53";
+			reg = <0x01>;
+			enable-method = "mt-boot";
+			cpu-idle-states = <0x02 0x02 0x03 0x03 0x03>;
+			cpu-release-addr = <0x00 0x40000200>;
+			clock-frequency = <1300000000>;
+		};
+
+		cpu2: cpu@2 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a53";
+			reg = <0x02>;
+			enable-method = "mt-boot";
+			cpu-idle-states = <0x02 0x02 0x03 0x03 0x03>;
+			cpu-release-addr = <0x00 0x40000200>;
+			clock-frequency = <1300000000>;
+		};
+
+		cpu3: cpu@3 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a53";
+			reg = <0x03>;
+			enable-method = "mt-boot";
+			cpu-idle-states = <0x02 0x02 0x03 0x03 0x03>;
+			cpu-release-addr = <0x00 0x40000200>;
+			clock-frequency = <1300000000>;
+		};
+
+		idle-states {
+			entry-method = "arm,psci";
+
+			cpu-sleep-0-0 {
+				compatible = "arm,idle-state";
+				arm,psci-suspend-param = <0x10000>;
+				entry-latency-us = <0x258>;
+				exit-latency-us = <0x258>;
+				min-residency-us = <0x4b0>;
+				linux,phandle = <0x03>;
+				phandle = <0x03>;
+			};
+
+			cluster-sleep-0 {
+				compatible = "arm,idle-state";
+				arm,psci-suspend-param = <0x2010000>;
+				entry-latency-us = <0x320>;
+				exit-latency-us = <0x3e8>;
+				min-residency-us = <0x7d0>;
+				linux,phandle = <0x02>;
+				phandle = <0x02>;
+			};
+		};
+	};
+
+	cpu_opp_table: opp-table-cpu {
+		compatible = "operating-points-v2";
+		opp-shared;
+
+		opp-600000000 {
+			opp-hz = /bits/ 64 <600000000>;
+			opp-microvolt = <1150000>;
+			clock-latency-ns = <500000>;
+		};
+		opp-741000000 {
+			opp-hz = /bits/ 64 <741000000>;
+			opp-microvolt = <1150000>;
+			clock-latency-ns = <500000>;
+		};
+		opp-871000000 {
+			opp-hz = /bits/ 64 <871000000>;
+			opp-microvolt = <1150000>;
+			clock-latency-ns = <500000>;
+		};
+		opp-1050000000 {
+			opp-hz = /bits/ 64 <1050000000>;
+			opp-microvolt = <1150000>;
+			clock-latency-ns = <500000>;
+		};
+		opp-1133000000 {
+			opp-hz = /bits/ 64 <1133000000>;
+			opp-microvolt = <1200000>;
+			clock-latency-ns = <500000>;
+		};
+		opp-1216000000 {
+			opp-hz = /bits/ 64 <1216000000>;
+			opp-microvolt = <1250000>;
+			clock-latency-ns = <500000>;
+		};
+		opp-1300000000 {
+			opp-hz = /bits/ 64 <1300000000>;
+			opp-microvolt = <1300000>;
+			clock-latency-ns = <500000>;
+		};
+	};
+
+	reserved-memory {
+		#address-cells = <0x02>;
+		#size-cells = <0x02>;
+		ranges;
+
+		atf-reserved-memory@43000000 {
+			compatible = "mediatek,mt8163-atf-reserved-memory";
+			no-map;
+			reg = <0x00 0x43000000 0x00 0x30000>;
+		};
+
+		/*
+		 * MediaTek reserves 2 MiB here for its ram_console, but no driver
+		 * in this kernel binds "mediatek,ram_console" -- the region was
+		 * reserved and then read by nothing. Bind it to pstore/ramoops so
+		 * the kernel console, panic/oops records and a userspace message
+		 * channel survive a reboot and can be read back from
+		 * /sys/fs/pstore after the device comes up.
+		 *
+		 * The zones sum to 0x120000 (1.125 MiB), inside the 2 MiB region.
+		 */
+		ramoops@44400000 {
+			compatible = "ramoops";
+			reg = <0x00 0x44400000 0x00 0x200000>;
+			console-size = <0x80000>;
+			pmsg-size = <0x40000>;
+			record-size = <0x40000>;
+			ftrace-size = <0x20000>;
+			ecc-size = <0x10>;
+		};
+
+		consys-reserve-memory {
+			compatible = "mediatek,consys-reserve-memory";
+			no-map;
+			size = <0x00 0x200000>;
+			alignment = <0x00 0x200000>;
+		};
+	};
+
+	psci {
+		compatible = "arm,psci";
+		method = "smc";
+		cpu_suspend = <0x84000001>;
+		cpu_off = <0x84000002>;
+		cpu_on = <0x84000003>;
+		affinity_info = <0x84000004>;
+	};
+
+	clocks {
+		#address-cells = <0x02>;
+		#size-cells = <0x02>;
+		compatible = "simple-bus";
+		ranges;
+
+		clk_null {
+			compatible = "fixed-clock";
+			#clock-cells = <0x00>;
+			clock-frequency = <0x00>;
+			linux,phandle = <0x33>;
+			phandle = <0x33>;
+		};
+
+		clk26m {
+			compatible = "fixed-clock";
+			#clock-cells = <0x00>;
+			clock-frequency = <0x18cba80>;
+			linux,phandle = <0x20>;
+			phandle = <0x20>;
+		};
+
+		/*
+		 * The board audio helper programs the physical SENINF MCLK output
+		 * to 9.6 MHz.  Model that rate separately from clk26m so the
+		 * AIC3204 clock solver selects dividers for the signal on its pin.
+		 */
+		puffin_codec_mclk: puffin_codec_mclk {
+			compatible = "fixed-clock";
+			#clock-cells = <0x00>;
+			clock-frequency = <0x927c00>;
+		};
+
+		clk32k {
+			compatible = "fixed-clock";
+			#clock-cells = <0x00>;
+			clock-frequency = <0x7d00>;
+		};
+
+		dummy26m {
+			compatible = "fixed-clock";
+			clock-frequency = <0x18cba80>;
+			#clock-cells = <0x00>;
+		};
+	};
+
+	thermal-zones {
+		cpu-thermal {
+			/*
+			 * mtk_thermal implements only .get_temp -- it has no
+			 * .set_trips -- so the interrupt this sensor declares is
+			 * never used to signal a trip crossing and polling is the
+			 * only path by which a trip is ever noticed.
+			 *
+			 * That makes this number the entire reaction time. The
+			 * step_wise governor moves exactly one cooling state per
+			 * poll, and this CPU has seven OPPs, so at the original
+			 * 1000 ms it took six seconds to walk from 1.3 GHz down to
+			 * 600 MHz -- and the same six seconds to come back up
+			 * afterwards. On a device whose whole job is answering
+			 * within a second, that recovery cost is as important as
+			 * the protection: a burst of heat left the CPU slow for
+			 * seconds after the heat was gone. At 250 ms the range
+			 * takes 1.5 s in both directions.
+			 *
+			 * Only the passive delay is shortened. Below every trip
+			 * the zone still polls once a second, which is where the
+			 * device spends nearly all of its time.
+			 */
+			polling-delay-passive = <250>;
+			polling-delay = <1000>;
+			thermal-sensors = <&thermal>;
+
+			/*
+			 * Temperatures are in millicelsius and written in decimal
+			 * on purpose. Both trips were hex literals that disagreed
+			 * with the comments next to them -- 0x14ba8 is 84.904 C,
+			 * not the 85 C it claimed, and 0x1c908 is 117 C, not the
+			 * 115 C it claimed. In both cases the value is right and
+			 * the comment was wrong. Decimal makes the number legible
+			 * at a glance so the two cannot drift apart again.
+			 */
+			/*
+			 * The power an enclosure this size can shed while the die
+			 * sits at the target trip. Four cores at 1.3 GHz draw about
+			 * 2311 mW by the coefficient above, and this part settles at
+			 * 81.5 C running exactly that, so the sustainable figure is a
+			 * little under it. Needs confirming on hardware.
+			 */
+			sustainable-power = <2000>;
+
+			/*
+			 * Mirrors mainline's MediaTek zones: a threshold where
+			 * control begins and a target it regulates toward.
+			 *
+			 * 68 C is what mainline uses for both mt8173 and mt8183, and
+			 * Amazon's own ladder for this SoC starts one degree below
+			 * it at 67 C. Three independent sources agree, which is why
+			 * it is here rather than a number of my own.
+			 *
+			 * It is close to where this device idles -- 66.7 C measured,
+			 * peaks of 71.8 C -- and that is exactly why the governor
+			 * matters. power_allocator treats the threshold as "start
+			 * budgeting" and does not touch the clock while the die is
+			 * below target, so idling astride it costs nothing. Under
+			 * step_wise a mapped trip here would cap the clock at idle,
+			 * which is why nothing is mapped to it.
+			 */
+			trips {
+				threshold: trip-point0 {
+					temperature = <68000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+
+				/*
+				 * The temperature to hold. 80 C is mainline's
+				 * mt8183 figure and sits just under the 81.5 C this
+				 * board reaches on sustained four-core load, so it
+				 * is the first trip in this tree that will actually
+				 * engage: the old 85 C was never reached, and the
+				 * cooling state stayed at 0 for an entire
+				 * characterisation run.
+				 */
+				target: trip-point1 {
+					temperature = <80000>;
+					hysteresis = <2000>;
+					type = "passive";
+				};
+				/*
+				 * Emergency power-off, left at the vendor's value.
+				 *
+				 * This looked like a transcription slip -- 117 C
+				 * beside a comment reading 115 C, exactly one
+				 * hysteresis step apart. It is not. Amazon's own
+				 * thermal.conf for the same SoC gives its CPU zone
+				 * an emergency trip of exactly 117000, wired to
+				 * mtktscpu-sysrst, above a shutdown at 100000. The
+				 * value is inherited and deliberate; only the
+				 * comment beside it was ever wrong.
+				 */
+				cpu-critical {
+					temperature = <117000>;
+					hysteresis = <2000>;
+					type = "critical";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&target>;
+					cooling-device = <&cpu0 0xffffffff 0xffffffff>,
+							 <&cpu1 0xffffffff 0xffffffff>,
+							 <&cpu2 0xffffffff 0xffffffff>,
+							 <&cpu3 0xffffffff 0xffffffff>;
+				};
+			};
+		};
+	};
+
+	timer {
+		compatible = "arm,armv8-timer";
+		interrupt-parent = <0x04>;
+		interrupts = <0x01 0x0d 0xf08 0x01 0x0e 0xf08 0x01 0x0b 0xf08 0x01 0x0a 0xf08>;
+		clock-frequency = <0xc65d40>;
+		/*
+		 * The MT8163 firmware leaves per-CPU virtual timer offsets
+		 * inconsistent.  Use the synchronized physical counter and reset
+		 * timer registers, as required by the ARM32 binding for this case.
+		 */
+		arm,cpu-registers-not-fw-configured;
+	};
+
+	soc {
+		#address-cells = <0x02>;
+		#size-cells = <0x02>;
+		compatible = "simple-bus";
+		ranges;
+
+		chipid@08000000 {
+			compatible = "mediatek,mt8163-chipid";
+			reg = <0x00 0x8000000 0x00 0x10>;
+		};
+
+		topckgen@10000000 {
+			compatible = "mediatek,mt8163-topckgen\0syscon";
+			reg = <0x00 0x10000000 0x00 0x1000>;
+			#clock-cells = <0x01>;
+			linux,phandle = <0x06>;
+			phandle = <0x06>;
+		};
+
+		infracfg@10001000 {
+			compatible = "mediatek,mt8163-infracfg\0syscon";
+			reg = <0x00 0x10001000 0x00 0x1000>;
+			#clock-cells = <0x01>;
+			#reset-cells = <0x01>;
+			linux,phandle = <0x05>;
+			phandle = <0x05>;
+		};
+
+		syscfg_pctl_a@10005000 {
+			compatible = "mediatek,mt8163-pctl-a-syscfg\0syscon";
+			reg = <0x00 0x10005000 0x00 0x1000>;
+			linux,phandle = <0x07>;
+			phandle = <0x07>;
+		};
+
+		toprgu@10007000 {
+			compatible = "mediatek,mt8163-rgu", "mediatek,mt6589-wdt";
+			reg = <0x00 0x10007000 0x00 0x1000>;
+			/*
+			 * The vendor falling-edge bark IRQ cannot be requested through
+			 * Linux 6.1's GIC/sysirq hierarchy and made mtk_wdt probe return
+			 * -EINVAL.  Omit the optional pretimeout IRQ so the watchdog can
+			 * bind, detect the already-running timer, and keep it alive.
+			 */
+			#reset-cells = <0x01>;
+		};
+
+		apxgpt@10008000 {
+			compatible = "mediatek,mt8163-apxgpt";
+			reg = <0x00 0x10008000 0x00 0x1000>;
+			interrupts = <0x00 0x98 0x08>;
+			clocks = <0x05 0x06 0x05 0x46 0x06 0x60>;
+			clock-names = "bus\0clk13m\0rtc_sel";
+		};
+
+		pio: pinctrl@10005000 {
+			compatible = "mediatek,mt8163-pinctrl";
+			reg = <0x00 0x1000b000 0x00 0x1000>;
+			mediatek,pctl-regmap = <0x07>;
+			pins-are-numbered;
+			gpio-controller;
+			#gpio-cells = <0x02>;
+			interrupt-controller;
+			#interrupt-cells = <0x02>;
+			interrupts = <0x00 0x99 0x04 0x00 0x9a 0x04 0x00 0x9b 0x04>;
+			linux,phandle = <0x09>;
+			phandle = <0x09>;
+
+			spi1 {
+				linux,phandle = <0x24>;
+				phandle = <0x24>;
+
+				pins_spi {
+					pinmux = <0x3501 0x3601 0x3701 0x3801>;
+					bias-disable;
+					drive-strength = <0x02>;
+				};
+			};
+
+			uart0gpiodefault {
+				linux,phandle = <0x0b>;
+				phandle = <0x0b>;
+			};
+
+			uart0_rx_set {
+				linux,phandle = <0x0c>;
+				phandle = <0x0c>;
+
+				pins_cmd_dat {
+					pinmux = <0x4f01>;
+				};
+			};
+
+			uart0_rx_clear {
+				linux,phandle = <0x0d>;
+				phandle = <0x0d>;
+
+				pins_cmd_dat {
+					pinmux = <0x4f00>;
+					slew-rate = <0x01>;
+					output-high;
+				};
+			};
+
+			uart0_tx_set {
+				linux,phandle = <0x0e>;
+				phandle = <0x0e>;
+
+				pins_cmd_dat {
+					pinmux = <0x5001>;
+				};
+			};
+
+			uart0_tx_clear {
+				linux,phandle = <0x0f>;
+				phandle = <0x0f>;
+
+				pins_cmd_dat {
+					pinmux = <0x5000>;
+					slew-rate = <0x01>;
+					output-high;
+				};
+			};
+
+			uart1gpiodefault {
+				linux,phandle = <0x10>;
+				phandle = <0x10>;
+			};
+
+			uart1_rx_set {
+				linux,phandle = <0x11>;
+				phandle = <0x11>;
+
+				pins_cmd_dat {
+					pinmux = <0x5101>;
+				};
+			};
+
+			uart1_rx_clear {
+				linux,phandle = <0x12>;
+				phandle = <0x12>;
+
+				pins_cmd_dat {
+					pinmux = <0x5100>;
+					slew-rate = <0x01>;
+					output-high;
+				};
+			};
+
+			uart1_tx_set {
+				linux,phandle = <0x13>;
+				phandle = <0x13>;
+
+				pins_cmd_dat {
+					pinmux = <0x5201>;
+				};
+			};
+
+			uart1_tx_clear {
+				linux,phandle = <0x14>;
+				phandle = <0x14>;
+
+				pins_cmd_dat {
+					pinmux = <0x5200>;
+					slew-rate = <0x01>;
+					output-high;
+				};
+			};
+
+			uart2gpiodefault {
+				linux,phandle = <0x15>;
+				phandle = <0x15>;
+			};
+
+			uart2_rx_set {
+				linux,phandle = <0x16>;
+				phandle = <0x16>;
+
+				pins_cmd_dat {
+					pinmux = <0xe01>;
+				};
+			};
+
+			uart2_rx_clear {
+				linux,phandle = <0x17>;
+				phandle = <0x17>;
+
+				pins_cmd_dat {
+					pinmux = <0xe00>;
+					slew-rate = <0x01>;
+					output-high;
+				};
+			};
+
+			uart2_tx_set {
+				linux,phandle = <0x18>;
+				phandle = <0x18>;
+
+				pins_cmd_dat {
+					pinmux = <0xf01>;
+				};
+			};
+
+			uart2_tx_clear {
+				linux,phandle = <0x19>;
+				phandle = <0x19>;
+
+				pins_cmd_dat {
+					pinmux = <0xf00>;
+					slew-rate = <0x01>;
+					output-high;
+				};
+			};
+
+			uart3gpiodefault {
+				linux,phandle = <0x1a>;
+				phandle = <0x1a>;
+			};
+
+			uart3_rx_set {
+				linux,phandle = <0x1b>;
+				phandle = <0x1b>;
+
+				pins_cmd_dat {
+					pinmux = <0x1001>;
+				};
+			};
+
+			uart3_rx_clear {
+				linux,phandle = <0x1c>;
+				phandle = <0x1c>;
+
+				pins_cmd_dat {
+					pinmux = <0x1000>;
+					slew-rate = <0x01>;
+					output-high;
+				};
+			};
+
+			uart3_tx_set {
+				linux,phandle = <0x1d>;
+				phandle = <0x1d>;
+
+				pins_cmd_dat {
+					pinmux = <0x1101>;
+				};
+			};
+
+			uart3_tx_clear {
+				linux,phandle = <0x1e>;
+				phandle = <0x1e>;
+
+				pins_cmd_dat {
+					pinmux = <0x1100>;
+					slew-rate = <0x01>;
+					output-high;
+				};
+			};
+
+			eint4default {
+				linux,phandle = <0x45>;
+				phandle = <0x45>;
+			};
+
+			eint4 {
+				linux,phandle = <0x46>;
