+/***********************************************************************
+ * mendocino_woofer_irq_work
+ * Send uevent when interrupt for fault is received
+ * *********************************************************************/
+static void mendocino_woofer_irq_work(struct work_struct *work)
+{
+	struct snd_soc_card *card = &mt8519_mendocino_card;
+	struct mt8519_mendocino_priv *priv = snd_soc_card_get_drvdata(card);
+	char *envp[] = { "EVENT=DAC_FAULT_IRQ", NULL };
+
+	if (!priv->woofer_irq_enabled) {
+		dev_err(card->dev, "%s: woofer_irq not enabled!\n", __func__);
+		return;
+	}
+
+	dev_info(card->dev, "%s: sending uevent\n", __func__);
+	kobject_uevent_env(&priv->card->dev->kobj, KOBJ_CHANGE, envp);
+
+	enable_irq(priv->woofer_irq);
+}
+
+/***********************************************************************
+ * mendocino_woofer_irq_callback
+ * Interrupt callback for Woofer Amplifier FAULT and OTW
+ * *********************************************************************/
+static irqreturn_t mendocino_woofer_irq_callback(int irq, void *dev)
+{
+	struct snd_soc_card *card = &mt8519_mendocino_card;
+	struct mt8519_mendocino_priv *priv = snd_soc_card_get_drvdata(card);
+
+	dev_info(dev, "%s: irq: %d\n", __func__, irq);
+
+	if (!priv->woofer_irq_enabled || IS_ERR(priv->woofer_irq_gpiopin)) {
+		pr_err("%s: enabled=%d. woofer_irq_gpio=%d  Cannot proceed!\n",
+		       __func__, priv->woofer_irq_enabled,
+			desc_to_gpio(priv->woofer_irq_gpiopin));
+		return IRQ_HANDLED;
+	}
+
+	disable_irq_nosync(priv->woofer_irq);
+
+	queue_work(priv->woofer_wq, &priv->woofer_work);
+
+	return IRQ_HANDLED;
+}
+
+static int mendocino_irq_probe(struct snd_soc_card *card)
+{
+	struct mt8519_mendocino_priv *priv = snd_soc_card_get_drvdata(card);
+	struct gpio_desc *woofer_irq_gpiopin;
+	int woofer_irq_debounce;
+	int ret = 0;
+
+	dev_info(card->dev, "%s\n", __func__);
+
+	/* Setup Woofer irq if gpio is provided */
+	woofer_irq_gpiopin = devm_gpiod_get(card->dev, "woofer_irq", GPIOD_IN);
+	priv->woofer_irq_gpiopin = woofer_irq_gpiopin;
+	if (IS_ERR(woofer_irq_gpiopin)) {
+		ret = PTR_ERR(woofer_irq_gpiopin);
+		dev_err(card->dev, "%s: gpio_request failed. Error=%d\n",
+			__func__, ret);
+		return ret;
+	}
+
+	ret = device_property_read_u32(card->dev, "woofer-irq-debounce",
+				       &woofer_irq_debounce);
+	if (ret) {
+		dev_err(card->dev, "%s: debounce DT property missing\n", __func__);
+		woofer_irq_debounce = 512000;
+	}
+
+	gpiod_direction_input(woofer_irq_gpiopin);
+	gpiod_set_debounce(woofer_irq_gpiopin, woofer_irq_debounce);
+
+	priv->woofer_irq = gpiod_to_irq(woofer_irq_gpiopin);
+
+	ret = request_irq(priv->woofer_irq, mendocino_woofer_irq_callback,
+			  IRQF_TRIGGER_FALLING, "wooferirq-eint", card);
+	if (ret) {
+		dev_err(card->dev, "%s: woofer_irq request_irq failed. Error=%d\n",
+			__func__, ret);
+		return ret;
+	}
+
+	priv->woofer_wq = alloc_workqueue("mendocino_woofer_irq_wq",
+					       WQ_MEM_RECLAIM, 0);
+	if (!priv->woofer_wq) {
+		dev_err(card->dev, "%s:Couldn't allocate Woofer WQ\n", __func__);
+		return -ENOMEM;
+	}
+
+	INIT_WORK(&priv->woofer_work, mendocino_woofer_irq_work);
+
+	dev_info(card->dev, "%s: woofer_irq gpio=%d irq=%d, deb=%d\n",
+		 __func__, desc_to_gpio(woofer_irq_gpiopin), priv->woofer_irq,
+		 woofer_irq_debounce);
+
+	return ret;
+}
