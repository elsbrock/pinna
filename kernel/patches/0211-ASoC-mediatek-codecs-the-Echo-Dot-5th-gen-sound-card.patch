+static int mt8519_mendocino_hw_free(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd;
+	struct mt8519_mendocino_priv *priv;
+	struct mtk_base_afe *afe;
+	int error = 0;
+
+	afe = mt8519_afe_pcm_get_info();
+
+	if (!substream || !substream->private_data)
+		return 0;
+	rtd = substream->private_data;
+	priv = snd_soc_card_get_drvdata(rtd->card);
+	/* turn off bclk before putting AMP in sleep state */
+	if (strstr(snd_soc_rtd_to_codec(rtd, 0)->name, "tas5805m")) {
+		mutex_lock(&priv->amp_lock);
+		if (!priv->force_i2s_enable)
+			error = mt8519_afe_force_etdm2_out_enable(afe, 0);
+		if (error) {
+			dev_warn(rtd->card->dev, "%s I2S disable error %d\n",
+				__func__, error);
+		}
+		priv->amp_playing = false;
+		mutex_unlock(&priv->amp_lock);
+		dev_info(rtd->card->dev, "%s\n", __func__);
+	}
+
+	return 0;
+}
