+#ifdef CONFIG_MTK_HIFIXDSP_SUPPORT
+static int mt8519_adsp_hostless_va_init(struct snd_soc_pcm_runtime *rtd)
+{
+	struct snd_soc_dapm_context *dapm;
+	struct snd_soc_card *card;
+	struct snd_soc_pcm_runtime *afe_rtd;
+
+	/* set ignore suspend for hostless path */
+	dapm = snd_soc_component_get_dapm(snd_soc_rtd_to_cpu(rtd, 0)->component);
+	snd_soc_dapm_ignore_suspend(dapm, "FE_HOSTLESS_VA");
+	snd_soc_dapm_ignore_suspend(dapm, "FE_VA");
+	snd_soc_dapm_ignore_suspend(dapm, "FE_PCM_PLAYBACK");
+	snd_soc_dapm_ignore_suspend(dapm, "FE_HOSTLESS_PLAYBACK");
+	snd_soc_dapm_ignore_suspend(dapm, "VA UL2 In");
+	snd_soc_dapm_ignore_suspend(dapm, "VA TDMIN In");
+	snd_soc_dapm_ignore_suspend(dapm, "VA UL9 In");
+	snd_soc_dapm_ignore_suspend(dapm, "PCM DL2 OUT");
+
+	card = rtd->card;
+
+	list_for_each_entry(afe_rtd, &card->rtd_list, list) {
+		if (!strcmp(snd_soc_rtd_to_cpu(afe_rtd, 0)->name, "DMIC"))
+			break;
+	}
+	if (afe_rtd != NULL) {
+		dapm = snd_soc_component_get_dapm(snd_soc_rtd_to_cpu(afe_rtd, 0)->component);
+		snd_soc_dapm_ignore_suspend(dapm, "DMIC In");
+		snd_soc_dapm_ignore_suspend(dapm, "ETDM1 In");
+		snd_soc_dapm_ignore_suspend(dapm, "ETDM2 In");
+		snd_soc_dapm_ignore_suspend(dapm, "ETDM2 Out");
+	}
+
+#ifdef CONFIG_SND_SOC_MT8519_CODEC
+	list_for_each_entry(afe_rtd, &card->rtd_list, list) {
+		if (!strcmp(snd_soc_rtd_to_cpu(afe_rtd, 0)->name, "INT ADDA"))
+			break;
+	}
+	if (afe_rtd != NULL) {
+		dapm =
+		snd_soc_component_get_dapm(snd_soc_rtd_to_codec(afe_rtd, 0)->component);
+		snd_soc_dapm_ignore_suspend(dapm, "AU_VIN0");
+		snd_soc_dapm_ignore_suspend(dapm, "AU_VIN1");
+	}
+#endif
+
+	return 0;
+}
