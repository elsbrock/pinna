+static int mt8519_hostless_enable(struct snd_soc_card *card,
+				  struct mt8519_hostless_data *hostless_data,
+				  int enable)
+{
+	int ret = 0;
+	struct snd_pcm *pcm;
+	struct snd_soc_pcm_runtime *rtd;
+
+	rtd = mendocino_get_rtd(card, hostless_data->dai_link);
+	if (rtd == NULL) {
+		dev_info(card->dev, "%s() dai_link=%s  ctrl_name=%s runtime is NULL\n",
+				__func__, hostless_data->dai_link, hostless_data->ctl_name);
+		return -ENODEV;
+	}
+	pcm = rtd->pcm;
+	if (hostless_data->enable == enable) {
+		dev_info(card->dev, "already set %s enable:%d\n",
+			 hostless_data->dai_link, hostless_data->enable);
+//		ret = -EBUSY;
+		goto err;
+	}
+
+	if (enable) {
+		dev_info(card->dev, "dai_link:%s, dir:%d, channel:%d, rate:%d\n",
+			 hostless_data->dai_link, hostless_data->stream_dir,
+			 hostless_data->config.channels, hostless_data->config.rate);
+		ret = afe_hostless_enable(pcm,
+				&hostless_data->substream,
+				&hostless_data->config,
+				hostless_data->stream_dir);
+		if (ret)
+			goto err;
+	} else {
+		afe_hostless_disable(&hostless_data->substream);
+	}
+
+	hostless_data->enable = enable;
+	dev_info(card->dev, "%s enable:%d\n", hostless_data->dai_link, hostless_data->enable);
+err:
+	return ret;
+}
+
+static int mt8519_hostless_get(struct snd_kcontrol *kcontrol,
+			       struct snd_ctl_elem_value *ucontrol)
+{
+	int i = 0;
+	int ret = -EINVAL;
+	struct mt8519_hostless_data *hostless_data = NULL;
+
+	for (i = 0; i < ARRAY_SIZE(hostless_datas); i++) {
+		hostless_data = &hostless_datas[i];
+		if (!strcmp(ucontrol->id.name, hostless_data->ctl_name)) {
+			ucontrol->value.integer.value[0] = hostless_data->enable;
+			ret = 0;
+			break;
+		}
+	}
+
+	return ret;
+}
+
+static int mt8519_hostless_put(struct snd_kcontrol *kcontrol,
+			       struct snd_ctl_elem_value *ucontrol)
+{
+	int enable;
+	int i = 0;
+	int ret = -EINVAL;
+	struct mt8519_hostless_data *hostless_data = NULL;
+	struct snd_soc_card *card = snd_kcontrol_chip(kcontrol);
+
+	enable = ucontrol->value.integer.value[0];
+	for (i = 0; i < ARRAY_SIZE(hostless_datas); i++) {
+		hostless_data = &hostless_datas[i];
+		if (!strcmp(ucontrol->id.name, hostless_data->ctl_name)) {
+			ret = mt8519_hostless_enable(card, hostless_data, enable);
+			break;
+		}
+	}
+
+	return ret;
+}
