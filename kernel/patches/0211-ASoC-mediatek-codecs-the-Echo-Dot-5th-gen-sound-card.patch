+};
+
+static int mt8519_mendocino_ext_spk_amp_wevent(struct snd_soc_dapm_widget *w,
+	struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_dapm_context *dapm = w->dapm;
+	struct snd_soc_card *card = dapm->card;
+	struct mt8519_mendocino_priv *card_data = snd_soc_card_get_drvdata(card);
+	int ret = 0;
+
+	dev_dbg(card->dev, "%s event %d\n", __func__, event);
+
+	switch (event) {
+	case SND_SOC_DAPM_POST_PMU:
+		if (!IS_ERR(card_data->pin_states[PIN_STATE_EXT_SPK_AMP_ON])) {
+			ret = pinctrl_select_state(card_data->pinctrl,
+			      card_data->pin_states[PIN_STATE_EXT_SPK_AMP_ON]);
+			if (ret)
+				dev_info(card->dev,
+					"%s failed to select state %d\n",
+					__func__, ret);
+		} else {
+			dev_info(card->dev,
+				 "%s invalid pin state %s\n",
+				 __func__,
+				 mt8519_mendocino_pin_str[PIN_STATE_EXT_SPK_AMP_ON]);
+		}
+		break;
+	case SND_SOC_DAPM_PRE_PMD:
+		if (!IS_ERR(card_data->pin_states[PIN_STATE_EXT_SPK_AMP_OFF])) {
+			ret = pinctrl_select_state(card_data->pinctrl,
+			      card_data->pin_states[PIN_STATE_EXT_SPK_AMP_OFF]);
+			if (ret)
+				dev_info(card->dev,
+					"%s failed to select state %d\n",
+					__func__, ret);
+		} else {
+			dev_info(card->dev,
+				 "%s invalid pin state %s\n",
+				 __func__,
+				 mt8519_mendocino_pin_str[PIN_STATE_EXT_SPK_AMP_OFF]);
+		}
+		break;
+	default:
+		break;
+	}
+
+	return 0;
+}
+
