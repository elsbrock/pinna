diff --git a/sound/soc/codecs/tas2764.c b/sound/soc/codecs/tas2764.c
index e8fbe8a39..79a7e04e2 100644
--- a/sound/soc/codecs/tas2764.c
+++ b/sound/soc/codecs/tas2764.c
@@ -798,6 +798,29 @@ static struct i2c_driver tas2764_i2c_driver = {
 	.probe      = tas2764_i2c_probe,
 	.id_table   = tas2764_i2c_id,
 };
+/*
+ * tas2764_get_irq_state - read and clear the amp's latched fault flags.
+ * The Echo Dot (5th gen) sound card reports these to the owner (ADR 0035).
+ */
+u64 tas2764_get_irq_state(struct snd_soc_component *component)
+{
+	static const unsigned int regs[] = {
+		TAS2764_INT_LTCH0, TAS2764_INT_LTCH1, TAS2764_INT_LTCH1_0,
+		TAS2764_INT_LTCH2, TAS2764_INT_LTCH3, TAS2764_INT_LTCH4,
+	};
+	u64 state = 0;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(regs); i++)
+		state = (state << 8) + (snd_soc_component_read(component, regs[i]) & 0xff);
+
+	/* Clear the flags after the read. */
+	snd_soc_component_write(component, TAS2764_INT_CLK_CFG, TAS2764_INT_CLK_CFG_RST);
+
+	return state;
+}
+EXPORT_SYMBOL_GPL(tas2764_get_irq_state);
+
 module_i2c_driver(tas2764_i2c_driver);
 
 MODULE_AUTHOR("Dan Murphy <dmurphy@ti.com>");
diff --git a/sound/soc/codecs/tas2764.h b/sound/soc/codecs/tas2764.h
index 69c0f91cb..3503560b2 100644
--- a/sound/soc/codecs/tas2764.h
+++ b/sound/soc/codecs/tas2764.h
@@ -119,4 +119,9 @@
 
 #define TAS2764_BOP_CFG0                TAS2764_REG(0X0, 0x1d)
 
+/* All latched-interrupt flags plus the clear strobe (Amazon's value). */
+#define TAS2764_INT_CLK_CFG_RST		(BIT(0) | BIT(2) | BIT(3) | BIT(4))
+
+u64 tas2764_get_irq_state(struct snd_soc_component *component);
+
 #endif /* __TAS2764__ */
