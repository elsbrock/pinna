diff --git a/sound/soc/codecs/max98396.c b/sound/soc/codecs/max98396.c
index d4a739273..a05691dcd 100644
--- a/sound/soc/codecs/max98396.c
+++ b/sound/soc/codecs/max98396.c
@@ -1928,6 +1928,54 @@ static struct i2c_driver max98396_i2c_driver = {
 	.id_table = max98396_i2c_id,
 };
 
+/*
+ * max98396_get_irq_state - read and clear the amp's interrupt state.
+ * max98396_reset_platform - power the amp down or bring it back up, used by
+ * the Echo Dot (5th gen) sound card (ADR 0035).
+ */
+unsigned int max98396_get_irq_state(struct snd_soc_component *component)
+{
+	struct max98396_priv *max98396 = snd_soc_component_get_drvdata(component);
+	unsigned int state = 0, temp;
+	int i;
+
+	for (i = 0; i < 4; i++) {
+		if (regmap_read(max98396->regmap, MAX98396_R2006_INT_STATE1 + i, &temp))
+			temp = 0;
+		state = (state << 8) + (temp & 0xff);
+		/* Clear the flag after the read. */
+		regmap_write(max98396->regmap, MAX98396_R2015_INT_FLAG_CLR1 + i, 0xff);
+	}
+
+	return state;
+}
+EXPORT_SYMBOL_GPL(max98396_get_irq_state);
+
+int max98396_reset_platform(struct snd_soc_component *component, int enable)
+{
+	struct max98396_priv *max98396 = snd_soc_component_get_drvdata(component);
+
+	if (!enable) {
+		regmap_write(max98396->regmap, MAX98396_R210F_GLOBAL_EN, 0);
+		usleep_range(100, 150);			/* tOff */
+		regcache_cache_only(max98396->regmap, true);
+		regcache_mark_dirty(max98396->regmap);
+		/* The reset line is active-low in the device tree, so the
+		 * descriptor's logical 1 asserts reset (matches probe). */
+		gpiod_set_value_cansleep(max98396->reset_gpio, 1);
+		usleep_range(1, 2);			/* tRESET_LOW */
+	} else {
+		gpiod_set_value_cansleep(max98396->reset_gpio, 0);
+		usleep_range(1500, 1600);		/* tI2C_READY */
+		regcache_cache_only(max98396->regmap, false);
+		regcache_sync(max98396->regmap);
+		regmap_write(max98396->regmap, MAX98396_R210F_GLOBAL_EN, 1);
+	}
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(max98396_reset_platform);
+
 module_i2c_driver(max98396_i2c_driver)
 
 MODULE_DESCRIPTION("ALSA SoC MAX98396 driver");
