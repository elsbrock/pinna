+static int max98396_reset(struct snd_soc_card *card)
+{
+	struct mtk_base_afe *afe;
+	struct snd_soc_pcm_runtime *rtd;
+	int error = 0;
+
+	dev_info(card->dev, "%s+\n", __func__);
+
+	/* Turn Off I2S */
+	/* Can continue with error */
+	afe = mt8519_afe_pcm_get_info();
+	error = mt8519_afe_force_etdm2_out_enable(afe, 0);
+	if (error)
+		dev_err(card->dev, "%s I2S disable error %d\n",
+			__func__, error);
+
+	/* Turn off AMP */
+	rtd = mendocino_get_rtd(card, "ETDM2_OUT BE");
+	if (rtd == NULL) {
+		dev_info(card->dev, "%s() runtime is NULL\n", __func__);
+		return -ENODEV;
+	}
+
+	error = max98396_reset_platform(snd_soc_rtd_to_codec(rtd, 0)->component, 0);
+	if (error)
+		dev_err(card->dev, "%s Amp reset error %d\n", __func__, error);
+
+	/* Turn On AMP */
+	error = max98396_reset_platform(snd_soc_rtd_to_codec(rtd, 0)->component, 1);
+	if (error)
+		dev_err(card->dev, "%s Amp reset error %d\n", __func__, error);
+
+	/* Turn On I2S */
+	error = mt8519_afe_force_etdm2_out_enable(afe, 1);
+	if (error)
+		dev_err(card->dev, "%s I2S enable error %d\n",
+			__func__, error);
+
+	dev_info(card->dev, "%s-\n", __func__);
+
+	return 0;
+}
+
+static int max98396_reset_get(struct snd_kcontrol *kcontrol,
+			      struct snd_ctl_elem_value *ucontrol)
+{
+	pr_debug("%s\n", __func__);
+
+	/* Always set 0, otherwise userspace won't apply kcontrol */
+	ucontrol->value.integer.value[0] = 0;
+
+	return 0;
+}
+
+static int max98396_reset_put(struct snd_kcontrol *kcontrol,
+			      struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_card *card = snd_kcontrol_chip(kcontrol);
+	int error = 0;
+
+	pr_debug("%s enable %ld\n", __func__,
+		 ucontrol->value.integer.value[0]);
+
+	error = max98396_reset(card);
+
+	return 0;
+}
