+/* tlv320_clock_source:*/
+/*    TLV320_PLL_ADC_FS_CLKIN_MCLK = 0 */
+/*    TLV320_PLL_ADC_FS_CLKIN_BCLK = 1 */
+/*   TLV320_PLL_ADC_FS_CLKIN_PLL_MCLK = 2 */
+/*   TLV320_PLL_ADC_FS_CLKIN_PLL_BCLK = 3 */
+/*    TLV320_ADC_FS_CLKIN_BCLK = 4 */
+
+static int mt8519_mendocino_hw_params(struct snd_pcm_substream *substream,
+				struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_pcm_runtime *rtd = substream->private_data;
+	struct mt8519_mendocino_priv *priv = snd_soc_card_get_drvdata(rtd->card);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	int id = rtd->dai_link->id;
+	struct mt8519_mendocino_etdm_ctrl_data *etdm;
+	struct snd_soc_dai *codec_dai;
+	struct mtk_base_afe *afe;
+
+	unsigned int mclk_multiplier = 0;
+	unsigned int fmt = 0;
+	unsigned int mclk = 0;
+	unsigned int lrck_width = 0;
+	int slot = 0;
+	int slot_width = 0;
+	unsigned int slot_bitmask = 0;
+	unsigned int tlv320_clock_source = 0;
+	unsigned int idx;
+	int ret, i;
+	int error;
+
+	afe = mt8519_afe_pcm_get_info();
+	if (id == DAI_LINK_ETDM1_IN) {
+		idx = MT8519_ETDM1;
+		etdm = &priv->etdm_data[idx];
+		mclk_multiplier = etdm->mck_multp_in;
+		lrck_width = etdm->lrck_width_in;
+		tlv320_clock_source = etdm->tlv320_clock_mux;
+	} else if (id == DAI_LINK_ETDM2_OUT) {
+		idx = MT8519_ETDM2;
+		etdm = &priv->etdm_data[idx];
+		mclk_multiplier = etdm->mck_multp_out;
+		lrck_width = etdm->lrck_width_out;
+	} else if (id == DAI_LINK_ETDM2_IN) {
+		idx = MT8519_ETDM2;
+		etdm = &priv->etdm_data[idx];
+		mclk_multiplier = etdm->mck_multp_in;
+		lrck_width = etdm->lrck_width_in;
+	}
+
+	if (mclk_multiplier > 0) {
+		mclk = mclk_multiplier * params_rate(params);
+
+		/* MCLK needs to be minimum 12.228MHz for ADC5140 */
+		if (mclk < 12288000  && id == DAI_LINK_ETDM1_IN)
+			mclk = 12288000;
+
+		ret = snd_soc_dai_set_sysclk(cpu_dai, 0, mclk,
+					     SND_SOC_CLOCK_OUT);
+		if (ret)
+			return ret;
+		if (id == DAI_LINK_ETDM1_IN) {
+			/* Set MCLK rate in codec */
+			ret = snd_soc_dai_set_sysclk(snd_soc_rtd_to_codec(rtd, 0), 0,
+				mclk, SND_SOC_CLOCK_OUT);
+
+			if (ret)
+				return ret;
+		}
+	}
+
+	slot_width = lrck_width;
+	if (slot_width > 0) {
+		slot = params_channels(params);
+		slot_bitmask = GENMASK(slot - 1, 0);
+
+		ret = snd_soc_dai_set_tdm_slot(cpu_dai,
+					       slot_bitmask,
+					       slot_bitmask,
+					       slot,
+					       slot_width);
+		if (ret)
+			return ret;
+	}
+
+	for_each_rtd_codec_dais(rtd, i, codec_dai)
+	{
+		if (codec_dai == NULL) {
+			pr_err("%s invalid dai parameter\n", __func__);
+			return -EINVAL;
+		}
+
+		snd_soc_dai_set_pll(codec_dai, 0, tlv320_clock_source,
+			snd_pcm_format_width(params_format(params))
+			* params_channels(params) * params_rate(params)
+			, params_rate(params));
+
+		/* Inverse the BCLK bit for TI ADC5140 to match MTK and AKM. */
+		if (strstr(snd_soc_rtd_to_codec(rtd, 0)->name, "tlv320adc5140") ||
+			strstr(snd_soc_rtd_to_codec(rtd, 0)->name, "tlv320adc5120")) {
+			switch (rtd->dai_link->dai_fmt & SND_SOC_DAIFMT_INV_MASK) {
+			case SND_SOC_DAIFMT_NB_NF:
+				fmt = rtd->dai_link->dai_fmt | SND_SOC_DAIFMT_IB_NF;
+				break;
+			case SND_SOC_DAIFMT_IB_NF:
+				fmt = rtd->dai_link->dai_fmt & SND_SOC_DAIFMT_INV_RESET;
+				break;
+			default:
+				pr_err("%s invalid dai fmt\n", __func__);
+				return -EINVAL;
+			}
+		} else {
+			fmt = rtd->dai_link->dai_fmt;
+		}
+
+		snd_soc_dai_set_fmt(codec_dai, fmt);
+
+	}
+
+	if (id == DAI_LINK_ETDM2_OUT) {
+	/* turn on bclk before putting AMP in play state */
+		if (strstr(snd_soc_rtd_to_codec(rtd, 0)->name, "tas5805m")) {
+			mutex_lock(&priv->amp_lock);
+			if (!priv->force_i2s_enable) {
+				error = mt8519_afe_force_etdm2_out_enable(afe, 1);
+				if (error) {
+					dev_warn(rtd->card->dev, "%s I2S enable error %d\n",
+						__func__, error);
+				}
+			}
+			priv->amp_playing = true;
+			mutex_unlock(&priv->amp_lock);
+		}
+	}
+
+	return 0;
+}
