+static int mendocino_i2s_enable_get(struct snd_kcontrol *kcontrol,
+	struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_card *card = snd_kcontrol_chip(kcontrol);
+	struct mt8519_mendocino_priv *priv = snd_soc_card_get_drvdata(card);
