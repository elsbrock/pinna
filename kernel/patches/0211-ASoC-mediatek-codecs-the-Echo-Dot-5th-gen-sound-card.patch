+static int mt8519_mendocino_dev_probe(struct platform_device *pdev)
+{
+	struct snd_soc_card *card = &mt8519_mendocino_card;
+	struct device *dev = &pdev->dev;
+	struct device_node *np = dev->of_node;
+	struct device_node *platform_node;
+#ifdef CONFIG_MTK_HIFIXDSP_SUPPORT
+	struct device_node *adsp_platform_node;
+#endif
+	struct mt8519_mendocino_priv *priv;
+	struct thermal_zone_device *tzd;
+	int ret, id;
+	size_t i;
+	size_t dais_num = ARRAY_SIZE(mt8519_mendocino_dais);
+
+	platform_node = of_parse_phandle(dev->of_node, "mediatek,platform", 0);
+	if (!platform_node) {
+		dev_info(dev, "Property 'platform' missing or invalid\n");
+		return -EINVAL;
+	}
+
+	for (i = 0; i < dais_num; i++) {
+#ifdef CONFIG_MTK_HIFIXDSP_SUPPORT
+		if (is_adsp_dai_link(i))
+			continue;
+#endif
+		if (mt8519_mendocino_dais[i].platforms->name)
+			continue;
+
+		id = mt8519_mendocino_dais[i].id;
+
+		if ((id >= DAI_LINK_AFE_FE_BASE &&
+		     id <= DAI_LINK_AFE_FE_END) ||
+		    (id >= DAI_LINK_AFE_BE_BASE &&
+		     id <= DAI_LINK_AFE_BE_END)) {
+			mt8519_mendocino_dais[i].platforms->of_node = platform_node;
+		}
+	}
+
+#ifdef CONFIG_MTK_HIFIXDSP_SUPPORT
+	adsp_platform_node = of_parse_phandle(dev->of_node,
+					 "mediatek,adsp-platform", 0);
+	if (!adsp_platform_node) {
+		dev_info(dev, "Property 'adsp-platform' missing or invalid\n");
+		ret = -EINVAL;
+		goto err_adsp_platform_node;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(adsp_dai_links); i++) {
+		unsigned int dai = adsp_dai_links[i];
+
+		if (mt8519_mendocino_dais[dai].platforms->name)
+			continue;
+		mt8519_mendocino_dais[dai].platforms->of_node = adsp_platform_node;
+	}
+#endif
+
+	card->dev = dev;
+
+	priv = devm_kzalloc(dev, sizeof(struct mt8519_mendocino_priv),
+			    GFP_KERNEL);
+	if (!priv) {
+		ret = -ENOMEM;
+		dev_info(dev, "%s allocate card private data fail %d\n",
+			__func__, ret);
+		goto err_priv;
+	}
+
+	priv->mendocino_platform_node = platform_node;
+#ifdef CONFIG_MTK_HIFIXDSP_SUPPORT
+	priv->mendocino_adsp_platform_node = adsp_platform_node;
+#endif
+
+	snd_soc_card_set_drvdata(card, priv);
+	priv->card = card;
+
+	mt8519_mendocino_gpio_probe(card);
+
+	mt8519_mendocino_parse_of(card, np);
+
+	ret = devm_snd_soc_register_card(dev, card);
+	if (ret) {
+		dev_info(dev, "%s snd_soc_register_card fail %d\n",
+			__func__, ret);
+		goto err_priv;
+	} else {
+		mutex_init(&priv->amp_lock);
+		priv->amp_playing = false;
+		priv->force_i2s_enable = 0;
+	}
+
+	/* init amp irq, and continue if error */
+	if (mendocino_irq_probe(card))
+		dev_info(&pdev->dev, "init amp irq error\n");
+
+	priv->rms = 0;
+	mutex_init(&priv->rms_lock);
+	if (of_find_property(np, "#thermal-sensor-cells", NULL)) {
+		tzd = devm_thermal_of_zone_register(dev, 0, priv, &mendocino_rms_tz_ops);
+		if (IS_ERR(tzd))
+		{
+			ret = PTR_ERR(tzd);
+			dev_err(dev,
+				"%s: Failed to register the thermal sensor %d \n", __func__, ret);
+		}
+	}
+
+	/* probe ok, of_node_put in .remove func */
+	return ret;
+
+err_priv:
+#ifdef CONFIG_MTK_HIFIXDSP_SUPPORT
+	of_node_put(priv->mendocino_adsp_platform_node);
+	priv->mendocino_adsp_platform_node = NULL;
+err_adsp_platform_node:
+#endif
+	of_node_put(priv->mendocino_platform_node);
+	priv->mendocino_platform_node = NULL;
+
+	return ret;
+}
+
+static void mt8519_mendocino_dev_remove(struct platform_device *pdev)
+{
+	struct snd_soc_card *card = platform_get_drvdata(pdev);
+
+	mt8519_mendocino_cleanup_of_resource(card);
+}
