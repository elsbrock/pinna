+static int link_to_dai(int link_id)
+{
+	switch (link_id) {
+	case DAI_LINK_ETDM1_IN:
+		return MT8519_AFE_IO_ETDM1_IN;
+	case DAI_LINK_ETDM2_OUT:
+		return MT8519_AFE_IO_ETDM2_OUT;
+	case DAI_LINK_ETDM2_IN:
+		return MT8519_AFE_IO_ETDM2_IN;
+	case DAI_LINK_PCM_INTF:
+		return MT8519_AFE_IO_PCM1;
+	case DAI_LINK_DMIC:
+		return MT8519_AFE_IO_DMIC;
+	case DAI_LINK_INT_ADDA:
+		return MT8519_AFE_IO_INT_ADDA;
+	default:
+		break;
