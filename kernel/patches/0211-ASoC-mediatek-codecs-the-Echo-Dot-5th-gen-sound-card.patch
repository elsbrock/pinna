+/***********************************************************************
+ * woofer_get_irq_state
+ * Reading irq state from DAC
+ * *********************************************************************/
+static u64 woofer_get_irq_state(struct snd_soc_card *card)
+{
+	struct snd_soc_pcm_runtime *rtd = mendocino_get_rtd(card, "ETDM2_OUT BE");
+
+	dev_info(card->dev, "%s() codec: %s\n", __func__, snd_soc_rtd_to_codec(rtd, 0)->name);
+	if (!strncmp(snd_soc_rtd_to_codec(rtd, 0)->name, "tas2764", 7))
+		return tas2764_get_irq_state(snd_soc_rtd_to_codec(rtd, 0)->component);
+	else if (!strncmp(snd_soc_rtd_to_codec(rtd, 0)->name, "max98396", 8))
+		return max98396_get_irq_state(snd_soc_rtd_to_codec(rtd, 0)->component);
+	else if (!strncmp(snd_soc_rtd_to_codec(rtd, 0)->name, "tas5805", 7))
+		return tas5805m_get_irq_state(snd_soc_rtd_to_codec(rtd, 0)->component);
+
+	dev_err(card->dev, "codec is not supported\n");
+	return 0;
+}
+
+enum fault_status_bit_info {
+	FAULT_STATUS_OTW_BIT = 0,	// Over Temperature Warning
+	FAULT_STATUS_OTE_BIT = 1,	// Over Temperature Error
+	FAULT_STATUS_OC_BIT = 2,	// Over Current
+	FAULT_STATUS_GENERIC_BIT = 3,	// Generic Fault
+};
+
+static int dac_fault_info_get(struct snd_kcontrol *kcontrol,
+			      struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_card *card = snd_kcontrol_chip(kcontrol);
+	struct snd_soc_pcm_runtime *rtd = mendocino_get_rtd(card, "ETDM2_OUT BE");
+	u64 irq_raw_status;
+	u32 fault_status;
+	bool generic_fault_status = false, otw_status = false, ote_status = false,
+	     oc_status = false;
+
+	if (!rtd) {
+		dev_err(card->dev, "%s() runtime is NULL\n", __func__);
+		return -EINVAL;
+	}
+
+	irq_raw_status = woofer_get_irq_state(card);
+	dev_info(card->dev, "%s: woofer irq state = 0x%08llx\n", __func__, irq_raw_status);
+	if (!irq_raw_status) {
+		ucontrol->value.integer.value[0] = 0;
+		return 0;
+	}
+
+	if (!strncmp(snd_soc_rtd_to_codec(rtd, 0)->name, "tas2764", 7)) {
+		otw_status = !!(irq_raw_status & TAS2764_OTW_BIT);
+		ote_status = !!(irq_raw_status & TAS2764_OTE_BIT);
+		oc_status = !!(irq_raw_status & TAS2764_OC_BIT);
+	} else if (!strncmp(snd_soc_rtd_to_codec(rtd, 0)->name, "max98396", 8)) {
+		generic_fault_status = !!(irq_raw_status & MAX98396_GENERIC_FAULT_BITS);
+		otw_status = !!(irq_raw_status & MAX98396_OTW_BITS);
+		ote_status = generic_fault_status && otw_status;
+		oc_status = !!(irq_raw_status & MAX98396_OVC);
+	} else if (!strncmp(snd_soc_rtd_to_codec(rtd, 0)->name, "tas5805", 7)) {
+		otw_status = !!(irq_raw_status & (1 << FAULT_STATUS_OTW_BIT));
+		ote_status = !!(irq_raw_status & (1 << FAULT_STATUS_OTE_BIT));
+		oc_status = !!(irq_raw_status & (1 << FAULT_STATUS_OC_BIT));
+		generic_fault_status = !!(irq_raw_status & (1 << FAULT_STATUS_GENERIC_BIT));
+	} else {
+		dev_err(card->dev, "codec is not supported\n");
+		return -EINVAL;
+	}
+
+	fault_status = (otw_status << FAULT_STATUS_OTW_BIT) |
+		       (ote_status << FAULT_STATUS_OTE_BIT) |
+		       (oc_status << FAULT_STATUS_OC_BIT) |
+		       (generic_fault_status << FAULT_STATUS_GENERIC_BIT);
+	dev_info(card->dev,
+		 "%s: otw_status=%d, ote_status=%d, oc_status=%d, generic_fault_status=%d\n",
+		 __func__, otw_status, ote_status, oc_status, generic_fault_status);
+	ucontrol->value.integer.value[0] = fault_status;
+
+	return 0;
+}
