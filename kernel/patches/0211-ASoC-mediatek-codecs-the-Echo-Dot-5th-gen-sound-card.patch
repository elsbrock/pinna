+static int mendocino_i2s_enable_set(struct snd_kcontrol *kcontrol,
+	struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_card *card = snd_kcontrol_chip(kcontrol);
+	struct mt8519_mendocino_priv *priv = snd_soc_card_get_drvdata(card);
+	int error = 0;
+	struct mtk_base_afe *afe;
+
+	afe = mt8519_afe_pcm_get_info();
+
+	dev_info(card->dev, "%s+ enable %ld\n", __func__,
+		ucontrol->value.integer.value[0]);
+
+	mutex_lock(&priv->amp_lock);
+	if (!priv->amp_playing)
+		error = mt8519_afe_force_etdm2_out_enable(afe,
+				ucontrol->value.integer.value[0]);
+	if (!error)
+		priv->force_i2s_enable = ucontrol->value.integer.value[0];
+	mutex_unlock(&priv->amp_lock);
+
+	if (error)
+		dev_warn(card->dev, "%s I2S disable error %d\n",
+			__func__, error);
+
+	return error;
+}
