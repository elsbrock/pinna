+static int mendocino_rms_read_thermal_zone(struct thermal_zone_device *tz, int *rms)
+{
+	struct mt8519_mendocino_priv *priv = thermal_zone_device_priv(tz);
+	struct snd_soc_card *card = priv->card;
+
+	mutex_lock(&priv->rms_lock);
+	dev_dbg(card->dev, "%s rms %d",__func__, priv->rms);
+	*rms = priv->rms;
+	mutex_unlock(&priv->rms_lock);
+
+	return 0;
+}
