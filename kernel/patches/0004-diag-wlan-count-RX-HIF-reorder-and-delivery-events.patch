+/*
+ * ECHO_WLAN_RXSTAT: RX path counters (HIF read, reordering, delivery to the
+ * stack).  All writers run in the driver main thread; a summary is printed
+ * every two seconds while frames are received.
+ */
+typedef struct _ECHO_WLAN_RX_STAT_T {
+	/* HIF */
+	UINT_32 u4IntStatusRead;	/* enhanced WHISR status reads */
+	UINT_32 u4RxLenNoIntBit;	/* status reads with RX lengths but RX0/RX1 DONE clear */
+	UINT_32 u4RxPortRead;		/* RX port (WRDR0/1) reads */
+	UINT_32 u4RxPortPkt;		/* frames taken from RX port reads */
+	UINT_32 u4RxPortPktMax;		/* most frames in one read (since last summary) */
+	UINT_32 u4RxRfbShortSkip;	/* frames not read: too few free SW_RFBs */
+	UINT_32 u4RxOver16Skip;		/* frames not read: count > 16 */
+	UINT_32 u4RxTruncSkip;		/* frames not read: zero length or buffer full */
+	UINT_32 u4RxLenMismatch;	/* HIF header length != status length */
+	UINT_32 u4FreeRfbMin;		/* fewest free SW_RFBs seen (since last summary) */
+	UINT_32 u4QmLowRfbDrop;		/* data frames dropped by QM: too few free SW_RFBs */
+	/* reordering */
+	UINT_32 u4BaIn;			/* frames handed to reordering */
+	UINT_32 u4BaNoEntry;		/* reorder flag but no BA agreement */
+	UINT_32 u4BaWithin;
+	UINT_32 u4BaHeld;		/* arrivals that left frames waiting behind a hole */
+	UINT_32 u4BaAhead;
+	UINT_32 u4BaAheadSkip;		/* sequence numbers given up by fall-ahead */
+	UINT_32 u4BaBehindDrop;		/* fall-behind retries dropped */
+	UINT_32 u4BaBehindPass;		/* fall-behind frames passed up out of order */
+	UINT_32 u4BaDup;
+	UINT_32 u4BaBar;
+	UINT_32 u4BaBarSkip;		/* sequence numbers given up by BAR */
+	UINT_32 u4BaTimeoutSkip;	/* holes given up by the miss timeout */
+	UINT_32 u4BaRelease;		/* frames released from a reorder queue */
+	UINT_32 u4BaHoldMaxMs;		/* longest wait in a reorder queue (since last summary) */
+	UINT_32 u4BaHold100;		/* frames that waited >= 100 ms */
+	UINT_32 u4BaDepthMax;		/* deepest reorder queue (since last summary) */
+	UINT_32 u4NoReorder;		/* unicast data frames without the reorder flag */
+	/* delivery */
+	UINT_32 u4IndBatch;
+	UINT_32 u4IndPkt;
+	UINT_32 u4IndCpuSwitch;		/* batches on a different CPU than the previous one */
+	UINT_32 u4IndSoftirqdBusy;	/* batches while this CPU's ksoftirqd was runnable */
+} ECHO_WLAN_RX_STAT_T;
+
+extern ECHO_WLAN_RX_STAT_T g_rEchoRxStat;
+
+VOID echoWlanRxStatTick(VOID);
+
+VOID echoWlanRxStatHold(IN P_SW_RFB_T prSwRfb);
+
