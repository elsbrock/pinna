 /*******************************************************************************
 *                           P R I V A T E   D A T A
 ********************************************************************************
 */
+static ECHO_WLAN_RX_STAT_T g_rEchoRxStatLast;
+static unsigned long g_ulEchoRxStatJiffies;
+static BOOLEAN g_fgEchoRxStatStarted;
+
+/*----------------------------------------------------------------------------*/
+/*!
+* \brief Account for a frame leaving a reorder queue.
+*/
+/*----------------------------------------------------------------------------*/
+VOID echoWlanRxStatHold(IN P_SW_RFB_T prSwRfb)
+{
+	UINT_32 u4HoldMs = (UINT_32) (kalGetTimeTick() - prSwRfb->rEchoBaTime);
+
+	g_rEchoRxStat.u4BaRelease++;
+	if (u4HoldMs > g_rEchoRxStat.u4BaHoldMaxMs)
+		g_rEchoRxStat.u4BaHoldMaxMs = u4HoldMs;
+	if (u4HoldMs >= 100)
+		g_rEchoRxStat.u4BaHold100++;
+}
+
+/*----------------------------------------------------------------------------*/
+/*!
+* \brief Print the RX counters accumulated over the last two seconds.
+*
+* Called from the RX path, so nothing is printed while no frames arrive.
+* jiffies starts close to its wrap, so the first call only arms the interval.
+*/
+/*----------------------------------------------------------------------------*/
+VOID echoWlanRxStatTick(VOID)
+{
+	ECHO_WLAN_RX_STAT_T *s = &g_rEchoRxStat, *l = &g_rEchoRxStatLast;
+	unsigned long ulNow = jiffies;
+
+	if (!g_fgEchoRxStatStarted) {
+		g_fgEchoRxStatStarted = TRUE;
+		g_ulEchoRxStatJiffies = ulNow;
+		*l = *s;
+		return;
+	}
+	if (time_before(ulNow, g_ulEchoRxStatJiffies + 2 * HZ))
+		return;
+
+#define ECHO_D(_f) (s->_f - l->_f)
+	pr_info("ECHO_WLAN_RXSTAT: hif dt=%ums stat=%u lenNoBit=%u rd=%u pkt=%u maxPkt=%u rfbSkip=%u over16=%u trunc=%u lenErr=%u freeMin=%u qmDrop=%u\n",
+		jiffies_to_msecs(ulNow - g_ulEchoRxStatJiffies),
+		ECHO_D(u4IntStatusRead), ECHO_D(u4RxLenNoIntBit), ECHO_D(u4RxPortRead),
+		ECHO_D(u4RxPortPkt), s->u4RxPortPktMax, ECHO_D(u4RxRfbShortSkip),
+		ECHO_D(u4RxOver16Skip), ECHO_D(u4RxTruncSkip), ECHO_D(u4RxLenMismatch),
+		s->u4FreeRfbMin, ECHO_D(u4QmLowRfbDrop));
+	pr_info("ECHO_WLAN_RXSTAT: ba in=%u noBa=%u within=%u held=%u ahead=%u aheadSkip=%u behindDrop=%u behindPass=%u dup=%u bar=%u barSkip=%u tmoSkip=%u rel=%u holdMax=%ums hold100=%u depthMax=%u noReorder=%u\n",
+		ECHO_D(u4BaIn), ECHO_D(u4BaNoEntry), ECHO_D(u4BaWithin), ECHO_D(u4BaHeld),
+		ECHO_D(u4BaAhead), ECHO_D(u4BaAheadSkip), ECHO_D(u4BaBehindDrop),
+		ECHO_D(u4BaBehindPass), ECHO_D(u4BaDup), ECHO_D(u4BaBar), ECHO_D(u4BaBarSkip),
+		ECHO_D(u4BaTimeoutSkip), ECHO_D(u4BaRelease), s->u4BaHoldMaxMs, ECHO_D(u4BaHold100),
+		s->u4BaDepthMax, ECHO_D(u4NoReorder));
+	pr_info("ECHO_WLAN_RXSTAT: ind batch=%u pkt=%u cpuSwitch=%u softirqdBusy=%u cpu=%u\n",
+		ECHO_D(u4IndBatch), ECHO_D(u4IndPkt), ECHO_D(u4IndCpuSwitch),
+		ECHO_D(u4IndSoftirqdBusy), raw_smp_processor_id());
+#undef ECHO_D
+
+	s->u4RxPortPktMax = 0;
+	s->u4FreeRfbMin = ~0U;
+	s->u4BaHoldMaxMs = 0;
+	s->u4BaDepthMax = 0;
+	*l = *s;
+	g_ulEchoRxStatJiffies = ulNow;
+}
 
