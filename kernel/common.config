# Pinna kernel configuration shared by every variant (device, qemu, x86).
#
# kernel/build.sh starts from allnoconfig and merges common.config, then the
# variant's fragment (device.config, qemu.config or x86.config), then
# debug.config for dev builds (DEBUG=1). Nothing is enabled that is not listed
# in one of them, and build.sh fails if any symbol below does not end up in the
# final .config. EXPERT is on, so the syscalls and features that allnoconfig
# would otherwise keep by default are listed explicitly.
#
# The QEMU variants boot the real image on this same base, so the VM boot gates
# (just vm-test, vm-test-x86) check that systemd runs on exactly this set.

CONFIG_LOCALVERSION="-pinna"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_EXPERT=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# The compression of a self-decompressing kernel (KERNEL_XZ) is in the arm
# and x86 fragments: arm64 has none.
# CONFIG_MODULES is not set

# --- core -----------------------------------------------------------------
CONFIG_MULTIUSER=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_KALLSYMS=y
CONFIG_FUTEX=y
CONFIG_SHMEM=y
CONFIG_MEMFD_CREATE=y
CONFIG_POSIX_TIMERS=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_PREEMPT=y
CONFIG_SMP=y
CONFIG_VM_EVENT_COUNTERS=y
CONFIG_COMPACTION=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLOCK=y
CONFIG_EFI_PARTITION=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
CONFIG_CRYPTO_MANAGER_DISABLE_TESTS=y
# 32-bit time syscalls, for binaries built before the time64 transition.
CONFIG_COMPAT_32BIT_TIME=y

# --- systemd (README "REQUIREMENTS", v257 as in Debian trixie) ------------
# Required.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_CGROUPS=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_UNIX=y
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_FHANDLE=y
# flock()/fcntl() locks: udev (block devices, /dev/disk links), PipeWire's
# socket lock, systemd.
CONFIG_FILE_LOCKING=y
# CONFIG_SYSFS_DEPRECATED is not set
# CONFIG_UEVENT_HELPER is not set
# CONFIG_FW_LOADER_USER_HELPER is not set
# PrivateNetwork= and PrivateUsers= (localed, hostnamed, … use them).
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
# Optional but strongly recommended.
CONFIG_IPV6=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_KCMP=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ_CODEL=y
# Resource control: CPUShares=, CPUQuota=, MemoryMax=, TasksMax=, IO*=,
# DeviceAllow=, IPAddressDeny= (cgroup BPF), PSI for memory pressure.
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
# CONFIG_RT_GROUP_SCHED is not set
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_CGROUP_BPF=y
CONFIG_PSI=y
# Syscalls systemd, glibc, journald and PipeWire use.
CONFIG_EVENTFD=y
CONFIG_AIO=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SYSVIPC=y
CONFIG_FANOTIFY=y
CONFIG_KEYS=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA256=y
# BLK_DEV_BSG (serial numbers of SCSI devices) and DMIID (x86 firmware
# tables) are not applicable: there is no SCSI and no DMI here.

# --- filesystems ----------------------------------------------------------
CONFIG_MISC_FILESYSTEMS=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
# systemd-sysext (scripts/push-dev.sh).
CONFIG_OVERLAY_FS=y
CONFIG_CONFIGFS_FS=y

# --- device mapper: dm-verity root, set up by pinna-init (ADR 0003) -------
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y

# --- networking -----------------------------------------------------------
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_INET=y
# mDNS (systemd-resolved) needs multicast.
CONFIG_IP_MULTICAST=y
# SO_BINDTODEVICE/SO_BINDTOIFINDEX return ENOPROTOOPT without NETDEVICES;
# networkd (IPv6 RA, DHCP) and resolved (stub listener on lo) need them.
CONFIG_NETDEVICES=y

# --- console, terminals, firmware -----------------------------------------
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
# CONFIG_LEGACY_PTYS is not set
CONFIG_FW_LOADER=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_INTF_SYSFS=y
CONFIG_RTC_INTF_DEV=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_SYSTOHC=y
CONFIG_WATCHDOG=y
# Keep pinging a watchdog the bootloader left running until systemd takes
# over (RuntimeWatchdogSec=).
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
