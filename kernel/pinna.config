# Pinna kernel configuration fragment, merged on top of mt8163_arm32_defconfig.
# kernel/build.sh fails if any symbol below does not end up in the final .config.

CONFIG_LOCALVERSION="-pinna"

# --- systemd requirements -------------------------------------------------
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_EPOLL=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_DNOTIFY=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SYSVIPC=y
CONFIG_AIO=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_KCMP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PSI=y
CONFIG_KEYS=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA256=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_IPV6=y
# systemd wants no usermode firmware fallback. FW_LOADER_USER_HELPER itself is
# force-selected by the LP55xx LED driver; keeping only the opt-in path is fine.
# CONFIG_FW_LOADER_USER_HELPER_FALLBACK is not set

# --- filesystems ----------------------------------------------------------
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y

# --- device mapper (dm-verity later, via dm-mod.create) -------------------
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_INIT=y
CONFIG_DM_VERITY=y

# --- USB gadget: serial console + network over the micro-USB cable --------
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y

# --- boot: own the command line; LK's injected root=/dm= are ignored -------
CONFIG_CMDLINE="console=ttyS0,921600n1 root=PARTLABEL=system_a rootfstype=erofs ro rootwait vmalloc=496M clk_ignore_unused net.ifnames=0 panic=10"
CONFIG_CMDLINE_FORCE=y
# CONFIG_CMDLINE_EXTEND is not set
