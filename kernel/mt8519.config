# The Echo Dot (5th gen)'s kernel (cannoli, MT8519, ADR 0034): a 32-bit ARM
# kernel, the same armhf root every satellite runs, native (no compatibility
# layer). Merged after common.config onto allnoconfig (see common.config).
# Board support comes from kernel/patches 0201 and up (see source.env),
# forward-ported from Amazon's own 5.4 kernel. Nothing built from it has run
# on an MT8519 device.
#
# This is the core-boot config: the SoC, the console, storage and USB. The
# peripheral drivers Amazon ships (audio, thermal, the ring co-processor, the
# CPLD buttons and the microphone switch) land with their patches; until then
# their nodes are inert.

# --- SoC ------------------------------------------------------------------
CONFIG_KERNEL_XZ=y
CONFIG_MMU=y
CONFIG_ARCH_MULTIPLATFORM=y
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_MEDIATEK=y
CONFIG_MACH_MT8519=y
CONFIG_NR_CPUS=4
CONFIG_HZ_100=y
CONFIG_VFP=y
CONFIG_NEON=y
# Debian armhf is Thumb-2: signal handlers in Thumb code need ARM_THUMB.
CONFIG_ARM_THUMB=y
CONFIG_VDSO=y
CONFIG_KUSER_HELPERS=y
CONFIG_ARM_ARCH_TIMER_EVTSTREAM=y
CONFIG_ARM_PATCH_IDIV=y
CONFIG_ARM_CPU_TOPOLOGY=y
CONFIG_ARM_PSCI=y
CONFIG_PM=y
CONFIG_SUSPEND=y
CONFIG_PM_SLEEP=y
# SCPSYS power domains (audio, the DSP, connectivity) are genpd providers.
CONFIG_PM_GENERIC_DOMAINS=y
CONFIG_PM_GENERIC_DOMAINS_OF=y
CONFIG_MTK_SCPSYS_PM_DOMAINS=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_ARM_MEDIATEK_CPUFREQ_HW=y
CONFIG_COMMON_CLK_MT8519=y
CONFIG_PINCTRL_MT8519=y
CONFIG_RESET_CONTROLLER=y
CONFIG_RESET_TI_SYSCON=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
# The MT6395 PMIC (patch 0207).
CONFIG_REGULATOR_MT6395=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_SYSFS=y
# The Amazon CPLD GPIO expander: the buttons and the microphone switch (0207).
CONFIG_GPIO_AMZNCPLD=y
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_NVMEM=y
CONFIG_NVMEM_MTK_EFUSE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_MT65XX=y
CONFIG_SPI=y
CONFIG_SPI_MT65XX=y
CONFIG_IIO=y
CONFIG_MEDIATEK_MT6577_AUXADC=y
CONFIG_PWM=y
CONFIG_PWM_MEDIATEK=y

# --- thermal: the thermistors on the auxadc and Amazon's virtual sensor -----
# (the virtual-sensor driver is already in the tree from the MT8163 port, 0010;
# the MT8519 SoC temperature sensor is a later patch.)
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_AMAZON_VIRTUAL_SENSOR_THERMISTOR=y

# --- storage: SDIO for Wi-Fi, and NAND/UBI for the root -------------------
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_MTK=y
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_UBI=y
CONFIG_MTD_UBI_BLOCK=y
CONFIG_UBIFS_FS=y
# MediaTek's nandx SPI-NAND driver (patch 0206).
CONFIG_MTD_NANDX_MT8519=y

# --- buttons, the microphone switch, LED ring, ambient light --------------
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y
# The microphone switch: Amazon's gpio-privacy (already in the tree, patch 0107).
CONFIG_INPUT_MISC=y
CONFIG_INPUT_GPIO_PRIVACY=y
# The ambient light sensor: ams TSL2540 (Amazon's IIO driver, in the tree, 0013).
CONFIG_SENSORS_TSL2540=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
# The light ring, all three board revisions: TI LP5036 (mainline), and the
# ISSI IS31FL3246 and Awinic AW21036 (patch 0208). On build 8349 the ring may
# be driven by the SCP co-processor instead; that is a later patch (ADR 0034).
CONFIG_LEDS_LP50XX=y
CONFIG_LEDS_IS31FL3246=y
CONFIG_LEDS_AW210XX=y

# --- Wi-Fi and Bluetooth: the MT7663 on SDIO (mainline mt76 + btmtksdio) ---
CONFIG_RFKILL=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
# Unsigned regulatory.db from wireless-regdb, without the kernel's X.509 stack.
CONFIG_CFG80211_CERTIFICATION_ONUS=y
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_MTKSDIO=y
CONFIG_MAC80211=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7663S=y

# --- USB gadget: serial console + network over the test pads --------------
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_MTK=y
CONFIG_USB_MTU3=y
CONFIG_USB_MTU3_DUAL_ROLE=y
CONFIG_PHY_MTK_TPHY=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y

# --- crash logs: the DTB reserves ramoops; a warm reboot keeps it ---------
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# --- boot: own the command line; LK's additions are ignored ---------------
CONFIG_CMDLINE="console=ttyS0,921600n1 loglevel=4 root=PARTLABEL=system_a rootfstype=erofs ro rootwait net.ifnames=0 panic=10"
CONFIG_CMDLINE_FORCE=y
