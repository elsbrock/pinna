# The Echo Dot (5th gen)'s kernel (cannoli, MT8519, ADR 0035): a 32-bit ARM
# kernel, the same armhf root every satellite runs, native (no compatibility
# layer). Merged after common.config onto allnoconfig (see common.config).
# Board support comes from kernel/patches 0201 and up (see source.env),
# forward-ported from Amazon's own 5.4 kernel. Nothing built from it has run
# on an MT8519 device.
#
# This is the core-boot config: the SoC, the console, storage and USB. The
# peripheral drivers Amazon ships (audio, thermal, the ring co-processor, the
# CPLD buttons and the microphone switch) land with their patches; until then
# their nodes are inert.

# --- SoC ------------------------------------------------------------------
CONFIG_KERNEL_XZ=y
CONFIG_MMU=y
CONFIG_ARCH_MULTIPLATFORM=y
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_MEDIATEK=y
CONFIG_MACH_MT8519=y
CONFIG_NR_CPUS=4
CONFIG_HZ_100=y
CONFIG_VFP=y
CONFIG_NEON=y
# Debian armhf is Thumb-2: signal handlers in Thumb code need ARM_THUMB.
CONFIG_ARM_THUMB=y
CONFIG_VDSO=y
CONFIG_KUSER_HELPERS=y
CONFIG_ARM_ARCH_TIMER_EVTSTREAM=y
CONFIG_ARM_PATCH_IDIV=y
CONFIG_ARM_CPU_TOPOLOGY=y
CONFIG_ARM_PSCI=y
CONFIG_PM=y
CONFIG_SUSPEND=y
CONFIG_PM_SLEEP=y
# SCPSYS power domains (audio, the DSP, connectivity) are genpd providers.
CONFIG_PM_GENERIC_DOMAINS=y
CONFIG_PM_GENERIC_DOMAINS_OF=y
CONFIG_MTK_SCPSYS_PM_DOMAINS=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_ARM_MEDIATEK_CPUFREQ_HW=y
CONFIG_COMMON_CLK_MT8519=y
CONFIG_PINCTRL_MT8519=y
CONFIG_RESET_CONTROLLER=y
CONFIG_RESET_TI_SYSCON=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
# The MT6395 PMIC (patch 0207).
CONFIG_REGULATOR_MT6395=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_SYSFS=y
# The Amazon CPLD GPIO expander: the buttons and the microphone switch (0207).
CONFIG_GPIO_AMZNCPLD=y
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_NVMEM=y
CONFIG_NVMEM_MTK_EFUSE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_MT65XX=y
CONFIG_SPI=y
CONFIG_SPI_MT65XX=y
CONFIG_IIO=y
CONFIG_MEDIATEK_MT6577_AUXADC=y
CONFIG_PWM=y
CONFIG_PWM_MEDIATEK=y

# --- thermal: the thermistors on the auxadc and Amazon's virtual sensor -----
# (the virtual-sensor driver is already in the tree from the MT8163 port, 0010;
# the MT8519 SoC temperature sensor is a later patch.)
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_AMAZON_VIRTUAL_SENSOR_THERMISTOR=y
# The MT8519 on-die SoC temperature sensor (patch 0209).
CONFIG_MTK_SOC_TEMP=y

# --- storage: SDIO for Wi-Fi, and NAND/UBI for the root -------------------
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_MTK=y
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_UBI=y
CONFIG_MTD_UBI_BLOCK=y
CONFIG_UBIFS_FS=y
# MediaTek's nandx SPI-NAND driver (patch 0206).
CONFIG_MTD_NANDX_MT8519=y
# Sub-page writes: the volumes were written with 2048-byte sub-pages, and
# without them UBI attaches read-only (0223).
CONFIG_MTK_NANDX_WRITE_SUBPAGE=y
# The GPT at the start of NAND names the MTD partitions, ubi0 among them (0221).
CONFIG_MTD_GPT_PARTS=y
CONFIG_MTD_GPT_BACKUP=y

# --- buttons, the microphone switch, LED ring, ambient light --------------
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y
# The microphone switch: Amazon's gpio-privacy (already in the tree, patch 0107).
CONFIG_INPUT_MISC=y
CONFIG_INPUT_GPIO_PRIVACY=y
# The ambient light sensor: the BSP IIO TSL2540 driver (patch 0219).
# Keep the legacy AMS sensor driver for other boards; it does not match this DT.
# CONFIG_SENSORS_TSL2540 is not set
CONFIG_IIO_TSL2540=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y

# --- audio: the MT8519 front end (patch 0210, compile-only), + the codecs ---
# The ETDM direct PCM paths; Pinna does its DSP in userland. The cannoli
# machine driver (the sound card) is a follow-on, so this builds the front
# end without yet forming a card.
CONFIG_SOUND=y
CONFIG_SND=y
# /proc/asound/cards: pinnad finds the sound card there; without it pinnad
# starts with no audio backend (C2N6L4, 2026-11-26).
CONFIG_SND_PROC_FS=y
# pcmXY/subZ/status: pinna-audio tracks the speaker and microphone clocks.
CONFIG_SND_VERBOSE_PROCFS=y
CONFIG_SND_SOC=y
# Not SND_SOC_MEDIATEK: the MT8519 AFE carries its own common layer (vendor-*,
# patch 0210), so it never builds sound/soc/mediatek/common/. That symbol has no
# prompt and nothing selects it here; REGMAP_MMIO (the only thing it would give)
# already comes from MFD_SYSCON via pinctrl/clk.
CONFIG_SND_SOC_MT8519=y
# The cannoli machine driver, patch 0211: the sound card that wires the front
# end to the codecs.
CONFIG_SND_SOC_MT8519_MENDOCINO=y
# cannoli's codecs (mainline): the MAX98396/TAS2764 amp and the ADC5140 mics.
CONFIG_SND_SOC_MAX98396=y
CONFIG_SND_SOC_TAS2764=y
CONFIG_SND_SOC_TLV320ADCX140=y
# The light ring, all three board revisions: TI LP5036 (mainline), and the
# ISSI IS31FL3246 and Awinic AW21036 (patch 0208). U-Boot enables the one the
# unit carries. Fire OS drives the ring through the SCP co-processor; Pinna
# doesn't port that path (ADR 0035).
CONFIG_LEDS_LP50XX=y
CONFIG_LEDS_IS31FL3246=y
CONFIG_LEDS_AW210XX=y

# --- Wi-Fi and Bluetooth: the MT7663 on SDIO (mainline mt76 + btmtksdio) ---
CONFIG_RFKILL=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
# Unsigned regulatory.db from wireless-regdb, without the kernel's X.509 stack.
CONFIG_CFG80211_CERTIFICATION_ONUS=y
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_MTKSDIO=y
CONFIG_MAC80211=y
# mt76 has no rate control of its own on the MT7663: without minstrel,
# registration fails ("Failed to select rate control algorithm", C2N6L4).
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_MAC80211_RC_DEFAULT_MINSTREL=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7663S=y
# mt76 and btmtksdio load the MT7663's ROM patch and N9 firmware at probe,
# before the root is mounted, and give up when they find neither (C2N6L4,
# 2026-11-26). kernel/build.sh copies linux-firmware's files from
# blobs/firmware/ (just firmware).
CONFIG_EXTRA_FIRMWARE="mediatek/mt7663pr2h.bin mediatek/mt7663_n9_v3.bin"
CONFIG_EXTRA_FIRMWARE_DIR="firmware"

# --- USB gadget: serial console + network over the test pads --------------
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_MTK=y
CONFIG_USB_MTU3=y
CONFIG_USB_MTU3_DUAL_ROLE=y
CONFIG_PHY_MTK_TPHY=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y

# --- crash logs: the DTB reserves ramoops; a warm reboot keeps it ---------
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# --- boot: own the command line; U-Boot's additions are ignored -----------
# pinna-init reads the slot from U-Boot's chosen/bootargs, not from here.
# ubi.mtd= attaches ubi0 as stock Fire OS does (VID header at 2048, 20 per
# 1024 reserved, ubi0); ubi.block= gives each slot the block device that
# dm-verity needs. The wired UART at 0x11002000 is ttyS1 on 6.12 (C2N6L4).
CONFIG_CMDLINE="console=ttyS1,921600n8 loglevel=4 ubi.mtd=ubi0,2048,20,0 ubi.block=0,system_a ubi.block=0,system_b net.ifnames=0 panic=10"
CONFIG_CMDLINE_FORCE=y
