# Kernel source pin: Debian's linux 6.12.117-1 (trixie).
#
# That is upstream stable v6.12.117 plus Debian's patch series from the
# kernel team's packaging tag. kernel/patches/*.patch are applied on top, in
# order: the MT8163 board support ported from the previous firmware's Linux tree (release 0.14.5)
# (Linux 6.1.178), each part followed by Pinna's fixes to it (0001–0017
# board, audio and its fixes; 0018–0030 the CONSYS Wi-Fi/BT driver and its
# fixes).
#
# LINUX_LOCAL may point at a local git repository that already has
# LINUX_BASE, to fetch from instead of kernel.org.
LINUX_REPO=https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git
LINUX_TAG=v6.12.117
LINUX_BASE=d3417611a3b40b7f04a29e558cebac2bf69889d7
DEBIAN_REPO=https://salsa.debian.org/kernel-team/linux.git
DEBIAN_TAG=debian/6.12.117-1
DEBIAN_BASE=f142d2e2e48fc8d4b59383e775ac7d8414173066
