# Kernel source pin.
#
# Base: LibreEcho-Linux release/0.14.5 (Linux 6.1.178 + MT8163 board support).
# kernel/patches/*.patch are applied on top, in order.
#
# LINUX_LOCAL may point at an existing local clone to avoid a network clone
# (objects are shared, nothing in it is modified).
LINUX_REPO=https://github.com/aslater3/LibreEcho-Linux.git
LINUX_BASE=b81fd49a950bec24ad1931d0086f2cbad5873869
LINUX_LOCAL=${LINUX_LOCAL:-$HOME/src/github.com/aslater3/LibreEcho-Linux}
LINUX_DEFCONFIG=mt8163_arm32_defconfig
