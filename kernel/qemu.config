# QEMU `virt` variant of the Pinna kernel, used to boot-test the real image.
# Merged after pinna.config on top of multi_v7_defconfig.

CONFIG_ARCH_VIRT=y
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_RTC_DRV_PL031=y

# Same boot contract as the device, with the PL011 console.
CONFIG_CMDLINE="console=ttyAMA0 root=PARTLABEL=system_a rootfstype=erofs ro rootwait net.ifnames=0 panic=10"
CONFIG_CMDLINE_FORCE=y
