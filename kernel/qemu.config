# QEMU `virt` variant of the Pinna kernel, used to boot-test the real image
# (tests/vm). Merged after common.config onto allnoconfig, like the device.

CONFIG_KERNEL_XZ=y
CONFIG_MMU=y
CONFIG_ARCH_MULTIPLATFORM=y
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_VIRT=y
CONFIG_VFP=y
CONFIG_NEON=y
# Debian armhf is Thumb-2: signal handlers in Thumb code need ARM_THUMB.
CONFIG_ARM_THUMB=y
CONFIG_VDSO=y
CONFIG_KUSER_HELPERS=y
CONFIG_ARM_PAN=y
CONFIG_STACKPROTECTOR_PER_TASK=y
CONFIG_ARM_ARCH_TIMER_EVTSTREAM=y
CONFIG_ARM_PATCH_IDIV=y
CONFIG_ARM_CPU_TOPOLOGY=y
CONFIG_ARM_PSCI=y
CONFIG_ARM_AMBA=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_RTC_DRV_PL031=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# Same boot contract as the device, with the PL011 console.
CONFIG_CMDLINE="console=ttyAMA0 root=PARTLABEL=system_a rootfstype=erofs ro rootwait net.ifnames=0 panic=10 pinna.bootloader=none"
CONFIG_CMDLINE_FORCE=y
