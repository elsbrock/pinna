# The Echo Dot (2nd gen, MT8163) kernel: merged after common.config onto
# allnoconfig (see common.config). Board support comes from kernel/patches.

# --- SoC ------------------------------------------------------------------
CONFIG_KERNEL_XZ=y
CONFIG_MMU=y
CONFIG_ARCH_MULTIPLATFORM=y
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_MEDIATEK=y
CONFIG_MACH_MT8163=y
CONFIG_NR_CPUS=4
CONFIG_HZ_100=y
CONFIG_HIGHMEM=y
CONFIG_VFP=y
CONFIG_NEON=y
# Debian armhf is Thumb-2: signal handlers in Thumb code need ARM_THUMB.
CONFIG_ARM_THUMB=y
CONFIG_VDSO=y
CONFIG_KUSER_HELPERS=y
CONFIG_ARM_PAN=y
CONFIG_STACKPROTECTOR_PER_TASK=y
CONFIG_ARM_ARCH_TIMER_EVTSTREAM=y
CONFIG_ARM_PATCH_IDIV=y
CONFIG_ARM_CPU_TOPOLOGY=y
CONFIG_HARDEN_BRANCH_PREDICTOR=y
CONFIG_HARDEN_BRANCH_HISTORY=y
CONFIG_ARM_PSCI=y
CONFIG_PM=y
# PM_SLEEP (via SUSPEND), as on 6.1: without it wakeup_source_register() is a
# stub returning NULL and the CONSYS WMT init fails with -ENOMEM.
CONFIG_SUSPEND=y
CONFIG_PM_SLEEP=y
# SCPSYS power domains (audio, connectivity) are genpd providers.
CONFIG_PM_GENERIC_DOMAINS=y
CONFIG_PM_GENERIC_DOMAINS_OF=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPUFREQ_DT=y
CONFIG_COMMON_CLK_MT8163=y
CONFIG_PINCTRL_MT8163=y
CONFIG_PINCTRL_MT6397=y
CONFIG_MTK_SCPSYS_MT8163=y
CONFIG_MTK_PMIC_WRAP=y
CONFIG_MFD_MT6397=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_MT6323=y
CONFIG_RTC_DRV_MT6397=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_MT6323=y
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_NVMEM=y
CONFIG_NVMEM_MTK_EFUSE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_MT65XX=y
CONFIG_SPI=y
CONFIG_SPI_MT65XX=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_MTK=y

# --- thermal --------------------------------------------------------------
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_CPU_THERMAL=y
CONFIG_CPU_FREQ_THERMAL=y
CONFIG_MTK_THERMAL=y
CONFIG_MTK_SOC_THERMAL=y
CONFIG_IIO=y
CONFIG_MEDIATEK_MT6577_AUXADC=y
CONFIG_AMAZON_VIRTUAL_SENSOR_THERMISTOR=y

# --- buttons, LED ring, privacy (mute) switch, ambient light --------------
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYBOARD_MTK_PMIC=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_IS31FL32XX=y
# Not LEDS_MT6323: the DT has no mediatek,mt6323-led node, and since 6.x the
# driver dereferences its (then NULL) match data at probe -> oops in PID 1.
# 6.1 bound nothing there either; the ring is the IS31 above.
# CONFIG_LEDS_MT6323 is not set
CONFIG_AMZ_PRIVACY=y
CONFIG_SENSORS_TSL2540=y
CONFIG_AMZN_AMS_ALS=y
CONFIG_ALS_TSL2583=y
# Factory calibration from /idme/alscal (AMZN_AMS_ALS needs it).
CONFIG_AMS_ADJUST_WITH_BASELINE=y

# --- audio: AFE + TLV320AIC32x4 speaker, FPGA SPI microphones -------------
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PROC_FS=y
# pcmXY/subZ/status: pinna-audio tracks the speaker and microphone clocks.
CONFIG_SND_VERBOSE_PROCFS=y
CONFIG_SND_PCM_TIMER=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_MT8163=y
CONFIG_SND_SOC_AMZN_MT8163_SPI_AUDIO=y
CONFIG_SND_SOC_MT8163_RADAR_PUFFIN=y
# The FPGA bitstream the SPI capture driver loads at probe, before the root
# is mounted. kernel/build.sh copies it from blobs/firmware/ (just firmware).
CONFIG_EXTRA_FIRMWARE="i2s_to_spi_v34.bin"
CONFIG_EXTRA_FIRMWARE_DIR="firmware"

# --- Wi-Fi and Bluetooth: MT8163 CONSYS vendor driver ---------------------
CONFIG_RFKILL=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
# Unsigned regulatory.db from wireless-regdb, without the kernel's X.509 stack.
CONFIG_CFG80211_CERTIFICATION_ONUS=y
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
CONFIG_CFG80211_DEFAULT_PS=y
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=y
CONFIG_MTK_MT8163_CONSYS=y
CONFIG_IDME=y
CONFIG_MTK_MT8163_BLUEZ_HCI=y
CONFIG_MTK_WIFI_ANTENNA_SWITCH=y
CONFIG_MTK_WIFI_ANTENNA_SELECT=y
# The setup hotspot (ADR 0028): the vendor driver's access point, ap0.
CONFIG_MTK_MT8163_WIFI_AP=y

# --- USB gadget: serial console + network over the micro-USB cable --------
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_USB_MUSB_MEDIATEK=y
# The MediaTek glue only provides a DMA controller with USB_INVENTRA_DMA;
# without either, musb-hdrc fails to probe ("DMA controller not set") and
# there is no UDC. LibreEcho's 6.1 kernel, which this board support is ported
# from, ran PIO as well.
CONFIG_MUSB_PIO_ONLY=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y

# --- crash logs: the DTB reserves ramoops@44400000; a warm reboot keeps it --
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# --- boot: own the command line; LK's injected root=/dm= are ignored -------
CONFIG_CMDLINE="console=ttyS0,921600n1 loglevel=4 root=PARTLABEL=system_a rootfstype=erofs ro rootwait vmalloc=496M clk_ignore_unused net.ifnames=0 panic=10"
CONFIG_CMDLINE_FORCE=y
