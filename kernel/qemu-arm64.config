# QEMU `virt` variant of the arm64 kernel (ADR 0031): boots the armhf image,
# as the MT8516 boards will, so its userland runs as 32-bit EL0 under a
# 64-bit kernel (tests/vm, ARCH=arm64). Merged after common.config onto
# allnoconfig, like the device.

# --- 32-bit EL0: the armhf root, pinna-init and the static armv7 binaries ---
CONFIG_ARM64_4K_PAGES=y
CONFIG_COMPAT=y
# Some armhf code still uses the kuser helpers (cmpxchg, TLS) at 0xffff0000.
CONFIG_KUSER_HELPERS=y
# clock_gettime() without a system call for 32-bit processes. build.sh
# passes the armhf cross compiler as CROSS_COMPILE_COMPAT to build it.
CONFIG_COMPAT_VDSO=y

# --- QEMU virt ------------------------------------------------------------
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_RTC_DRV_PL031=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# Same boot contract as the device, with the PL011 console.
CONFIG_CMDLINE="console=ttyAMA0 root=PARTLABEL=system_a rootfstype=erofs ro rootwait net.ifnames=0 panic=10 pinna.bootloader=none"
CONFIG_CMDLINE_FORCE=y
