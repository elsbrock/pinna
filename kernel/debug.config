# Dev-build extras (kernel/build.sh with DEBUG=1, `just kernel-debug`):
# tracing, debugfs and richer crash reports. Not in release kernels.

CONFIG_DEBUG_FS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_DEBUG_BUGVERBOSE=y
CONFIG_SYMBOLIC_ERRNAME=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_PERF_EVENTS=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_COREDUMP=y
CONFIG_ELF_CORE=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
