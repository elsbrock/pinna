# x86_64 variant of the Pinna kernel: boots the x86_64 image under QEMU/KVM for
# fast userland smoke tests. Merged after pinna.config on x86_64_defconfig.

CONFIG_EFI_PARTITION=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# pinna.config asks for the ACM/NCM gadget functions; there is no UDC here,
# they just have to build.
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y

# Same boot contract as the device: the kernel owns its command line.
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=ttyS0 root=PARTLABEL=system_a rootfstype=erofs ro rootwait net.ifnames=0 panic=10"
CONFIG_CMDLINE_OVERRIDE=y
# CONFIG_CMDLINE_FORCE is not set
