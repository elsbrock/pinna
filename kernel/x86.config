# x86_64 variant of the Pinna kernel: boots the x86_64 image under QEMU/KVM
# (q35) for fast userland smoke tests. Merged after common.config onto
# allnoconfig, like the device.

CONFIG_64BIT=y
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# The virtual Echo Dot (just dev-vm, ADR 0014): pinnad's buttons are a uinput
# device, which pinna-hal reads through evdev like the device's gpio-keys.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y

# Same boot contract as the device: the kernel owns its command line.
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=ttyS0 root=PARTLABEL=system_a rootfstype=erofs ro rootwait net.ifnames=0 panic=10"
CONFIG_CMDLINE_OVERRIDE=y
