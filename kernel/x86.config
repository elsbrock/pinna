# x86_64 variant of the Pinna kernel: boots the x86_64 image under QEMU/KVM
# (q35) for fast userland smoke tests. Merged after common.config onto
# allnoconfig, like the device.

CONFIG_64BIT=y
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# The virtual Echo Dot (just dev-vm, ADR 0014): pinnad's buttons are a uinput
# device, which pinna-hal reads through evdev like the device's gpio-keys.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y

# Same boot contract as the device: the kernel owns its command line. QEMU
# appends nothing, except the setup hotspot test's simulated radios.
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=ttyS0 root=PARTLABEL=system_a rootfstype=erofs ro rootwait net.ifnames=0 panic=10 pinna.bootloader=none mac80211_hwsim.radios=0"
# CONFIG_CMDLINE_OVERRIDE is not set

# Simulated Wi-Fi for the setup hotspot test (ADR 0028): no radios unless the
# test appends mac80211_hwsim.radios=N, so the virtual Echo Dot keeps no Wi-Fi.
CONFIG_RFKILL=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
# Unsigned regulatory.db from wireless-regdb, as on the device.
CONFIG_CFG80211_CERTIFICATION_ONUS=y
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
CONFIG_MAC80211=y
# mac80211 registers no radio without a rate control algorithm.
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_MAC80211_RC_DEFAULT_MINSTREL=y
CONFIG_WLAN=y
CONFIG_MAC80211_HWSIM=y
