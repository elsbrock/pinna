# The MT8516 Echos' kernel (ADR 0031): an arm64 kernel under the armhf
# root image every satellite runs. Merged after common.config onto
# allnoconfig (see common.config). Board support comes from kernel/patches
# (01xx: lidar-mainline's MT8516 work backported, then the Echo Dot (3rd
# gen)). Nothing built from it has run on an MT8516 device yet.

# --- 32-bit EL0: the armhf root, pinna-init and the static armv7 binaries ---
CONFIG_ARM64_4K_PAGES=y
CONFIG_COMPAT=y
CONFIG_KUSER_HELPERS=y
# clock_gettime() without a system call for 32-bit processes (build.sh
# passes the armhf cross compiler as CROSS_COMPILE_COMPAT).
CONFIG_COMPAT_VDSO=y

# --- SoC ------------------------------------------------------------------
CONFIG_ARCH_MEDIATEK=y
CONFIG_NR_CPUS=4
CONFIG_HZ_100=y
# The Cortex-A35 has no PAN (ARMv8.1); emulate it.
CONFIG_ARM64_SW_TTBR0_PAN=y
CONFIG_PM=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_ARM_MEDIATEK_CPUFREQ=y
CONFIG_COMMON_CLK_MT8516=y
CONFIG_PINCTRL_MT8516=y
CONFIG_RESET_CONTROLLER=y
# The microphone ADCs share one reset line (tlv320adc3xxx).
CONFIG_RESET_GPIO=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
# Vproc: a Richtek RT5738 (patch: regulator: rt5739: support the RT5738).
CONFIG_REGULATOR_RT5739=y
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_MTK_TIMER=y
CONFIG_NVMEM=y
CONFIG_NVMEM_MTK_EFUSE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_MT65XX=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_MTK=y
CONFIG_IIO=y
CONFIG_MEDIATEK_MT6577_AUXADC=y

# --- buttons, LED ring, microphone switch, ambient light ------------------
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_GPIO_PRIVACY=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_IS31FL32XX=y
CONFIG_TSL2772=y

# --- audio: AFE, TAS2770 speaker amplifier, TLV320ADC3101 microphones -----
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PROC_FS=y
# pcmXY/subZ/status: pinna-audio tracks the speaker and microphone clocks.
CONFIG_SND_VERBOSE_PROCFS=y
CONFIG_SND_PCM_TIMER=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_MT8516=y
CONFIG_SND_SOC_MT8516_AMAZON_DONUT=y

# --- Bluetooth: the MT7668's SDIO function 2 (btmtksdio) ------------------
CONFIG_RFKILL=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
# Unsigned regulatory.db from wireless-regdb, without the kernel's X.509 stack.
CONFIG_CFG80211_CERTIFICATION_ONUS=y
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_MTKSDIO=y

# --- USB gadget: serial console + network over the test pads --------------
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_USB_MUSB_MEDIATEK=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_INVENTRA_DMA=y
CONFIG_PHY_MTK_TPHY=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y

# --- crash logs: the device tree reserves ramoops; a warm reboot keeps it --
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# --- boot: own the command line; LK's additions are ignored ----------------
CONFIG_CMDLINE="console=ttyS0,921600n1 loglevel=4 root=PARTLABEL=system_a rootfstype=erofs ro rootwait net.ifnames=0 panic=10"
CONFIG_CMDLINE_FORCE=y
