---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Icon from "../components/Icon.astro";
import RingDemo from "../components/RingDemo.astro";
import { docHref, href, SITE } from "../lib/site";

const steps = [
  {
    number: "1",
    title: "The device hears the wake word",
    body: "Pinna listens for “Alexa” on the Echo Dot itself. Until it hears the wake word, no audio leaves the device.",
  },
  {
    number: "2",
    title: "Home Assistant handles the request",
    body: "The device streams your request to Home Assistant over the ESPHome API. Your Assist pipeline turns it into text, acts on it, and creates the spoken reply.",
  },
  {
    number: "3",
    title: "The device answers",
    body: "The reply plays on the speaker, and the light ring shows each step. Timers, announcements and music play on the device too.",
  },
];

const features = [
  {
    icon: "mic",
    title: "Wake word on the device",
    body: "Pinna detects the wake word with openWakeWord, on the Echo Dot. It doesn't use Amazon's services.",
  },
  {
    icon: "broadcast",
    title: "Adds itself to Home Assistant",
    body: "Home Assistant finds the device on your network and adds it like an ESPHome device. You can encrypt the connection.",
  },
  {
    icon: "ring",
    title: "Light ring and buttons",
    body: "The ring shows what the device is doing and also works as a light. Button presses arrive in Home Assistant as events.",
  },
  {
    icon: "layer",
    title: "Updates that roll back",
    body: "Pinna keeps two copies of the system. An update goes to the unused copy, and the device returns to the old one if the new one doesn't start.",
  },
  {
    icon: "shield",
    title: "A way back to your backup",
    body: "Fastboot stays reachable on every start, and one command restores the backup you made before installing.",
  },
  {
    icon: "terminal",
    title: "Command-line control",
    body: "pinnactl shows the device's state and sets the volume, mute and the ring. A small API on the device offers the same to other programs.",
  },
];

const entities: { entity: string; type: string; notes: string }[] = [
  { entity: "LED ring", type: "light", notes: "Colour and brightness; effects Solid, Pulse and Flash" },
  { entity: "Microphone mute", type: "switch", notes: "Turns the microphones off in software" },
  { entity: "Wake word", type: "switch", notes: "Turns wake word detection on or off" },
  { entity: "Volume, Reply volume", type: "number", notes: "0 to 100" },
  { entity: "Wake word sensitivity", type: "number", notes: "0 to 100; higher triggers more easily" },
  { entity: "LED brightness", type: "number", notes: "0 to 100" },
  { entity: "Cancel request", type: "button", notes: "Stops a request, a reply or a timer alarm" },
  { entity: "Voice assistant", type: "event", notes: "wake_word, listening, thinking, replying, finished, stopped" },
  { entity: "Action, Volume up, Volume down, Microphone mute", type: "event", notes: "press, double_press; Action also long_press" },
  { entity: "Timer, Playback", type: "event", notes: "Timer and media player changes" },
  { entity: "Last wake word", type: "text sensor", notes: "For example “Alexa”" },
  { entity: "Media player", type: "media player", notes: "Music from a URL, announcements, volume" },
];

const hardware: { device: string; soc: string; status: string; tone: string }[] = [
  {
    device: "Echo Dot (2nd gen)",
    soc: "MediaTek MT8163, about 480 MB of memory",
    status: "Supported, in early development",
    tone: "text-ink",
  },
  {
    device: "Echo (2nd gen)",
    soc: "The same MT8163 platform",
    status: "Planned",
    tone: "text-ink-muted",
  },
];

const goals = [
  { title: "Keep speech local", body: "The wake word runs on the device, and audio goes only to your Home Assistant." },
  { title: "Be a good Home Assistant satellite", body: "Everything the device can do is available in Home Assistant." },
  { title: "Be safe to install and update", body: "Every installation step can be undone, and updates roll back on their own." },
  { title: "Use standard parts", body: "Debian, systemd and a small set of Rust programs." },
  { title: "Make development pleasant", body: "One shell for every tool, and tests that run without hardware." },
  { title: "Stay open", body: "All code is public. Proprietary firmware stays with you." },
];

const works = [
  "The images build and boot in a virtual machine",
  "Updates install into the second slot and roll back when they fail",
  "The Home Assistant connection passes tests with Home Assistant's own client library",
  "A complete voice request works against a simulated Home Assistant",
  "On the Echo Dot, echo cancellation lowers the device's own music by 32 to 44 dB",
];

const gaps = [
  "No web interface yet: you use the command line and Home Assistant",
  "No prebuilt images: you build and sign your own",
  "Backing up the device and extracting the Wi-Fi firmware need your own tools",
  "The microphone gain and the LED order still need tuning on hardware",
];
---

<BaseLayout>
  <SiteHeader slot="header" />

  <!-- Hero -->
  <section
    class="mx-auto grid max-w-6xl items-center gap-12 px-4 pt-14 pb-16 sm:px-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)] lg:pt-20 lg:pb-24"
  >
    <div>
      <div class="flex flex-wrap items-center gap-2">
        <span class="chip">
          <span class="bg-caution h-1.5 w-1.5 rounded-full"></span>
          Early development · console only
        </span>
        <span class="chip">Echo Dot (2nd gen)</span>
      </div>

      <h1 class="font-display text-ink text-display-l sm:text-display-xl mt-6 max-w-2xl text-balance">
        A local voice satellite for your Echo&nbsp;Dot
      </h1>

      <p class="text-ink-muted text-body-l mt-5 max-w-xl">
        Pinna is an open-source operating system for the Echo Dot (2nd gen).
        It detects the wake word on the device and sends your requests to your
        own Home Assistant. It doesn't use Amazon's services.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a class="pn-btn pn-btn-primary pn-btn-lg" href={href("/docs/")}>
          Get started
          <Icon name="arrow" size={16} />
        </a>
        <a class="pn-btn pn-btn-lg" href={SITE.repo}>
          <Icon name="github" size={16} />
          Source on GitHub
        </a>
      </div>

      <div class="mt-9 flex flex-wrap gap-2">
        {["Debian trixie", "read-only root", "systemd", "Rust", "ESPHome API"].map(
          (fact) => <span class="chip">{fact}</span>,
        )}
      </div>
    </div>

    <div class="flex flex-col items-center">
      <RingDemo />
    </div>
  </section>

  <!-- How it works -->
  <section id="how" class="scroll-mt-20">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
      <p class="eyebrow">How it works</p>
      <h2 class="section-title">How a voice request works</h2>

      <div class="mt-10 grid gap-8 md:grid-cols-3">
        {
          steps.map((step) => (
            <div class="border-line border-t pt-5">
              <p class="text-signal font-mono text-sm">{step.number}</p>
              <h3 class="text-ink text-heading mt-2">{step.title}</h3>
              <p class="text-ink-muted text-body mt-2">{step.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="scroll-mt-20">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
      <p class="eyebrow">Features</p>
      <h2 class="section-title">What Pinna does</h2>

      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          features.map((feature) => (
            <div class="card p-5">
              <div class="bg-signal-soft text-signal grid h-9 w-9 place-items-center rounded-sm">
                <Icon name={feature.icon} size={18} />
              </div>
              <h3 class="text-ink text-heading mt-4">{feature.title}</h3>
              <p class="text-ink-muted text-body mt-2">{feature.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Home Assistant -->
  <section id="assistant" class="scroll-mt-20">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
      <p class="eyebrow">Home Assistant</p>
      <h2 class="section-title">Works with Home Assistant</h2>
      <p class="text-ink-muted text-body-l mt-4 max-w-3xl">
        Pinna uses the ESPHome native API, the protocol of ESPHome devices.
        Home Assistant finds the Echo Dot on your network and adds it like any
        ESPHome device, without YAML or an add-on. Choose an Assist pipeline
        for it, and say the wake word. These are the entities it adds:
      </p>

      <div class="card mt-8 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-surface-sunken text-ink-muted text-xs tracking-wide uppercase">
                <th class="px-4 py-3 text-left font-semibold">Entity</th>
                <th class="px-4 py-3 text-left font-semibold">Type</th>
                <th class="px-4 py-3 text-left font-semibold">Notes</th>
              </tr>
            </thead>
            <tbody>
              {
                entities.map((row) => (
                  <tr class="border-line border-t">
                    <td class="text-ink px-4 py-2.5">{row.entity}</td>
                    <td class="text-ink-muted px-4 py-2.5 font-mono text-xs whitespace-nowrap">
                      {row.type}
                    </td>
                    <td class="text-ink-muted px-4 py-2.5">{row.notes}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <p class="text-ink-muted text-body mt-5 flex max-w-3xl items-start gap-2.5">
        <Icon name="shield" size={16} class="text-signal mt-1 shrink-0" />
        <span>
          The connection isn't encrypted until you set a key. With a key, it
          uses the same encryption as ESPHome devices, and Home Assistant can
          replace the key later. See
          <a class="link" href={docHref("home-assistant")}>Connect to Home Assistant</a>.
        </span>
      </p>
    </div>
  </section>

  <!-- Hardware -->
  <section id="hardware" class="scroll-mt-20">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
      <p class="eyebrow">Devices</p>
      <h2 class="section-title">Supported devices</h2>
      <p class="text-ink-muted text-body-l mt-4 max-w-3xl">
        Pinna supports the Echo Dot (2nd gen). The Echo (2nd gen) uses the
        same platform and is planned next.
      </p>

      <div class="card mt-8 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-surface-sunken text-ink-muted text-xs tracking-wide uppercase">
                <th class="px-4 py-3 text-left font-semibold">Device</th>
                <th class="px-4 py-3 text-left font-semibold">Platform</th>
                <th class="px-4 py-3 text-left font-semibold">Status</th>
              </tr>
            </thead>
            <tbody>
              {
                hardware.map((row) => (
                  <tr class="border-line border-t">
                    <td class="text-ink px-4 py-3 font-medium whitespace-nowrap">{row.device}</td>
                    <td class="text-ink-muted px-4 py-3">{row.soc}</td>
                    <td class={`px-4 py-3 ${row.tone}`}>{row.status}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <div class="mt-8 grid gap-5 md:grid-cols-3">
        <div class="flex items-start gap-3">
          <Icon name="board" size={18} class="text-signal mt-0.5 shrink-0" />
          <p class="text-ink-muted text-body">
            <span class="text-ink font-medium">It needs an unlocked bootloader.</span>
            Pinna installs over fastboot on a device unlocked with amonet and
            Kaeru. Holding Volume Down while you plug in the cable always opens
            fastboot.
          </p>
        </div>
        <div class="flex items-start gap-3">
          <Icon name="disk" size={18} class="text-signal mt-0.5 shrink-0" />
          <p class="text-ink-muted text-body">
            <span class="text-ink font-medium">You provide the firmware.</span>
            The Wi-Fi and Bluetooth firmware is proprietary. It comes from the
            backup of your own device and isn't distributed with Pinna.
          </p>
        </div>
        <div class="flex items-start gap-3">
          <Icon name="home" size={18} class="text-signal mt-0.5 shrink-0" />
          <p class="text-ink-muted text-body">
            <span class="text-ink font-medium">It's standard Linux.</span>
            Debian trixie with systemd on a read-only root filesystem. Pinna's
            own programs are written in Rust.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Use cases -->
  <section id="use-cases" class="scroll-mt-20">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
      <p class="eyebrow">Use cases</p>
      <h2 class="section-title">What you can use it for</h2>

      <div class="mt-10 grid gap-5 lg:grid-cols-2">
        <div class="card p-6">
          <div class="flex items-center justify-between gap-3">
            <div class="bg-signal-soft text-signal grid h-9 w-9 place-items-center rounded-sm">
              <Icon name="home" size={18} />
            </div>
            <span class="chip">
              <span class="bg-ok h-1.5 w-1.5 rounded-full"></span>
              Available now
            </span>
          </div>
          <h3 class="text-ink text-heading mt-4">Voice control for Home Assistant</h3>
          <p class="text-ink-muted text-body mt-2">
            Say the wake word, ask Home Assistant to do something, and hear the
            answer from the Echo Dot. Timers, announcements and music work too,
            and you can use the ring and the buttons in automations.
          </p>
        </div>

        <div class="card p-6">
          <div class="flex items-center justify-between gap-3">
            <div class="bg-signal-soft text-signal grid h-9 w-9 place-items-center rounded-sm">
              <Icon name="speaker" size={18} />
            </div>
            <span class="chip">
              <span class="bg-line-strong h-1.5 w-1.5 rounded-full"></span>
              Planned
            </span>
          </div>
          <h3 class="text-ink text-heading mt-4">A voice assistant on its own</h3>
          <p class="text-ink-muted text-body mt-2">
            Use the Echo Dot as a voice assistant without a Home Assistant
            instance. Pinna's parts are kept separate so that this stays
            possible.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Get started -->
  <section id="start" class="scroll-mt-20">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
      <p class="eyebrow">Get started</p>
      <h2 class="section-title">Build, install, connect</h2>

      <div class="mt-10 grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)]">
        <ol class="space-y-5">
          <li class="flex gap-4">
            <span class="text-signal font-mono text-sm">1</span>
            <p class="text-ink-muted text-body">
              <span class="text-ink block font-medium">Build the images</span>
              The development shell has every tool. <code class="font-mono text-sm">just all</code>
              builds the kernel, the root filesystem and the boot image.
            </p>
          </li>
          <li class="flex gap-4">
            <span class="text-signal font-mono text-sm">2</span>
            <p class="text-ink-muted text-body">
              <span class="text-ink block font-medium">Install over fastboot</span>
              <code class="font-mono text-sm">scripts/flash-dot.sh</code> writes
              the images, and can restore your backup later.
            </p>
          </li>
          <li class="flex gap-4">
            <span class="text-signal font-mono text-sm">3</span>
            <p class="text-ink-muted text-body">
              <span class="text-ink block font-medium">Connect to Home Assistant</span>
              Home Assistant finds the device on your network. Choose an Assist
              pipeline for it and say “Alexa”.
            </p>
          </li>
        </ol>

        <div>
          <div class="border-line bg-surface-sunken overflow-x-auto rounded-md border px-4 py-3.5">
            <pre class="text-ink font-mono text-[0.8125rem] leading-6"><span
                class="text-ink-muted"># Build, in the development shell</span>
nix develop
just keygen
just models
just all

<span class="text-ink-muted"># Install: hold Volume Down and plug in the device</span>
scripts/flash-dot.sh check
scripts/flash-dot.sh root
scripts/flash-dot.sh try    <span class="text-ink-muted"># start from memory first</span>
scripts/flash-dot.sh boot</pre>
          </div>
          <p class="mt-4 text-sm">
            <a class="link inline-flex items-center gap-1.5" href={docHref("requirements")}>
              Read the full guide, including what you need first
              <Icon name="arrow" size={14} />
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Goals -->
  <section id="goals" class="scroll-mt-20">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
      <p class="eyebrow">Goals</p>
      <h2 class="section-title">What Pinna sets out to do</h2>

      <div class="mt-10 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          goals.map((goal) => (
            <div class="border-line border-t pt-4">
              <h3 class="text-ink text-heading">{goal.title}</h3>
              <p class="text-ink-muted text-body mt-1.5">{goal.body}</p>
            </div>
          ))
        }
      </div>

      <p class="mt-8 text-sm">
        <a class="link inline-flex items-center gap-1.5" href={docHref("goals")}>
          Read the goals, the plans and what's out of scope
          <Icon name="arrow" size={14} />
        </a>
      </p>
    </div>
  </section>

  <!-- Status -->
  <section id="status" class="scroll-mt-20">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
      <p class="eyebrow">Status</p>
      <h2 class="section-title">Project status</h2>

      <div class="mt-10 grid gap-5 lg:grid-cols-2">
        <div class="card p-6">
          <p class="text-ink text-heading flex items-center gap-2">
            <Icon name="check" size={16} class="text-ok" />
            What works
          </p>
          <ul class="mt-4 space-y-3">
            {
              works.map((item) => (
                <li class="text-ink-muted text-body flex items-start gap-2.5">
                  <Icon name="check" size={14} class="text-ok mt-1 shrink-0" />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="card p-6">
          <p class="text-ink text-heading flex items-center gap-2">
            <span class="bg-caution h-2 w-2 rounded-full"></span>
            Known gaps
          </p>
          <ul class="mt-4 space-y-3">
            {
              gaps.map((item) => (
                <li class="text-ink-muted text-body flex items-start gap-2.5">
                  <span class="bg-line-strong mt-2.5 h-1 w-1 shrink-0 rounded-full" />
                  {item}
                </li>
              ))
            }
          </ul>
          <p class="mt-5 text-sm">
            <a class="link inline-flex items-center gap-1.5" href={docHref("status")}>
              Status and roadmap
              <Icon name="arrow" size={14} />
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- How you can help -->
  <section id="help" class="scroll-mt-20">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
      <p class="eyebrow">Get involved</p>
      <h2 class="section-title">Help with Pinna</h2>
      <p class="text-ink-muted text-body-l mt-4 max-w-3xl">
        Pinna is a small project in early development, and most of the useful
        work happens on real devices. You can help in three ways:
      </p>

      <div class="mt-10 grid gap-5 md:grid-cols-3">
        <div class="card flex flex-col p-5">
          <div class="bg-signal-soft text-signal grid h-9 w-9 place-items-center rounded-sm">
            <Icon name="bug" size={18} />
          </div>
          <h3 class="text-ink text-heading mt-4">Report problems</h3>
          <p class="text-ink-muted text-body mt-2">
            Problems show up on real devices first. If an installation fails,
            the ring stays dark or the wake word doesn't trigger, open an issue
            with the image version and the log
            (<code class="font-mono text-sm">journalctl -b -u pinnad</code>).
          </p>
          <p class="mt-4 text-sm">
            <a class="link inline-flex items-center gap-1.5" href={`${SITE.repo}/issues`}>
              Open an issue
              <Icon name="arrow" size={14} />
            </a>
          </p>
        </div>

        <div class="card flex flex-col p-5">
          <div class="bg-signal-soft text-signal grid h-9 w-9 place-items-center rounded-sm">
            <Icon name="code" size={18} />
          </div>
          <h3 class="text-ink text-heading mt-4">Send changes</h3>
          <p class="text-ink-muted text-body mt-2">
            Pinna is a small Rust workspace with standard systemd units.
            Experience with Rust, systemd or embedded audio helps most. Open an
            issue before larger changes, so that nobody does the same work
            twice.
          </p>
          <p class="mt-4 text-sm">
            <a class="link inline-flex items-center gap-1.5" href={docHref("development")}>
              Contribute
              <Icon name="arrow" size={14} />
            </a>
          </p>
        </div>

        <div class="card flex flex-col p-5">
          <div class="bg-signal-soft text-signal grid h-9 w-9 place-items-center rounded-sm">
            <Icon name="board" size={18} />
          </div>
          <h3 class="text-ink text-heading mt-4">Support another device</h3>
          <p class="text-ink-muted text-body mt-2">
            The Echo (2nd gen) uses the same platform as the Echo Dot. Other
            devices need a device tree, board support and a device to test on.
          </p>
          <p class="mt-4 text-sm">
            <a class="link inline-flex items-center gap-1.5" href={docHref("architecture")}>
              Read the architecture
              <Icon name="arrow" size={14} />
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
