---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Icon from "../components/Icon.astro";
import RingDemo from "../components/RingDemo.astro";
import RequestPath from "../components/RequestPath.astro";
import Switchboard from "../components/Switchboard.astro";
import GroupsPlan from "../components/GroupsPlan.astro";
import WakeMeter from "../components/WakeMeter.astro";
import MusicDuck from "../components/MusicDuck.astro";
import UpdateSlots from "../components/UpdateSlots.astro";
import DeviceDrawing from "../components/DeviceDrawing.astro";
import { docHref, href, SITE } from "../lib/site";

const goals = [
  { title: "Your voice goes only where you send it", body: "The wake word runs on the device, and audio goes only to your Home Assistant or to services you set up." },
  { title: "Be a good Home Assistant satellite", body: "Everything the device can do is available in Home Assistant." },
  { title: "Play music without getting in the way", body: "AirPlay, Bluetooth and Sendspin share the audio path, and replies, announcements and timers come first." },
  { title: "Work without Home Assistant", body: "In standalone mode the device is a voice assistant on its own, with the services you choose, and the voice of your AI agent." },
  { title: "Be safe to install and update", body: "Every installation step can be undone, updates roll back on their own, and none installs without you." },
  { title: "Use standard parts", body: "Debian, systemd and a small set of Rust programs." },
  { title: "Make development pleasant", body: "One shell for every tool, and tests that run without hardware." },
  { title: "Stay open", body: "All of Pinna's code is open source." },
];

// What the page says about each device. "Tested on it" follows the status
// page: only what has run on that model.
const devices = [
  {
    model: "echo-dot-2" as const,
    name: "Echo Dot (2nd gen)",
    rows: [
      { label: "In fastboot", value: "BISCUIT" },
      { label: "USB", value: "Its micro-USB port, with a cable that carries data" },
      { label: "Tested on it", value: "Installing, updates that roll back, standalone mode, and echo cancellation" },
    ],
  },
  {
    model: "echo-2" as const,
    name: "Echo (2nd gen)",
    rows: [
      { label: "In fastboot", value: "RADAR" },
      { label: "USB", value: "Pins in the base: a pogo-pin adapter, or a cable soldered to the pads" },
      { label: "Tested on it", value: "The same image runs. The bootloader's rollback and echo cancellation are tested on the Echo Dot only" },
    ],
  },
];

const works = [
  "The images build and boot in a virtual machine",
  "Updates install a kernel and a root filesystem into the second slot and roll back when they fail (tested on the Echo Dot)",
  "The Home Assistant connection passes tests with Home Assistant's own client library",
  "A complete voice request works against a simulated Home Assistant",
  "Standalone mode answers requests; tried on an Echo Dot (2nd gen) with OpenRouter and ElevenLabs",
  "On the Echo Dot, echo cancellation lowers the device's own music by 23 to 31 dB",
  "The dashboard sets up and controls the device from a browser on your network",
  "AirPlay and Bluetooth play music from phones and computers",
];

const gaps = [
  "The dashboard's password is optional and it serves plain HTTP: until you set one, anyone on your network can use it. Pinna offers no access from outside your network",
  "Standalone mode is new and hasn't been tried with every service yet",
  "With a Kaeru from before 22 October 2026, a new kernel needs fastboot. Pinna finds out at its first update and says so",
];
---

<BaseLayout>
  <SiteHeader slot="header" />

  <!-- Hero -->
  <div class="hero-glow">
    <section
      class="mx-auto grid max-w-6xl items-center gap-12 px-4 pt-14 pb-16 sm:px-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)] lg:pt-20 lg:pb-24"
    >
      <div>
        <div class="flex flex-wrap items-center gap-2">
          <span class="chip">
            <span class="bg-caution h-1.5 w-1.5 rounded-full"></span>
            Early development
          </span>
          <span class="chip">Echo (2nd gen) · Echo Dot (2nd gen)</span>
        </div>

        <h1 class="font-display text-ink text-display-l sm:text-display-xl mt-6 max-w-2xl text-balance">
          A local voice satellite for your Echo and Echo&nbsp;Dot
        </h1>

        <p class="text-ink-muted text-body-l mt-5 max-w-xl">
          Pinna is an open-source operating system for the Echo (2nd gen) and
          the Echo Dot (2nd gen). It detects the wake word on the device and
          sends your request to your own Home Assistant, or, in standalone mode,
          to the speech services and the language model or AI agent you choose.
          It doesn't use Amazon's services.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a class="pn-btn pn-btn-primary pn-btn-lg" href={href("/docs/")}>
            Get started
            <Icon name="arrow" size={16} />
          </a>
          <a class="pn-btn pn-btn-lg" href={SITE.repo}>
            <Icon name="github" size={16} />
            Source on GitHub
          </a>
        </div>

        <div class="mt-9 flex flex-wrap gap-2">
          {["Debian trixie", "read-only root", "systemd", "Rust", "ESPHome API"].map(
            (fact) => <span class="chip">{fact}</span>,
          )}
        </div>
      </div>

      <div class="flex flex-col items-center">
        <RingDemo />
      </div>
    </section>
  </div>

  <!-- How it works -->
  <section id="how" class="scroll-mt-20">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
      <p class="eyebrow">How it works</p>
      <h2 class="section-title">From the wake word to the reply</h2>
      <p class="text-ink-muted text-body-l mt-4 max-w-3xl">
        Home Assistant answers, or the satellite answers itself with services
        you choose. You switch on the dashboard, or by voice. The ring, music
        and updates work the same in both modes.
      </p>
      <div class="mt-10">
        <RequestPath />
      </div>
    </div>
  </section>

  <!-- Standalone -->
  <section id="standalone" class="scroll-mt-20">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
      <p class="eyebrow">Standalone mode</p>
      <h2 class="section-title">An assistant from parts you choose</h2>
      <p class="text-ink-muted text-body-l mt-4 max-w-3xl">
        Without Home Assistant, the satellite hands each request to its brain:
        the language model or AI agent that works out what you asked and
        answers. You set it up on the satellite's dashboard, and it uses the
        tools you allow.
        Standalone mode is new: it has been tried on an Echo Dot (2nd gen)
        with OpenRouter and ElevenLabs, not yet with every service.
      </p>
      <div class="mt-12">
        <Switchboard />
      </div>
    </div>
  </section>

  <!-- Features -->
  <div id="features" class="scroll-mt-20">
    <!-- Satellite groups -->
    <section id="groups" class="scroll-mt-20">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
        <p class="eyebrow">Satellite groups</p>
        <h2 class="section-title">Satellites that work together</h2>
        <p class="text-ink-muted text-body-l mt-4 max-w-3xl">
          Put the satellites in your home in one group, and ask any of them to
          pass a message or act on another by its name.
        </p>
        <div class="mt-10">
          <GroupsPlan />
        </div>
      </div>
    </section>

    <!-- Wake words -->
    <section id="wake-words" class="scroll-mt-20">
      <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-16 lg:py-20">
        <div>
          <p class="eyebrow">Wake words</p>
          <h2 class="section-title">A wake word you can tune</h2>
          <p class="text-ink-muted text-body-l mt-4">
            The satellite keeps its recent wakes and near misses with their
            scores, so you can see what a sensitivity catches and what it
            ignores. Try the slider.
          </p>
          <div class="facts mt-8" style="--facts: 1">
            <div class="fact">
              <span class="fact-title">Five built in, or your own</span>
              <span class="fact-say">
                Alexa, Hey Jarvis, Hey Mycroft, Hey Rhasspy and Okay Nabu, up to two at once. Or upload an openWakeWord
                model for a phrase of your own.
              </span>
            </div>
            <div class="fact">
              <span class="fact-title">Calibrate where you stand</span>
              <span class="fact-say">
                Say the wake word, then press + if it missed you or − if something else woke it. The ring shows the
                setting.
              </span>
            </div>
          </div>
          <p class="mt-6 text-sm">
            <a class="link inline-flex items-center gap-1.5" href={docHref("wake-words")}>
              Wake words
              <Icon name="arrow" size={14} />
            </a>
          </p>
        </div>
        <WakeMeter />
      </div>
    </section>

    <!-- Music -->
    <section id="music" class="scroll-mt-20">
      <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:gap-16 lg:py-20">
        <div class="lg:order-2">
          <p class="eyebrow">Music</p>
          <h2 class="section-title">A speaker that steps aside</h2>
          <p class="text-ink-muted text-body-l mt-4">
            Play from your phone, your computer or Music Assistant. When you
            speak to the satellite, the music makes room and comes back.
          </p>
          <div class="facts mt-8" style="--facts: 1">
            <div class="fact">
              <span class="fact-title">Off until you turn it on</span>
              <span class="fact-say">
                AirPlay, Bluetooth, radio by name, and Sendspin, which plays in step with Music Assistant's other speakers
                (experimental).
              </span>
            </div>
            <div class="fact">
              <span class="fact-title">Replies come first</span>
              <span class="fact-say">
                Music drops 20 dB while the satellite listens, works on a request or speaks.
              </span>
            </div>
            <div class="fact">
              <span class="fact-title">The wake word still hears you</span>
              <span class="fact-say">
                Echo cancellation lowers the device's own music by 23 to 31 dB, measured on the Echo Dot (2nd gen).
              </span>
            </div>
          </div>
          <p class="mt-6 text-sm">
            <a class="link inline-flex items-center gap-1.5" href={docHref("music")}>
              Play music
              <Icon name="arrow" size={14} />
            </a>
          </p>
        </div>
        <div class="lg:order-1">
          <MusicDuck />
        </div>
      </div>
    </section>

    <!-- Updates -->
    <section id="updates" class="scroll-mt-20">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
        <p class="eyebrow">Updates</p>
        <h2 class="section-title">Updates that roll back by themselves</h2>
        <p class="text-ink-muted text-body-l mt-4 max-w-3xl">
          The satellite has two copies of its system. An update goes into the
          one it isn't running, and if that one doesn't start, the satellite
          goes back to the other by itself, kernel included.
        </p>
        <div class="mt-10">
          <UpdateSlots />
        </div>
        <div class="facts mt-10" style="--facts: 3">
          <div class="fact">
            <span class="fact-title">Signed releases</span>
            <span class="fact-say">
              It checks the Stable or Beta channel once a day, unless you turn updates off, and installs only releases whose signature checks
              out.
            </span>
          </div>
          <div class="fact">
            <span class="fact-title">When you want</span>
            <span class="fact-say">
              Install from the dashboard or Home Assistant, or let it install by itself in a window you choose.
            </span>
          </div>
          <div class="fact">
            <span class="fact-title">Always a way back</span>
            <span class="fact-say">
              Fastboot stays reachable on every start, and your backup restores the original firmware.
            </span>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Hardware -->
  <section id="hardware" class="scroll-mt-20">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
      <p class="eyebrow">Devices</p>
      <h2 class="section-title">Two Echos, one image</h2>
      <p class="text-ink-muted text-body-l mt-4 max-w-3xl">
        The Echo (2nd gen) and the Echo Dot (2nd gen) share the MT8163
        platform and run the same image. More Echo devices may follow.
      </p>

      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {
          devices.map((d) => (
            <div class="spec">
              <div class="spec-pic">
                <DeviceDrawing model={d.model} id={`spec-${d.model}`} effect="idle" width="100%" label={`Illustration of an ${d.name}.`} />
              </div>
              <div class="spec-body">
                <h3 class="text-ink text-heading">{d.name}</h3>
                <dl class="spec-rows">
                  {d.rows.map((r) => (
                    <div>
                      <dt>{r.label}</dt>
                      <dd>{r.value}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </div>
          ))
        }
      </div>

      <div class="facts mt-10" style="--facts: 3">
        <div class="fact">
          <span class="fact-title">It needs an unlocked bootloader</span>
          <span class="fact-say">
            The unlock (amonet) installs Kaeru, a small addition to the
            bootloader. Pinna installs over fastboot, the bootloader's USB mode
            for writing the device's storage. Holding Volume Down while you
            plug the device in always opens it.
          </span>
        </div>
        <div class="fact">
          <span class="fact-title">You keep a backup</span>
          <span class="fact-say">
            You back up your own device before you install, and Pinna can
            restore that backup.
          </span>
        </div>
        <div class="fact">
          <span class="fact-title">It's standard Linux</span>
          <span class="fact-say">
            Debian trixie with systemd, on a read-only root filesystem. Pinna's
            own programs are written in Rust.
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Get started -->
  <section id="start" class="scroll-mt-20">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
      <p class="eyebrow">Get started</p>
      <h2 class="section-title">Install Pinna</h2>

      <div class="mt-10 grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] lg:gap-16">
        <ol class="timeline">
          <li>
            <span class="node">1</span>
            <span class="text-ink block font-semibold">Unlock and back up the device</span>
            <span class="text-ink-muted text-body">
              Pinna installs on an Echo whose bootloader is unlocked. Back it
              up first if you want to go back to its current firmware later.
            </span>
          </li>
          <li>
            <span class="node">2</span>
            <span class="text-ink block font-semibold">Install from the browser</span>
            <span class="text-ink-muted text-body">
              The installer downloads the newest release, checks its signature
              and writes it over USB. From a terminal,
              <code class="font-mono text-sm">scripts/flash-gen2.sh</code> does
              the same.
            </span>
          </li>
          <li>
            <span class="node">3</span>
            <span class="text-ink block font-semibold">Set it up on the dashboard</span>
            <span class="text-ink-muted text-body">
              Open the satellite's dashboard in your browser: every setting is
              there. Add it to Home Assistant, or set up standalone mode, and
              say the wake word.
            </span>
          </li>
        </ol>

        <div>
          <div class="card p-6">
            <p class="text-ink font-semibold">The installer</p>
            <p class="text-ink-muted text-body mt-2">
              Choose your device, plug it in, and install. The page checks the
              device first and asks you before it writes anything. It runs in
              Chrome, Edge, Brave or Opera on a computer.
            </p>
            <a class="pn-btn pn-btn-primary pn-btn-lg mt-5" href={href("/install/")}>
              Open the installer
              <Icon name="arrow" size={16} />
            </a>
          </div>
          <div class="pn-notice mt-5" data-tone="caution">
            <span class="pn-notice-icon"><Icon name="shield" size={20} /></span>
            <div class="pn-notice-body">
              <p class="pn-notice-title">Unlocking can brick the device</p>
              <p class="text-body">
                Pinna doesn't unlock devices, and its docs don't cover the
                unlock. A mistake there can leave the device unusable. Pinna
                itself never writes the bootloader or Kaeru, so fastboot stays
                reachable after you install it: hold Volume Down while you plug
                the device in, and restore your backup from there. Making and
                restoring the backup needs a Linux computer with
                <code>adb</code> and <code>fastboot</code>.
              </p>
              <p class="text-sm">
                <a class="link inline-flex items-center gap-1.5" href={docHref("recovery")}>
                  Recover a device
                  <Icon name="arrow" size={14} />
                </a>
              </p>
            </div>
          </div>
          <p class="mt-4 flex flex-col gap-2 text-sm">
            <a class="link inline-flex items-center gap-1.5" href={docHref("requirements")}>
              Read the full guide, including what you need first
              <Icon name="arrow" size={14} />
            </a>
            <a class="link inline-flex items-center gap-1.5" href={docHref("build")}>
              Build Pinna yourself
              <Icon name="arrow" size={14} />
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Status -->
  <section id="status" class="scroll-mt-20">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
      <p class="eyebrow">Status</p>
      <h2 class="section-title">Where Pinna stands</h2>

      <div class="mt-10 grid gap-10 lg:grid-cols-2 lg:gap-16">
        <div>
          <p class="status-head">What works</p>
          <ul class="leds mt-5" style="--led: var(--ok)">
            {works.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div>
          <p class="status-head">Known gaps</p>
          <ul class="leds mt-5" style="--led: var(--caution)">
            {gaps.map((item) => <li>{item}</li>)}
          </ul>
          <p class="mt-6 text-sm">
            <a class="link inline-flex items-center gap-1.5" href={docHref("status")}>
              Status and roadmap
              <Icon name="arrow" size={14} />
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Goals -->
  <section id="goals" class="scroll-mt-20">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
      <p class="eyebrow">Goals</p>
      <h2 class="section-title">What Pinna sets out to do</h2>

      <ol class="facts mt-10" style="--facts: 4">
        {
          goals.map((goal, i) => (
            <li class="fact">
              <span class="goal-num">{String(i + 1).padStart(2, "0")}</span>
              <span class="fact-title">{goal.title}</span>
              <span class="fact-say">{goal.body}</span>
            </li>
          ))
        }
      </ol>

      <p class="mt-8 text-sm">
        <a class="link inline-flex items-center gap-1.5" href={docHref("goals")}>
          Read the goals, the plans and what's out of scope
          <Icon name="arrow" size={14} />
        </a>
      </p>
    </div>
  </section>

  <!-- How you can help -->
  <section id="help" class="scroll-mt-20">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
      <p class="eyebrow">Get involved</p>
      <h2 class="section-title">Help with Pinna</h2>
      <p class="text-ink-muted text-body-l mt-4 max-w-3xl">
        Pinna is a small project in early development, and most of the useful
        work happens on real devices. Until 1.0 it can change from one release
        to the next, standalone mode most of all, and what owners report
        shapes those changes. You can help in three ways:
      </p>

      <div class="facts mt-10" style="--facts: 3">
        <div class="fact">
          <span class="fact-title">Give feedback</span>
          <span class="fact-say">
            Say what works for you, what doesn't and what you miss. If an
            installation fails, the ring stays dark or the wake word doesn't
            trigger, open an issue with the version and the log, as
            <a class="link" href={docHref("troubleshooting") + "#report-a-problem"}>Report a problem</a>
            describes.
          </span>
          <span class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm">
            <a class="link inline-flex items-center gap-1.5" href={`${SITE.repo}/discussions`}>
              Start a discussion
              <Icon name="arrow" size={14} />
            </a>
            <a class="link inline-flex items-center gap-1.5" href={`${SITE.repo}/issues`}>
              Open an issue
              <Icon name="arrow" size={14} />
            </a>
          </span>
        </div>
        <div class="fact">
          <span class="fact-title">Send changes</span>
          <span class="fact-say">
            Pinna is a small Rust workspace with standard systemd units.
            Experience with Rust, systemd or embedded audio helps most. Open an
            issue before larger changes, so that nobody does the same work
            twice.
          </span>
          <span class="mt-3 text-sm">
            <a class="link inline-flex items-center gap-1.5" href={docHref("development")}>
              Contribute
              <Icon name="arrow" size={14} />
            </a>
          </span>
        </div>
        <div class="fact">
          <span class="fact-title">Support another device</span>
          <span class="fact-say">
            Pinna supports the Echo (2nd gen) and the Echo Dot (2nd gen), and
            aims to support more Echo devices. Each needs a device tree, board
            support and a device to test on.
          </span>
          <span class="mt-3 text-sm">
            <a class="link inline-flex items-center gap-1.5" href={docHref("architecture")}>
              Read the architecture
              <Icon name="arrow" size={14} />
            </a>
          </span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
