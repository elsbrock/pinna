---
// The browser installer (ADR 0016): a page of its own, as five steps, with
// the help for when it doesn't work below them. The ids are what
// src/lib/installer/install-page.ts drives.
import BaseLayout from "../layouts/BaseLayout.astro";
import DeviceDrawing from "../components/DeviceDrawing.astro";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import { docHref, href, SITE } from "../lib/site";

const UDEV_RULE =
  'SUBSYSTEM=="usb", ATTR{idVendor}=="0bb4", ATTR{idProduct}=="0c01", TAG+="uaccess"';

const MODELS = [
  {
    value: "echo-dot-2",
    name: "Echo Dot (2nd gen)",
    hint: "Connects with a micro-USB cable.",
    width: 80,
  },
  {
    value: "echo-2",
    name: "Echo (2nd gen)",
    hint: "Connects through the USB pads in its base.",
    width: 40,
  },
] as const;
---

<BaseLayout
  title="Install Pinna"
  description="Install Pinna on an Echo (2nd gen) or an Echo Dot (2nd gen) from Chrome, Edge, Brave or Opera, over USB, without a terminal."
>
  <header slot="header" class="border-line bg-surface/85 sticky top-0 z-30 border-b backdrop-blur">
    <div class="mx-auto flex h-14 max-w-5xl items-center gap-3 px-4 sm:px-6">
      <a href={href("/")} class="flex items-center gap-2.5" aria-label="Pinna home">
        <Logo size={24} />
        <span class="text-ink-muted text-sm">/ install</span>
      </a>
      <div class="ml-auto flex items-center gap-2">
        <a class="pn-btn px-2.5" href={SITE.repo} aria-label="Pinna on GitHub">
          <Icon name="github" size={16} />
        </a>
        <a class="pn-btn" href={docHref("flash")}>Docs</a>
      </div>
    </div>
  </header>

  <div class="install mx-auto max-w-3xl px-4 pt-10 pb-6 sm:px-6 sm:pt-14">
    <p class="eyebrow">Installer</p>
    <h1 class="font-display text-ink text-display-l sm:text-display-xl mt-2 text-balance">
      Install Pinna
    </h1>
    <p class="text-ink-muted text-body-l mt-4 max-w-2xl">
      This page installs Pinna on an Echo (2nd gen) or an Echo Dot (2nd gen)
      over USB, without a terminal. It checks the device first, and asks you
      before it writes anything.
    </p>

    <div id="install-unsupported" class="pn-notice mt-8" data-tone="danger" hidden>
      <Icon name="close" class="pn-notice-icon" />
      <div class="pn-notice-body">
        <p class="pn-notice-title">This browser can't talk to USB devices</p>
        <p>
          Open this page in Chrome, Edge, Brave or Opera on a computer. Firefox
          and Safari don't support WebUSB. Or install from a terminal, as
          described in <a class="link" href={docHref("flash") + "#install-from-a-terminal"}>Install Pinna</a>.
        </p>
      </div>
    </div>

    <section class="card mt-8 p-5 sm:p-6" aria-labelledby="before-title">
      <h2 id="before-title" class="text-ink text-lg font-semibold">Before you start</h2>
      <ul class="mt-4 grid gap-x-8 gap-y-4 sm:grid-cols-2">
        <li class="before-item">
          <Icon name="shield" size={18} class="text-caution" />
          <span>
            <strong class="text-ink">A device that was unlocked before.</strong>
            It runs Pinna, or other firmware with adb. A device that still runs
            Amazon's software needs the bootloader unlock first: this page can
            check it, but can't unlock it yet.
          </span>
        </li>
        <li class="before-item">
          <Icon name="disk" size={18} />
          <span>
            <strong class="text-ink">A backup, if you want to go back later.</strong>
            Installing replaces the current firmware and erases the device's
            data. Make the backup as described in
            <a class="link" href={`${docHref("requirements")}#backup-of-the-device`}>What you need</a>;
            this page can't make one yet.
          </span>
        </li>
        <li class="before-item">
          <Icon name="terminal" size={18} />
          <span>
            <strong class="text-ink">Chrome, Edge, Brave or Opera</strong> on a
            computer, with an internet connection: the page downloads the
            release from <code>updates.getpinna.dev</code>. On Linux, the
            browser needs a <a class="link" href="#cannot-open">udev rule</a>;
            on Windows, the <a class="link" href="#windows">WinUSB driver</a>.
          </span>
        </li>
        <li class="before-item">
          <Icon name="ring" size={18} />
          <span>
            <strong class="text-ink">A USB connection.</strong> For the Echo Dot
            (2nd gen), a micro-USB cable that carries data, plugged straight
            into the computer, not into a hub. For the Echo (2nd gen), pogo pins
            or a cable soldered to the USB pads on its base.
          </span>
        </li>
      </ul>
    </section>

    <form id="install-form" class="mt-12" onsubmit="return false">
      <ol class="install-steps">
        <li class="pn-step" id="install-step-model" data-state="current">
          <span class="pn-step-mark" aria-hidden="true">
            <span class="step-num">1</span>
            <Icon name="check" size={16} class="step-done" strokeWidth={2.25} />
            <Icon name="close" size={16} class="step-failed" strokeWidth={2.25} />
          </span>
          <h2 class="pn-step-label">Choose your device</h2>
          <div class="step-body">
            <fieldset id="install-models" class="grid gap-3 sm:grid-cols-2">
              <legend class="sr-only">Your device</legend>
              {
                MODELS.map((model) => (
                  <label class="device-option">
                    <input class="sr-only" type="radio" name="model" value={model.value} required />
                    <span class="device-pic" aria-hidden="true">
                      <DeviceDrawing model={model.value} effect="idle" width={model.width} label="" id={`pick-${model.value}`} />
                    </span>
                    <span class="min-w-0">
                      <span class="text-ink block font-semibold">{model.name}</span>
                      <span class="text-ink-muted mt-0.5 block text-sm">{model.hint}</span>
                    </span>
                    <Icon name="check" size={18} class="device-check" strokeWidth={2.25} />
                  </label>
                ))
              }
            </fieldset>
            <div class="pn-notice mt-4">
              <Icon name="board" class="pn-notice-icon" />
              <div class="pn-notice-body">
                <p class="pn-notice-title">The Echo Dot (5th gen) isn't in this list</p>
                <p>
                  Pinna installs on it from TWRP, not from this page. It is
                  unlocked with firebreak, which Pinna doesn't ship, and has
                  its own steps:
                  <a class="link" href={docHref("flash") + "#install-on-the-echo-dot-5th-gen"}>Install on the Echo Dot (5th gen)</a>.
                  See <a class="link" href={docHref("devices") + "#echo-dot-5th-gen"}>Echo devices</a>
                  for what works on it.
                </p>
              </div>
            </div>
          </div>
        </li>

        <li class="pn-step" id="install-step-release" data-state="pending">
          <span class="pn-step-mark" aria-hidden="true">
            <span class="step-num">2</span>
            <Icon name="check" size={16} class="step-done" strokeWidth={2.25} />
            <Icon name="close" size={16} class="step-failed" strokeWidth={2.25} />
          </span>
          <h2 class="pn-step-label">Get Pinna</h2>
          <div class="step-body">
            <p>
              The page downloads the newest release, and checks its signature
              and each file before it writes anything.
            </p>
            <fieldset id="install-channels" class="mt-4 flex flex-wrap items-center gap-3">
              <legend class="sr-only">Release channel</legend>
              <span class="channel-picker">
                <label>
                  <input class="sr-only" type="radio" name="channel" value="stable" checked />
                  Stable
                </label>
                <label>
                  <input class="sr-only" type="radio" name="channel" value="beta" />
                  Beta
                </label>
              </span>
              <button id="install-download" type="button" class="pn-btn pn-btn-primary">
                <Icon name="arrow" size={16} class="rotate-90" />
                <span id="install-download-label">Download</span>
              </button>
            </fieldset>
            <p class="text-ink-muted mt-2 text-sm">
              Stable has finished releases. Beta also has releases before they
              are finished.
            </p>
            <ul id="install-download-status" class="mt-3 flex flex-col gap-1 text-sm" aria-live="polite"></ul>
            <details class="mt-4">
              <summary class="text-ink-muted cursor-pointer text-sm font-semibold">
                Use files you downloaded or built
              </summary>
              <p class="text-ink-muted mt-2 mb-2 text-sm">
                Select <code>pinna-boot.img</code>, <code>pinna-&lt;version&gt;.root.img</code> and
                <code>SHA256SUMS</code> together. The page checks each file against
                <code>SHA256SUMS</code>; the device checks the root image's signature.
              </p>
              <input id="install-files" type="file" multiple class="pn-input w-full py-2" />
              <ul id="install-files-status" class="mt-2 flex flex-col gap-1 text-sm"></ul>
            </details>
          </div>
        </li>

        <li class="pn-step" id="install-step-fastboot" data-state="pending">
          <span class="pn-step-mark" aria-hidden="true">
            <span class="step-num">3</span>
            <Icon name="check" size={16} class="step-done" strokeWidth={2.25} />
            <Icon name="close" size={16} class="step-failed" strokeWidth={2.25} />
          </span>
          <h2 class="pn-step-label">Start the device in fastboot</h2>
          <div class="step-body">
            <ol class="numbered" data-for-model="any">
              <li>Unplug the device.</li>
              <li>On an Echo (2nd gen), connect its USB pads to the computer first.</li>
              <li>Hold <strong>Volume Down (−)</strong>.</li>
              <li>
                Plug in the power while you hold it: on the Echo Dot (2nd gen)
                the micro-USB cable, with the other end on your computer; on the
                Echo (2nd gen) its power adapter.
              </li>
              <li>When the light ring changes, release the button.</li>
            </ol>
            <ol class="numbered" data-for-model="echo-dot-2">
              <li>Unplug the device.</li>
              <li>Hold <strong>Volume Down (−)</strong>.</li>
              <li>
                While you hold it, plug the micro-USB cable into the device, with
                the other end on your computer.
              </li>
              <li>When the light ring changes, release the button.</li>
            </ol>
            <ol class="numbered" data-for-model="echo-2">
              <li>Unplug the device.</li>
              <li>Connect its USB pads to the computer.</li>
              <li>Hold <strong>Volume Down (−)</strong>.</li>
              <li>While you hold it, plug in its power adapter.</li>
              <li>When the light ring changes, release the button.</li>
            </ol>
            <p class="text-ink-muted mt-3 text-sm">
              A device that still runs Amazon's software starts fastboot with
              <strong>Action</strong> instead of Volume Down. The page can check
              it, but not install on it.
            </p>
          </div>
        </li>

        <li class="pn-step" id="install-step-connect" data-state="pending">
          <span class="pn-step-mark" aria-hidden="true">
            <span class="step-num">4</span>
            <Icon name="check" size={16} class="step-done" strokeWidth={2.25} />
            <Icon name="close" size={16} class="step-failed" strokeWidth={2.25} />
          </span>
          <h2 class="pn-step-label">Connect</h2>
          <div class="step-body">
            <p>
              The browser asks which device to use. Choose <strong>Android</strong>
              (<code>0bb4:0c01</code>). The page then reads what the device is;
              it writes nothing yet.
            </p>
            <div class="mt-4 flex flex-wrap items-center gap-3">
              <button id="install-connect" type="button" class="pn-btn pn-btn-primary" disabled>
                Connect
              </button>
              <p id="install-status" class="text-ink-muted text-sm" role="status" aria-live="polite">
                Choose your device first.
              </p>
            </div>

            <div id="install-result" class="pn-notice mt-5" hidden>
              <span data-icon="ok" hidden><Icon name="check" class="pn-notice-icon" /></span>
              <span data-icon="caution" hidden><Icon name="shield" class="pn-notice-icon" /></span>
              <span data-icon="danger" hidden><Icon name="close" class="pn-notice-icon" /></span>
              <div class="pn-notice-body">
                <p id="install-headline" class="pn-notice-title"></p>
                <p id="install-detail"></p>
                <p id="install-next"></p>
                <details class="mt-2">
                  <summary class="cursor-pointer text-sm font-semibold">What the page read</summary>
                  <dl id="install-facts" class="mt-2 grid grid-cols-[max-content_minmax(0,1fr)] gap-x-6 gap-y-1 text-sm"></dl>
                </details>
              </div>
            </div>

            <div id="install-outcome-check"></div>
          </div>
        </li>

        <li class="pn-step" id="install-step-install" data-state="pending">
          <span class="pn-step-mark" aria-hidden="true">
            <span class="step-num">5</span>
            <Icon name="check" size={16} class="step-done" strokeWidth={2.25} />
            <Icon name="close" size={16} class="step-failed" strokeWidth={2.25} />
          </span>
          <h2 class="pn-step-label">Install</h2>
          <div class="step-body">
            <section id="install-confirm" hidden>
              <p>The page writes, in this order:</p>
              <ul class="bulleted mt-2">
                <li><code>system_a</code>: Pinna's root filesystem.</li>
                <li><code>system_b</code>: its beginning is cleared.</li>
                <li>
                  <code>userdata</code>: erased. Settings, Wi-Fi networks, the
                  pairing with Home Assistant and anything else stored on the
                  device are gone.
                </li>
                <li><code>boot_a</code> and <code>boot_b</code>: Pinna's boot image.</li>
              </ul>
              <p class="mt-3">
                Keep the device connected until the page says it's done, about a
                minute. If the install stops halfway, the device stays in
                fastboot and you can start again from step 3.
              </p>
              <label class="confirm-box mt-4">
                <input id="install-agree" type="checkbox" />
                <span id="install-agree-text">I want to erase this device and install Pinna on it.</span>
              </label>
              <div class="mt-4 flex flex-wrap items-center gap-3">
                <button id="install-start" type="button" class="pn-btn pn-btn-primary pn-btn-lg" disabled>Install Pinna</button>
                <span id="install-start-hint" class="text-ink-muted text-sm"></span>
              </div>
              <div id="install-progress-box" class="mt-4" hidden>
                <progress id="install-progress" class="w-full" max="1" value="0"></progress>
                <p id="install-progress-text" class="text-ink-muted mt-1 text-sm" aria-live="polite"></p>
              </div>
            </section>
            <p class="install-wait text-ink-muted">
              The page offers the install once it has checked the device in
              step 4.
            </p>

            <div id="install-done" class="pn-notice mt-5" data-tone="ok" hidden>
              <Icon name="check" class="pn-notice-icon" />
              <div class="pn-notice-body">
                <p class="pn-notice-title">Pinna is installed</p>
                <p>
                  The device restarts now. After about 20 seconds your computer
                  sees a USB device named <strong>Pinna</strong>. Open its
                  dashboard at <code>http://10.42.0.1</code>, and connect the
                  device to Wi-Fi there.
                </p>
                <p class="mt-3">
                  Without the cable, a release after 0.4.0-beta.3 also runs a
                  Wi-Fi network named <strong>Pinna setup</strong> followed by
                  its hostname, with the password <code>pinnasetup</code>. Join
                  it from a phone to open the dashboard.
                </p>
                <div class="mt-3 flex flex-wrap gap-2">
                  <a class="pn-btn pn-btn-primary" href="http://10.42.0.1" target="_blank" rel="noopener">
                    Open the dashboard
                    <Icon name="external" size={14} />
                  </a>
                  <a class="pn-btn" href={`${docHref("flash")}#connect-to-wi-fi`}>Connect to Wi-Fi</a>
                </div>
                <p class="mt-3 text-sm">
                  If the device is named <strong>Pinna rescue</strong> instead,
                  see <a class="link" href={`${docHref("flash")}#check-the-device`}>Check the device</a>.
                </p>
              </div>
            </div>

            <div id="install-outcome-install"></div>
          </div>
        </li>
      </ol>
    </form>

    <div id="install-problem" class="pn-notice mt-5" data-tone="danger" hidden>
      <Icon name="close" class="pn-notice-icon" />
      <div class="pn-notice-body">
        <p id="install-problem-title" class="pn-notice-title"></p>
        <p id="install-problem-text"></p>
      </div>
    </div>

    <details id="install-report-box" class="mt-5" hidden open>
      <summary class="text-ink cursor-pointer font-semibold">Report</summary>
      <p class="text-ink-muted mt-1 text-sm">
        If the result looks wrong, or the page can't go on, paste this into an
        issue. The serial number is cut short.
      </p>
      <textarea
        id="install-report"
        class="pn-input is-mono mt-2 h-56 w-full py-2"
        readonly
        aria-label="Device report"></textarea>
      <div class="mt-3 flex flex-wrap items-center gap-3">
        <button id="install-copy" type="button" class="pn-btn">Copy</button>
        <a id="install-issue" class="pn-btn" href={`${SITE.repo}/issues/new`} target="_blank" rel="noopener">
          Open an issue
          <Icon name="external" size={14} />
        </a>
        <span id="install-copy-status" class="text-ink-muted text-sm" aria-live="polite"></span>
      </div>
    </details>

    <section class="mt-16" aria-labelledby="help-title">
      <h2 id="help-title" class="font-display text-ink text-display-m">If it doesn't work</h2>
      <p class="text-ink-muted mt-2">
        You can also
        <a class="link" href={docHref("flash") + "#install-from-a-terminal"}>install from a terminal</a>.
      </p>

      <div class="help mt-5">
        <details id="not-listed">
          <summary>The device isn't in the list</summary>
          <ul class="bulleted">
            <li>The device isn't in fastboot. Start it again as described in step 3.</li>
            <li>
              The cable only charges. Try another cable, and a USB port on the
              computer itself.
            </li>
          </ul>
        </details>

        <details id="cannot-open">
          <summary>The browser can't open the device</summary>
          <p>
            On Linux the browser runs as your user, and only root may open USB
            devices that no rule names. Add this rule as
            <code>/etc/udev/rules.d/60-pinna-fastboot.rules</code>:
          </p>
          <pre><code>{UDEV_RULE}</code></pre>
          <p>Then load it:</p>
          <pre><code>sudo udevadm control --reload-rules && sudo udevadm trigger</code></pre>
          <p>
            On NixOS, put the rule in <code>services.udev.extraRules</code>
            instead. Then start the device in fastboot again (step 3) and
            connect again.
          </p>
        </details>

        <details id="busy">
          <summary>Another program uses the device</summary>
          <p>
            <code>fastboot</code>, <code>adb</code> (run <code>adb kill-server</code>),
            Android Studio, or this page in another tab. Close them and connect
            again.
          </p>
        </details>

        <details id="windows">
          <summary>Windows needs the WinUSB driver</summary>
          <p>
            Install it with <a class="link" href="https://zadig.akeo.ie/">Zadig</a>
            while the device is in fastboot: choose <strong>Options › List All Devices</strong>,
            select <strong>Android</strong> (USB ID <code>0BB4 0C01</code>), choose
            <strong>WinUSB</strong> and <strong>Install Driver</strong>. Then
            connect again.
          </p>
        </details>

        <details id="no-reply">
          <summary>The device doesn't answer, or goes away</summary>
          <p>
            The page stops after the first request that gets no reply, and sends
            nothing more. Some devices that were never unlocked reset when they
            get a request and come back in fastboot. Unplug the device, start it
            in fastboot again, use another cable or USB port, and connect again.
            If it happens every time, open an issue with the report the page
            shows.
          </p>
        </details>

        <details id="leave-fastboot">
          <summary>Leave fastboot without installing</summary>
          <p>Unplug the device and plug it in again. It starts as before.</p>
        </details>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { startInstallPage } from "../lib/installer/install-page";
  startInstallPage();
</script>

<style>
  .install code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 1px 4px;
    border-radius: var(--radius-xs);
    background: var(--surface-sunken);
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .install pre {
    margin: 0.75rem 0;
    padding: 0.75rem 1rem;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface-sunken);
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .install pre code {
    all: unset;
    font: inherit;
  }
  .install .numbered {
    list-style: decimal;
    padding-left: 1.25rem;
  }
  .install .bulleted {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .install .numbered > li + li,
  .install .bulleted > li + li {
    margin-top: 0.25rem;
  }

  /* Before you start */
  .before-item {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    gap: 12px;
    color: var(--ink-muted);
    font-size: 15px;
    line-height: 1.5;
  }
  .before-item > :global(svg) {
    margin-top: 2px;
    color: var(--ink-muted);
  }
  .before-item > :global(svg.text-caution) {
    color: var(--caution);
  }

  /* The steps: the design system's stepper, at page scale. */
  .install-steps {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .install-steps > .pn-step {
    grid-template-columns: 32px minmax(0, 1fr);
    gap: 6px 18px;
    padding-bottom: 40px;
  }
  .install-steps > .pn-step:last-child {
    padding-bottom: 0;
  }
  .install-steps > .pn-step::before {
    left: 15px;
    top: 40px;
    bottom: 8px;
  }
  .install-steps .pn-step-mark {
    grid-row: span 2;
    width: 32px;
    height: 32px;
    font-weight: 700;
    font-size: 14px;
  }
  .install-steps .pn-step-mark > :global(*) {
    display: none;
  }
  .install-steps .pn-step[data-state="current"] .pn-step-mark::after {
    display: none;
  }
  .install-steps .pn-step:not([data-state="done"]):not([data-state="failed"]) .step-num,
  .install-steps .pn-step[data-state="done"] :global(.step-done),
  .install-steps .pn-step[data-state="failed"] :global(.step-failed) {
    display: block;
  }
  .install-steps .pn-step[data-state="current"] .pn-step-mark {
    background: var(--signal);
    border-color: var(--signal);
    color: var(--surface-raised);
  }
  .install-steps .pn-step-label {
    margin: 0;
    font-size: 1.125rem;
    line-height: 32px;
  }
  .install-steps .pn-step[data-state="pending"] .pn-step-label {
    font-weight: 650;
    color: var(--ink-muted);
  }
  .install-steps .step-body {
    min-width: 0;
    color: var(--ink);
  }

  /* Step 1: the device cards. */
  .device-option {
    position: relative;
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr) 18px;
    align-items: center;
    gap: 14px;
    padding: 12px 14px 12px 10px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    cursor: pointer;
