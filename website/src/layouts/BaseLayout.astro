---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import { SITE, href } from "../lib/site";
import markUrl from "../../../design/mark.svg?url";

type Props = {
  /** Page title, without the site suffix. */
  title?: string;
  description?: string;
  footer?: boolean;
};

const {
  title = SITE.tagline,
  description = SITE.description,
  footer = true,
} = Astro.props;

const pageTitle = title === SITE.tagline ? `${SITE.name} — ${title}` : `${title} · ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.repo);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={href("/sitemap-index.xml")} />
    <link rel="icon" type="image/svg+xml" href={markUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta
      name="theme-color"
      content="#f3f5f6"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0e1215"
      media="(prefers-color-scheme: dark)"
    />
    <script is:inline>
      // Runs before the first paint, so a chosen theme never flashes.
      try {
        const theme = localStorage.getItem("pinna-theme");
        if (theme === "light" || theme === "dark") {
          document.documentElement.dataset.theme = theme;
        }
      } catch {
        // A browser that blocks storage keeps the system theme.
      }
    </script>
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <slot name="header" />
    <main class="flex-1">
      <slot />
    </main>
    {footer && <Footer />}
  </body>
</html>
