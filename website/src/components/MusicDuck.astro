---
// The landing page's music section: the sources as a row of inputs, each off
// until you turn it on, and a stretch of music whose level drops while a
// reply plays (audio.md: the media lane gets 20 dB quieter while the voice
// lane plays, or while the device listens or works on a request). A playhead
// crosses it on screen, unless motion is reduced.

// The music's envelope: a deterministic, gently varying level, so the page
// renders the same every time.
const BARS = 72;
const level = Array.from({ length: BARS }, (_, i) => {
  const v = 0.55 + 0.25 * Math.sin(i * 0.55) + 0.15 * Math.sin(i * 1.7 + 1) + 0.05 * Math.sin(i * 3.1);
  return Math.min(1, Math.max(0.18, v));
});
// The reply plays over this stretch, with a short ramp at each end.
const FROM = 30;
const TO = 50;
const duck = (i: number) => {
  if (i < FROM - 2 || i > TO + 2) return 1;
  if (i < FROM) return 1 - ((i - (FROM - 2)) / 2) * 0.82;
  if (i > TO) return 0.18 + ((i - TO) / 2) * 0.82;
  return 0.18;
};

const sources = [
  { name: "AirPlay", on: true },
  { name: "Bluetooth", on: true },
  { name: "Sendspin", on: false, note: "experimental" },
  { name: "Radio", on: true },
];
---

<div class="music" data-music data-animates>
  <div class="sources" role="list" aria-label="Music sources">
    {
      sources.map((s) => (
        <span class="source" role="listitem" data-on={s.on ? "" : undefined}>
          <span class="led" aria-hidden="true" />
          {s.name}
          {s.note && <span class="note">{s.note}</span>}
          <span class="sr">{s.on ? ", on" : ", off"}</span>
        </span>
      ))
    }
  </div>

  <div class="track" aria-hidden="true">
    <p class="bubble" style={`--at:${((FROM / BARS) * 100).toFixed(2)}%`}>
      <span class="who">Reply</span>
      Light rain from noon, up to 12 degrees.
    </p>
    <div class="dip" style={`left:${((FROM / BARS) * 100).toFixed(2)}%;width:${(((TO - FROM + 1) / BARS) * 100).toFixed(2)}%`}>
      <span>−20 dB</span>
    </div>
    <div class="bars">
      {level.map((v, i) => <span class:list={["b", { ducked: duck(i) < 1 }]} style={`--h:${(v * duck(i)).toFixed(3)}`} />)}
    </div>
    <span class="playhead"></span>
  </div>
</div>

<style>
  /* Fills the column beside it: the waveform takes the height left over. */
  .music {
    flex: 1;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: 22px;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    box-shadow: var(--shadow-raised);
  }

  .sources {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .source {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    background: var(--surface-sunken);
    color: var(--ink-muted);
    font-size: 14px;
    font-weight: 650;
  }

  .source[data-on] {
    color: var(--ink);
  }

  .led {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .source[data-on] .led {
    background: var(--ok);
    box-shadow: 0 0 6px 1px color-mix(in oklab, var(--ok) 55%, transparent);
  }

  .note {
    color: var(--ink-muted);
    font-size: 12px;
    font-weight: 400;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ------------------------------------------------------------ track -- */

  .track {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-top: 76px;
  }

  .bars {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 2px;
    min-height: 7rem;
  }

  .b {
    flex: 1 1 0;
    height: calc(var(--h) * 100%);
    border-radius: 2px;
    background: linear-gradient(to top, var(--brand-start), var(--brand-end));
    opacity: 0.85;
  }

  .b.ducked {
    opacity: 0.45;
  }

  /* The stretch under the reply. */
  .dip {
    position: absolute;
    top: 70px;
    bottom: -6px;
    border: 1px dashed color-mix(in oklab, var(--brand-mid) 50%, var(--line));
    border-radius: var(--radius-sm);
    background: color-mix(in oklab, var(--brand-mid) 6%, transparent);
  }

  .dip span {
    position: absolute;
    right: 6px;
    bottom: 4px;
    color: var(--brand-mid);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
  }

  /* Over the dip, but never past the track's right edge on a narrow screen. */
  .bubble {
    position: absolute;
    top: 0;
    left: clamp(0px, var(--at), calc(100% - 17rem));
    z-index: 2;
    width: max-content;
    max-width: min(17rem, 70%);
    margin: 0;
    padding: 6px 12px 8px;
    border: 1px solid color-mix(in oklab, var(--brand-mid) 35%, var(--line));
    border-radius: var(--radius-md);
    background: color-mix(in oklab, var(--brand-mid) 12%, var(--surface-raised));
    color: var(--ink);
    font-size: 14px;
    line-height: 20px;
  }

  .bubble::after {
    content: "";
    position: absolute;
    bottom: -6px;
    left: 24px;
    width: 10px;
    height: 10px;
    border-right: 1px solid;
    border-bottom: 1px solid;
    border-color: inherit;
    background: inherit;
    transform: rotate(45deg);
  }

  .who {
    display: block;
    color: var(--ink-muted);
    font-size: 11px;
    line-height: 16px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .playhead {
    position: absolute;
    top: 70px;
    bottom: -6px;
    left: 0;
    width: 2px;
    border-radius: 1px;
    background: var(--ink);
    opacity: 0.6;
    animation: play 14s linear infinite;
  }

  @keyframes play {
    from {
      left: 0;
    }
    to {
      left: calc(100% - 2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .playhead {
      display: none;
    }
  }
</style>
