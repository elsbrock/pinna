---
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { docHref, SITE } from "../lib/site";

// Set by astro.config.mjs from git at build time.
declare const __PINNA_SITE_VERSION__: { describe: string; commit: string };
const version = __PINNA_SITE_VERSION__;

const docs = [
  { slug: "", title: "Overview" },
  { slug: "requirements", title: "What you need" },
  { slug: "flash", title: "Install Pinna" },
  { slug: "dashboard", title: "Set up the satellite" },
  { slug: "home-assistant", title: "Connect to Home Assistant" },
  { slug: "standalone", title: "Set up standalone mode" },
  { slug: "goals", title: "Goals" },
];

const project = [
  { href: SITE.repo, title: "GitHub" },
  { href: SITE.adr, title: "Decision records" },
  { href: SITE.runbook, title: "First-flash runbook" },
  { href: `${SITE.repo}/issues`, title: "Issues" },
];
---

<footer class="border-line bg-surface-raised mt-24 border-t">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-10 md:grid-cols-[1.6fr_1fr_1fr]">
      <div>
        <Logo size={24} />
        <p class="text-ink-muted mt-3 max-w-sm text-body">
          Pinna is an open-source operating system that turns the Echo (2nd
          gen) and the Echo Dot (2nd gen) into a local voice satellite, with
          Home Assistant or on its own.
        </p>
        <p class="text-ink-muted mt-4 max-w-sm text-caption">
          Pinna is an independent project and isn't affiliated with Amazon.
          Echo and Alexa are trademarks of Amazon.com, Inc.
        </p>
      </div>

      <div>
        <p class="eyebrow">Docs</p>
        <ul class="mt-3 space-y-2 text-sm">
          {
            docs.map((doc) => (
              <li>
                <a
                  class="text-ink-muted hover:text-ink transition-colors"
                  href={docHref(doc.slug)}
                >
                  {doc.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="eyebrow">Project</p>
        <ul class="mt-3 space-y-2 text-sm">
          {
            project.map((item) => (
              <li>
                <a
                  class="text-ink-muted hover:text-ink transition-colors"
                  href={item.href}
                >
                  {item.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="border-line text-ink-muted mt-10 flex flex-col gap-2 border-t pt-6 text-xs sm:flex-row sm:items-center sm:justify-between"
    >
      <p>
        Site source in <a
          class="text-ink-muted hover:text-ink font-mono"
          href={`${SITE.repo}/tree/main/website`}>website/</a
        > · built with Astro and Tailwind CSS ·
        {
          version.commit ? (
            <a
              class="text-ink-muted hover:text-ink font-mono"
              href={`${SITE.repo}/commit/${version.commit}`}
              title="The commit this site was built from"
            >
              {version.describe}
            </a>
          ) : (
            <span class="font-mono">{version.describe}</span>
          )
        }
      </p>
      <div class="flex items-center gap-4">
        <a class="text-ink-muted hover:text-ink" href={docHref("status")}
          >Status and roadmap</a
        >
        <ThemeToggle />
      </div>
    </div>
  </div>
</footer>
