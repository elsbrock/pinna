type Props = {
  name: string;
  size?: number;
  class?: string;
  strokeWidth?: number;
};

const { name, size = 20, class: className = "", strokeWidth = 1.75 } =
  Astro.props;
const paths = ICONS[name as keyof typeof ICONS] ?? ICONS.ring;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  set:html={paths}
/>
