---
// The mark (design/mark.svg) and the wordmark in Unbounded. The mark's
// colours are fixed, the same in light and dark, so it is an image: inlined
// twice on a page, its gradient ids would collide.
import markUrl from "../../../design/mark.svg?url";

type Props = {
  /** Mark size in px; the wordmark scales with it. */
  size?: number;
  wordmark?: boolean;
  class?: string;
};

const { size = 28, wordmark = true, class: className } = Astro.props;
---

<span class:list={["inline-flex items-center gap-2.5", className]}>
  <img class="block shrink-0" src={markUrl} alt={wordmark ? "" : "Pinna"} width={size} height={size} />
  {
    wordmark && (
      <span
        class="font-display text-ink font-semibold tracking-[-0.01em]"
        style={`font-size:${Math.round(size * 0.72)}px;line-height:1`}
      >
        Pinna
      </span>
    )
  }
</span>
