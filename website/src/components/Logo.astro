---
// The mark (design/mark.svg: the ring's boot frame) and the wordmark in Unbounded.
import mark from "../../../design/mark.svg?raw";

type Props = {
  /** Mark size in px; the wordmark scales with it. */
  size?: number;
  wordmark?: boolean;
  class?: string;
};

const { size = 28, wordmark = true, class: className } = Astro.props;
// Inline, the mark takes its colours from the tokens (its own <style> only
// serves the favicon); the rim brightens in dark so the disc keeps its edge.
const svg = mark
  .replace(/<title>.*?<\/title>/, "")
  .replace(/<style>.*?<\/style>/, "")
  .replace('class="puck"', 'class="pn-mark-puck"')
  .replace('width="100" height="100"', 'width="100%" height="100%" aria-hidden="true" focusable="false"');
---

<style is:global>
  .pn-mark-puck {
    fill: var(--puck);
    stroke: var(--puck-rim);
  }
  @media (prefers-color-scheme: dark) {
    .pn-mark-puck {
      stroke: var(--line-strong);
    }
  }
</style>

<span class:list={["inline-flex items-center gap-2.5", className]}>
  <span class="block shrink-0" style={`width:${size}px;height:${size}px`} set:html={svg} />
  {
    wordmark && (
      <span
        class="font-display text-ink font-semibold tracking-[-0.01em]"
        style={`font-size:${Math.round(size * 0.72)}px;line-height:1`}
      >
        Pinna
      </span>
    )
  }
</span>
