---
type Props = { class?: string };

const { class: className = "h-6 w-6" } = Astro.props;
---

<svg viewBox="0 0 32 32" class={className} aria-hidden="true">
  <circle
    cx="16"
    cy="16"
    r="10.5"
    fill="none"
    stroke="currentColor"
    stroke-width="3"
    stroke-linecap="round"
    stroke-dasharray="16.5 5.5"
  ></circle>
  <circle cx="16" cy="16" r="2.4" fill="var(--color-ring)"></circle>
</svg>
