---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { href, SITE } from "../lib/site";
---

<header
  class="border-line bg-canvas/85 sticky top-0 z-30 border-b backdrop-blur"
>
  <div class="mx-auto flex h-14 max-w-6xl items-center gap-2 px-4 sm:px-6">
    <a href={href("/")} class="flex items-center gap-2.5">
      <Logo class="text-accent h-7 w-7" />
      <span class="text-ink text-[1.0625rem] font-semibold tracking-tight"
        >Pinna</span
      >
    </a>

    <nav class="text-muted ml-5 hidden items-center gap-1 lg:flex">
      <a
        class="hover:bg-surface hover:text-ink rounded-md px-3 py-2 text-sm"
        href="#how">How it works</a
      >
      <a
        class="hover:bg-surface hover:text-ink rounded-md px-3 py-2 text-sm"
        href="#features">Features</a
      >
      <a
        class="hover:bg-surface hover:text-ink rounded-md px-3 py-2 text-sm"
        href="#assistant">Home Assistant</a
      >
      <a
        class="hover:bg-surface hover:text-ink rounded-md px-3 py-2 text-sm"
        href="#use-cases">Use cases</a
      >
      <a
        class="hover:bg-surface hover:text-ink rounded-md px-3 py-2 text-sm"
        href="#hardware">Hardware</a
      >
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <a
        class="btn btn-secondary px-2.5"
        href={SITE.repo}
        aria-label="Pinna on GitHub"
      >
        <Icon name="github" size={16} />
      </a>
      <a class="btn btn-secondary hidden sm:inline-flex" href={href("/docs/")}
        >Docs</a
      >
      <a class="btn btn-primary" href={href("/docs/build/")}>Get started</a>
    </div>
  </div>
</header>
