---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { href, SITE } from "../lib/site";
---

<header
  class="border-line bg-surface/85 sticky top-0 z-30 border-b backdrop-blur"
>
  <div class="mx-auto flex h-14 max-w-6xl items-center gap-2 px-4 sm:px-6">
    <a href={href("/")} class="flex items-center" aria-label="Pinna home">
      <Logo size={28} />
    </a>

    <nav class="text-ink-muted ml-5 hidden items-center gap-1 lg:flex">
      <a
        class="hover:bg-surface-sunken hover:text-ink rounded-sm px-3 py-2 text-sm"
        href="#how">How it works</a
      >
      <a
        class="hover:bg-surface-sunken hover:text-ink rounded-sm px-3 py-2 text-sm"
        href="#features">Features</a
      >
      <a
        class="hover:bg-surface-sunken hover:text-ink rounded-sm px-3 py-2 text-sm"
        href="#modes">Modes</a
      >
      <a
        class="hover:bg-surface-sunken hover:text-ink rounded-sm px-3 py-2 text-sm"
        href="#hardware">Devices</a
      >
      <a
        class="hover:bg-surface-sunken hover:text-ink rounded-sm px-3 py-2 text-sm"
        href="#goals">Goals</a
      >
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <a
        class="pn-btn px-2.5"
        href={SITE.repo}
        aria-label="Pinna on GitHub"
      >
        <Icon name="github" size={16} />
      </a>
      <a class="pn-btn" href={href("/docs/")}>Docs</a>
      <a class="pn-btn pn-btn-primary" href={href("/install/")}>Install</a>
    </div>
  </div>
</header>
