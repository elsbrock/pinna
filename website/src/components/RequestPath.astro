---
// The landing page's "How it works": one request as a loop round one
// satellite. It leaves at the ring, which hears the wake word, runs through
// speech-to-text, the brain and text-to-speech, and comes back into the
// speaker. A switch shows either mode; both modes' words share each place on
// the page, so switching changes the words and nothing moves. A pulse runs
// the loop and the satellite's ring follows it: Listening on the way out,
// Thinking at the brain, Speaking on the way back. Without JavaScript it shows
// Home Assistant mode with a still ring and no wire.
import DeviceDrawing from "./DeviceDrawing.astro";
import Icon from "./Icon.astro";
import { docHref } from "../lib/site";

type Mode = "home-assistant" | "standalone";
type Words = Record<Mode, string>;

const label: Words = {
  "home-assistant": "Home Assistant: your Assist pipeline",
  standalone: "Standalone: services you choose",
};

const stages: { key: string; n: string; name: Words; say: Words }[] = [
  {
    key: "stt",
    n: "2",
    name: { "home-assistant": "Speech-to-text", standalone: "Speech-to-text" },
    say: {
      "home-assistant": "Whichever your pipeline uses, such as Whisper or Home Assistant Cloud",
      standalone: "OpenAI, Groq, ElevenLabs, or your own server",
    },
  },
  {
    key: "brain",
    n: "3",
    name: { "home-assistant": "Conversation agent", standalone: "Brain" },
    say: {
      "home-assistant": "Home Assistant's own, or a language model you connected to it",
      standalone: "A language model, in the cloud or at home, or an AI agent",
    },
  },
  {
    key: "tts",
    n: "4",
    name: { "home-assistant": "Text-to-speech", standalone: "Text-to-speech" },
    say: {
      "home-assistant": "Whichever your pipeline uses, such as Piper or Home Assistant Cloud",
      standalone: "OpenAI, ElevenLabs, or your own server",
    },
  },
];

const facts: { title: Words; say: Words }[] = [
  {
    title: { "home-assistant": "Adds itself", standalone: "Set up on the dashboard" },
    say: {
      "home-assistant": "Home Assistant finds the satellite and adds it like any ESPHome device, without YAML or an add-on.",
      standalone: "Each service with your own key, or on your own server. No Home Assistant needed.",
    },
  },
  {
    title: { "home-assistant": "Entities for automations", standalone: "Audio only on purpose" },
    say: {
      "home-assistant": "The ring, the buttons, mute, volume, timers and a media player.",
      standalone: "It goes only to those services, and only after the wake word or a press of the Action button.",
    },
  },
  {
    title: { "home-assistant": "Encrypted, updated from there", standalone: "Home Assistant if you like" },
    say: {
      "home-assistant": "Home Assistant encrypts the connection, and new releases install from it.",
      standalone: "It can stay connected for the media player, announcements, the ring and the buttons.",
    },
  },
];

const links: Record<Mode, { label: string; href: string }[]> = {
  "home-assistant": [
    { label: "Connect to Home Assistant", href: docHref("home-assistant") },
    { label: "Home Assistant entities", href: docHref("entities") },
  ],
  standalone: [
    { label: "Set up standalone mode", href: docHref("standalone") },
    { label: "What it can use", href: "#standalone" },
  ],
};

const modes = Object.keys(label) as Mode[];
---

<div class="path" data-path data-mode="home-assistant">
  <div class="pn-segmented" role="group" aria-label="Who answers" data-switch hidden>
    <button type="button" data-set="home-assistant" aria-pressed="true">Home Assistant</button>
    <button type="button" data-set="standalone" aria-pressed="false">Standalone</button>
  </div>

  <div class="loop" data-loop>
    <svg class="wire" aria-hidden="true" data-wire>
      <defs>
        <linearGradient id="loop-wire" gradientUnits="userSpaceOnUse" data-gradient>
          <stop offset="0" style="stop-color: var(--brand-start)"></stop>
          <stop offset="0.5" style="stop-color: var(--brand-mid)"></stop>
          <stop offset="1" style="stop-color: var(--brand-end)"></stop>
        </linearGradient>
        <marker id="loop-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M1,1 L9,5 L1,9" fill="none" stroke="var(--brand-end)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </marker>
      </defs>
      <path class="track" data-track marker-end="url(#loop-arrow)"></path>
      <circle class="pulse" r="4" data-pulse></circle>
    </svg>

    <div class="satellite">
      <div class="end">
        <span class="num">1</span>
        <span class="name">Wake word</span>
        <span class="say">The satellite hears it. Until then, no audio leaves the device.</span>
      </div>
      <div class="device" data-device>
        <DeviceDrawing model="echo-dot-2" id="path-dot" effect="listening" width="100%" label="An Echo Dot (2nd gen) running Pinna." />
      </div>
      <div class="end">
        <span class="num">5</span>
        <span class="name">Reply</span>
        <span class="say">Back on the satellite: the speaker plays it, the ring shows each step.</span>
      </div>
    </div>

    <div class="panel">
      <span class="panel-label swap">
        {
          modes.map((m) => (
            <span data-show={m}>
              <Icon name={m === "home-assistant" ? "home" : "sliders"} size={14} /> {label[m]}
            </span>
          ))
        }
      </span>
      <ol class="stages">
        {
          stages.map((s) => (
            <li class="stage" data-stage={s.key}>
              <span class="num">{s.n}</span>
              <span class="name swap">
                {modes.map((m) => (
                  <span data-show={m}>{s.name[m]}</span>
                ))}
              </span>
              <span class="say swap">
                {modes.map((m) => (
                  <span data-show={m}>{s.say[m]}</span>
                ))}
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <div class="facts">
    {
      facts.map((f) => (
        <div class="fact">
          <span class="fact-title swap">
            {modes.map((m) => (
              <span data-show={m}>{f.title[m]}</span>
            ))}
          </span>
          <span class="fact-say swap">
            {modes.map((m) => (
              <span data-show={m}>{f.say[m]}</span>
            ))}
          </span>
        </div>
      ))
    }
  </div>
  <p class="links swap">
    {
      modes.map((m) => (
        <span data-show={m}>
          {links[m].map((link) => (
            <a class="link inline-flex items-center gap-1.5" href={link.href}>
              {link.label}
              <Icon name="arrow" size={14} />
            </a>
          ))}
        </span>
      ))
    }
  </p>
</div>

<style>
  .path {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  [data-switch] {
    align-self: flex-start;
  }

  [data-switch][hidden] {
    display: none;
  }

  /* Both modes' words share one grid cell, so the taller sets the height and
     switching moves nothing. The other mode's words are hidden, not removed. */
  .swap {
    display: grid;
  }

  .swap > * {
    grid-area: 1 / 1;
  }

  [data-mode="home-assistant"] .swap > [data-show="standalone"],
  [data-mode="standalone"] .swap > [data-show="home-assistant"] {
    visibility: hidden;
  }

  /* -------------------------------------------------------------- loop -- */

  .loop {
    position: relative;
    display: grid;
    gap: 28px;
    /* Room on the right for the wire's way back on phones. */
    padding-right: 28px;
  }

  /* Above the panel, below the cards and the drawing, so the wire shows
     between the stages and passes behind them. */
  .wire {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .track {
    fill: none;
    stroke: url(#loop-wire);
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0.8;
  }

  .pulse {
    fill: var(--brand-mid);
    stroke: color-mix(in oklab, var(--brand-mid) 30%, transparent);
    stroke-width: 6;
    paint-order: stroke;
  }

  /* The wake word above the satellite, the reply below it. */
  .satellite {
    display: grid;
    justify-items: start;
    gap: 14px;
  }

  .device {
    position: relative;
    z-index: 2;
    width: 9rem;
  }

  .end,
  .stage {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    align-items: baseline;
  }

  /* Clear of the wire, which runs down the right on phones. */
  .end {
    max-width: 13.5rem;
  }

  .num {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
    color: var(--brand-mid);
  }

  .name {
    color: var(--ink);
    font-size: 17px;
    line-height: 24px;
    font-weight: 700;
  }

  .say {
    grid-column: 2;
    margin-top: 2px;
    color: var(--ink-muted);
    font-size: 15px;
    line-height: 22px;
  }

  .panel {
    position: relative;
    padding: 14px 16px 16px;
    border: 1px dashed color-mix(in oklab, var(--brand-mid) 45%, var(--line));
    border-radius: var(--radius-md);
  }

  /* The page's own fill, so the wire passes behind the label, not through it. */
  .panel-label {
    position: relative;
    z-index: 2;
    width: fit-content;
    padding-right: 6px;
    background: var(--surface);
    color: var(--ink-muted);
    font-size: 12px;
    line-height: 16px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .panel-label :global(svg) {
    display: inline;
    vertical-align: -2px;
    margin-right: 4px;
  }

  .stages {
    display: grid;
    gap: 28px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }

  .stage {
    position: relative;
    z-index: 2;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface-raised);
    box-shadow: var(--shadow-raised);
  }

  .stage .say {
    font-size: 14px;
    line-height: 20px;
  }

  /* ------------------------------------------------------------- facts -- */

  /* Three short facts, each under a hairline in the mark's colours. */
  .facts {
    display: grid;
    gap: 20px;
  }

  .fact {
    display: grid;
    gap: 4px;
    padding-top: 14px;
    border-top: 2px solid transparent;
    border-image: linear-gradient(90deg, var(--brand-start), var(--brand-end)) 1;
  }

  .fact-title {
    color: var(--ink);
    font-size: 15px;
    line-height: 22px;
    font-weight: 700;
  }

  .fact-say {
    color: var(--ink-muted);
    font-size: 15px;
    line-height: 22px;
  }

  .links > span {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    font-size: 14px;
  }

  /* ---------------------------------------------------------- desktop -- */

  /* The satellite on the left; the stages open to the right as a loop:
     speech-to-text along the top, the brain at the turn, text-to-speech
     along the bottom. */
  @media (min-width: 1024px) {
    .loop {
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: 0 88px;
      align-items: center;
      padding-right: 0;
    }

    .satellite {
      gap: 18px;
    }

    .device {
      width: 11rem;
    }

    /* Narrower than the column, so the wire coming back clears the text. */
    .end {
      max-width: 12.5rem;
    }

    .panel {
      padding: 16px 20px 20px;
    }

    .stages {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        "stt ."
        ". brain"
        "tts .";
      gap: 18px 56px;
    }

    [data-stage="stt"] {
      grid-area: stt;
    }

    [data-stage="brain"] {
      grid-area: brain;
    }

    [data-stage="tts"] {
      grid-area: tts;
    }

    .facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse {
      display: none;
    }
  }
</style>

<script>
  import { displayLevel, ringFrame, type Effect } from "../../../design/ring";

  // One trip round the loop, then a short rest with the ring off.
  const TRIP = 6000;
  const REST = 1400;
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");

  for (const root of document.querySelectorAll<HTMLElement>("[data-path]")) {
    const loop = root.querySelector<HTMLElement>("[data-loop]");
    const svg = root.querySelector<SVGSVGElement>("[data-wire]");
    const track = root.querySelector<SVGPathElement>("[data-track]");
    const pulse = root.querySelector<SVGCircleElement>("[data-pulse]");
    const gradient = root.querySelector<SVGLinearGradientElement>("[data-gradient]");
    const device = root.querySelector<HTMLElement>("[data-device] .pn-drawing");
    const stage = (k: string) => root.querySelector<HTMLElement>(`[data-stage="${k}"]`);
    const stt = stage("stt");
    const brain = stage("brain");
    const tts = stage("tts");
    const toggle = root.querySelector<HTMLElement>("[data-switch]");
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-set]")];
    if (!loop || !svg || !track || !pulse || !device || !stt || !brain || !tts) continue;

    if (toggle) toggle.hidden = false;
    for (const button of buttons) {
      button.addEventListener("click", () => {
        root.dataset.mode = button.dataset.set;
        for (const b of buttons) b.setAttribute("aria-pressed", String(b === button));
      });
    }

    const leds = [...device.querySelectorAll<SVGPathElement>("[data-led]")];
    const glows = [...device.querySelectorAll<SVGPathElement>("[data-glow]")];
    const paint = (effect: Effect, t: number) =>
      ringFrame(effect, t).forEach((p, i) => {
        const stroke = p.c ? `rgb(${p.c.join(",")})` : "none";
        const opacity = p.c ? displayLevel(p.level) : 0;
        leds[i]?.setAttribute("stroke", stroke);
        leds[i]?.setAttribute("stroke-opacity", opacity.toFixed(3));
        glows[i]?.setAttribute("stroke", stroke);
        glows[i]?.setAttribute("stroke-opacity", (opacity * 0.6).toFixed(3));
      });

    // Where, along the wire, the ring turns from Listening to Thinking and
    // from Thinking to Speaking: the brain's top and bottom edges.
    let total = 1;
    let thinkAt = 0.4;
    let speakAt = 0.6;

    const draw = () => {
      const o = loop.getBoundingClientRect();
      const r = (el: Element) => {
        const b = el.getBoundingClientRect();
        return {
          l: b.left - o.left,
          r: b.right - o.left,
          t: b.top - o.top,
          b: b.bottom - o.top,
          cx: b.left - o.left + b.width / 2,
          cy: b.top - o.top + b.height / 2,
        };
      };
      const d = r(device);
      const s = r(stt);
      const k = r(brain);
      const t = r(tts);
      const across = k.l > s.r - 1; // the brain stands beside speech-to-text: the desktop loop
      const parts: string[] = [];
      let toThink = "";
      let toSpeak = "";
      if (across) {
        // Out of the ring along the top, down through the brain, back along the bottom into the speaker.
        const out = { x: d.r - 4, y: d.t + (d.b - d.t) * 0.28 };
        const back = { x: d.r - 6, y: d.t + (d.b - d.t) * 0.7 };
        parts.push(`M${out.x},${out.y}`);
        parts.push(`C${(out.x + s.l) / 2},${out.y} ${(out.x + s.l) / 2},${s.cy} ${s.l},${s.cy}`);
        parts.push(`L${s.r},${s.cy}`);
        parts.push(`C${k.cx},${s.cy} ${k.cx},${s.cy} ${k.cx},${k.t}`);
        toThink = parts.join(" ");
        parts.push(`L${k.cx},${k.b}`);
        toSpeak = parts.join(" ");
        parts.push(`C${k.cx},${t.cy} ${k.cx},${t.cy} ${t.r},${t.cy}`);
        parts.push(`L${t.l},${t.cy}`);
        parts.push(`C${(back.x + t.l) / 2},${t.cy} ${(back.x + t.l) / 2},${back.y} ${back.x},${back.y}`);
      } else {
        // Stacked: from the satellite's right side, down the right edge past
        // the reply, through the stages, and round to come back up into its
        // side. The wire never crosses the text on the left.
        const edge = o.width - 10;
        const x = Math.max(s.l + (s.r - s.l) * 0.78, d.r + 12);
        const out = { x: d.r - 6, y: d.t + (d.b - d.t) * 0.3 };
        const back = { x: d.r - 6, y: d.t + (d.b - d.t) * 0.72 };
        parts.push(`M${out.x},${out.y}`);
        parts.push(`C${x},${out.y} ${x},${out.y} ${x},${out.y + 24}`);
        parts.push(`L${x},${k.t}`);
        toThink = parts.join(" ");
        parts.push(`L${x},${k.b}`);
        toSpeak = parts.join(" ");
        parts.push(`L${x},${t.b}`);
        parts.push(`C${x},${t.b + 24} ${edge},${t.b + 24} ${edge},${t.b - 12}`);
        parts.push(`L${edge},${back.y + 16}`);
        parts.push(`C${edge},${back.y} ${edge},${back.y} ${back.x},${back.y}`);
      }
      track.setAttribute("d", parts.join(" "));
      gradient?.setAttribute("x1", "0");
      gradient?.setAttribute("x2", String(o.width));
      // Lengths along the wire, from throwaway paths of its first parts.
      const measure = (dd: string) => {
        const p = document.createElementNS("http://www.w3.org/2000/svg", "path");
        p.setAttribute("d", dd);
        svg.appendChild(p);
        const len = p.getTotalLength();
        p.remove();
        return len;
      };
      total = track.getTotalLength() || 1;
      thinkAt = measure(toThink) / total;
      speakAt = measure(toSpeak) / total;
    };

    let start = performance.now();
    let raf = 0;
    let visible = false;

    const frame = (now: number) => {
      const t = Math.max(0, now - start) % (TRIP + REST);
      if (t < TRIP) {
        const f = t / TRIP;
        const p = track.getPointAtLength(f * total);
        pulse.setAttribute("cx", String(p.x));
        pulse.setAttribute("cy", String(p.y));
        pulse.style.opacity = "1";
        const effect: Effect = f < thinkAt ? "listening" : f < speakAt ? "thinking" : "speaking";
        const since = f < thinkAt ? t : f < speakAt ? t - thinkAt * TRIP : t - speakAt * TRIP;
        paint(effect, since);
      } else {
        pulse.style.opacity = "0";
        paint("idle", 0);
      }
      raf = requestAnimationFrame(frame);
    };

    const run = () => {
      cancelAnimationFrame(raf);
      if (visible && !reduceMotion.matches) {
        start = performance.now();
        raf = requestAnimationFrame(frame);
      } else {
        pulse.style.opacity = "0";
        paint("listening", 0);
      }
    };

    const resize = new ResizeObserver(draw);
    for (const el of [loop, stt, brain, tts]) resize.observe(el);
    draw();
    new IntersectionObserver(([entry]) => {
      visible = Boolean(entry?.isIntersecting);
      run();
    }).observe(loop);
    reduceMotion.addEventListener("change", run);
  }
</script>
