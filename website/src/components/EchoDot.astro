---
// An Echo Dot (2nd gen) in three-quarter view. design/devices/echo-dot-2.ts
// draws it and .pn-drawing in design/pinna.css styles it, so the dashboard
// shows the same device. Light paths carry data-led / data-glow in pixel
// order; RingDemo animates them.
import { svg } from "../../../design/devices/echo-dot-2.ts";
import type { Effect } from "../../../design/ring";

type Props = {
  /** Effect shown before (or without) JavaScript. */
  effect?: Effect;
  /** Rendered width in px; height follows. */
  width?: number;
  /** Accessible name. */
  label: string;
  /** Unique per page: prefixes gradient and filter ids. */
  id: string;
  class?: string;
};

const { effect = "listening", width = 300, label, id, class: className } = Astro.props;
---

<span
  class:list={["pn-drawing", className]}
  style={`width:${width}px`}
  role="img"
  aria-label={label}
  set:html={svg(id, effect)}
/>
