---
// The hero drawing: the Echo (2nd gen) behind, the Echo Dot (2nd gen) in
// front, staggered so the pair reads with depth. Both rings step through a
// voice request with the device's own timings, with the phase word under the
// Dot. Starts paused (on Listening) under reduced motion, and the Pause button
// stops it at any time.
import DeviceDrawing from "./DeviceDrawing.astro";
import { drawingFor } from "../../../design/devices/index.ts";

type Props = { class?: string };
const { class: className } = Astro.props;

// The scene, in millimetres on the floor: x to the right, z towards the
// viewer. The Echo stands at the origin and the Dot in front of its right
// side, a hand's width clear of it. Both drawings are seen from the same
// angle, so a floor point (x, z) shows at (x, z * tilt), and each is scaled
// to the same millimetres.
const placed = [
  { model: "echo-2", id: "hero-echo", x: 0, z: 0, label: "Illustration of an Echo (2nd gen) running Pinna." },
  {
    model: "echo-dot-2",
    id: "hero-dot",
    x: 54,
    z: 76,
    label: "Illustration of an Echo Dot running Pinna. Its light ring shows the phase named below.",
  },
] as const;

const boxes = placed.map((p) => {
  const { view, foot, mm, tilt } = drawingFor(p.model)!.stage;
  const left = p.x - (foot.x - view.x) / mm;
  const top = p.z * tilt - (foot.y - view.y) / mm;
  return { ...p, left, top, w: view.w / mm, h: view.h / mm };
});

// The floor: a disc round both footprints, seen at the same angle.
const { tilt } = drawingFor("echo-2")!.stage;
const cx = (placed[0].x + placed[1].x) / 2;
const cz = (placed[0].z + placed[1].z) / 2;
const floorR = Math.max(...placed.map((p) => Math.hypot(p.x - cx, p.z - cz) + drawingFor(p.model)!.stage.radius)) + 14;
const floor = { left: cx - floorR, top: cz * tilt - floorR * tilt, w: 2 * floorR, h: 2 * floorR * tilt };

// The stage is the box round the drawings; the floor may spill past it sideways.
const minX = Math.min(...boxes.map((b) => b.left));
const maxX = Math.max(...boxes.map((b) => b.left + b.w));
const minY = Math.min(...boxes.map((b) => b.top));
const maxY = Math.max(floor.top + floor.h, ...boxes.map((b) => b.top + b.h));
const W = maxX - minX;
const H = maxY - minY;
const pct = (b: { left: number; top: number; w: number; h: number }) =>
  `left:${(((b.left - minX) / W) * 100).toFixed(3)}%;top:${(((b.top - minY) / H) * 100).toFixed(3)}%;` +
  `width:${((b.w / W) * 100).toFixed(3)}%;height:${((b.h / H) * 100).toFixed(3)}%`;
---

<figure class:list={["flex w-full flex-col items-center gap-4", className]} data-ring-demo>
  <div class="relative w-[14rem] max-w-full sm:w-[17rem] lg:w-[22rem]" style={`aspect-ratio:${W.toFixed(2)} / ${H.toFixed(2)}`}>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute rounded-[50%]"
      style={`${pct(floor)};background:radial-gradient(closest-side, color-mix(in oklab, var(--ink) 9%, transparent), transparent)`}
    >
    </div>
    {
      boxes.map((b) => (
        <div class="absolute" style={pct(b)}>
          <DeviceDrawing model={b.model} id={b.id} width="100%" label={b.label} />
        </div>
      ))
    }
  </div>
  <figcaption class="flex max-w-[18rem] flex-col items-center gap-2 text-center">
    <span class="flex items-center gap-2">
      <span class="pn-badge" data-phase="listening">
        <span class="pn-badge-dot" aria-hidden="true"></span>
        <span data-word>Listening</span>
      </span>
      <button type="button" class="pn-btn pn-btn-quiet pn-btn-sm" data-toggle hidden>Pause</button>
    </span>
    <span class="text-ink-muted text-caption">
      A demo of the light rings, using the devices' own colours and timing.
    </span>
  </figcaption>
</figure>

<script>
  import { displayLevel, ringFrame, type Effect } from "../../../design/ring";

  const STEPS: { effect: Effect; word: string; ms: number }[] = [
    { effect: "listening", word: "Listening", ms: 3200 },
    { effect: "thinking", word: "Thinking", ms: 2400 },
    { effect: "speaking", word: "Speaking", ms: 4800 },
    { effect: "idle", word: "Idle", ms: 1600 },
  ];
  const CYCLE = STEPS.reduce((sum, s) => sum + s.ms, 0);
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");

  for (const root of document.querySelectorAll<HTMLElement>("[data-ring-demo]")) {
    // Every drawing in the demo (the Echo and the Dot) shows the same phase.
    const drawings = [...root.querySelectorAll<HTMLElement>(".pn-drawing")].map((el) => ({
      leds: [...el.querySelectorAll<SVGPathElement>("[data-led]")],
      glows: [...el.querySelectorAll<SVGPathElement>("[data-glow]")],
    }));
    const badge = root.querySelector<HTMLElement>("[data-phase]");
    const word = root.querySelector<HTMLElement>("[data-word]");
    const toggle = root.querySelector<HTMLButtonElement>("[data-toggle]");

    let elapsed = 0;
    let last = 0;
    let raf = 0;
    let shown = 0;
    let visible = false;
    let playing = !reduceMotion.matches;
    let pausedByUser = false;

    const show = (ms: number) => {
      let t = ms % CYCLE;
      let i = 0;
      while (t >= STEPS[i].ms) t -= STEPS[i++].ms;
      if (i !== shown) {
        shown = i;
        if (badge) badge.dataset.phase = STEPS[i].effect;
        if (word) word.textContent = STEPS[i].word;
      }
      const frame = ringFrame(STEPS[i].effect, t);
      for (const { leds, glows } of drawings) {
        frame.forEach((p, n) => {
          const stroke = p.c ? `rgb(${p.c.join(",")})` : "none";
          const opacity = p.c ? displayLevel(p.level) : 0;
          leds[n]?.setAttribute("stroke", stroke);
          leds[n]?.setAttribute("stroke-opacity", opacity.toFixed(3));
          glows[n]?.setAttribute("stroke", stroke);
          glows[n]?.setAttribute("stroke-opacity", (opacity * 0.6).toFixed(3));
        });
      }
    };

    const tick = (now: number) => {
      elapsed += now - last;
      last = now;
      show(elapsed);
      raf = requestAnimationFrame(tick);
    };

    // Animate only while playing and on screen.
    const run = () => {
      cancelAnimationFrame(raf);
      if (playing && visible) {
        last = performance.now();
        raf = requestAnimationFrame(tick);
      }
    };

    const setPlaying = (next: boolean) => {
      playing = next;
      if (toggle) {
        toggle.textContent = next ? "Pause" : "Play";
        toggle.setAttribute("aria-label", next ? "Pause the ring demo" : "Play the ring demo");
      }
      run();
    };

    if (toggle) {
      toggle.hidden = false;
      toggle.addEventListener("click", () => {
        pausedByUser = playing;
        setPlaying(!playing);
      });
    }
    setPlaying(playing);

    reduceMotion.addEventListener("change", () => {
      if (reduceMotion.matches) setPlaying(false);
      else if (!pausedByUser) setPlaying(true);
    });

    new IntersectionObserver(([entry]) => {
      visible = Boolean(entry?.isIntersecting);
      run();
    }).observe(root);
  }
</script>
