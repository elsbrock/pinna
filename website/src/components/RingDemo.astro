---
// The hero drawing: the Echo (2nd gen) behind, the Echo Dot (2nd gen) in
// front, staggered so the pair reads with depth. The two play the requests in
// ringDemoScenes.ts, with Home Assistant or in standalone mode, each to its own
// wake word: a device that takes part steps through the phases with its own
// timings and a speech bubble shows what was said; a device that doesn't
// stays dark, and both rest between requests. A row of dots names the request
// and jumps to another. Starts paused (on the first request) under reduced
// motion. The Pause button beside the dots stops it at any time and mutes both
// satellites until Play.
import DeviceDrawing from "./DeviceDrawing.astro";
import { drawingFor } from "../../../design/devices/index.ts";
import { MODE_NAME, SCENES, sceneTitle } from "./ringDemoScenes.ts";

type Props = { class?: string };
const { class: className } = Astro.props;

// The scene, in millimetres on the floor: x to the right, z towards the
// viewer. The Echo stands at the origin and the Dot in front of its right
// side, a hand's width clear of it. Both drawings are seen from the same
// angle, so a floor point (x, z) shows at (x, z * tilt), and each is scaled
// to the same millimetres.
const placed = [
  { model: "echo-2", id: "hero-echo", x: 0, z: 0, label: "Illustration of an Echo (2nd gen) running Pinna." },
  { model: "echo-dot-2", id: "hero-dot", x: 54, z: 76, label: "Illustration of an Echo Dot (2nd gen) running Pinna." },
] as const;

// The still frame before the script runs: the first beat of the first request.
const first = SCENES[0];
const opening = (n: number) => first.beats[0].parts.find((p) => p.device === n);

const boxes = placed.map((p) => {
  const { view, foot, mm, tilt } = drawingFor(p.model)!.stage;
  const left = p.x - (foot.x - view.x) / mm;
  const top = p.z * tilt - (foot.y - view.y) / mm;
  return { ...p, left, top, w: view.w / mm, h: view.h / mm };
});

// The floor: a disc round both footprints, seen at the same angle.
const { tilt } = drawingFor("echo-2")!.stage;
const cx = (placed[0].x + placed[1].x) / 2;
const cz = (placed[0].z + placed[1].z) / 2;
const floorR = Math.max(...placed.map((p) => Math.hypot(p.x - cx, p.z - cz) + drawingFor(p.model)!.stage.radius)) + 14;
const floor = { left: cx - floorR, top: cz * tilt - floorR * tilt, w: 2 * floorR, h: 2 * floorR * tilt };

// The stage is the box round the drawings; the floor may spill past it sideways.
const minX = Math.min(...boxes.map((b) => b.left));
const maxX = Math.max(...boxes.map((b) => b.left + b.w));
const minY = Math.min(...boxes.map((b) => b.top));
const maxY = Math.max(floor.top + floor.h, ...boxes.map((b) => b.top + b.h));
const W = maxX - minX;
const H = maxY - minY;
const pct = (b: { left: number; top: number; w: number; h: number }) =>
  `left:${(((b.left - minX) / W) * 100).toFixed(3)}%;top:${(((b.top - minY) / H) * 100).toFixed(3)}%;` +
  `width:${((b.w / W) * 100).toFixed(3)}%;height:${((b.h / H) * 100).toFixed(3)}%`;

// A device's speech bubbles stand on its top edge, flush with the side of the
// stage it stands on, so they never reach past the stage on that side.
const anchor = (b: (typeof boxes)[number]) => {
  const bottom = `bottom:${(100 - ((b.top - minY) / H) * 100).toFixed(3)}%`;
  return b.left + b.w / 2 < minX + W / 2
    ? { side: "left", style: `${bottom};left:${(((b.left - minX) / W) * 100).toFixed(3)}%` }
    : { side: "right", style: `${bottom};right:${(((maxX - b.left - b.w) / W) * 100).toFixed(3)}%` };
};
---

<figure class:list={["flex w-full flex-col items-center gap-4", className]} data-ring-demo>
  <div
    class="relative mt-20 w-[14rem] max-w-full sm:w-[17rem] lg:w-[22rem]"
    style={`aspect-ratio:${W.toFixed(2)} / ${H.toFixed(2)}`}
  >
    <div
      aria-hidden="true"
      class="pointer-events-none absolute rounded-[50%]"
      style={`${pct(floor)};background:radial-gradient(closest-side, color-mix(in oklab, var(--ink) 9%, transparent), transparent)`}
    >
    </div>
    {
      boxes.map((b, i) => (
        <div class="absolute" style={pct(b)}>
          <DeviceDrawing model={b.model} id={b.id} effect={opening(i)?.effect ?? "idle"} width="100%" label={b.label} />
        </div>
      ))
    }
    {
      boxes.map((b, i) => {
        const a = anchor(b);
        const request = opening(i)?.request;
        return (
          <div class="anchor" data-side={a.side} data-device={i} style={a.style} aria-hidden="true">
            <p class="bubble" data-bubble="request" data-shown={request ? "" : undefined}>
              <span class="who">You</span>
              <span data-text>{request ?? ""}</span>
            </p>
            <p class="bubble reply" data-bubble="reply">
              <span class="who" data-who>
                {MODE_NAME[first.mode]}
              </span>
              <span data-text />
            </p>
          </div>
        );
      })
    }
  </div>
  <figcaption class="flex max-w-[18rem] flex-col items-center gap-1 text-center">
    <span class="flex items-center gap-2">
      <span class="scenes" role="group" aria-label="Demo requests" data-scenes hidden>
        {
          SCENES.map((s, i) => (
            <button
              type="button"
              class="scene"
              data-scene={i}
              aria-label={`Play the demo from: ${sceneTitle(s)}`}
              aria-current={i === 0 ? "true" : undefined}
            />
          ))
        }
      </span>
      <button type="button" class="pn-btn pn-btn-quiet pn-btn-sm" data-toggle hidden>Pause</button>
    </span>
    <span class="text-ink-muted text-caption" data-scene-title>{sceneTitle(first)}</span>
  </figcaption>
</figure>

<style>
  .anchor {
    position: absolute;
    width: 0;
    height: 0;
  }

  .bubble {
    position: absolute;
    bottom: 10px;
    width: max-content;
    max-width: 15rem;
    margin: 0;
    padding: 6px 12px 8px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    box-shadow: var(--shadow-raised);
    color: var(--ink);
    font-size: 14px;
    line-height: 20px;
    text-align: left;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 200ms ease,
      transform 200ms ease;
  }

  .bubble[data-shown] {
    opacity: 1;
    transform: none;
  }

  .reply {
    border-color: color-mix(in oklab, var(--brand-mid) 35%, var(--line));
    background: color-mix(in oklab, var(--brand-mid) 12%, var(--surface-raised));
  }

  /* The tail: a square turned onto its corner, the bubble's own fill and edge. */
  .bubble::after {
    content: "";
    position: absolute;
    bottom: -6px;
    width: 10px;
    height: 10px;
    border-right: 1px solid;
    border-bottom: 1px solid;
    border-color: inherit;
    background: inherit;
    transform: rotate(45deg);
  }

  [data-side="left"] .bubble {
    left: 0;
  }

  [data-side="left"] .bubble::after {
    left: 2.5rem;
  }

  [data-side="right"] .bubble {
    right: 0;
  }

  [data-side="right"] .bubble::after {
    right: 2.5rem;
  }

  .who {
    display: block;
    color: var(--ink-muted);
    font-size: 11px;
    line-height: 16px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* The scene row: small dots, the current one a short bar in the mark's
     indigo. Each button is a 24px target round its dot. */
  .scenes {
    display: flex;
    align-items: center;
  }

  .scenes[hidden] {
    display: none;
  }

  .scene {
    display: grid;
    place-items: center;
    width: 20px;
    height: 24px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .scene::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: var(--line-strong);
    transition:
      width 200ms ease,
      background-color 200ms ease;
  }

  .scene:hover::before {
    background: var(--ink-muted);
  }

  .scene[aria-current="true"]::before {
    width: 16px;
    background: var(--brand-mid);
  }

  .scene:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: -2px;
    border-radius: var(--radius-sm);
  }

  @media (prefers-reduced-motion: reduce) {
    .bubble,
    .scene::before {
      transition: none;
    }
  }
</style>

<script>
  import { displayLevel, ringFrame, type Effect } from "../../../design/ring";
  import { MODE_NAME, REST_MS, SCENES, sceneTitle, type Part } from "./ringDemoScenes";

  // The whole demo as one timeline: each beat with its start, and a rest
  // after each request.
  type Step = { start: number; ms: number; scene: number; parts: Part[] };
  const STEPS: Step[] = [];
  const SCENE_START: number[] = [];
  let end = 0;
  SCENES.forEach((scene, s) => {
    SCENE_START.push(end);
    for (const beat of [...scene.beats, { ms: REST_MS, parts: [] }]) {
      STEPS.push({ start: end, ms: beat.ms, scene: s, parts: beat.parts });
      end += beat.ms;
    }
  });
  const CYCLE = end;
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");

  for (const root of document.querySelectorAll<HTMLElement>("[data-ring-demo]")) {
    const drawings = [...root.querySelectorAll<HTMLElement>(".pn-drawing")].map((el) => ({
      leds: [...el.querySelectorAll<SVGPathElement>("[data-led]")],
      glows: [...el.querySelectorAll<SVGPathElement>("[data-glow]")],
    }));
    const bubbles = [...root.querySelectorAll<HTMLElement>("[data-device]")].map((el) => ({
      request: el.querySelector<HTMLElement>('[data-bubble="request"]'),
      reply: el.querySelector<HTMLElement>('[data-bubble="reply"]'),
    }));
    const toggle = root.querySelector<HTMLButtonElement>("[data-toggle]");
    const row = root.querySelector<HTMLElement>("[data-scenes]");
    const dots = [...root.querySelectorAll<HTMLButtonElement>("[data-scene]")];
    const title = root.querySelector<HTMLElement>("[data-scene-title]");

    let elapsed = 0;
    let last = 0;
    let raf = 0;
    let shown = -1;
    let shownScene = 0;
    let visible = false;
    let playing = !reduceMotion.matches;
    let pausedByUser = false;
    let muted = false;

    const paint = (n: number, effect: Effect, t: number) => {
      const { leds, glows } = drawings[n];
      ringFrame(effect, t).forEach((p, i) => {
        const stroke = p.c ? `rgb(${p.c.join(",")})` : "none";
        const opacity = p.c ? displayLevel(p.level) : 0;
        leds[i]?.setAttribute("stroke", stroke);
        leds[i]?.setAttribute("stroke-opacity", opacity.toFixed(3));
        glows[i]?.setAttribute("stroke", stroke);
        glows[i]?.setAttribute("stroke-opacity", (opacity * 0.6).toFixed(3));
      });
    };

    const say = (el: HTMLElement | null, text: string | undefined, who?: string) => {
      if (!el) return;
      if (!text) return void el.removeAttribute("data-shown");
      const span = el.querySelector<HTMLElement>("[data-text]");
      if (span) span.textContent = text;
      const label = el.querySelector<HTMLElement>("[data-who]");
      if (label && who) label.textContent = who;
      el.setAttribute("data-shown", "");
    };

    const markScene = (s: number) => {
      shownScene = s;
      dots.forEach((d, i) => (i === s ? d.setAttribute("aria-current", "true") : d.removeAttribute("aria-current")));
      if (title) title.textContent = sceneTitle(SCENES[s]);
    };

    const show = (ms: number) => {
      const t = ((ms % CYCLE) + CYCLE) % CYCLE;
      let n = 0;
      while (n < STEPS.length - 1 && t >= STEPS[n].start + STEPS[n].ms) n++;
      const step = STEPS[n];
      const into = t - step.start;

      // Bubbles, the scene row and the dark devices change only with the beat.
      if (n !== shown) {
        shown = n;
        const scene = SCENES[step.scene];
        if (step.scene !== shownScene) markScene(step.scene);
        bubbles.forEach((b, d) => {
          const part = step.parts.find((p) => p.device === d);
          say(b.request, part?.request);
          say(b.reply, part?.reply, MODE_NAME[scene.mode]);
          if (!part) paint(d, "idle", 0);
        });
      }
      for (const part of step.parts) paint(part.device, part.effect, into);
    };

    const tick = (now: number) => {
      // A frame's timestamp can be a little older than `last`, set when the
      // animation started: never let the time run backwards.
      elapsed += Math.max(0, now - last);
      last = now;
      show(elapsed);
      raf = requestAnimationFrame(tick);
    };

    // Animate only while playing and on screen.
    const run = () => {
      cancelAnimationFrame(raf);
      if (playing && visible) {
        last = performance.now();
        raf = requestAnimationFrame(tick);
      }
    };

    const setPlaying = (next: boolean) => {
      playing = next;
      if (toggle) {
        toggle.textContent = next ? "Pause" : "Play";
        toggle.setAttribute("aria-label", next ? "Pause the ring demo" : "Play the ring demo");
      }
      run();
    };

    // Pausing mutes both satellites, as their mute buttons would: red rings,
    // no bubbles. Playing again starts with the next request, not mid-sentence.
    const mute = () => {
      muted = true;
      shown = -1;
      bubbles.forEach((b) => {
        say(b.request, undefined);
        say(b.reply, undefined);
      });
      drawings.forEach((_, d) => paint(d, "muted", 0));
    };

    const playFrom = (ms: number) => {
      muted = false;
      pausedByUser = false;
      elapsed = ms;
      shown = -1;
      show(elapsed);
      setPlaying(true);
    };

    if (toggle) {
      toggle.hidden = false;
      toggle.addEventListener("click", () => {
        if (playing) {
          pausedByUser = true;
          setPlaying(false);
          mute();
        } else if (muted) {
          const next = SCENE_START.find((s) => s >= elapsed % CYCLE) ?? 0;
          playFrom(elapsed - (elapsed % CYCLE) + next);
        } else {
          playFrom(elapsed);
        }
      });
    }

    if (row) row.hidden = false;
    dots.forEach((dot, i) =>
      dot.addEventListener("click", () => playFrom(elapsed - (elapsed % CYCLE) + SCENE_START[i])),
    );

    show(elapsed);
    setPlaying(playing);

    reduceMotion.addEventListener("change", () => {
      if (reduceMotion.matches) setPlaying(false);
      else if (!pausedByUser) setPlaying(true);
    });

    new IntersectionObserver(([entry]) => {
      visible = Boolean(entry?.isIntersecting);
      run();
    }).observe(root);
  }
</script>
