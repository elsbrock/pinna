#!/bin/sh
# Make the setup hotspot's interface exist (ADR 0028), before hostapd starts.
# On the MT8163 the vendor driver registers ap0 when "A" is written to
# /dev/wmtWifi, after wifi-up has powered the Wi-Fi function on. It stays
# registered until the next boot: never write "S" or "0" here, since the
# chip powers up once per boot. On a mac80211 driver (the Echo Dot (5th
# gen)'s mt76) it is a second interface on the same radio, added with iw;
# access point mode on the MT7663 is unmeasured. Elsewhere (simulated radios
# in the virtual Echo Dot) the interface is already there under that name.
#
# After hostapd stops, --remove takes the interface iw added off the radio
# again. With ap0 left on the MT7663, wlan0 associates and completes WPA,
# but nothing it sends arrives: the DHCP server saw no DISCOVER, where the
# same join without ap0 got a lease in 0.3 s (Echo Dot (5th gen),
# 2026-11-27). The MT8163's ap0 stays registered.
#
#   wifi-ap ap0
#   wifi-ap --remove ap0
set -u
log() { echo "wifi-ap: $*"; }

if [ "${1:-}" = --remove ]; then
    iface=${2:?usage: wifi-ap --remove <interface>}
    [ "$(pinnactl wifi-chip 2>/dev/null)" = mt7663-sdio ] || exit 0
    [ -e "/sys/class/net/$iface" ] || exit 0
    iw dev "$iface" del || { log "couldn't remove $iface"; exit 1; }
    log "$iface removed"
    exit 0
fi

iface=${1:?usage: wifi-ap <interface>}

[ -e "/sys/class/net/$iface" ] && exit 0
if [ -c /dev/wmtWifi ]; then
    [ -e /sys/class/net/wlan0 ] || { log "wlan0 is missing: the Wi-Fi didn't start this boot"; exit 1; }
    timeout 15 sh -c "printf A > /dev/wmtWifi" || { log "the Wi-Fi driver refused access point mode"; exit 1; }
fi
if [ "$(pinnactl wifi-chip 2>/dev/null)" = mt7663-sdio ]; then
    [ -e /sys/class/net/wlan0 ] || { log "wlan0 is missing: the Wi-Fi didn't start this boot"; exit 1; }
    iw dev wlan0 interface add "$iface" type __ap || { log "the Wi-Fi driver refused access point mode"; exit 1; }
fi
i=0
while [ "$i" -lt 15 ] && [ ! -e "/sys/class/net/$iface" ]; do sleep 1; i=$((i + 1)); done
[ -e "/sys/class/net/$iface" ] || { log "$iface did not appear"; exit 1; }
log "$iface is there"
