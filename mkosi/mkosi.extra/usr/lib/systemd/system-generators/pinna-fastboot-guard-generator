#!/bin/sh
# The fastboot guard arms Kaeru's one-shot fastboot request in misc. Only
# the MT8163 and MT8516 Echos run Kaeru. Amazon's U-Boot has no fastboot and
# the guard's wait for a GPT misc partition would hold up the boot for the
# device timeout, so mask the guard there.
set -eu
if bootloader=$(/usr/bin/pinna-bootctl bootloader) && [ "$bootloader" != kaeru ]; then
    ln -sf /dev/null "$2/pinna-fastboot-guard.service"
fi
