# The satellite's hostname is its node name (ADR 0010): the dashboard's
# setting, else pinnad.toml's, else pinna-2a914e from the MAC. It is systemd's
# transient hostname; the image has no static one. Set it before
# systemd-networkd sends it with DHCP and systemd-resolved announces it over
# mDNS. pinnad sets it again at start.
[Unit]
Description=Name this satellite on the network
DefaultDependencies=no
# After a factory reset, the name from the cleared settings must not come back.
After=local-fs.target pinna-factory-reset.service
Before=systemd-networkd.service systemd-resolved.service network-pre.target sysinit.target
Wants=network-pre.target

[Service]
Type=oneshot
ExecStart=/usr/bin/pinnad --set-hostname

[Install]
WantedBy=sysinit.target
