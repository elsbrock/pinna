# USB network to the host over the micro-USB cable (NCM gadget).
# The host gets 10.42.0.x by DHCP; no default route or DNS is pushed, so the
# host's own networking is unaffected. ssh root@10.42.0.1.
[Match]
Name=usb0

[Network]
Address=10.42.0.1/24
DHCPServer=yes
MulticastDNS=yes
LinkLocalAddressing=ipv6
ConfigureWithoutCarrier=yes

[DHCPServer]
PoolOffset=10
PoolSize=20
EmitDNS=no
EmitRouter=no
