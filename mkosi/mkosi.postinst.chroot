#!/bin/sh
# Runs inside the image after packages and extra trees are installed.
set -eu

# No static hostname (ADR 0010): the name is systemd's transient one, set by
# pinna-hostname.service; os-release gives the fallback before that.
grep -q '^DEFAULT_HOSTNAME=' /usr/lib/os-release || echo 'DEFAULT_HOSTNAME="pinna"' >> /usr/lib/os-release
rm -f /etc/hostname

# The time zone is a setting (ADR 0007): /etc/localtime, on the read-only root,
# links to the link pinnad points at the chosen zone.
ln -sfn ../var/lib/pinna/localtime /etc/localtime
rm -f /etc/timezone

# Core services.
systemctl enable \
    systemd-networkd.service \
    systemd-resolved.service \
    systemd-timesyncd.service \
    ssh.service \
    pinna-gadget.service \
    pinna-wifi.service \
    pinna-bootstages.service \
    pinnad.service \
    pinna-fastboot-guard.service \
    pinna-boot-ok.service \
    systemd-sysext.service \
    pinna-pipewire.service \
    pinna-wireplumber.service \
    pinna-factory-reset.service \
    pinna-hostname.service

# wpa_supplicant and the USB serial getty are started by udev when wlan0 /
# ttyGS0 appear (see 90-pinna.rules), never by a static dependency on a device
# that may not exist (QEMU, Wi-Fi bring-up failure).
systemctl mask wpa_supplicant.service
# pinna-hotspot.service runs hostapd for the setup hotspot (ADR 0028).
systemctl mask hostapd.service

# No VT, no package management on a read-only image, no gpt-auto.
systemctl mask \
    getty@tty1.service \
    apt-daily.timer apt-daily-upgrade.timer \
    man-db.timer \
    e2scrub_all.timer e2scrub_reap.service \
    systemd-firstboot.service
mkdir -p /etc/systemd/system-generators
ln -sf /dev/null /etc/systemd/system-generators/systemd-gpt-auto-generator

# PipeWire runs system-wide on the device (pinna-pipewire.service, static Echo
# Dot nodes in /etc/pipewire/pipewire.conf.d); no per-user instances.
# The Echo Dot (5th gen)'s graph: PipeWire loads the .conf.d of the config's
# name (/usr/libexec/pinna/pipewire picks it on the MT8519).
ln -sfn ../../usr/share/pipewire/pipewire.conf /etc/pipewire/pinna-echo-dot-5.conf
systemctl --global disable pipewire.socket pipewire-pulse.socket wireplumber.service 2>/dev/null || true
systemctl --global mask pipewire.service pipewire.socket pipewire-pulse.service pipewire-pulse.socket wireplumber.service filter-chain.service 2>/dev/null || true

# pinna-airplay.service runs shairport-sync; resolved is the mDNS responder (ADR 0011).
systemctl mask shairport-sync.service avahi-daemon.service avahi-daemon.socket

# Bluetooth runs only while the switch is on: pinnad starts
# pinna-bluetooth.target, never udev or D-Bus activation. bluealsa-aplay would
# play past pinnad (ADR 0011).
if [ -e /usr/lib/systemd/system/bluetooth.service ]; then
    systemctl disable bluetooth.service bluealsa.service
    systemctl mask bluealsa-aplay.service
    # The mode bluetooth.service's ConfigurationDirectoryMode expects.
    chmod 0555 /etc/bluetooth
fi

ln -sfn ../run/systemd/resolve/stub-resolv.conf /etc/resolv.conf

# Pinna's system groups (sysusers.d/pinna.conf). /etc is read-only on the
# device, so they are created here, in the image.
systemd-sysusers /usr/lib/sysusers.d/pinna.conf

# The WMT driver opens its firmware by fixed paths under /lib/firmware and
# /etc/firmware.
ln -sfn ../usr/lib/firmware /etc/firmware
if [ -e /usr/lib/firmware/WIFI_RAM_CODE_8163 ] && [ ! -e /usr/lib/firmware/WIFI_RAM_CODE ]; then
    ln -s WIFI_RAM_CODE_8163 /usr/lib/firmware/WIFI_RAM_CODE
fi

# Permissions for owner-local inputs.
if [ -d /root/.ssh ]; then
    chmod 700 /root/.ssh
    chmod 600 /root/.ssh/authorized_keys 2>/dev/null || true
fi
chmod 600 /usr/share/pinna/wifi/*.conf 2>/dev/null || true
mkdir -p /etc/wpa_supplicant
ln -sfn /var/lib/pinna/wifi/wpa_supplicant-wlan0.conf /etc/wpa_supplicant/wpa_supplicant-wlan0.conf
chmod 755 /usr/libexec/pinna/* /usr/bin/pinna* 2>/dev/null || true

# udev's vendor-name databases (PCI, USB, IEEE OUI: 9 MB of sources and most
# of the 13 MB hwdb.bin) name hardware no Echo has, and nothing in Pinna reads
# them. Drop them and rebuild the index from the rest, so the root fits the
# Echo Dot (5th gen)'s 125 MiB system volume (ADR 0035).
rm -f /usr/lib/udev/hwdb.d/20-pci-vendor-model.hwdb \
    /usr/lib/udev/hwdb.d/20-usb-vendor-model.hwdb \
    /usr/lib/udev/hwdb.d/20-OUI.hwdb
systemd-hwdb update --usr
